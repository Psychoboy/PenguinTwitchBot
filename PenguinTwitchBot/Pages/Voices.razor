@page "/voices"
@attribute [Authorize(Roles = "Streamer, Editor")]
@inject PenguinTwitchBot.Bot.Commands.TTS.ITTSService TTSService

<PageTitle>@(AppConfiguration["ApplicationTitle"] ?? "Penguin Twitch Bot") - Voices</PageTitle>

<MudContainer MaxWidth="MaxWidth.False">
    <MudGrid>
        @* ── User-assigned voices ── *@
        <MudItem xs="8">
            <MudPaper Elevation="2" Class="pa-4">
                <MudTable Items="@UserRegisteredVoices">
                    <HeaderContent>
                        <MudTh>Username</MudTh>
                        <MudTh>Name</MudTh>
                        <MudTh>Sex</MudTh>
                        <MudTh>Type</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Username</MudTd>
                        <MudTd>@context.Name</MudTd>
                        <MudTd>@context.Sex</MudTd>
                        <MudTd>@context.Type</MudTd>
                            <MudTd DataLabel="Delete">
                                <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                                           @onclick="() => DeleteUserVoice(context)">
                                    Delete
                                </MudButton>
                            </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </MudItem>

        @* ── Assign voice to user ── *@
        <MudItem xs="4">
            <MudCard>
                <MudPaper Elevation="2" Class="pa-4">
                    <EditForm Model="@customVoice" OnValidSubmit="OnSubmit">
                        <MudTextField Label="Name" Required="true" @bind-Value="customVoice.Name" />
                        @if(SelectedVoice == null)
                        {
                            <MudText>No voice selected</MudText>
                        } else
                        {
                            <MudText>@SelectedVoice.Name</MudText>
                        }
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                                   Class="ml-auto">
                            Submit
                        </MudButton>
                    </EditForm>
                </MudPaper>
            </MudCard>
        </MudItem>

        @* ── Registered (active) voices ── *@
        <MudItem xs="6">
            <MudPaper Elevation="2" Class="pa-4">
                <MudTable Items="@RegisteredVoices">
                    <HeaderContent>
                        <MudTh>Name</MudTh>
                        <MudTh>Sex</MudTh>
                        <MudTh>Type</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Name</MudTd>
                            <MudTd>@context.Sex</MudTd>
                            <MudTd>@context.Type</MudTd>
                            <MudTd DataLabel="Delete">
                                <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                                           @onclick="() => Delete(context)">
                                    Delete
                                </MudButton>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            </MudItem>

        @* ── Available voices panel ── *@
        <MudItem xs="6">
            <MudPaper Elevation="2" Class="pa-4">

                @* ─ Kokoro voices (always available, no button needed) ─ *@
                <MudText Typo="Typo.h6" Class="mb-2">
                    Kokoro Voices
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Class="ml-2">Offline · No Cost</MudChip>
                </MudText>

                <MudTextField @bind-Value="KokoroFilter" Label="Filter" Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-2" />

                <MudTable Items="@FilteredKokoroVoices" Dense="true">
                    <HeaderContent>
                        <MudTh>Name</MudTh>
                        <MudTh>Language</MudTh>
                        <MudTh>Sex</MudTh>
                        <MudTh></MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Name</MudTd>
                        <MudTd>@context.LanguageCode</MudTd>
                        <MudTd>@context.Sex</MudTd>
                        <MudTd><MudButton Variant="Variant.Filled" Color="Color.Primary" @onclick="() => AddVoice(context)">Add</MudButton></MudTd>
                        <MudTd><MudButton Variant="Variant.Filled" Color="Color.Secondary" @onclick="() => SelectVoice(context)">Select</MudButton></MudTd>
                    </RowTemplate>
                </MudTable>

                <MudDivider Class="my-4" />

                @* ─ Google voices (requires credentials, explicit load) ─ *@
                <MudText Typo="Typo.h6" Class="mb-2">Google Voices</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           @onclick="LoadGoogleVoices"
                           Disabled="@_loadingGoogle"
                           Class="mb-2">
                    @(_loadingGoogle ? "Loading…" : "Load Google Voices")
                </MudButton>

                @if (GoogleVoices.Count > 0)
                {
                    <MudTable Items="@GoogleVoices" Dense="true">
                        <HeaderContent>
                            <MudTh>Name</MudTh>
                            <MudTh>Language</MudTh>
                            <MudTh>Sex</MudTh>
                            <MudTh></MudTh>
                            <MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.Name</MudTd>
                            <MudTd>@context.LanguageCode</MudTd>
                            <MudTd>@context.Sex</MudTd>
                            <MudTd><MudButton Variant="Variant.Filled" Color="Color.Primary" @onclick="() => AddVoice(context)">Add</MudButton></MudTd>
                            <MudTd><MudButton Variant="Variant.Filled" Color="Color.Secondary" @onclick="() => SelectVoice(context)">Select</MudButton></MudTd>
                        </RowTemplate>
                    </MudTable>
                }

            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private List<PenguinTwitchBot.Database.Bot.Models.RegisteredVoice> KokoroVoices { get; set; } = new();
    private List<PenguinTwitchBot.Database.Bot.Models.RegisteredVoice> GoogleVoices { get; set; } = new();
    private List<PenguinTwitchBot.Database.Bot.Models.RegisteredVoice> RegisteredVoices { get; set; } = new();
    private List<PenguinTwitchBot.Database.Bot.Models.UserRegisteredVoice> UserRegisteredVoices { get; set; } = new();
    private PenguinTwitchBot.Database.Bot.Models.RegisteredVoice? SelectedVoice { get; set; }
    private CustomVoice customVoice { get; set; } = new();
    private string KokoroFilter { get; set; } = string.Empty;
    private bool _loadingGoogle;

    private IEnumerable<PenguinTwitchBot.Database.Bot.Models.RegisteredVoice> FilteredKokoroVoices =>
        string.IsNullOrWhiteSpace(KokoroFilter)
            ? KokoroVoices
            : KokoroVoices.Where(v =>
                v.Name.Contains(KokoroFilter, StringComparison.OrdinalIgnoreCase) ||
                (v.LanguageCode?.Contains(KokoroFilter, StringComparison.OrdinalIgnoreCase) ?? false));

    public class CustomVoice
    {
        public string Name { get; set; } = "";
    }

    protected override async Task OnInitializedAsync()
    {
        // Kokoro voices are pre-populated; Google voices loaded on demand.
        KokoroVoices = await TTSService.GetAllVoices(includeGoogle: false);
        RegisteredVoices = await TTSService.GetRegisteredVoices();
        UserRegisteredVoices = await TTSService.GetUserRegisteredVoices();
        await base.OnInitializedAsync();
    }

    private async Task LoadGoogleVoices()
    {
        _loadingGoogle = true;
        StateHasChanged();
        var all = await TTSService.GetAllVoices(includeGoogle: true);
        GoogleVoices = all
            .Where(v => v.Type == PenguinTwitchBot.Database.Bot.Models.RegisteredVoice.VoiceType.Google)
            .ToList();
        _loadingGoogle = false;
        StateHasChanged();
    }

    private async Task AddVoice(RegisteredVoice voice)
    {
        await TTSService.RegisterVoice(voice);
        RegisteredVoices = await TTSService.GetRegisteredVoices();
        StateHasChanged();
    }

    private void SelectVoice(RegisteredVoice voice)
    {
        SelectedVoice = voice;
    }

    private async Task OnSubmit()
    {
        if (SelectedVoice == null) return;
        var userVoice = new UserRegisteredVoice
            {
                Username = customVoice.Name,
                LanguageCode = SelectedVoice.LanguageCode,
                Name = SelectedVoice.Name,
                Sex = SelectedVoice.Sex,
                Type = SelectedVoice.Type
            };
        await TTSService.RegisterUserVoice(userVoice);
        UserRegisteredVoices = await TTSService.GetUserRegisteredVoices();
        SelectedVoice = null;
        customVoice = new();
        StateHasChanged();
    }

    public async Task Delete(RegisteredVoice voice)
    {
        await TTSService.DeleteRegisteredVoice(voice);
        RegisteredVoices = await TTSService.GetRegisteredVoices();
        StateHasChanged();
    }

    public async Task DeleteUserVoice(UserRegisteredVoice voice)
    {
        await TTSService.DeleteRegisteredUserVoice(voice);
        UserRegisteredVoices = await TTSService.GetUserRegisteredVoices();
        StateHasChanged();
    }
}
