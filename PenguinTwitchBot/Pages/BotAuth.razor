@page "/settings/bot-auth"
@attribute [Authorize(Roles = "Streamer")]
@using PenguinTwitchBot.Bot.TwitchServices
@using PenguinTwitchBot.Shared.Help
@inject IConfiguration Configuration
@inject SettingsFileManager SettingsFileManager
@inject ITwitchService twitchService
@inject ITwitchChatBot twitchChatBot
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>@(AppConfiguration["ApplicationTitle"] ?? "Penguin Twitch Bot") - Bot Authentication</PageTitle>

<MudContainer Class="pa-4 pa-md-6" MaxWidth="MaxWidth.Large">
    <MudStack Spacing="4">
        <!-- Header -->
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
            <MudStack Spacing="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Security" Color="Color.Primary" Size="Size.Large" />
                    <MudText Typo="Typo.h5"><b>Bot &amp; Streamer Authentication</b></MudText>
                </MudStack>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Manage Twitch OAuth connections, view active status, configure developer credentials, and refresh access tokens.
                </MudText>
            </MudStack>

            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="RefreshStatusesAsync"
                           Disabled="_isRefreshing">
                    Refresh Status
                </MudButton>
                <HelpButton Topic="bot-auth" />
            </MudStack>
        </MudStack>

        <!-- Account Cards Grid -->
        <MudGrid Spacing="4">
            <!-- Streamer / Broadcaster Account Card -->
            <MudItem xs="12" md="6">
                <MudPaper Elevation="2" Class="pa-4 pa-md-5 h-100 d-flex flex-column justify-space-between">
                    <MudStack Spacing="3">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudAvatar Color="Color.Primary" Variant="Variant.Filled">
                                    <MudIcon Icon="@Icons.Material.Filled.LiveTv" />
                                </MudAvatar>
                                <div>
                                    <MudText Typo="Typo.h6"><b>Streamer Account</b></MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Broadcaster &amp; Channel Manager</MudText>
                                </div>
                            </MudStack>

                            @if (_isStreamerUp)
                            {
                                <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small">
                                    Connected
                                </MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Color="Color.Error" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Cancel" Size="Size.Small">
                                    Disconnected
                                </MudChip>
                            }
                        </MudStack>

                        <MudDivider />

                        <MudStack Spacing="2">
                            <MudStack Row="true" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Channel Name:</MudText>
                                <MudText Typo="Typo.body2"><b>@(_broadcasterName ?? "Unknown")</b></MudText>
                            </MudStack>

                            <MudStack Row="true" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Broadcaster User ID:</MudText>
                                <MudText Typo="Typo.body2" Style="font-family: monospace;">@(_broadcasterUserId ?? "Not Loaded")</MudText>
                            </MudStack>

                            <MudStack Row="true" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Helix Service Status:</MudText>
                                <MudText Typo="Typo.body2">
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@GetStatusColor(_streamerStatus)">
                                        @_streamerStatus
                                    </MudChip>
                                </MudText>
                            </MudStack>
                        </MudStack>

                        @if (!_isStreamerUp)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true">
                                Streamer account token is missing or expired. Sign in below to grant permissions for channel rewards, raids, and EventSub.
                            </MudAlert>
                        }
                    </MudStack>

                    <MudStack Row="true" Spacing="2" Class="mt-4" Wrap="Wrap.Wrap">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Login"
                                   Href="/streamersignin">
                            Sign In as Streamer
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Autorenew"
                                   OnClick="ValidateStreamerTokenAsync"
                                   Disabled="_isValidatingStreamer">
                            @if (_isValidatingStreamer)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                                <span>Validating...</span>
                            }
                            else
                            {
                                <span>Validate &amp; Refresh</span>
                            }
                        </MudButton>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <!-- Bot Account Card -->
            <MudItem xs="12" md="6">
                <MudPaper Elevation="2" Class="pa-4 pa-md-5 h-100 d-flex flex-column justify-space-between">
                    <MudStack Spacing="3">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudAvatar Color="Color.Secondary" Variant="Variant.Filled">
                                    <MudIcon Icon="@Icons.Material.Filled.SmartToy" />
                                </MudAvatar>
                                <div>
                                    <MudText Typo="Typo.h6"><b>Bot Account</b></MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Chatbot &amp; Announcement Actor</MudText>
                                </div>
                            </MudStack>

                            @if (_isBotTokenValid)
                            {
                                <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small">
                                    Token Active
                                </MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Color="Color.Error" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Warning" Size="Size.Small">
                                    Token Disconnected
                                </MudChip>
                            }
                        </MudStack>

                        <MudDivider />

                        <MudStack Spacing="2">
                            <MudStack Row="true" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Bot Username:</MudText>
                                <MudText Typo="Typo.body2"><b>@(_botUsername ?? "Not Configured")</b></MudText>
                            </MudStack>

                            <MudStack Row="true" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Chat Channel:</MudText>
                                <MudText Typo="Typo.body2"><b>#@(_broadcasterName ?? "Unknown")</b></MudText>
                            </MudStack>

                            <MudStack Row="true" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Bot Token Status:</MudText>
                                <MudText Typo="Typo.body2">
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(_isBotTokenValid ? Color.Success : Color.Error)">
                                        @(_isBotTokenValid ? "Valid / Active" : "Invalid / Expired")
                                    </MudChip>
                                </MudText>
                            </MudStack>
                        </MudStack>

                        @if (!_isBotTokenValid)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true">
                                Bot token is invalid or expired. Sign in below with your bot account or refresh the existing token.
                            </MudAlert>
                        }
                    </MudStack>

                    <MudStack Row="true" Spacing="2" Class="mt-4" Wrap="Wrap.Wrap">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Secondary"
                                   StartIcon="@Icons.Material.Filled.SmartToy"
                                   Href="/botsignin">
                            Sign In as Bot
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Secondary"
                                   StartIcon="@Icons.Material.Filled.Refresh"
                                   OnClick="RefreshBotAuthAsync"
                                   Disabled="_isRefreshingBot">
                            @if (_isRefreshingBot)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                                <span>Refreshing...</span>
                            }
                            else
                            {
                                <span>Refresh Token</span>
                            }
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   StartIcon="@Icons.Material.Filled.Chat"
                                   OnClick="SendTestPingAsync"
                                   Disabled="@(!_isBotTokenValid || _isSendingPing)">
                            @if (_isSendingPing)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                                <span>Sending...</span>
                            }
                            else
                            {
                                <span>Test Ping</span>
                            }
                        </MudButton>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <!-- Twitch Application & Extension Configuration Card -->
            <MudItem xs="12">
                <MudPaper Elevation="2" Class="pa-4 pa-md-5">
                    <MudStack Spacing="3">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudAvatar Color="Color.Tertiary" Variant="Variant.Filled">
                                    <MudIcon Icon="@Icons.Material.Filled.AppRegistration" />
                                </MudAvatar>
                                <div>
                                    <MudText Typo="Typo.h6"><b>Twitch Developer Application &amp; Extension</b></MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        Configure API credentials, channel identities, and Twitch Extension secrets stored in <code>appsettings.secrets.json</code>.
                                    </MudText>
                                </div>
                            </MudStack>

                            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                @if (!string.IsNullOrWhiteSpace(_clientId))
                                {
                                    <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle">
                                        Client ID Configured
                                    </MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.Warning">
                                        Missing Client ID
                                    </MudChip>
                                }

                                @if (!string.IsNullOrWhiteSpace(_clientSecret))
                                {
                                    <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle">
                                        Client Secret Configured
                                    </MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.Warning">
                                        Missing Client Secret
                                    </MudChip>
                                }

                                @if (!string.IsNullOrWhiteSpace(_extensionSecret))
                                {
                                    <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.Extension">
                                        Extension Secret Active
                                    </MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.ExtensionOff">
                                        Extension Secret Not Set
                                    </MudChip>
                                }
                            </MudStack>
                        </MudStack>

                        <MudDivider />

                        <MudAlert Severity="Severity.Info" Dense="true" Class="my-1">
                            Updating credentials writes directly to <code>appsettings.secrets.json</code>. Twitch Extension secrets take effect immediately via hot-reload. Modifying Client ID or Channel names may require re-authenticating above or restarting Penguin Bot.
                        </MudAlert>

                        <MudGrid Spacing="3">
                            <!-- Broadcaster Channel -->
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="_broadcasterNameInput"
                                              Label="Broadcaster Channel Name"
                                              HelperText="Your Twitch username / channel name (e.g. superpenguintv)"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.LiveTv"
                                              Variant="Variant.Outlined"
                                              Immediate="true" />
                            </MudItem>

                            <!-- Bot Username -->
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="_botUsernameInput"
                                              Label="Bot Account Username"
                                              HelperText="The Twitch username of your bot account (e.g. super_waffle_bot)"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.SmartToy"
                                              Variant="Variant.Outlined"
                                              Immediate="true" />
                            </MudItem>

                            <!-- Twitch Client ID -->
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="_clientIdInput"
                                              Label="Twitch Application Client ID"
                                              HelperText="From Twitch Developer Console -> Manage Application"
                                              Adornment="Adornment.Start"
                                              AdornmentIcon="@Icons.Material.Filled.Key"
                                              Variant="Variant.Outlined"
                                              Immediate="true" />
                            </MudItem>

                            <!-- Twitch Client Secret -->
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="_clientSecretInput"
                                              Label="Twitch Application Client Secret"
                                              HelperText="Generated client secret for your Twitch Developer Application"
                                              InputType="@(_showClientSecret ? InputType.Text : InputType.Password)"
                                              Adornment="Adornment.End"
                                              AdornmentIcon="@(_showClientSecret ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                              OnAdornmentClick="@(() => _showClientSecret = !_showClientSecret)"
                                              Variant="Variant.Outlined"
                                              Immediate="true" />
                            </MudItem>

                            <!-- Twitch Extension Secret -->
                            <MudItem xs="12">
                                <MudTextField @bind-Value="_extensionSecretInput"
                                              Label="Twitch Extension Shared Secret"
                                              HelperText="Base64-encoded secret from Twitch Developer Console -> Extensions -> Extension Configuration. Used to verify extension JWT tokens."
                                              InputType="@(_showExtensionSecret ? InputType.Text : InputType.Password)"
                                              Adornment="Adornment.End"
                                              AdornmentIcon="@(_showExtensionSecret ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                              OnAdornmentClick="@(() => _showExtensionSecret = !_showExtensionSecret)"
                                              Validation="@(new Func<string, string?>(ValidateExtensionSecretInput))"
                                              Variant="Variant.Outlined"
                                              Immediate="true" />
                            </MudItem>
                        </MudGrid>

                        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="mt-2">
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Default"
                                       StartIcon="@Icons.Material.Filled.Undo"
                                       OnClick="ResetSettingsInputs"
                                       Disabled="_isSavingSettings">
                                Reset
                            </MudButton>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Save"
                                       OnClick="SaveTwitchAppSettingsAsync"
                                       Disabled="_isSavingSettings">
                                @if (_isSavingSettings)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                                    <span>Saving...</span>
                                }
                                else
                                {
                                    <span>Save Configuration</span>
                                }
                            </MudButton>
                        </MudStack>
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudStack>
</MudContainer>

@code {
    private bool _isRefreshing;
    private bool _isValidatingStreamer;
    private bool _isRefreshingBot;
    private bool _isSendingPing;
    private bool _isSavingSettings;
    private bool _showClientSecret;
    private bool _showExtensionSecret;

    private bool _isStreamerUp;
    private TwitchServiceStatus _streamerStatus = TwitchServiceStatus.Unknown;
    private string? _broadcasterName;
    private string? _broadcasterUserId;
    private string? _botUsername;
    private string? _clientId;
    private string? _clientSecret;
    private string? _extensionSecret;
    private bool _isBotTokenValid;

    private string? _broadcasterNameInput;
    private string? _botUsernameInput;
    private string? _clientIdInput;
    private string? _clientSecretInput;
    private string? _extensionSecretInput;

    protected override async Task OnInitializedAsync()
    {
        await LoadStateAsync();
    }

    private async Task LoadStateAsync()
    {
        _broadcasterName = Configuration["broadcaster"];
        _botUsername = Configuration["botName"];
        _clientId = Configuration["twitchClientId"];
        _clientSecret = Configuration["twitchClientSecret"];
        _extensionSecret = Configuration["TwitchExtension:Secret"]
            ?? Configuration["Twitch:ExtensionSecret"]
            ?? Configuration["TwitchExtensionSecret"];

        _broadcasterNameInput = _broadcasterName;
        _botUsernameInput = _botUsername;
        _clientIdInput = _clientId;
        _clientSecretInput = _clientSecret;
        _extensionSecretInput = _extensionSecret;

        try
        {
            _isStreamerUp = twitchService.IsServiceUp();
            _streamerStatus = twitchService.GetStatus();
            _broadcasterUserId = await twitchService.GetBroadcasterUserId();
        }
        catch
        {
            _isStreamerUp = false;
            _streamerStatus = TwitchServiceStatus.Unavailable;
        }

        try
        {
            _isBotTokenValid = await twitchChatBot.IsConnected();
        }
        catch
        {
            _isBotTokenValid = false;
        }
    }

    private async Task RefreshStatusesAsync()
    {
        _isRefreshing = true;
        await LoadStateAsync();
        _isRefreshing = false;
        Snackbar.Add("Authentication status updated.", Severity.Info);
    }

    private void ResetSettingsInputs()
    {
        _broadcasterNameInput = _broadcasterName;
        _botUsernameInput = _botUsername;
        _clientIdInput = _clientId;
        _clientSecretInput = _clientSecret;
        _extensionSecretInput = _extensionSecret;
        Snackbar.Add("Form reset to currently loaded configuration.", Severity.Info);
    }

    private static string? ValidateExtensionSecretInput(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return null;
        }

        try
        {
            _ = Convert.FromBase64String(value.Trim());
            return null;
        }
        catch (FormatException)
        {
            return "Extension secret must be a valid Base64 string.";
        }
    }

    private async Task SaveTwitchAppSettingsAsync()
    {
        if (!string.IsNullOrWhiteSpace(_extensionSecretInput) && ValidateExtensionSecretInput(_extensionSecretInput) != null)
        {
            Snackbar.Add("Extension secret must be a valid Base64 string before saving.", Severity.Error);
            return;
        }

        _isSavingSettings = true;
        try
        {
            var trimmedBroadcaster = _broadcasterNameInput?.Trim() ?? string.Empty;
            var trimmedBotName = _botUsernameInput?.Trim() ?? string.Empty;
            var trimmedClientId = _clientIdInput?.Trim() ?? string.Empty;
            var trimmedClientSecret = _clientSecretInput?.Trim() ?? string.Empty;
            var trimmedExtensionSecret = _extensionSecretInput?.Trim() ?? string.Empty;

            await SettingsFileManager.AddOrUpdateAppSetting("broadcaster", trimmedBroadcaster);
            await SettingsFileManager.AddOrUpdateAppSetting("botName", trimmedBotName);
            await SettingsFileManager.AddOrUpdateAppSetting("twitchClientId", trimmedClientId);
            await SettingsFileManager.AddOrUpdateAppSetting("twitchClientSecret", trimmedClientSecret);
            await SettingsFileManager.AddOrUpdateAppSetting("TwitchExtension:Secret", trimmedExtensionSecret);

            _broadcasterName = trimmedBroadcaster;
            _botUsername = trimmedBotName;
            _clientId = trimmedClientId;
            _clientSecret = trimmedClientSecret;
            _extensionSecret = trimmedExtensionSecret;

            Snackbar.Add("Twitch application and extension settings saved to appsettings.secrets.json.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving settings: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSavingSettings = false;
        }
    }

    private async Task ValidateStreamerTokenAsync()
    {
        _isValidatingStreamer = true;
        try
        {
            var valid = await twitchService.ValidateAndRefreshToken();
            await LoadStateAsync();
            if (valid)
            {
                Snackbar.Add("Streamer token validated and active.", Severity.Success);
            }
            else
            {
                Snackbar.Add("Streamer token validation failed. Please sign in again.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Validation error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isValidatingStreamer = false;
        }
    }

    private async Task RefreshBotAuthAsync()
    {
        _isRefreshingBot = true;
        try
        {
            var result = await twitchChatBot.RefreshAccessToken();
            await LoadStateAsync();
            if (result)
            {
                Snackbar.Add("Bot access token refreshed successfully.", Severity.Success);
            }
            else
            {
                Snackbar.Add("Failed to refresh bot access token. Please sign in with your bot account.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Refresh error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isRefreshingBot = false;
        }
    }

    private async Task SendTestPingAsync()
    {
        _isSendingPing = true;
        try
        {
            var pingMessage = $"[Bot Test] Penguin Twitch Bot is connected and active! Timestamp: {DateTime.UtcNow:HH:mm:ss} UTC";
            var result = await twitchChatBot.SendMessage(pingMessage);
            if (result?.IsSent == true)
            {
                Snackbar.Add("Test message sent to Twitch chat.", Severity.Success);
            }
            else
            {
                var reason = result?.DropReason?.Message ?? "Test message was dropped or delivery was not confirmed by Twitch.";
                Snackbar.Add($"Test message was not sent: {reason}", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error sending test message: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSendingPing = false;
        }
    }

    private static Color GetStatusColor(TwitchServiceStatus status) => status switch
    {
        TwitchServiceStatus.Connected => Color.Success,
        TwitchServiceStatus.AuthenticationDisconnected => Color.Warning,
        TwitchServiceStatus.Unavailable => Color.Error,
        _ => Color.Default
    };

    private static string MaskString(string? value)
    {
        if (string.IsNullOrEmpty(value) || value.Length <= 8) return "••••••••";
        return $"{value[..4]}••••••••{value[^4..]}";
    }
}