@page "/backups"
@using PenguinTwitchBot.Services
@using PenguinTwitchBot.Shared.Help
@using System.IO
@using PenguinTwitchBot.Database.Bot.DatabaseTools
@using Microsoft.AspNetCore.Components.Forms
@inject PenguinTwitchBot.Bot.Commands.Moderation.Admin Admin
@inject PenguinTwitchBot.Database.Bot.DatabaseTools.IBackupTools BackupTools
@inject IBackupSettingsService BackupSettings
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@attribute [Authorize(Roles = "Streamer")]

<PageTitle>@(AppConfiguration["ApplicationTitle"] ?? "Penguin Twitch Bot") - Backups</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudStack Spacing="4">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <div>
                <MudText Typo="Typo.h4">Backup Management</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Create, download, and restore compressed database backups with automated retention.</MudText>
            </div>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudFileUpload T="IBrowserFile" Accept=".zip" FilesChanged="UploadBackupArchive">
                    <CustomContent>
                        <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.CloudUpload" Disabled="_uploading" OnClick="@context.OpenFilePickerAsync">
                            @(_uploading ? "Uploading..." : "Upload Backup (.zip)")
                        </MudButton>
                    </CustomContent>
                </MudFileUpload>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Backup" OnClick="BackupDatabase">
                    Create Backup
                </MudButton>
                <HelpButton Topic="backups" />
            </MudStack>
        </MudStack>

        <MudPaper Elevation="2" Class="pa-4">
            <MudStack Spacing="3">
                <MudText Typo="Typo.h6">Backup Retention Settings</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Configure how many backups to keep and for how long. Both constraints are applied together when cleaning up old backups.
                </MudText>
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                    Saved to the database <code>Setting</code> table.
                </MudAlert>
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudNumericField @bind-Value="_maxBackups" Label="Max backups to keep" Min="1" Max="1000" Immediate="true" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudNumericField @bind-Value="_maxDays" Label="Max days to keep" Min="1" Max="3650" Immediate="true" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudNumericField @bind-Value="_chatHistoryMonthsToBackup" Label="Chat history months to include in backup" Min="0" Max="120" Immediate="true" Variant="Variant.Outlined" />
                    </MudItem>
                </MudGrid>
                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveSettingsAsync" Disabled="_saving">
                        Save Settings
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" OnClick="ResetSettingsAsync">
                        Reset to Defaults
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>

        <MudText Typo="Typo.h6">Existing Backups (@_backups.Count)</MudText>

        @if (_backups.Count == 0)
        {
            <MudPaper Elevation="0" Outlined="true" Class="pa-6" Style="text-align: center;">
                <MudStack AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Large" Color="Color.Secondary" />
                    <MudText Typo="Typo.body1" Color="Color.Secondary">No backups found</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Create your first backup to get started.</MudText>
                </MudStack>
            </MudPaper>
        }
        else
        {
            <MudTable Items="@_backups" Dense="true" Hover="true" Bordered="true" Striped="true">
                <HeaderContent>
                    <MudTh>File Name</MudTh>
                    <MudTh>Creation Time</MudTh>
                    <MudTh>Size</MudTh>
                    <MudTh>Format</MudTh>
                    <MudTh>Migration ID</MudTh>
                    <MudTh>Rows</MudTh>
                    <MudTh Style="text-align: right;">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    @{
                        var manifest = GetOrLoadManifest(context);
                    }
                    <MudTd DataLabel="File Name">@context.Name</MudTd>
                    <MudTd DataLabel="Creation Time">@context.CreationTime.ToString("yyyy-MM-dd HH:mm")</MudTd>
                    <MudTd DataLabel="Size">@FormatBytes(context.Length)</MudTd>
                    <MudTd DataLabel="Format">
                        @if (manifest != null)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">v@manifest.FormatVersion</MudChip>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Legacy / Unknown</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Migration ID">
                        @if (!string.IsNullOrWhiteSpace(manifest?.LatestMigrationId))
                        {
                            <MudTooltip Text="@manifest.LatestMigrationId">
                                <MudText Typo="Typo.body2">@(manifest.LatestMigrationId.Length > 20 ? manifest.LatestMigrationId[..20] + "..." : manifest.LatestMigrationId)</MudText>
                            </MudTooltip>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">-</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Rows">
                        @if (manifest != null)
                        {
                            <MudText Typo="Typo.body2">@manifest.Tables.Values.Sum(t => t.RowCount).ToString("N0")</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">-</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Actions" Style="text-align: right;">
                        <MudStack Row="true" Style="justify-content: flex-end;" Spacing="1">
                            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small" OnClick="() => RestoreBackup(context)" StartIcon="@Icons.Material.Filled.Restore">
                                Restore
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="() => DownloadBackup(context)" StartIcon="@Icons.Material.Filled.Download">
                                Download
                            </MudButton>
                        </MudStack>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudStack>
</MudContainer>

@code {
    private List<FileInfo> _backups = new();
    private readonly Dictionary<string, BackupManifest?> _manifestCache = new(StringComparer.OrdinalIgnoreCase);
    private int _maxBackups = 15;
    private int _maxDays = 15;
    private int _chatHistoryMonthsToBackup = 12;
    private bool _saving;
    private bool _uploading;

    [Inject] private IDialogService DialogService { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadSettingsAsync();
        await RefreshBackupsAsync();
    }

    private BackupManifest? GetOrLoadManifest(FileInfo fileInfo)
    {
        if (_manifestCache.TryGetValue(fileInfo.FullName, out var cached))
        {
            return cached;
        }

        try
        {
            var manifest = BackupTools.ValidateBackupArchive(fileInfo.FullName);
            _manifestCache[fileInfo.FullName] = manifest;
            return manifest;
        }
        catch
        {
            _manifestCache[fileInfo.FullName] = null;
            return null;
        }
    }

    private async Task UploadBackupArchive(IBrowserFile file)
    {
        if (file == null) return;

        if (!file.Name.EndsWith(".zip", StringComparison.OrdinalIgnoreCase))
        {
            Snackbar.Add("Only .zip backup archives can be uploaded.", Severity.Error);
            return;
        }

        _uploading = true;
        var tempFile = Path.Combine(Path.GetTempPath(), $"{Guid.NewGuid()}.zip");
        try
        {
            await using (var stream = file.OpenReadStream(maxAllowedSize: 500 * 1024 * 1024))
            await using (var fs = new FileStream(tempFile, FileMode.Create, FileAccess.Write))
            {
                await stream.CopyToAsync(fs);
            }

            var manifest = BackupTools.ValidateBackupArchive(tempFile);

            var destFile = Path.Combine(BackupTools.BackupDirectory, file.Name);
            if (File.Exists(destFile))
            {
                var nameWithoutExt = Path.GetFileNameWithoutExtension(file.Name);
                destFile = Path.Combine(BackupTools.BackupDirectory, $"{nameWithoutExt}_{DateTime.UtcNow:yyyyMMddHHmmss}.zip");
            }

            File.Move(tempFile, destFile, overwrite: true);
            _manifestCache[destFile] = manifest;

            var totalRows = manifest.Tables.Values.Sum(t => t.RowCount);
            Snackbar.Add($"Backup uploaded and validated successfully! Format v{manifest.FormatVersion}, Migration: {manifest.LatestMigrationId ?? "N/A"}, Tables: {manifest.Tables.Count}, Total Rows: {totalRows:N0}", Severity.Success);

            await RefreshBackupsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to upload backup archive: {ex.Message}", Severity.Error);
        }
        finally
        {
            if (File.Exists(tempFile))
            {
                try { File.Delete(tempFile); } catch { /* ignore */ }
            }
            _uploading = false;
        }
    }

    private async Task LoadSettingsAsync()
    {
        _maxBackups = await BackupSettings.GetBackupCountToKeepAsync();
        _maxDays = await BackupSettings.GetBackupDaysToKeepAsync();
        _chatHistoryMonthsToBackup = await BackupSettings.GetBackupChatHistoryMonthsToKeepAsync();
    }

    private async Task SaveSettingsAsync()
    {
        _saving = true;
        try
        {
            _maxBackups = _maxBackups < 1 ? 1 : _maxBackups;
            _maxDays = _maxDays < 1 ? 1 : _maxDays;
            _chatHistoryMonthsToBackup = _chatHistoryMonthsToBackup < 0 ? 0 : _chatHistoryMonthsToBackup;

            await BackupSettings.SetBackupCountToKeepAsync(_maxBackups);
            await BackupSettings.SetBackupDaysToKeepAsync(_maxDays);
            await BackupSettings.SetBackupChatHistoryMonthsToKeepAsync(_chatHistoryMonthsToBackup);

            Snackbar.Add("Backup retention settings saved successfully.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to save settings: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ResetSettingsAsync()
    {
        _maxBackups = 15;
        _maxDays = 15;
        _chatHistoryMonthsToBackup = 12;
        await SaveSettingsAsync();
    }

    private async Task BackupDatabase()
    {
        Snackbar.Add("Database backup started...", Severity.Info);
        await Admin.BackupDatabase();
        await RefreshBackupsAsync();
        Snackbar.Add("Database backup completed.", Severity.Success);
    }

    private async Task RefreshBackupsAsync()
    {
        _manifestCache.Clear();
        _backups = BackupTools.GetBackupFiles(BackupTools.BackupDirectory)
            .OrderByDescending(x => x.CreationTime)
            .ToList();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RestoreBackup(FileInfo fileInfo)
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
            "Warning",
            "Are you sure you want to restore this database? Doing so will wipe current data!",
            yesText: "Restore!", cancelText: "Cancel");
        if (result != null)
        {
            try
            {
                await Admin.RestoreDatabase(fileInfo.FullName);
                await DialogService.ShowMessageBoxAsync("Success", "Database restored successfully!");
            }
            catch (Exception e)
            {
                await DialogService.ShowMessageBoxAsync("Error", e.Message);
            }
        }
    }

    private async Task DownloadBackup(FileInfo fileInfo)
    {
        try
        {
            var fileName = Path.GetFileName(fileInfo.FullName);
            var stream = File.OpenRead(fileInfo.FullName);
            var streamRef = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("downloadFile", fileName, streamRef);
            Snackbar.Add("Download started.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to download backup: {ex.Message}", Severity.Error);
        }
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes >= 0x1000000000000000) { return ((double)(bytes >> 50) / 1024).ToString("0.### EB"); }
        if (bytes >= 0x4000000000000) { return ((double)(bytes >> 40) / 1024).ToString("0.### PB"); }
        if (bytes >= 0x10000000000) { return ((double)(bytes >> 30) / 1024).ToString("0.### TB"); }
        if (bytes >= 0x40000000) { return ((double)(bytes >> 20) / 1024).ToString("0.### GB"); }
        if (bytes >= 0x100000) { return ((double)(bytes >> 10) / 1024).ToString("0.### MB"); }
        if (bytes >= 0x400) { return ((double)(bytes) / 1024).ToString("0.###") + " KB"; }
        return bytes.ToString("0 Bytes");
    }
}
