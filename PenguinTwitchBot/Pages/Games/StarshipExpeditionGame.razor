    private async Task<bool> SaveSectionAsync(string sectionName, Action<StarshipExpeditionSettings, StarshipExpeditionSettings> applySection)
    {
        if (_settings == null || _persistedSettings == null || _isSaving) return false;
        _isSaving = true;
        _error = string.Empty;
        try
        {
            var candidate = StarshipEventEditing.Copy(_persistedSettings);
            applySection(candidate, _settings);
            candidate = StarshipExpeditionSettings.NormalizeAndValidate(candidate);
            await SettingsStore.SaveAsync(candidate);
            _persistedSettings = StarshipEventEditing.Copy(candidate);
            try
            {
                await ExpeditionService.RefreshAppearanceAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"{sectionName} saved, but the appearance refresh failed: {ex.Message}", Severity.Warning);
                return true;
            }
            Snackbar.Add($"{sectionName} saved.", Severity.Success);
            return true;
        }
        catch (Exception ex)
        {
            _error = $"Could not save {sectionName.ToLowerInvariant()}: {ex.Message}";
            return false;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task SaveEventDefinitionAsync(StarshipEventDefinition definition)
    {
        var saved = await SaveSectionAsync($"Event '{definition.Title}'", (candidate, current) =>
        {
            var index = candidate.EventCatalog.FindIndex(item => item.EventType == definition.EventType);
            if (index < 0) candidate.EventCatalog.Add(definition);
            else candidate.EventCatalog[index] = definition;

            if (!string.IsNullOrWhiteSpace(definition.RewardProfileId) &&
                candidate.RewardProfiles.All(profile => profile.Id != definition.RewardProfileId) &&
                current.RewardProfiles.FirstOrDefault(profile => profile.Id == definition.RewardProfileId) is { } newProfile)
                candidate.RewardProfiles.Add(StarshipEventEditing.Copy(newProfile));
        });
        if (!saved) throw new InvalidOperationException(_error);
    }

