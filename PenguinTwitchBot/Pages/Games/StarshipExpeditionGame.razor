    private int GetBulkRewardTargetCount()
    {
        if (_settings == null) return 0;
        var tiers = _settings.RewardProfiles.Where(profile => _bulkProfileIds.Contains(profile.Id))
            .SelectMany(profile => profile.GetTiers())
            .Where(tier => string.Equals(tier.Name, _bulkRarityName, StringComparison.OrdinalIgnoreCase));
        if (_bulkAddReward)
            return _bulkPointTypeId is > 0
                ? tiers.Count(tier => tier.Rewards.Count < StarshipRewardProfile.MaximumRewardsPerTier &&
                                      !tier.Rewards.Any(reward => reward.PointTypeId == _bulkPointTypeId.Value))
                : 0;
        return tiers.SelectMany(tier => tier.Rewards)
            .Count(reward => !_bulkPointTypeId.HasValue || reward.PointTypeId == _bulkPointTypeId.Value);
    }

    private async Task PreviewBulkRewardEditAsync()
    {
        _bulkRewardError = string.Empty;
        _bulkRewardPreview = string.Empty;
        try
