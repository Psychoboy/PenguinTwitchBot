    private BalanceTestSummary SimulateBalance(StarshipExpeditionSettings settings, int runCount, int firstSeed, StarshipPreviewVoterPolicy voterPolicy)
    {
        var repairWindows = 0;
        var stationVisits = 0;
        var failures = 0;
        var randomEvents = 0;
        var earlyReturns = 0;
        long hullLost = 0;
        long endingHull = 0;
        long endingSupplies = 0;

        for (var run = 0; run < runCount; run++)
        {
            var seed = unchecked(firstSeed + run);
            var preview = ExpeditionService.BuildPreview(settings, seed, voterPolicy);
            foreach (var item in preview)
            {
                if (item.EventType == "StationStop" && item.ShipContext is { } station)
                {
                    stationVisits++;
                    if (station.HullBefore < settings.ShipSystems.MaximumHull &&
                        station.SuppliesBefore >= settings.ShipSystems.StationRepairSuppliesCost)
                        repairWindows++;
                }
                else if (!StarshipEventCatalog.IsStructural(item.EventType))
                {
                    randomEvents++;
                    if (item.OutcomeResult == StarshipExpeditionNarrative.OutcomeFailure) failures++;
                }
                if (item.ShipContext is { } context)
                    hullLost += Math.Max(0, context.HullBefore - context.HullAfter);
            }

            if (preview.Count < settings.LegCount) earlyReturns++;
            endingHull += preview.LastOrDefault()?.ShipContext?.HullAfter ?? settings.ShipSystems.StartingHull;
            endingSupplies += preview.LastOrDefault()?.ShipContext?.SuppliesAfter ?? settings.ShipSystems.StartingSupplies;
        }

        return new(runCount, stationVisits, repairWindows, failures, randomEvents, earlyReturns,
            hullLost / (double)runCount, endingHull / (double)runCount, endingSupplies / (double)runCount);
    }

    private sealed record BalanceTestSummary(int Runs, int StationVisits, int RepairWindows, int Failures,
        int RandomEvents, int EarlyReturns, double AverageHullLost, double AverageEndingHull, double AverageEndingSupplies)
    {
        public double FailureRatePercent => RandomEvents == 0 ? 0 : Failures * 100d / RandomEvents;
    }

