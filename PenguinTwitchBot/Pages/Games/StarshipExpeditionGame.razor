@page "/games/starship"
@attribute [Authorize(Roles = "Streamer, Editor")]
@using PenguinTwitchBot.Bot.Commands.Games.Starship
@using PenguinTwitchBot.Bot.Features
@using PenguinTwitchBot.Pages.Components
@using MudBlazor.Utilities
@inject IStarshipExpeditionSettingsStore SettingsStore
@inject IStarshipExpeditionService ExpeditionService
@inject PenguinTwitchBot.Bot.Actions.IActionManagementService ActionManagement
@inject PenguinTwitchBot.Bot.Core.Points.IPointsSystem PointsSystem
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<PageTitle>Starship Expedition</PageTitle>

<FeatureGate FeatureKey="@FeatureKeys.DropGames" DisabledMessage="Minigames are currently disabled. Enable them on the Bot Features page.">
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-8">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
            <div>
                <MudText Typo="Typo.h4">Starship Expedition</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Configure the voyage, preview a seeded route, and control the active expedition.</MudText>
                @if (_settings != null)
                {
                    <MudSwitch T="bool" Color="Color.Success" Label="Enable Starship Expedition" @bind-Value="_settings.GameEnabled" />
                }
                <MudText Typo="Typo.caption" Color="Color.Secondary">Save each settings section where you edit it. Saving one section leaves other unsaved edits untouched; events persist when you choose Save Event.</MudText>
            </div>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteSweep"
                           Disabled="@(_isSaving || _isLoading)" OnClick="ResetAllSettingsAsync">
                    Reset All
                </MudButton>
                <HelpButton Topic="starship-game" />
            </MudStack>
        </MudStack>

        @if (!_isLoading && !string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@_error</MudAlert>
        }

        @if (_isLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (_settings != null)
        {
            <ErrorBoundary>
                <ChildContent>
            <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-5" KeepPanelsAlive="true"
                     @bind-ActivePanelIndex="_activeTabIndex" @bind-ActivePanelIndex:after="OnActiveTabChangedAsync">
                <MudTabPanel Text="Voyage Settings">
                    <MudGrid Spacing="4">
                        <MudItem xs="12" lg="7">
                            <MudPaper Class="pa-4" Outlined="true">
                                <MudText Typo="Typo.h6" Class="mb-3">Expedition Configuration</MudText>
                                <MudGrid Spacing="3">
                                    <MudItem xs="12" sm="6">
                                        <MudNumericField T="int" Label="Voyage Legs" Variant="Variant.Outlined"
                                                         Min="1" Max="@StarshipExpeditionSettings.MaximumLegCount"
                                                         @bind-Value="_settings.LegCount" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudNumericField T="int" Label="Base Stop Interval (Legs)" Variant="Variant.Outlined"
                                                         Min="1" Max="@StarshipExpeditionSettings.MaximumLegCount"
                                                         HelperText="Stops are spread through the voyage; e.g. interval 3 gives one stop at 5-6 legs and two at 7."
                                                         @bind-Value="_settings.StationIntervalLegs" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudNumericField T="int" Label="Minimum Event Interval (Minutes)" Variant="Variant.Outlined"
                                                         Min="1" Max="@StarshipExpeditionSettings.MaximumEventIntervalLimitMinutes"
                                                         @bind-Value="_settings.MinimumEventIntervalMinutes" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudNumericField T="int" Label="Maximum Event Interval (Minutes)" Variant="Variant.Outlined"
                                                         Min="1" Max="@StarshipExpeditionSettings.MaximumEventIntervalLimitMinutes"
                                                         @bind-Value="_settings.MaximumEventIntervalMinutes" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudNumericField T="int" Label="Event Vote Window (Seconds)" Variant="Variant.Outlined"
                                                         Min="10" Max="300"
                                                         @bind-Value="_settings.EventVoteDurationSeconds" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudNumericField T="int" Label="Crew Boarding Window (Seconds)" Variant="Variant.Outlined"
                                                         Min="10" Max="300"
                                                         @bind-Value="_settings.BoardingDurationSeconds" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudSwitch T="bool" Color="Color.Primary"
                                                   @bind-Value="_settings.ActiveCrewRewardsOnly"
                                                   Label="Only Reward Active Crew" />
                                    </MudItem>
                                </MudGrid>
                                <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-3">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                                               Disabled="@_isSaving" OnClick="SaveExpeditionConfigurationAsync">Save Expedition Configuration</MudButton>
                                </MudStack>
                            </MudPaper>
                            <MudDivider Class="my-4" />
                            <StarshipShipSettingsEditor Settings="_settings.ShipSystems" />
                            <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-3">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                                           Disabled="@_isSaving" OnClick="SaveShipSystemsAsync">Save Ship Systems</MudButton>
                            </MudStack>
                        </MudItem>

                        <MudItem xs="12" lg="5">
                            <MudPaper Class="pa-4" Outlined="true">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                                    <div>
                                        <MudText Typo="Typo.h6">Live Expedition</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@FormatLiveStatus()</MudText>
                                    </div>
                                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" aria-label="Refresh expedition status"
                                                   Disabled="@_isOperating" OnClick="RefreshLiveStatusAsync" />
                                </MudStack>
                                @if (_liveSnapshot?.ShipSystems is { IntegrationEnabled: true } liveShip)
                                {
                                    <MudText Typo="Typo.body2">Hull @liveShip.Hull / @liveShip.Rules.MaximumHull</MudText>
                                    <MudProgressLinear Value="@(100d * liveShip.Hull / liveShip.Rules.MaximumHull)" Color="@(liveShip.Hull <= liveShip.Rules.MaximumHull / 4 ? Color.Error : Color.Success)" Class="mb-2" />
                                    <MudText Typo="Typo.body2">Supplies @liveShip.Supplies / 100</MudText>
                                    <MudProgressLinear Value="@liveShip.Supplies" Color="@(liveShip.Supplies == 0 ? Color.Warning : Color.Info)" Class="mb-2" />
                                    <MudText Typo="Typo.caption">Pending bonus +@liveShip.PendingSuccessBonusPercent pp | Active bonus +@liveShip.ActiveSuccessBonusPercent pp</MudText>
                                    @if (!string.IsNullOrEmpty(_liveSnapshot.ReturnReason))
                                    {
                                        <MudAlert Severity="Severity.Warning" Dense="true">Return reason: @_liveSnapshot.ReturnReason</MudAlert>
                                    }
                                }
                                @if (_liveSnapshot?.CurrentEvent is { } activeEvent)
                                {
                                    <MudText Typo="Typo.subtitle1">@activeEvent.Title</MudText>
                                    <MudText Typo="Typo.body2" Class="mb-2">@activeEvent.Description</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Sector: @activeEvent.Sector | Votes: @activeEvent.Votes.Count / @_liveSnapshot.Crew.Count</MudText>
                                    @if (GetLiveRewardProfile(activeEvent.EventType) is { } liveProfile)
                                    {
                                        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">@GetRewardProfilePreview(liveProfile, useSnapshotPointName: true)</MudAlert>
                                    }
                                }
                                <MudDivider Class="my-3" />
                                <MudStack Row="true" Spacing="2">
                                    <MudButton Variant="Variant.Filled" Color="Color.Success" Disabled="@(_isOperating || IsLive || _persistedSettings?.GameEnabled != true)"
                                               StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="StartLiveExpeditionAsync">Start Voyage</MudButton>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(_isOperating || !IsLive)"
                                               StartIcon="@Icons.Material.Filled.SkipNext" OnClick="AdvanceLiveEventAsync">
                                        @(_liveSnapshot?.Status == StarshipExpeditionStatus.Boarding ? "Launch Now" : "Advance Event")
                                    </MudButton>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="@(_isOperating || !IsLive)"
                                               StartIcon="@Icons.Material.Filled.Stop" OnClick="StopLiveExpeditionAsync">Stop</MudButton>
                                </MudStack>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                <MudTabPanel Text="Events & Sectors">
                    @if (_visitedTabs.Contains(1))
                    {
                    @if (_isLoadingRewardEditorOptions)
                    {
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" />
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Loading event editor options...</MudText>
                    }
                    else
                    {
                    <MudGrid Spacing="4">
                        <MudItem xs="12" lg="9">
                            <StarshipEventCatalogEditor @ref="_eventCatalogEditor" Settings="_settings" PointTypes="_rewardPointTypes" Actions="_rewardActions"
                                                        EventApplied="SaveEventDefinitionAsync" EventDeleted="DeleteEventDefinitionAsync" />
                        </MudItem>
                        <MudItem xs="12" lg="3">
                            <MudText Typo="Typo.h6">Sectors</MudText>
                            <MudText Typo="Typo.caption" Color="@(_settings.GetEffectiveSectors().Count < 2 ? Color.Error : Color.Secondary)">@_settings.GetEffectiveSectors().Count available (minimum 2)</MudText>
                            @foreach (var sector in StarshipExpeditionSettings.BuiltInSectors)
                            {
                                <MudCheckBox T="bool" Color="Color.Primary" Label="@sector"
                                             Value="@(!_settings.DisabledBuiltInSectors.Contains(sector, StringComparer.OrdinalIgnoreCase))"
                                             ValueChanged="@(enabled => SetBuiltInSectorEnabled(sector, enabled))" />
                            }
                            <MudDivider Class="my-3" />
                            <MudText Typo="Typo.subtitle2">Custom Sectors</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@_settings.CustomSectors.Count / @StarshipExpeditionSettings.MaximumCustomSectors</MudText>
                            <MudStack Spacing="2" Class="mt-2">
                                @for (var index = 0; index < _settings.CustomSectors.Count; index++)
                                {
                                    var sectorIndex = index;
                                    <MudStack Row="true" AlignItems="AlignItems.Center">
                                        <MudTextField T="string" Label="Sector Name" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                      Value="@_settings.CustomSectors[sectorIndex]" ValueChanged="@(value => UpdateSectorName(sectorIndex, value))" />
                                        <MudTooltip Text="Remove sector"><MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" aria-label="Remove custom sector" OnClick="@(() => RemoveSector(sectorIndex))" /></MudTooltip>
                                    </MudStack>
                                }
                                <MudStack Row="true" AlignItems="AlignItems.Center">
                                    <MudTextField T="string" Label="New Sector Name" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_newSectorName" />
                                    <MudTooltip Text="Add sector"><MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" aria-label="Add custom sector"
                                        Disabled="@(_settings.CustomSectors.Count >= StarshipExpeditionSettings.MaximumCustomSectors || string.IsNullOrWhiteSpace(_newSectorName))" OnClick="AddSector" /></MudTooltip>
                                </MudStack>
                                <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-3">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                                               Disabled="@_isSaving" OnClick="SaveSectorsAsync">Save Sectors</MudButton>
                                </MudStack>
                            </MudStack>
                        </MudItem>
                    </MudGrid>
                    }
                    }
                </MudTabPanel>

                <MudTabPanel Text="Reward Profiles">
                    @if (_visitedTabs.Contains(2))
                    {
                    @if (_isLoadingRewardEditorOptions)
                    {
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" />
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Loading reward editor options...</MudText>
                    }
                    else
                    {
                    <MudStack Spacing="3">
                        <div>
                            <MudText Typo="Typo.h6">Event Type Reward Bindings</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">These dropdowns choose which shared reward profile each built-in event uses. They do not edit profile payouts; custom events select their profile in Events &amp; Sectors.</MudText>
                        </div>
                        <MudGrid Spacing="2">
                            @foreach (var eventType in StarshipExpeditionSettings.RewardEventTypes)
                            {
                                <MudItem xs="12" sm="6" lg="3">
                                    <MudSelect T="string" Label="@eventType" Variant="Variant.Outlined" Value="@_settings.GetEffectiveRewardBindings().GetValueOrDefault(eventType, string.Empty)" ValueChanged="@(id => SetRewardBinding(eventType, id))">
                                        <MudSelectItem T="string" Value="@string.Empty">No rewards</MudSelectItem>
                                        @foreach (var profile in _settings.RewardProfiles)
                                        {
                                            <MudSelectItem T="string" Value="@profile.Id">@profile.Name</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                            }
                        </MudGrid>
                        <MudPaper Class="pa-4" Outlined="true">
                            <MudText Typo="Typo.h6">Bulk Edit Rarity Rewards</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">Choose profiles, a rarity, and a point type. Update the selected currency’s existing payouts, or add it to selected tiers where it is not already paid.</MudText>
                            @if (_rewardPointTypes.Count == 0)
                            {
                                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">No point types are configured. Create a point type before editing payouts.</MudAlert>
                            }
                            <MudSwitch T="bool" Label="Add reward to tiers instead of updating existing rewards" Color="Color.Primary"
                                       @bind-Value="_bulkAddReward" @bind-Value:after="InvalidateBulkRewardPreview" />
                            <MudGrid Spacing="2">
                                <MudItem xs="12" lg="5">
                                    <MudText Typo="Typo.subtitle2">Profiles</MudText>
                                    <MudStack Row="true" Wrap="Wrap.Wrap">
                                        @foreach (var profile in _settings.RewardProfiles)
                                        {
                                            var profileId = profile.Id;
                                            <MudCheckBox T="bool" Label="@profile.Name" Value="@_bulkProfileIds.Contains(profileId)"
                                                         ValueChanged="@(selected => ToggleBulkProfile(profileId, selected))" />
                                        }
                                    </MudStack>
                                </MudItem>
                                <MudItem xs="12" sm="6" lg="3">
                                    <MudSelect T="string" Label="Rarity" Variant="Variant.Outlined" @bind-Value="_bulkRarityName" @bind-Value:after="InvalidateBulkRewardPreview">
                                        @foreach (var rarity in GetBulkRarityOptions())
                                        {
                                            <MudSelectItem T="string" Value="@rarity">@rarity</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" sm="6" lg="3">
                                    <MudSelect T="int?" Label="Point Type" Variant="Variant.Outlined" Value="_bulkPointTypeId" ValueChanged="SetBulkPointType" Placeholder="Select a point type">
                                        @if (!_bulkAddReward)
                                        {
                                            <MudSelectItem T="int?" Value="@((int?)null)">All point types</MudSelectItem>
                                        }
                                        @foreach (var pointType in _rewardPointTypes)
                                        {
                                            <MudSelectItem T="int?" Value="@((int?)pointType.Key)">@pointType.Value</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="6" sm="3" lg="2"><MudNumericField T="long?" Label="Minimum" Variant="Variant.Outlined" Min="0" Clearable="true" @bind-Value="_bulkMinimum" @bind-Value:after="InvalidateBulkRewardPreview" /></MudItem>
                                <MudItem xs="6" sm="3" lg="2"><MudNumericField T="long?" Label="Maximum" Variant="Variant.Outlined" Min="0" Clearable="true" @bind-Value="_bulkMaximum" @bind-Value:after="InvalidateBulkRewardPreview" /></MudItem>
                                <MudItem xs="6" sm="3" lg="2"><MudNumericField T="int?" Label="Reward Chance (%)" Variant="Variant.Outlined" Min="1" Max="100" Clearable="true" @bind-Value="_bulkChancePercent" @bind-Value:after="InvalidateBulkRewardPreview" /></MudItem>
                                <MudItem xs="12" Class="d-flex align-center">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@GetBulkRewardTargetCount() @(_bulkAddReward ? "tiers can receive this point type" : "reward entries match")</MudText>
                                    <MudSpacer />
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Preview"
                                               Disabled="@(GetBulkRewardTargetCount() == 0 || !HasBulkRewardChanges)" OnClick="PreviewBulkRewardEditAsync">Preview Changes</MudButton>
                                </MudItem>
                            </MudGrid>
                            @if (!string.IsNullOrWhiteSpace(_bulkRewardPreview))
                            {
                                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">@_bulkRewardPreview</MudAlert>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Check"
                                           Class="mt-2" Disabled="@_isApplyingBulkRewards" OnClick="ApplyBulkRewardEditAsync">Apply to Unsaved Settings</MudButton>
                            }
                            @if (!string.IsNullOrWhiteSpace(_bulkRewardError))
                            {
                                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@_bulkRewardError</MudAlert>
                            }
                        </MudPaper>
                        <MudExpansionPanels>
                            @foreach (var profile in _settings.RewardProfiles)
                            {
                                <MudExpansionPanel Text="@GetRewardProfileLabel(profile)" @key="profile">
                                    <StarshipRewardProfileEditor Profile="profile" PointTypes="_rewardPointTypes" Actions="_rewardActions" />
                                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">@GetRewardProfilePreview(profile)</MudAlert>
                                    <MudButton StartIcon="@Icons.Material.Filled.ContentCopy" Class="mt-2" OnClick="@(() => CloneRewardProfile(profile))">Clone Profile</MudButton>
                                    @if (profile.EventType.Length == 0)
                                    {
                                        <MudButton StartIcon="@Icons.Material.Filled.Delete" Color="Color.Error" Class="mt-2" OnClick="@(() => RemoveRewardProfile(profile))">Delete Profile</MudButton>
                                    }
                                </MudExpansionPanel>
                            }
                        </MudExpansionPanels>
                        <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="AddRewardProfile">Add Reward Profile</MudButton>
                        <MudStack Row="true" Justify="Justify.FlexEnd">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                                       Disabled="@_isSaving" OnClick="SaveRewardProfilesAsync">Save Reward Profiles</MudButton>
                        </MudStack>
                    </MudStack>
                    }
                    }
                </MudTabPanel>

                <MudTabPanel Text="Test">
                    @if (_visitedTabs.Contains(3))
                    {
                    <MudGrid Spacing="4">
                        <MudItem xs="12">
                            <MudPaper Class="pa-4" Outlined="true">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Class="mb-3">
                                    <div>
                                        <MudText Typo="Typo.h6">Balance Test</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">Runs deterministic seeds using a temporary copy of these values. Changes here do not alter settings or save anything.</MudText>
                                    </div>
                                    <MudStack Row="true" Spacing="2">
                                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh"
                                                   Disabled="@_isRunningBalanceTest" OnClick="ResetBalanceTestSettings">Reload Current Settings</MudButton>
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Science"
                                                   Disabled="@(_isRunningBalanceTest || _balanceSettings == null)" OnClick="RunBalanceTestAsync">
                                            @(_isRunningBalanceTest ? "Testing..." : "Run Balance Test")
                                        </MudButton>
                                    </MudStack>
                                </MudStack>
                                @if (_balanceSettings is { } balanceSettings)
                                {
                                    <MudGrid Spacing="2">
                                        <MudItem xs="12" sm="6" md="3"><MudNumericField T="int" Label="Voyage Legs" Min="1" Max="@StarshipExpeditionSettings.MaximumLegCount" @bind-Value="balanceSettings.LegCount" /></MudItem>
                                        <MudItem xs="12" sm="6" md="3"><MudNumericField T="int" Label="Base Stop Interval" Min="1" Max="@StarshipExpeditionSettings.MaximumLegCount" @bind-Value="balanceSettings.StationIntervalLegs" /></MudItem>
                                        <MudItem xs="12" sm="6" md="3"><MudNumericField T="int" Label="Maximum Hull" Min="1" Max="100" @bind-Value="balanceSettings.ShipSystems.MaximumHull" /></MudItem>
                                        <MudItem xs="12" sm="6" md="3"><MudNumericField T="int" Label="Starting Hull" Min="1" Max="@balanceSettings.ShipSystems.MaximumHull" @bind-Value="balanceSettings.ShipSystems.StartingHull" /></MudItem>
                                        <MudItem xs="12" sm="6" md="3"><MudNumericField T="int" Label="Starting Supplies" Min="0" Max="100" @bind-Value="balanceSettings.ShipSystems.StartingSupplies" /></MudItem>
                                        <MudItem xs="12" sm="6" md="3"><MudNumericField T="int" Label="Travel Supplies per Leg" Min="0" Max="100" @bind-Value="balanceSettings.ShipSystems.TravelSuppliesCost" /></MudItem>
                                        <MudItem xs="12" sm="6" md="3"><MudNumericField T="int" Label="Default Success Chance (%)" Min="0" Max="100" @bind-Value="balanceSettings.ShipSystems.DefaultEventSuccessChancePercent" /></MudItem>
                                        <MudItem xs="12" sm="6" md="3"><MudNumericField T="int" Label="Empty Supplies Penalty (pp)" Min="0" Max="100" @bind-Value="balanceSettings.ShipSystems.EmptySuppliesSuccessPenaltyPercent" /></MudItem>
                                        <MudItem xs="12" sm="6" md="3"><MudNumericField T="int" Label="Station Hull Repair" Min="0" Max="100" @bind-Value="balanceSettings.ShipSystems.StationRepairAmount" /></MudItem>
                                        <MudItem xs="12" sm="6" md="3"><MudNumericField T="int" Label="Repair Supplies Cost" Min="0" Max="100" @bind-Value="balanceSettings.ShipSystems.StationRepairSuppliesCost" /></MudItem>
                                        <MudItem xs="12" sm="6" md="3"><MudNumericField T="int" Label="Station Supplies Restored" Min="0" Max="100" @bind-Value="balanceSettings.ShipSystems.StationResupplyAmount" /></MudItem>
                                        <MudItem xs="12" sm="6" md="3"><MudNumericField T="int" Label="Runs" Min="20" Max="2000" @bind-Value="_balanceRunCount" /></MudItem>
                                        <MudItem xs="12" sm="6" md="3"><MudNumericField T="int" Label="First Seed" @bind-Value="_balanceFirstSeed" /></MudItem>
                                        <MudItem xs="12" sm="6"><MudSelect T="StarshipPreviewVoterPolicy" Label="Voter Policy" Variant="Variant.Outlined" @bind-Value="_balanceVoterPolicy">
                                            <MudSelectItem Value="@StarshipPreviewVoterPolicy.Default">Default choices</MudSelectItem>
                                            <MudSelectItem Value="@StarshipPreviewVoterPolicy.SeededRandom">Seeded random</MudSelectItem>
                                            <MudSelectItem Value="@StarshipPreviewVoterPolicy.RiskAverse">Risk-averse</MudSelectItem>
                                            <MudSelectItem Value="@StarshipPreviewVoterPolicy.RiskSeeking">Risk-seeking</MudSelectItem>
                                        </MudSelect></MudItem>
                                    </MudGrid>
                                    <MudExpansionPanels Class="mt-3">
                                        <MudExpansionPanel Text="Event Failure Damage">
                                            <MudGrid Spacing="2">
                                                @foreach (var definition in balanceSettings.EventCatalog.Where(item => !StarshipEventCatalog.IsStructural(item.EventType)))
                                                {
                                                    var eventType = definition.EventType;
                                                    var failure = GetBalanceFailureEffect(balanceSettings, eventType);
                                                    <MudItem xs="12" sm="6" lg="4">
                                                        <MudText Typo="Typo.subtitle2">@definition.Title</MudText>
                                                        <MudStack Row="true" Spacing="2">
                                                            <MudNumericField T="int" Label="Hull Lost" Min="-100" Max="0" Value="@failure.HullDelta"
                                                                             ValueChanged="@(value => SetBalanceFailureEffect(eventType, value, failure.SuppliesDelta))" />
                                                            <MudNumericField T="int" Label="Supplies Lost" Min="-100" Max="0" Value="@failure.SuppliesDelta"
                                                                             ValueChanged="@(value => SetBalanceFailureEffect(eventType, failure.HullDelta, value))" />
                                                        </MudStack>
                                                    </MudItem>
                                                }
                                            </MudGrid>
                                        </MudExpansionPanel>
                                    </MudExpansionPanels>
                                }
                                @if (!string.IsNullOrEmpty(_balanceError))
                                {
                                    <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@_balanceError</MudAlert>
                                }
                                @if (_balanceSummary is { } summary)
                                {
                                    <MudDivider Class="my-3" />
                                    <MudGrid Spacing="2">
                                        <MudItem xs="6" sm="4" md="2"><MudText Typo="Typo.caption">Failure rate</MudText><MudText Typo="Typo.h6">@summary.FailureRatePercent.ToString("F1")%</MudText></MudItem>
                                        <MudItem xs="6" sm="4" md="2"><MudText Typo="Typo.caption">Early returns</MudText><MudText Typo="Typo.h6">@summary.EarlyReturns / @summary.Runs</MudText></MudItem>
                                        <MudItem xs="6" sm="4" md="2">
                                            <MudTooltip Text="A useful, affordable repair requires damaged hull and enough supplies to pay the station repair cost.">
                                                <MudText Typo="Typo.caption">Repair useful &amp; affordable</MudText>
                                            </MudTooltip>
                                            <MudText Typo="Typo.h6">@(summary.StationVisits == 0 ? "No station visits" : $"{summary.RepairWindows} / {summary.StationVisits}")</MudText>
                                        </MudItem>
                                        <MudItem xs="6" sm="4" md="2"><MudText Typo="Typo.caption">Avg hull lost</MudText><MudText Typo="Typo.h6">@summary.AverageHullLost.ToString("F1")</MudText></MudItem>
                                        <MudItem xs="6" sm="4" md="2"><MudText Typo="Typo.caption">Avg ending hull</MudText><MudText Typo="Typo.h6">@summary.AverageEndingHull.ToString("F1")</MudText></MudItem>
                                        <MudItem xs="6" sm="4" md="2"><MudText Typo="Typo.caption">Avg ending supplies</MudText><MudText Typo="Typo.h6">@summary.AverageEndingSupplies.ToString("F1")</MudText></MudItem>
                                    </MudGrid>
                                }
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudPaper Class="pa-4" Outlined="true">
                                <MudText Typo="Typo.h6" Class="mb-3">Seeded Route Preview</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">Preview uses unsaved settings and does not create a live voyage, save state, award points, send chat, or fire actions.</MudText>
                                <MudNumericField T="int" Label="Preview Seed" Variant="Variant.Outlined" @bind-Value="_previewSeed" />
                                <MudSelect T="StarshipPreviewVoterPolicy" Label="Voter Policy" Variant="Variant.Outlined" @bind-Value="_previewVoterPolicy">
                                    <MudSelectItem Value="@StarshipPreviewVoterPolicy.Default">Default choices</MudSelectItem>
                                    <MudSelectItem Value="@StarshipPreviewVoterPolicy.SeededRandom">Seeded random</MudSelectItem>
                                    <MudSelectItem Value="@StarshipPreviewVoterPolicy.RiskAverse">Risk-averse</MudSelectItem>
                                    <MudSelectItem Value="@StarshipPreviewVoterPolicy.RiskSeeking">Risk-seeking</MudSelectItem>
                                </MudSelect>
                                <MudButton Class="mt-3" Variant="Variant.Filled" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Visibility" OnClick="GeneratePreview">Generate Preview</MudButton>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="12" md="8">
                            @if (_previewEvents.Count > 0)
                            {
                                <MudStack Spacing="2">
                                    <MudPaper Class="pa-3" Outlined="true">
                                        <MudText Typo="Typo.subtitle2">Preview Seed: @_previewSeed</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">Effective Sector Pool</MudText>
                                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-1">
                                            @foreach (var sector in _settings.GetEffectiveSectors())
                                            {
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@sector</MudChip>
                                            }
                                        </MudStack>
                                    </MudPaper>
                                    @foreach (var previewEvent in _previewEvents)
                                    {
                                        <MudPaper Class="pa-3" Outlined="true">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                                <MudText Typo="Typo.subtitle1">Leg @previewEvent.Sequence: @previewEvent.Title</MudText>
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@previewEvent.Sector</MudChip>
                                            </MudStack>
                                            <MudText Typo="Typo.body2">@previewEvent.Description</MudText>
                                            <MudStack Spacing="1" Class="mt-2">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Subject: @previewEvent.Subject</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">No-vote default: @previewEvent.Choices.FirstOrDefault(choice => choice.ChoiceId == previewEvent.DefaultChoiceId)?.Label</MudText>
                                                @if (previewEvent.ShipContext is { } shipPreview)
                                                {
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@GetVoterPolicyLabel(_previewVoterPolicy) resources: hull @shipPreview.HullBefore → @shipPreview.HullAfter / @shipPreview.HullMaximum; supplies @shipPreview.SuppliesBefore → @shipPreview.SuppliesAfter; success modifier @shipPreview.ResourceSuccessModifierPercent pp</MudText>
                                                    @if (shipPreview.HullAfter == 0)
                                                    {
                                                        <MudText Typo="Typo.body2" Color="Color.Warning">Emergency return: hull depleted.</MudText>
                                                    }
                                                }
                                                @if (previewEvent.Path.Count > 0)
                                                {
                                                    <MudText Typo="Typo.caption" Color="Color.Primary">@GetVoterPolicyLabel(_previewVoterPolicy) path</MudText>
                                                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                                                        @foreach (var pathStep in previewEvent.Path)
                                                        {
                                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@pathStep.Label</MudChip>
                                                        }
                                                    </MudStack>
                                                }
                                            </MudStack>
                                            @if (GetRewardProfile(previewEvent.EventType) is { } previewProfile)
                                            {
                                                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">@GetRewardProfilePreview(previewProfile)</MudAlert>
                                            }
                                            @if (previewEvent.StepDefinitions.Count > 0)
                                            {
                                                <MudText Typo="Typo.subtitle2" Class="mt-2">Resolved path</MudText>
                                                <MudSimpleTable Dense="true" Bordered="true" Class="mt-1">
                                                    <thead><tr><th>#</th><th>Step</th><th>Selected result</th><th>Effect</th><th>Story</th></tr></thead>
                                                    <tbody>
                                                        @for (var pathIndex = 0; pathIndex < previewEvent.Path.Count; pathIndex++)
                                                        {
                                                            var pathStep = previewEvent.Path[pathIndex];
                                                            var stepDefinition = previewEvent.StepDefinitions.FirstOrDefault(step => step.StepId == pathStep.StepId);
                                                            var selectedChoice = stepDefinition?.Choices.FirstOrDefault(choice => choice.ChoiceId == pathStep.ChoiceId);
                                                            var stepCost = stepDefinition == null ? 0 : stepDefinition.SuppliesCostOverride ?? previewEvent.DefaultStepSuppliesCost;
                                                            <tr>
                                                                <td>@(pathIndex + 1)</td>
                                                                <td>@pathStep.StepId <span class="text-secondary">(@pathStep.StepType)</span></td>
                                                                <td>@(selectedChoice?.Label ?? (pathStep.StepType == StarshipEventStepType.End.ToString() ? "Event ended" : pathStep.StepType == StarshipEventStepType.Automatic.ToString() ? "Automatic step" : pathStep.Label))</td>
                                                                <td>@(selectedChoice == null ? (stepCost > 0 ? $"Entry cost {stepCost} supplies" : "-") : StarshipExpeditionNarrative.DescribeEffects(selectedChoice))</td>
                                                                <td>@GetPreviewPathStory(previewEvent, pathStep, selectedChoice)</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </MudSimpleTable>
                                                @if (!string.IsNullOrEmpty(previewEvent.OutcomeResult))
                                                {
                                                    var outcomeSeverity = previewEvent.OutcomeResult == StarshipExpeditionNarrative.OutcomeSuccess ? Severity.Success : Severity.Warning;
                                                    <MudAlert Severity="outcomeSeverity" Dense="true" Class="mt-2">
                                                        Seeded outcome: @previewEvent.OutcomeResult@(string.IsNullOrEmpty(previewEvent.OutcomeRarity) ? string.Empty : $" ({previewEvent.OutcomeRarity})")
                                                        @if (!string.IsNullOrWhiteSpace(previewEvent.OutcomeStory))
                                                        {
                                                            <span> @previewEvent.OutcomeStory</span>
                                                        }
                                                    </MudAlert>
                                                }
                                            }
                                            else
                                            {
                                                <MudSimpleTable Dense="true" Bordered="true" Class="mt-2">
                                                    <thead><tr><th>#</th><th>Option</th><th>Effect</th><th>Story (sample viewer: Viewer)</th></tr></thead>
                                                    <tbody>
                                                        @{ var previewOptions = GetPreviewOptions(previewEvent); var shipDisclosure = GetPreviewShipDisclosure(previewEvent); }
                                                        @for (var optionIndex = 0; optionIndex < previewOptions.Count; optionIndex++)
                                                        {
                                                            var option = previewOptions[optionIndex];
                                                            var shipChoice = shipDisclosure?.Choices.FirstOrDefault(item => item.ChoiceId == option.ChoiceId);
                                                            <tr>
                                                                <td>@(shipChoice == null ? (optionIndex + 1).ToString() : shipChoice.Number?.ToString() ?? "-")</td>
                                                                <td>@option.Label@(option.ContinuesEvent ? " (next step)" : option.EndsWithoutReward ? " (ends, no reward)" : "")</td>
                                                                <td>@StarshipExpeditionNarrative.DescribeEffects(option) @shipChoice?.Describe()</td>
                                                                <td>@StarshipExpeditionStory.Render(option.Story, previewEvent, _previewSeed, ["Viewer"], null)</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </MudSimpleTable>
                                                @if (GetExamplePath(previewEvent) is { } examplePath)
                                                {
                                                    <MudText Typo="Typo.caption" Class="mt-2" Style="display:block">Example full path: @examplePath</MudText>
                                                }
                                            }
                                            @if (!string.IsNullOrEmpty(previewEvent.SuccessStory) || !string.IsNullOrEmpty(previewEvent.FailureStory))
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Success" Style="display:block">On success (Rare): @StarshipExpeditionStory.Render(previewEvent.SuccessStory, previewEvent, _previewSeed, ["Viewer"], "Rare")</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Warning" Style="display:block">On failure: @StarshipExpeditionStory.Render(previewEvent.FailureStory, previewEvent, _previewSeed, ["Viewer"], "Rare")</MudText>
                                            }
                                        </MudPaper>
                                    }
                                </MudStack>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Generate a preview to inspect the route and event sequence.</MudText>
                            }
                        </MudItem>
                    </MudGrid>
                    }
                </MudTabPanel>

                <MudTabPanel Text="Appearance">
                    @if (_visitedTabs.Contains(4))
                    {
                    <MudGrid Spacing="4">
                        <MudItem xs="12" lg="6">
                            <MudStack Spacing="3">
                                <MudPaper Class="pa-4" Outlined="true">
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                                        <MudText Typo="Typo.h6">Colours & Style</MudText>
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="ResetAppearance">Reset to defaults</MudButton>
                                    </MudStack>
                                    <MudGrid Spacing="2">
                                        <MudItem xs="12" sm="6">@ColorField("Panel colour", _settings.Appearance.PanelColor, value => _settings.Appearance.PanelColor = value)</MudItem>
                                        <MudItem xs="12" sm="6">@ColorField("Text colour", _settings.Appearance.TextColor, value => _settings.Appearance.TextColor = value)</MudItem>
                                        <MudItem xs="12" sm="6">@ColorField("Secondary text", _settings.Appearance.MutedColor, value => _settings.Appearance.MutedColor = value)</MudItem>
                                        <MudItem xs="12" sm="6">@ColorField("Accent colour", _settings.Appearance.AccentColor, value => _settings.Appearance.AccentColor = value)</MudItem>
                                        <MudItem xs="12" sm="6">@ColorField("Highlight colour", _settings.Appearance.HighlightColor, value => _settings.Appearance.HighlightColor = value)</MudItem>
                                        <MudItem xs="12" sm="6">@ColorField("Warning / failure colour", _settings.Appearance.WarningColor, value => _settings.Appearance.WarningColor = value)</MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudText Typo="Typo.caption">Panel opacity: @_settings.Appearance.PanelOpacityPercent%</MudText>
                                            <MudSlider T="int" Min="0" Max="100" @bind-Value="_settings.Appearance.PanelOpacityPercent" />
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudText Typo="Typo.caption">Corner radius: @_settings.Appearance.CornerRadiusPx px</MudText>
                                            <MudSlider T="int" Min="0" Max="24" @bind-Value="_settings.Appearance.CornerRadiusPx" />
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudSelect T="string" Label="Font" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_settings.Appearance.FontFamily">
                                                @foreach (var font in StarshipAppearanceSettings.FontFamilies)
                                                {
                                                    <MudSelectItem Value="@font">@font</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudSwitch T="bool" Color="Color.Primary" Label="Use each ship's own accent colour" @bind-Value="_settings.Appearance.UseShipAccent" />
                                        </MudItem>
                                    </MudGrid>
                                </MudPaper>

                                <MudPaper Class="pa-4" Outlined="true">
                                    <MudText Typo="Typo.h6" Class="mb-2">Show or hide</MudText>
                                    <MudGrid Spacing="0">
                                        <MudItem xs="12" sm="6"><MudSwitch T="bool" Color="Color.Primary" Label="Animations" @bind-Value="_settings.Appearance.AnimationsEnabled" /></MudItem>
                                        <MudItem xs="12" sm="6"><MudSwitch T="bool" Color="Color.Primary" Label="Join toasts" @bind-Value="_settings.Appearance.ShowToasts" /></MudItem>
                                        <MudItem xs="12" sm="6"><MudSwitch T="bool" Color="Color.Primary" Label="Route map (status widget)" @bind-Value="_settings.Appearance.ShowRouteMap" /></MudItem>
                                        <MudItem xs="12">
                                            <MudSelect T="string" Label="Overlay visibility" Variant="Variant.Outlined"
                                                       @bind-Value="_settings.Appearance.OverlayDisplayMode">
                                                @foreach (var mode in StarshipAppearanceSettings.OverlayDisplayModes)
                                                {
                                                    <MudSelectItem T="string" Value="@mode.Key">@mode.Value</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="12" sm="6"><MudSwitch T="bool" Color="Color.Primary" Label="Effect chips on choices" @bind-Value="_settings.Appearance.ShowEffectChips" /></MudItem>
                                        <MudItem xs="12" sm="6"><MudSwitch T="bool" Color="Color.Primary" Label="Live vote bars" @bind-Value="_settings.Appearance.ShowVoteBars" /></MudItem>
                                        <MudItem xs="12" sm="6"><MudSwitch T="bool" Color="Color.Primary" Label="Odds and loss lines" @bind-Value="_settings.Appearance.ShowOddsPanel" /></MudItem>
                                        <MudItem xs="12" sm="6"><MudSwitch T="bool" Color="Color.Primary" Label="Path / sector footer" @bind-Value="_settings.Appearance.ShowPath" /></MudItem>
                                    </MudGrid>
                                </MudPaper>

                                <MudPaper Class="pa-4" Outlined="true">
                                    <MudText Typo="Typo.h6" Class="mb-1">Custom images</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                                        Pick images from the media library. They are mixed into the same pool as the built-in art; each voyage's ship and each event's object is chosen from the pool automatically. Turn the built-in art off to use only your images (a type with no images falls back to the built-in art).
                                    </MudText>
                                    <MudSwitch T="bool" Color="Color.Primary" Label="Use built-in ship art" @bind-Value="_settings.Appearance.UseBuiltInShipArt" />
                                    <MediaUrlPicker Label="Ship images"
                                                    AllowMultiple="true"
                                                    Value="@JoinImages(_settings.Appearance.ShipImages)"
                                                    ValueChanged="@((string? value) => _settings.Appearance.ShipImages = SplitImages(value))"
                                                    HelperText="Side-on ship images work best (transparent PNG or WebP)." />
                                    <MudDivider Class="my-3" />
                                    <MudSwitch T="bool" Color="Color.Primary" Label="Use built-in event object art" @bind-Value="_settings.Appearance.UseBuiltInObjectArt" />
                                    @foreach (var kind in StarshipAppearanceSettings.ObjectKinds)
                                    {
                                        var objectKind = kind;
                                        <MediaUrlPicker Label="@(ObjectKindLabel(objectKind) + " images")"
                                                        AllowMultiple="true"
                                                        Value="@JoinImages(GetObjectImages(objectKind))"
                                                        ValueChanged="@((string? value) => SetObjectImages(objectKind, value))" />
                                    }
                                </MudPaper>
                            </MudStack>
                        </MudItem>
                        <MudItem xs="12" lg="6">
                            <MudPaper Class="pa-4" Outlined="true">
                                <MudText Typo="Typo.h6" Class="mb-1">Live preview</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">Shows sample data with your current appearance edits. Save Appearance to persist them; connected overlays update immediately.</MudText>
                                <MudText Typo="Typo.caption">Status widget</MudText>
                                <iframe class="starship-preview-frame" src="/starship-status.html?preview=1&sample=status" title="Status widget preview"
                                        style="width:520px;height:180px;max-width:100%;border:1px dashed #666;background:#222;"></iframe>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-3">
                                    <MudText Typo="Typo.caption">Event widget</MudText>
                                    <MudSelect T="string" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_eventSample" Style="max-width:200px">
                                        <MudSelectItem Value="@("event")">Voting</MudSelectItem>
                                        <MudSelectItem Value="@("result")">Result</MudSelectItem>
                                        <MudSelectItem Value="@("end")">Voyage end</MudSelectItem>
                                    </MudSelect>
                                </MudStack>
                                <iframe class="starship-preview-frame" src="@($"/starship-event.html?preview=1&sample={_eventSample}")" title="Event widget preview"
                                    style="width:780px;height:460px;max-width:100%;border:1px dashed #666;background:#222;"></iframe>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-3">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                                   Disabled="@_isSaving" OnClick="SaveAppearanceAsync">Save Appearance</MudButton>
                    </MudStack>
                    }
                </MudTabPanel>

                <MudTabPanel Text="Automation & Messages">
                    @if (_visitedTabs.Contains(5))
                    {
                    <MudGrid Spacing="4">
                        <MudItem xs="12" lg="7">
                            <GameSessionMessageSettings Settings="_settings" SessionNoun="Voyage" RequiredStartAnnouncement="true"
                                                        EndMessageHelperText="Available placeholders: {count}, {duration}, {result}." />
                            <StarshipMessagesEditor Messages="_settings.Messages" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">Automation actions save in their setup flow. This button saves session message and command response templates.</MudText>
                            <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-3">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                                           Disabled="@_isSaving" OnClick="SaveSessionMessagesAsync">Save Messages</MudButton>
                            </MudStack>
                        </MudItem>
                        <MudItem xs="12" lg="5">
                            <GameOutcomeAutomationPanel DefaultCommandName="starship" GameTitle="Starship Expedition" IsActive="@(_activeTabIndex == 5)" />
                        </MudItem>
                    </MudGrid>
                    }
                </MudTabPanel>

                <MudTabPanel Text="Audio">
                    @if (_visitedTabs.Contains(6))
                    {
                    <MudStack Spacing="3" Style="max-width: 760px">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Configure the boarding announcement cue, default opening cues for each event type, and the emergency return cue. Individual events can inherit, override, or mute their event-type cue in Events & Sectors.</MudText>
                        <DropGameSoundEditor Title="Crew Boarding Open Cue" SoundConfig="_settings.BoardingOpenSound" />
                        <MudDivider />
                        <MudText Typo="Typo.h6">Event-Type Default Cues</MudText>
                        @foreach (var definition in _settings.EventCatalog.OrderBy(item => item.SortOrder).ThenBy(item => item.Title, StringComparer.Ordinal))
                        {
                            <DropGameSoundEditor @key="definition.EventType" Title="@(definition.Title + " Default Cue")"
                                                 SoundConfig="_settings.GetEventTypeOpenSound(definition.EventType)" />
                        }
                        <MudDivider />
                        <DropGameSoundEditor Title="Emergency Return Cue" SoundConfig="_settings.EmergencyReturnSound" />
                    </MudStack>
                    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-3">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                                   Disabled="@_isSaving" OnClick="SaveAudioSettingsAsync">Save Audio Settings</MudButton>
                    </MudStack>
                    }
                </MudTabPanel>
            </MudTabs>
                </ChildContent>
                <ErrorContent Context="renderError">
                    <MudAlert Severity="Severity.Error" Dense="true">Could not render Starship settings: @renderError.Message</MudAlert>
                </ErrorContent>
            </ErrorBoundary>
        }
    </MudContainer>
</FeatureGate>

@code {
    private StarshipShipEventDisclosure? GetPreviewShipDisclosure(StarshipExpeditionEventSnapshot expeditionEvent)
    {
        if (expeditionEvent.ShipContext is not { } context || _settings == null) return null;
        var ship = StarshipShipSystems.Create(_settings.ShipSystems);
        if (ship == null) return null;
        ship.Hull = context.HullBefore;
        ship.Supplies = context.SuppliesBefore;
        return StarshipShipEventDisclosure.From(new() { ShipSystems = ship }, expeditionEvent, GetRewardProfile(expeditionEvent.EventType));
    }

    private StarshipExpeditionSettings? _settings;
    private StarshipExpeditionSettings? _persistedSettings;
    private StarshipExpeditionSnapshot? _liveSnapshot;
    private IReadOnlyList<StarshipExpeditionEventSnapshot> _previewEvents = [];
    private StarshipExpeditionSettings? _balanceSettings;
    private BalanceTestSummary? _balanceSummary;
    private int _balanceRunCount = 500;
    private int _balanceFirstSeed = 0;
    private StarshipPreviewVoterPolicy _balanceVoterPolicy;
    private StarshipPreviewVoterPolicy _previewVoterPolicy;
    private string _balanceError = string.Empty;
    private bool _isRunningBalanceTest;
    private int _previewSeed = 12345;
    private int _activeTabIndex;
    private string _newSectorName = string.Empty;
    private string _error = string.Empty;
    private bool _isLoading = true;
    private bool _isLoadingRewardEditorOptions;
    private bool _rewardEditorOptionsLoaded;
    private bool _isSaving;
    private bool _isOperating;
    private string _eventSample = "event";
    private readonly HashSet<int> _visitedTabs = new() { 0 };
    private IJSObjectReference? _editorModule;
    private StarshipEventCatalogEditor? _eventCatalogEditor;
    private Dictionary<int, string> _rewardPointTypes = [];
    private Dictionary<int, string> _rewardActions = [];
    private readonly HashSet<string> _bulkProfileIds = new(StringComparer.OrdinalIgnoreCase);
    private string _bulkRarityName = string.Empty;
    private int? _bulkPointTypeId;
    private bool _bulkAddReward;
    private long? _bulkMinimum;
    private long? _bulkMaximum;
    private int? _bulkChancePercent;
    private string _bulkRewardPreview = string.Empty;
    private string _bulkRewardError = string.Empty;
    private bool _isApplyingBulkRewards;

    private bool HasBulkRewardChanges => _bulkAddReward
        ? _bulkPointTypeId is > 0 && _bulkMinimum.HasValue && _bulkMaximum.HasValue
        : _bulkMinimum.HasValue || _bulkMaximum.HasValue || _bulkChancePercent.HasValue;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
