    private StarshipExpeditionSettings CreateBulkRewardCandidate()
    {
        if (_settings == null) throw new InvalidOperationException("Settings are not loaded.");
        if (_bulkProfileIds.Count == 0) throw new ArgumentException("Select at least one reward profile.");
        if (string.IsNullOrWhiteSpace(_bulkRarityName)) throw new ArgumentException("Select a rarity tier.");
        if (!HasBulkRewardChanges) throw new ArgumentException(_bulkAddReward
            ? "Select a point type and enter a minimum and maximum payout to add."
            : "Enter at least one payout or chance value to update.");
        if (_bulkMinimum < 0 || _bulkMaximum < 0) throw new ArgumentOutOfRangeException(nameof(_bulkMinimum), "Reward amounts must be non-negative.");
        if (_bulkChancePercent is < 1 or > 100) throw new ArgumentOutOfRangeException(nameof(_bulkChancePercent), "Reward chance must be between 1 and 100 percent.");
        if (_bulkAddReward && (_bulkMinimum == null || _bulkMaximum == null || _bulkMaximum < _bulkMinimum))
            throw new ArgumentException("Enter an ordered minimum and maximum payout for the new reward.");

        var candidate = new StarshipExpeditionSettings
        {
            RewardProfiles = StarshipEventEditing.Copy(_settings.RewardProfiles),
            EventRewardProfileIds = new(_settings.EventRewardProfileIds, StringComparer.OrdinalIgnoreCase)
        };
        var affected = 0;
        foreach (var profile in candidate.RewardProfiles.Where(profile => _bulkProfileIds.Contains(profile.Id)))
        {
            var tier = profile.GetTiers().FirstOrDefault(item => string.Equals(item.Name, _bulkRarityName, StringComparison.OrdinalIgnoreCase));
            if (tier == null) continue;
            if (_bulkAddReward)
            {
                if (_bulkPointTypeId is not { } pointTypeId || tier.Rewards.Count >= StarshipRewardProfile.MaximumRewardsPerTier ||
                    tier.Rewards.Any(reward => reward.PointTypeId == pointTypeId)) continue;
                tier.Rewards.Add(new StarshipRewardEntry
                {
                    PointTypeId = pointTypeId,
                    PointTypeName = _rewardPointTypes.GetValueOrDefault(pointTypeId, string.Empty),
                    Minimum = _bulkMinimum!.Value,
                    Maximum = _bulkMaximum!.Value,
                    ChancePercent = _bulkChancePercent ?? 100
                });
                affected++;
                continue;
            }
            foreach (var reward in tier.Rewards)
            {
                if (_bulkPointTypeId.HasValue && reward.PointTypeId != _bulkPointTypeId.Value) continue;
                if (_bulkMinimum is { } minimum) reward.Minimum = minimum;
                if (_bulkMaximum is { } maximum) reward.Maximum = maximum;
                if (_bulkChancePercent is { } chance) reward.ChancePercent = chance;
                affected++;
            }
        }
        if (affected == 0) throw new ArgumentException(_bulkAddReward
            ? "No selected rarity tiers can receive this point type. It may already be present or the tiers may be full."
            : "No reward entries match the selected profiles, rarity, and point type.");
        StarshipExpeditionSettings.NormalizeAndValidateRewardProfiles(candidate);
        return candidate;
    }

    private void AddRewardProfile()
    {
        if (_settings == null) return;
        _settings.RewardProfiles.Add(new StarshipRewardProfile
        {
            Id = Guid.NewGuid().ToString("N"), Name = $"Reward Profile {_settings.RewardProfiles.Count + 1}",
            Tiers = [new() { Id = "common", Name = "Common", Weight = 1 }]
        });
    }

    private void CloneRewardProfile(StarshipRewardProfile profile)
    {
        if (_settings == null) return;
        var clone = StarshipEventEditing.Copy(profile);
        clone.Id = Guid.NewGuid().ToString("N");
        clone.Name = GetUniqueRewardProfileCopyName(profile.Name);
        clone.EventType = string.Empty;
        _settings.RewardProfiles.Add(clone);
    }

    private string GetUniqueRewardProfileCopyName(string sourceName)
    {
        var name = string.IsNullOrWhiteSpace(sourceName) ? "Reward Profile" : sourceName.Trim();
        var suffix = " Copy";
        var candidate = name[..Math.Min(name.Length, 80 - suffix.Length)] + suffix;
        for (var copyNumber = 2; _settings!.RewardProfiles.Any(profile =>
                 string.Equals(profile.Name, candidate, StringComparison.OrdinalIgnoreCase)); copyNumber++)
        {
            suffix = $" Copy {copyNumber}";
            candidate = name[..Math.Min(name.Length, 80 - suffix.Length)] + suffix;
        }
        return candidate;
    }

    private void RemoveRewardProfile(StarshipRewardProfile profile)
    {
        if (_settings == null) return;
        _settings.RewardProfiles.Remove(profile);
        foreach (var eventType in _settings.EventRewardProfileIds.Where(binding => binding.Value == profile.Id).Select(binding => binding.Key).ToList())
            _settings.EventRewardProfileIds[eventType] = string.Empty;
        for (var index = 0; index < _settings.EventCatalog.Count; index++)
        {
            var definition = _settings.EventCatalog[index];
            if (string.Equals(definition.RewardProfileId, profile.Id, StringComparison.OrdinalIgnoreCase))
                _settings.EventCatalog[index] = definition with { RewardProfileId = string.Empty };
        }
    }

    private string GetRewardProfilePreview(StarshipRewardProfile profile, bool useSnapshotPointName = false)
    {
        string PointName(int id) => useSnapshotPointName ? profile.GetPointTypeName(id) : _rewardPointTypes.GetValueOrDefault(id, "No point type selected");
        var tiers = profile.GetTiers().Where(tier => tier.Enabled && tier.Weight > 0).ToList();
        var total = Math.Max(1, tiers.Sum(tier => tier.Weight));
        var odds = tiers.Select(tier => $"{tier.Name} {100d * tier.Weight / total:0.#}%: " +
            string.Join(", ", tier.Rewards.Select(reward => $"{reward.Minimum}-{reward.Maximum} {PointName(reward.PointTypeId)} ({reward.ChancePercent}%)")));
        var loss = profile.GetLossRules().Select(rule => $"{PointName(rule.PointTypeId)}: up to {rule.Percent}%, maximum {rule.MaximumPerEvent?.ToString() ?? "Unlimited"}");
        return $"Success {profile.SuccessChancePercent}% / failure {100 - profile.SuccessChancePercent}%. " + string.Join("; ", odds) +
            ". Unbanked loss: " + string.Join("; ", loss) + ".";
    }

    private StarshipRewardProfile? GetRewardProfile(string eventType) => _settings?.GetRewardProfile(eventType);

    private StarshipRewardProfile? GetLiveRewardProfile(string eventType) => _liveSnapshot == null ? null :
        StarshipRewardProfile.FindForEvent(_liveSnapshot.RewardProfiles, _liveSnapshot.EventRewardProfileIds, eventType);
}