            var candidate = CreateBulkRewardCandidate();
            var pointName = _bulkPointTypeId is { } pointTypeId
                ? _rewardPointTypes.GetValueOrDefault(pointTypeId, "selected point type")
                : "all point types";
            var selectedProfiles = string.Join(", ", candidate.RewardProfiles.Where(profile => _bulkProfileIds.Contains(profile.Id)).Select(profile => profile.Name));
            if (_bulkAddReward)
                _bulkRewardPreview = $"Add {_bulkMinimum}-{_bulkMaximum} {pointName} rewards to {GetBulkRewardTargetCount()} {_bulkRarityName} tiers in {selectedProfiles}. Chance: {_bulkChancePercent ?? 100}%. Existing rewards and other profile settings stay unchanged.";
            else
            {
                var changes = new List<string>();
                if (_bulkMinimum is { } minimum) changes.Add($"minimum {minimum}");
                if (_bulkMaximum is { } maximum) changes.Add($"maximum {maximum}");
                if (_bulkChancePercent is { } chance) changes.Add($"chance {chance}%");
                _bulkRewardPreview = $"Set {string.Join(", ", changes)} on {GetBulkRewardTargetCount()} {pointName} reward entries in {selectedProfiles} at the {_bulkRarityName} tier. Other reward fields stay unchanged.";
            }
        }
        catch (ArgumentException ex)
        {
            _bulkRewardError = ex.Message;
        }
