@page "/dropgames"
@attribute [Authorize(Roles = "Streamer, Editor")]
@using PenguinTwitchBot.Bot.Actions
@using PenguinTwitchBot.Bot.Commands.Games
@using PenguinTwitchBot.Bot.Events.Chat
@using PenguinTwitchBot.Bot.Features
@using PenguinTwitchBot.Pages.Components
@inject IDropGamesService DropGamesService
@inject IActionManagementService ActionManagementService
@inject ISnackbar Snackbar
@inject ILogger<DropGames> Logger

<PageTitle>Parachute Drop & Plinko Bounce</PageTitle>

<FeatureGate FeatureKey="@FeatureKeys.DropGames" DisabledMessage="Parachute Drop & Plinko Bounce is currently disabled. Enable it on the Bot Features page.">
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-8">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
            <div>
                <MudText Typo="Typo.h4">🪂 Parachute Drop & 🪙 Plinko Bounce</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Customizable stream overlay minigames with seasonal themes, interactive droplets, emote support, and tamper-proof win actions.
                </MudText>
            </div>
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.OpenInNew"
                           Href="/parachute.html" Target="_blank">
                    Open Parachute Overlay
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.OpenInNew"
                           Href="/plinko.html" Target="_blank">
                    Open Plinko Overlay
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                           OnClick="SaveAllSettingsAsync">
                    Save All Settings
                </MudButton>
            </MudStack>
        </MudStack>

        @if (_settings == null)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else
        {
            <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-5">
                <!-- ================= TAB 1: PARACHUTE DROP ================= -->
                <MudTabPanel Text="Parachute Drop (!drop)" Icon="@Icons.Material.Filled.Paragliding">
                    <MudGrid Spacing="4">
                        <MudItem xs="12" md="7">
                            <MudPaper Class="pa-4" Outlined="true">
                                <MudText Typo="Typo.h6" Class="mb-3">Gameplay & Target Configuration</MudText>
                                <MudStack Spacing="3">
                                    <MudSelect T="string" Label="Active Theme" Variant="Variant.Outlined"
                                               @bind-Value="_settings.Parachute.ActiveThemeId"
                                               HelperText="Select a stock seasonal theme (Spring, Summer, Fall, Winter) or custom theme.">
                                        @foreach (var theme in _settings.Themes)
                                        {
                                            <MudSelectItem Value="@theme.Id">@theme.Name @(theme.IsStock ? "(Seasonal Stock)" : "(Custom)")</MudSelectItem>
                                        }
                                    </MudSelect>

                                    <MudGrid>
                                        <MudItem xs="12" sm="4">
                                            <MudNumericField T="double" Label="Target Width (%)" Variant="Variant.Outlined"
                                                             Min="5" Max="60" Step="1"
                                                             @bind-Value="_settings.Parachute.TargetWidthPercent"
                                                             HelperText="Width of landing target (% of screen)" />
                                        </MudItem>
                                        <MudItem xs="12" sm="4">
                                            <MudNumericField T="double" Label="Bullseye Width (%)" Variant="Variant.Outlined"
                                                             Min="1" Max="25" Step="0.5"
                                                             @bind-Value="_settings.Parachute.BullseyeWidthPercent"
                                                             HelperText="Center bullseye zone (% of screen)" />
                                        </MudItem>
                                        <MudItem xs="12" sm="4">
                                            <MudNumericField T="double" Label="Target Position X (0.15 - 0.85)" Variant="Variant.Outlined"
                                                             Min="0.15" Max="0.85" Step="0.05"
                                                             @bind-Value="_settings.Parachute.TargetCenterX"
                                                             HelperText="0.50 = Dead Center" />
                                        </MudItem>
                                    </MudGrid>

                                    <MudGrid>
                                        <MudItem xs="12" sm="6">
                                            <MudNumericField T="double" Label="Descent Duration (Seconds)" Variant="Variant.Outlined"
                                                             Min="2.5" Max="15.0" Step="0.5"
                                                             @bind-Value="_settings.Parachute.DescentDurationSeconds"
                                                             HelperText="Time it takes to parachute from top to bottom" />
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudNumericField T="double" Label="Wind Drift Strength (0.0 - 1.0)" Variant="Variant.Outlined"
                                                             Min="0.0" Max="1.0" Step="0.05"
                                                             @bind-Value="_settings.Parachute.WindStrength"
                                                             HelperText="Horizontal breeze affecting descent trajectory" />
                                        </MudItem>
                                    </MudGrid>

                                    <MudSwitch T="bool" Color="Color.Warning"
                                               @bind-Value="_settings.Parachute.WinOnBullseyeOnly"
                                               Label="Require Bullseye Hit to Trigger Win Action (Otherwise any Target Hit wins)" />
                                </MudStack>
                            </MudPaper>

                            <MudPaper Class="pa-4 mt-4" Outlined="true">
                                <MudText Typo="Typo.h6" Class="mb-3">Win Action & Chat Announcement</MudText>
                                <MudStack Spacing="3">
                                    <MudSelect T="string" Label="Direct Win Action (Optional)" Variant="Variant.Outlined"
                                               Clearable="true"
                                               @bind-Value="_settings.Parachute.WinActionName"
                                               HelperText="Action executed immediately when a viewer lands a winning drop. Variables passed: %User%, %Score%, %IsBullseye%, %DropletHits%, %Theme%.">
                                        <MudSelectItem Value="@("")">None (Use Default Command Triggers Only)</MudSelectItem>
                                        @foreach (var actName in _actionNames)
                                        {
                                            <MudSelectItem Value="@actName">@actName</MudSelectItem>
                                        }
                                    </MudSelect>

                                    <MudAlert Severity="Severity.Info" Dense="true">
                                        You can also attach triggers in <b>Manage Actions &rarr; Add Trigger &rarr; Default Command &rarr; drop</b> for <b>Win (Target Hit)</b>, <b>Bullseye Hit</b>, or <b>Missed Target (Lose)</b>!
                                    </MudAlert>

                                    <MudSwitch T="bool" Color="Color.Success"
                                               @bind-Value="_settings.Parachute.AnnounceWinsInChat"
                                               Label="Send Chat Message on Win" />

                                    @if (_settings.Parachute.AnnounceWinsInChat)
                                    {
                                        <MudTextField T="string" Label="Win Chat Message Template" Variant="Variant.Outlined"
                                                      @bind-Value="_settings.Parachute.WinChatMessageTemplate"
                                                      HelperText="Placeholders: {user}, {score}, {bullseye}, {droplethits}" />
                                    }
                                </MudStack>
                            </MudPaper>

                            <MudPaper Class="pa-4 mt-4" Outlined="true">
                                <MudText Typo="Typo.h6" Class="mb-3">⏱️ Timed Session / Round Mode</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                                    Run timed drop rounds (e.g., 100 seconds). Controls when viewers can participate and how rounds start/stop.
                                </MudText>

                                <MudStack Spacing="3">
                                    <MudSwitch T="bool" Color="Color.Primary"
                                               @bind-Value="_settings.Parachute.SessionModeEnabled"
                                               Label="Enable Timed Session Mode (When disabled, drops run anytime in free-play mode)" />

                                    @if (_settings.Parachute.SessionModeEnabled)
                                    {
                                        <div>
                                            <MudSwitch T="bool" Color="Color.Secondary"
                                                       @bind-Value="_settings.Parachute.AutoStartOnCommand"
                                                       Label="Auto-start Round on Command (Starts round automatically when someone types !drop)" />
                                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block ml-3">
                                                When off, rounds can only be started/stopped via SubActions, mod commands (!drop start [seconds]), or the button below.
                                            </MudText>
                                        </div>

                                        <MudGrid>
                                            <MudItem xs="12" sm="6">
                                                <MudNumericField T="int" Label="Default Round Duration (Seconds)" Variant="Variant.Outlined"
                                                                 Min="10" Max="600" Step="5"
                                                                 @bind-Value="_settings.Parachute.DefaultSessionDurationSeconds"
                                                                 HelperText="e.g. 100 seconds" />
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                <MudNumericField T="int" Label="Max Drops Per User Per Round" Variant="Variant.Outlined"
                                                                 Min="0" Max="50"
                                                                 @bind-Value="_settings.Parachute.MaxDropsPerUserPerSession"
                                                                 HelperText="0 = Unlimited drops during the round" />
                                            </MudItem>
                                        </MudGrid>

                                        <MudSwitch T="bool" Color="Color.Info"
                                                   @bind-Value="_settings.Parachute.AnnounceSessionStatusInChat"
                                                   Label="Announce Round Start & End in Chat" />

                                        @if (_settings.Parachute.AnnounceSessionStatusInChat)
                                        {
                                            <MudTextField T="string" Label="Round Start Chat Message" Variant="Variant.Outlined"
                                                          @bind-Value="_settings.Parachute.SessionStartChatMessageTemplate"
                                                          HelperText="Placeholders: {duration}" />
                                            <MudTextField T="string" Label="Round End Chat Message" Variant="Variant.Outlined"
                                                          @bind-Value="_settings.Parachute.SessionEndChatMessageTemplate"
                                                          HelperText="Placeholders: {count}, {duration}" />
                                        }
                                    }
                                </MudStack>
                            </MudPaper>
                        </MudItem>

                        <MudItem xs="12" md="5">
                            <MudPaper Class="pa-4" Outlined="true">
                                <MudText Typo="Typo.h6" Class="mb-3">🧪 Test Parachute Drop Live</MudText>
                                <MudStack Spacing="3">
                                    <MudTextField T="string" Label="Test Player Name" Variant="Variant.Outlined"
                                                  @bind-Value="_testUsername" />
                                    <MudTextField T="string" Label="Test Emote Code or Image URL (Optional)" Variant="Variant.Outlined"
                                                  @bind-Value="_testEmoteInput"
                                                  HelperText="Leave blank to test the active theme's default character sprite, or enter an emote code / image URL." />

                                    <MudButton Variant="Variant.Filled" Color="Color.Info" FullWidth="true"
                                               StartIcon="@Icons.Material.Filled.Paragliding"
                                               OnClick="TestParachuteDropAsync">
                                        Launch Test Parachute Drop
                                    </MudButton>

                                    <MudButton Variant="Variant.Outlined" Color="Color.Success" FullWidth="true"
                                               StartIcon="@Icons.Material.Filled.GpsFixed"
                                               OnClick="TestParachuteBullseyeAsync">
                                        Launch Guaranteed Bullseye Drop
                                    </MudButton>

                                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" FullWidth="true"
                                               StartIcon="@Icons.Material.Filled.WaterDrop"
                                               OnClick="TestComboDropAndDropletsAsync">
                                        Combo Test: Drop + Mid-Air Droplets Collision!
                                    </MudButton>

                                    <MudDivider Class="my-2" />
                                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">⏱️ Session Controls</MudText>
                                    <MudStack Row="true" Spacing="2">
                                        <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true"
                                                   StartIcon="@Icons.Material.Filled.PlayArrow"
                                                   OnClick="StartParachuteSessionLiveAsync">
                                            Start Round (@(_settings.Parachute.DefaultSessionDurationSeconds)s)
                                        </MudButton>
                                        <MudButton Variant="Variant.Outlined" Color="Color.Error" FullWidth="true"
                                                   StartIcon="@Icons.Material.Filled.Stop"
                                                   OnClick="StopParachuteSessionLiveAsync">
                                            Stop Round
                                        </MudButton>
                                    </MudStack>
                                </MudStack>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                <!-- ================= TAB 2: INTERACTIVE DROPLETS ================= -->
                <MudTabPanel Text="Interactive Droplets (!droplets)" Icon="@Icons.Material.Filled.WaterDrop">
                    <MudGrid Spacing="4">
                        <MudItem xs="12" md="7">
                            <MudPaper Class="pa-4" Outlined="true">
                                <MudText Typo="Typo.h6" Class="mb-2">Default Droplets Physics & Sub-Action Settings</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                                    Droplets physically collide with parachuting characters mid-air and alter their landing trajectory based on droplet size (mass) and speed (momentum). Can be triggered via <b>!droplets</b> or the <b>Parachute Droplets</b> Sub-Action!
                                </MudText>

                                <MudStack Spacing="3">
                                    <MudGrid>
                                        <MudItem xs="12" sm="6">
                                            <MudNumericField T="int" Label="Default Droplet Count (1 - 30)" Variant="Variant.Outlined"
                                                             Min="1" Max="30"
                                                             @bind-Value="_settings.Parachute.DefaultDropletCount" />
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudNumericField T="double" Label="Knockback Force Multiplier" Variant="Variant.Outlined"
                                                             Min="0.1" Max="5.0" Step="0.1"
                                                             @bind-Value="_settings.Parachute.DefaultKnockbackMultiplier"
                                                             HelperText="1.0 = Standard push force on collision" />
                                        </MudItem>
                                    </MudGrid>

                                    <MudGrid>
                                        <MudItem xs="12" sm="4">
                                            <MudSelect T="string" Label="Default Droplet Size" Variant="Variant.Outlined"
                                                       @bind-Value="_settings.Parachute.DefaultDropletSize">
                                                <MudSelectItem Value="@("Small")">Small (Light nudge)</MudSelectItem>
                                                <MudSelectItem Value="@("Medium")">Medium (Standard)</MudSelectItem>
                                                <MudSelectItem Value="@("Large")">Large (Heavy bump)</MudSelectItem>
                                                <MudSelectItem Value="@("Giant")">Giant (Massive knockback)</MudSelectItem>
                                                <MudSelectItem Value="@("Random")">Random Mix</MudSelectItem>
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="12" sm="4">
                                            <MudSelect T="string" Label="Default Droplet Speed" Variant="Variant.Outlined"
                                                       @bind-Value="_settings.Parachute.DefaultDropletSpeed">
                                                <MudSelectItem Value="@("Slow")">Slow (0.6x)</MudSelectItem>
                                                <MudSelectItem Value="@("Normal")">Normal (1.0x)</MudSelectItem>
                                                <MudSelectItem Value="@("Fast")">Fast (1.6x)</MudSelectItem>
                                                <MudSelectItem Value="@("Hyper")">Hyper (2.2x)</MudSelectItem>
                                                <MudSelectItem Value="@("Random")">Random Mix</MudSelectItem>
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="12" sm="4">
                                            <MudSelect T="string" Label="Default Spawn Pattern" Variant="Variant.Outlined"
                                                       @bind-Value="_settings.Parachute.DefaultDropletPattern">
                                                <MudSelectItem Value="@("Targeted")">Targeted (Intercepts active parachutists)</MudSelectItem>
                                                <MudSelectItem Value="@("TopRain")">Top Rain (Falls from sky)</MudSelectItem>
                                                <MudSelectItem Value="@("SideWind")">Side Wind (Diagonal crosswind)</MudSelectItem>
                                                <MudSelectItem Value="@("Fountain")">Fountain (Arcs from sides)</MudSelectItem>
                                            </MudSelect>
                                        </MudItem>
                                    </MudGrid>
                                </MudStack>
                            </MudPaper>
                        </MudItem>

                        <MudItem xs="12" md="5">
                            <MudPaper Class="pa-4" Outlined="true">
                                <MudText Typo="Typo.h6" Class="mb-3">🌊 Live Droplet Barrage Tester</MudText>
                                <MudStack Spacing="2">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                               StartIcon="@Icons.Material.Filled.WaterDrop"
                                               OnClick="TestDropletsNowAsync">
                                        Fire Droplets Now (Uses Default Settings)
                                    </MudButton>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" FullWidth="true"
                                               StartIcon="@Icons.Material.Filled.Bolt"
                                               OnClick='() => TestCustomDropletsAsync("Giant", "Hyper", "Targeted", 4)'>
                                        Fire Giant Hyper Targeted Barrage (4x)
                                    </MudButton>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Info" FullWidth="true"
                                               StartIcon="@Icons.Material.Filled.Grain"
                                               OnClick='() => TestCustomDropletsAsync("Random", "Random", "SideWind", 12)'>
                                        Fire Random Side-Wind Storm (12x)
                                    </MudButton>
                                </MudStack>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                <!-- ================= TAB 3: PLINKO BOUNCE ================= -->
                <MudTabPanel Text="Plinko Bounce (!plinko)" Icon="@Icons.Material.Filled.Apps">
                    <MudGrid Spacing="4">
                        <MudItem xs="12" md="7">
                            <MudPaper Class="pa-4" Outlined="true">
                                <MudText Typo="Typo.h6" Class="mb-3">Plinko Board & Win Settings</MudText>
                                <MudStack Spacing="3">
                                    <MudSelect T="string" Label="Active Theme" Variant="Variant.Outlined"
                                               @bind-Value="_settings.Plinko.ActiveThemeId">
                                        @foreach (var theme in _settings.Themes)
                                        {
                                            <MudSelectItem Value="@theme.Id">@theme.Name @(theme.IsStock ? "(Seasonal Stock)" : "(Custom)")</MudSelectItem>
                                        }
                                    </MudSelect>

                                    <MudGrid>
                                        <MudItem xs="12" sm="6">
                                            <MudNumericField T="int" Label="Peg Rows (5 - 14)" Variant="Variant.Outlined"
                                                             Min="5" Max="14"
                                                             @bind-Value="_settings.Plinko.RowCount" />
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudNumericField T="double" Label="Drop Duration (Seconds)" Variant="Variant.Outlined"
                                                             Min="2.0" Max="12.0" Step="0.5"
                                                             @bind-Value="_settings.Plinko.DropDurationSeconds" />
                                        </MudItem>
                                    </MudGrid>

                                    <MudSelect T="string" Label="Direct Win Action (Optional)" Variant="Variant.Outlined"
                                               Clearable="true"
                                               @bind-Value="_settings.Plinko.WinActionName"
                                               HelperText="Action executed when a token lands in a winning bucket. Variables: %User%, %Score%, %BucketLabel%, %BucketIndex%, %Theme%.">
                                        <MudSelectItem Value="@("")">None (Use Default Command Triggers Only)</MudSelectItem>
                                        @foreach (var actName in _actionNames)
                                        {
                                            <MudSelectItem Value="@actName">@actName</MudSelectItem>
                                        }
                                    </MudSelect>

                                    <MudSwitch T="bool" Color="Color.Success"
                                               @bind-Value="_settings.Plinko.AnnounceWinsInChat"
                                               Label="Send Chat Message on Winning Bucket" />

                                    @if (_settings.Plinko.AnnounceWinsInChat)
                                    {
                                        <MudTextField T="string" Label="Win Chat Message Template" Variant="Variant.Outlined"
                                                      @bind-Value="_settings.Plinko.WinChatMessageTemplate"
                                                      HelperText="Placeholders: {user}, {score}, {bucket}" />
                                    }
                                </MudStack>
                            </MudPaper>

                            <MudPaper Class="pa-4 mt-4" Outlined="true">
                                <MudText Typo="Typo.h6" Class="mb-3">⏱️ Timed Session / Round Mode</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                                    Run timed Plinko rounds (e.g., 100 seconds). Controls when viewers can participate and how rounds start/stop.
                                </MudText>

                                <MudStack Spacing="3">
                                    <MudSwitch T="bool" Color="Color.Primary"
                                               @bind-Value="_settings.Plinko.SessionModeEnabled"
                                               Label="Enable Timed Session Mode (When disabled, drops run anytime in free-play mode)" />

                                    @if (_settings.Plinko.SessionModeEnabled)
                                    {
                                        <div>
                                            <MudSwitch T="bool" Color="Color.Secondary"
                                                       @bind-Value="_settings.Plinko.AutoStartOnCommand"
                                                       Label="Auto-start Round on Command (Starts round automatically when someone types !plinko)" />
                                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block ml-3">
                                                When off, rounds can only be started/stopped via SubActions, mod commands (!plinko start [seconds]), or the button below.
                                            </MudText>
                                        </div>

                                        <MudGrid>
                                            <MudItem xs="12" sm="6">
                                                <MudNumericField T="int" Label="Default Round Duration (Seconds)" Variant="Variant.Outlined"
                                                                 Min="10" Max="600" Step="5"
                                                                 @bind-Value="_settings.Plinko.DefaultSessionDurationSeconds"
                                                                 HelperText="e.g. 100 seconds" />
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                <MudNumericField T="int" Label="Max Drops Per User Per Round" Variant="Variant.Outlined"
                                                                 Min="0" Max="50"
                                                                 @bind-Value="_settings.Plinko.MaxDropsPerUserPerSession"
                                                                 HelperText="0 = Unlimited drops during the round" />
                                            </MudItem>
                                        </MudGrid>

                                        <MudSwitch T="bool" Color="Color.Info"
                                                   @bind-Value="_settings.Plinko.AnnounceSessionStatusInChat"
                                                   Label="Announce Round Start & End in Chat" />

                                        @if (_settings.Plinko.AnnounceSessionStatusInChat)
                                        {
                                            <MudTextField T="string" Label="Round Start Chat Message" Variant="Variant.Outlined"
                                                          @bind-Value="_settings.Plinko.SessionStartChatMessageTemplate"
                                                          HelperText="Placeholders: {duration}" />
                                            <MudTextField T="string" Label="Round End Chat Message" Variant="Variant.Outlined"
                                                          @bind-Value="_settings.Plinko.SessionEndChatMessageTemplate"
                                                          HelperText="Placeholders: {count}, {duration}" />
                                        }
                                    }
                                </MudStack>
                            </MudPaper>

                            <MudPaper Class="pa-4 mt-4" Outlined="true">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                                    <MudText Typo="Typo.h6">Prize Buckets (@_settings.Plinko.Buckets.Count)</MudText>
                                    <MudStack Row="true" Spacing="2">
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="ResetPlinkoBuckets">
                                            Reset Default Buckets
                                        </MudButton>
                                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                                   StartIcon="@Icons.Material.Filled.Add" OnClick="AddPlinkoBucket">
                                            Add Bucket
                                        </MudButton>
                                    </MudStack>
                                </MudStack>

                                @{
                                    var totalWeight = Math.Max(1, _settings.Plinko.Buckets.Sum(b => Math.Max(1, b.Weight)));
                                }
                                <MudStack Spacing="2">
                                    @for (var i = 0; i < _settings.Plinko.Buckets.Count; i++)
                                    {
                                        var idx = i;
                                        var bucket = _settings.Plinko.Buckets[idx];
                                        var pct = (Math.Max(1, bucket.Weight) * 100.0 / totalWeight).ToString("F1");
                                        <MudPaper @key="bucket" Class="pa-3" Outlined="true">
                                            <MudGrid Spacing="2">
                                                <MudItem xs="12" sm="3">
                                                    <MudTextField T="string" Label="Bucket Label" Margin="Margin.Dense" Variant="Variant.Outlined"
                                                                  @bind-Value="bucket.Label" />
                                                </MudItem>
                                                <MudItem xs="6" sm="2">
                                                    <MudNumericField T="int" Label="Score" Margin="Margin.Dense" Variant="Variant.Outlined"
                                                                     @bind-Value="bucket.Score" />
                                                </MudItem>
                                                <MudItem xs="6" sm="2">
                                                    <MudNumericField T="int" Label="@($"Weight ({pct}%)")" Margin="Margin.Dense" Variant="Variant.Outlined"
                                                                     Min="1" Max="1000"
                                                                     @bind-Value="bucket.Weight" />
                                                </MudItem>
                                                <MudItem xs="6" sm="2">
                                                    <MudTextField T="string" Label="Color" Margin="Margin.Dense" Variant="Variant.Outlined"
                                                                  @bind-Value="bucket.Color" />
                                                </MudItem>
                                                <MudItem xs="4" sm="2">
                                                    <MudSwitch T="bool" Color="Color.Success"
                                                               Value="bucket.IsWin"
                                                               ValueChanged="@((bool val) => OnBucketWinToggled(bucket, val))"
                                                               Label="Win" />
                                                </MudItem>
                                                <MudItem xs="2" sm="1">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                                                   Disabled="@(_settings.Plinko.Buckets.Count <= 2)"
                                                                   OnClick="@(() => _settings.Plinko.Buckets.RemoveAt(idx))" />
                                                </MudItem>
                                            </MudGrid>
                                        </MudPaper>
                                    }
                                </MudStack>
                            </MudPaper>
                        </MudItem>

                        <MudItem xs="12" md="5">
                            <MudPaper Class="pa-4" Outlined="true">
                                <MudText Typo="Typo.h6" Class="mb-3">🧪 Test Plinko Bounce Live</MudText>
                                <MudStack Spacing="3">
                                    <MudTextField T="string" Label="Test Player Name" Variant="Variant.Outlined"
                                                  @bind-Value="_testUsername" />
                                    <MudTextField T="string" Label="Test Emote Code or Image URL (Optional)" Variant="Variant.Outlined"
                                                  @bind-Value="_testEmoteInput" />

                                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" FullWidth="true"
                                               StartIcon="@Icons.Material.Filled.Apps"
                                               OnClick="TestPlinkoDropAsync">
                                        Launch Test Plinko Token (Weighted Random)
                                    </MudButton>

                                    <MudButton Variant="Variant.Outlined" Color="Color.Success" FullWidth="true"
                                               StartIcon="@Icons.Material.Filled.EmojiEvents"
                                               OnClick="TestPlinkoJackpotAsync">
                                        Launch Guaranteed Winning Bucket Token
                                    </MudButton>

                                    <MudDivider Class="my-2" />
                                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">⏱️ Session Controls</MudText>
                                    <MudStack Row="true" Spacing="2">
                                        <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true"
                                                   StartIcon="@Icons.Material.Filled.PlayArrow"
                                                   OnClick="StartPlinkoSessionLiveAsync">
                                            Start Round (@(_settings.Plinko.DefaultSessionDurationSeconds)s)
                                        </MudButton>
                                        <MudButton Variant="Variant.Outlined" Color="Color.Error" FullWidth="true"
                                                   StartIcon="@Icons.Material.Filled.Stop"
                                                   OnClick="StopPlinkoSessionLiveAsync">
                                            Stop Round
                                        </MudButton>
                                    </MudStack>
                                </MudStack>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                <!-- ================= TAB 4: SEASONAL & CUSTOM THEMES ================= -->
                <MudTabPanel Text="Themes & Seasons (4 Stock + Custom)" Icon="@Icons.Material.Filled.Palette">
                    <MudGrid Spacing="4">
                        <MudItem xs="12" md="4">
                            <MudPaper Class="pa-4" Outlined="true">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                                    <MudText Typo="Typo.h6">Themes</MudText>
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Add" OnClick="CreateCustomTheme">
                                        New Theme
                                    </MudButton>
                                </MudStack>

                                <MudList T="DropGameTheme" SelectedValue="_selectedTheme" SelectedValueChanged="OnSelectedThemeChanged">
                                    @foreach (var theme in _settings.Themes)
                                    {
                                        <MudListItem Value="@theme">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                                    <span style="display:inline-block; width:16px; height:16px; border-radius:50%; background:@theme.PrimaryColor; border:2px solid @theme.SecondaryColor;"></span>
                                                    <MudText>@theme.Name</MudText>
                                                </MudStack>
                                                @if (theme.IsStock)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">Stock</MudChip>
                                                }
                                            </MudStack>
                                        </MudListItem>
                                    }
                                </MudList>

                                <MudDivider Class="my-3" />
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" FullWidth="true"
                                           OnClick="ResetStockSeasonalThemes">
                                    Restore Default 4 Seasonal Themes
                                </MudButton>
                            </MudPaper>
                        </MudItem>

                        <MudItem xs="12" md="8">
                            @if (_selectedTheme != null)
                            {
                                <MudPaper Class="pa-4" Outlined="true">
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                                        <MudText Typo="Typo.h6">Editing Theme: @_selectedTheme.Name (@_selectedTheme.Id)</MudText>
                                        @if (!_selectedTheme.IsStock)
                                        {
                                            <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined"
                                                       StartIcon="@Icons.Material.Filled.Delete"
                                                       OnClick="DeleteSelectedCustomTheme">
                                                Delete Theme
                                            </MudButton>
                                        }
                                    </MudStack>

                                    <MudGrid Spacing="3">
                                        <MudItem xs="12" sm="6">
                                            <MudTextField T="string" Label="Theme Display Name" Variant="Variant.Outlined"
                                                          @bind-Value="_selectedTheme.Name" />
                                        </MudItem>
                                        <MudItem xs="6" sm="3">
                                            <MudSelect T="string" Label="Seasonal Style" Variant="Variant.Outlined"
                                                       @bind-Value="_selectedTheme.SeasonPreset">
                                                <MudSelectItem Value="@("spring")">🌸 Spring</MudSelectItem>
                                                <MudSelectItem Value="@("summer")">☀️ Summer</MudSelectItem>
                                                <MudSelectItem Value="@("fall")">🍁 Fall</MudSelectItem>
                                                <MudSelectItem Value="@("winter")">❄️ Winter</MudSelectItem>
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="6" sm="3">
                                            <MudSelect T="string" Label="Ambient Particles" Variant="Variant.Outlined"
                                                       @bind-Value="_selectedTheme.ParticleType">
                                                <MudSelectItem Value="@("petals")">Blossom Petals</MudSelectItem>
                                                <MudSelectItem Value="@("bubbles")">Beach Bubbles</MudSelectItem>
                                                <MudSelectItem Value="@("leaves")">Autumn Leaves</MudSelectItem>
                                                <MudSelectItem Value="@("snow")">Snowflakes</MudSelectItem>
                                                <MudSelectItem Value="@("stars")">Sparkle Stars</MudSelectItem>
                                                <MudSelectItem Value="@("none")">None</MudSelectItem>
                                            </MudSelect>
                                        </MudItem>

                                        <MudItem xs="6" sm="3">
                                            <MudTextField T="string" Label="Primary Color" Variant="Variant.Outlined"
                                                          @bind-Value="_selectedTheme.PrimaryColor" />
                                        </MudItem>
                                        <MudItem xs="6" sm="3">
                                            <MudTextField T="string" Label="Secondary Color" Variant="Variant.Outlined"
                                                          @bind-Value="_selectedTheme.SecondaryColor" />
                                        </MudItem>
                                        <MudItem xs="6" sm="3">
                                            <MudTextField T="string" Label="Accent / Bullseye Color" Variant="Variant.Outlined"
                                                          @bind-Value="_selectedTheme.AccentColor" />
                                        </MudItem>
                                        <MudItem xs="6" sm="3">
                                            <MudTextField T="string" Label="Target Pad Color" Variant="Variant.Outlined"
                                                          @bind-Value="_selectedTheme.TargetColor" />
                                        </MudItem>

                                        <MudItem xs="12">
                                            <MudDivider Class="my-2" />
                                            <MudText Typo="Typo.subtitle1" Class="mb-2"><b>Custom Sprites & Media (Leave blank to use built-in Seasonal Art)</b></MudText>
                                        </MudItem>

                                        <MudItem xs="12" sm="6">
                                            <MediaUrlPicker Label="Default Character Image (Fallback when no emote used)"
                                                            @bind-Value="_selectedTheme.DefaultCharacterImageUrl"
                                                            HelperText="Used when a viewer runs !drop or !plinko without specifying an emote." />
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MediaUrlPicker Label="Default Droplet Image"
                                                            @bind-Value="_selectedTheme.DefaultDropletImageUrl"
                                                            HelperText="Used for interactive droplets when no custom emote is provided." />
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MediaUrlPicker Label="Parachute Canopy Image"
                                                            @bind-Value="_selectedTheme.ParachuteCanopyImageUrl"
                                                            HelperText="Optional custom parachute canopy sprite." />
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MediaUrlPicker Label="Parachute Target Platform Image"
                                                            @bind-Value="_selectedTheme.TargetPlatformImageUrl"
                                                            HelperText="Optional custom landing platform image." />
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MediaUrlPicker Label="Plinko Board Background Image"
                                                            @bind-Value="_selectedTheme.PlinkoBoardBackgroundImageUrl"
                                                            HelperText="Optional custom Plinko board background." />
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MediaUrlPicker Label="Plinko Peg Image"
                                                            @bind-Value="_selectedTheme.PlinkoPegImageUrl"
                                                            HelperText="Optional custom peg sprite." />
                                        </MudItem>
                                    </MudGrid>
                                </MudPaper>
                            }
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>
            </MudTabs>
        }
    </MudContainer>
</FeatureGate>

@code {
    private DropGamesSettings? _settings;
    private DropGameTheme? _selectedTheme;
    private List<string> _actionNames = [];
    private string _testUsername = "PenguinViewer";
    private string _testEmoteInput = "";

    protected override async Task OnInitializedAsync()
    {
        _settings = await DropGamesService.GetSettingsAsync();
        _selectedTheme = _settings.Themes.FirstOrDefault();

        var actions = await ActionManagementService.GetAllActionsAsync();
        _actionNames = actions
            .Select(a => a.Name)
            .Where(n => !string.IsNullOrWhiteSpace(n))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(n => n, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private void OnSelectedThemeChanged(DropGameTheme? theme)
    {
        _selectedTheme = theme;
    }

    private async Task SaveAllSettingsAsync()
    {
        if (_settings == null) return;
        await DropGamesService.SaveSettingsAsync(_settings);
        Snackbar.Add("Parachute Drop & Plinko Bounce settings saved!", Severity.Success);
    }

    private void CreateCustomTheme()
    {
        if (_settings == null) return;
        var id = $"custom_{Guid.NewGuid().ToString("N")[..6]}";
        var newTheme = new DropGameTheme
        {
            Id = id,
            Name = $"Custom Theme {_settings.Themes.Count(t => !t.IsStock) + 1}",
            IsStock = false,
            SeasonPreset = "spring",
            ParticleType = "stars",
            PrimaryColor = "#A855F7",
            SecondaryColor = "#EC4899",
            AccentColor = "#FACC15",
            TargetColor = "#22C55E",
            TextColor = "#FFFFFF"
        };
        _settings.Themes.Add(newTheme);
        _selectedTheme = newTheme;
    }

    private void DeleteSelectedCustomTheme()
    {
        if (_settings == null || _selectedTheme == null || _selectedTheme.IsStock) return;
        var removedId = _selectedTheme.Id;
        _settings.Themes.Remove(_selectedTheme);
        if (_settings.Parachute.ActiveThemeId == removedId) _settings.Parachute.ActiveThemeId = "spring";
        if (_settings.Plinko.ActiveThemeId == removedId) _settings.Plinko.ActiveThemeId = "spring";
        _selectedTheme = _settings.Themes.FirstOrDefault();
    }

    private void ResetStockSeasonalThemes()
    {
        if (_settings == null) return;
        var defaults = DropGameTheme.CreateDefaultSeasonalThemes();
        foreach (var def in defaults)
        {
            var idx = _settings.Themes.FindIndex(t => t.Id.Equals(def.Id, StringComparison.OrdinalIgnoreCase));
            if (idx >= 0)
                _settings.Themes[idx] = def;
            else
                _settings.Themes.Insert(0, def);
        }
        _selectedTheme = _settings.Themes.FirstOrDefault();
        Snackbar.Add("Restored stock Spring, Summer, Fall, and Winter themes.", Severity.Info);
    }

    private void AddPlinkoBucket()
    {
        _settings?.Plinko.Buckets.Add(new PlinkoBucket
        {
            Label = "100 PTS",
            Score = 100,
            IsWin = true,
            Color = "#3B82F6",
            Weight = 15
        });
    }

    private void OnBucketWinToggled(PlinkoBucket bucket, bool isWin)
    {
        bucket.IsWin = isWin;
    }

    private void ResetPlinkoBuckets()
    {
        if (_settings == null) return;
        _settings.Plinko.Buckets = PlinkoGameSettings.CreateDefaultBuckets();
    }

    private CommandEventArgs BuildTestEventArgs() => new()
    {
        Name = string.IsNullOrWhiteSpace(_testUsername) ? "penguinviewer" : _testUsername.Trim().ToLowerInvariant(),
        DisplayName = string.IsNullOrWhiteSpace(_testUsername) ? "PenguinViewer" : _testUsername.Trim(),
        Arg = _testEmoteInput?.Trim() ?? "",
        IsBroadcaster = true,
        FromOwnChannel = true
    };

    private async Task TestParachuteDropAsync()
    {
        if (_settings != null) await DropGamesService.SaveSettingsAsync(_settings);
        await DropGamesService.TriggerParachuteDropAsync(BuildTestEventArgs(), _testEmoteInput, allowDirectUrlOrPath: true);
        Snackbar.Add("Launched test Parachute Drop! Watch your /parachute.html overlay.", Severity.Info);
    }

    private async Task TestParachuteBullseyeAsync()
    {
        if (_settings == null) return;
        await DropGamesService.SaveSettingsAsync(_settings);
        await DropGamesService.TriggerParachuteDropAsync(
            BuildTestEventArgs(),
            _testEmoteInput,
            forcedStartX: _settings.Parachute.TargetCenterX,
            forcedWindAccelX: 0.0,
            allowDirectUrlOrPath: true);
        Snackbar.Add("Launched guaranteed Bullseye Parachute Drop!", Severity.Success);
    }

    private async Task TestComboDropAndDropletsAsync()
    {
        if (_settings == null) return;
        await DropGamesService.SaveSettingsAsync(_settings);

        var capturedEmote = _testEmoteInput;
        var capturedUser = _testUsername;

        await DropGamesService.TriggerParachuteDropAsync(
            BuildTestEventArgs(),
            capturedEmote,
            forcedStartX: _settings.Parachute.TargetCenterX,
            forcedWindAccelX: 0.0,
            allowDirectUrlOrPath: true);

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(900);
                await DropGamesService.SpawnDropletsAsync(new DropletSpawnRequest
                {
                    Count = 6,
                    SizePreset = "Large",
                    SpeedPreset = "Fast",
                    SpawnPattern = "Targeted",
                    KnockbackMultiplier = 1.4,
                    EmoteOrImage = capturedEmote,
                    AllowDirectUrlOrPath = true,
                    TriggeredByUser = capturedUser
                });
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to spawn test droplets collision barrage");
            }
        });

        Snackbar.Add("Launched Parachute Drop + Targeted Droplet Collision barrage!", Severity.Info);
    }

    private async Task TestDropletsNowAsync()
    {
        if (_settings == null) return;
        await DropGamesService.SaveSettingsAsync(_settings);
        await DropGamesService.SpawnDropletsAsync(new DropletSpawnRequest
        {
            Count = _settings.Parachute.DefaultDropletCount,
            SizePreset = _settings.Parachute.DefaultDropletSize,
            SpeedPreset = _settings.Parachute.DefaultDropletSpeed,
            SpawnPattern = _settings.Parachute.DefaultDropletPattern,
            KnockbackMultiplier = _settings.Parachute.DefaultKnockbackMultiplier,
            EmoteOrImage = _testEmoteInput,
            AllowDirectUrlOrPath = true,
            TriggeredByUser = _testUsername
        });
        Snackbar.Add("Spawned interactive droplets on Parachute overlay!", Severity.Info);
    }

    private async Task TestCustomDropletsAsync(string size, string speed, string pattern, int count)
    {
        await DropGamesService.SpawnDropletsAsync(new DropletSpawnRequest
        {
            Count = count,
            SizePreset = size,
            SpeedPreset = speed,
            SpawnPattern = pattern,
            KnockbackMultiplier = 1.25,
            EmoteOrImage = _testEmoteInput,
            AllowDirectUrlOrPath = true,
            TriggeredByUser = _testUsername
        });
        Snackbar.Add($"Spawned {count}x {size}/{speed} ({pattern}) droplets!", Severity.Info);
    }

    private async Task TestPlinkoDropAsync()
    {
        if (_settings != null) await DropGamesService.SaveSettingsAsync(_settings);
        await DropGamesService.TriggerPlinkoDropAsync(BuildTestEventArgs(), _testEmoteInput, allowDirectUrlOrPath: true);
        Snackbar.Add("Launched test Plinko token! Watch your /plinko.html overlay.", Severity.Info);
    }

    private async Task TestPlinkoJackpotAsync()
    {
        if (_settings == null) return;
        await DropGamesService.SaveSettingsAsync(_settings);
        var bestWinIdx = _settings.Plinko.Buckets
            .Select((b, idx) => (b, idx))
            .Where(x => x.b.IsWin)
            .OrderByDescending(x => x.b.Score)
            .Select(x => (int?)x.idx)
            .FirstOrDefault() ?? 0;

        await DropGamesService.TriggerPlinkoDropAsync(BuildTestEventArgs(), _testEmoteInput, forcedBucketIndex: bestWinIdx, allowDirectUrlOrPath: true);
        Snackbar.Add("Launched guaranteed Winning Bucket Plinko token!", Severity.Success);
    }

    private async Task StartParachuteSessionLiveAsync()
    {
        if (_settings != null) await DropGamesService.SaveSettingsAsync(_settings);
        var duration = _settings?.Parachute.DefaultSessionDurationSeconds ?? 100;
        var result = await DropGamesService.StartSessionAsync(DropGameType.Parachute, duration, triggeredBy: "Dashboard");
        if (result.IsQueued)
        {
            Snackbar.Add($"Queued Parachute Drop session (Position #{result.QueuePosition}) behind active game.", Severity.Info);
        }
        else
        {
            Snackbar.Add($"Started Parachute Drop session for {duration} seconds!", Severity.Success);
        }
    }

    private async Task StopParachuteSessionLiveAsync()
    {
        var result = await DropGamesService.StopSessionAsync(DropGameType.Parachute, triggeredBy: "Dashboard");
        if (result != null)
        {
            Snackbar.Add("Stopped Parachute Drop session.", Severity.Warning);
        }
        else
        {
            Snackbar.Add("No active or queued Parachute Drop session to stop.", Severity.Info);
        }
    }

    private async Task StartPlinkoSessionLiveAsync()
    {
        if (_settings != null) await DropGamesService.SaveSettingsAsync(_settings);
        var duration = _settings?.Plinko.DefaultSessionDurationSeconds ?? 100;
        var result = await DropGamesService.StartSessionAsync(DropGameType.Plinko, duration, triggeredBy: "Dashboard");
        if (result.IsQueued)
        {
            Snackbar.Add($"Queued Plinko Bounce session (Position #{result.QueuePosition}) behind active game.", Severity.Info);
        }
        else
        {
            Snackbar.Add($"Started Plinko Bounce session for {duration} seconds!", Severity.Success);
        }
    }

    private async Task StopPlinkoSessionLiveAsync()
    {
        var result = await DropGamesService.StopSessionAsync(DropGameType.Plinko, triggeredBy: "Dashboard");
        if (result != null)
        {
            Snackbar.Add("Stopped Plinko Bounce session.", Severity.Warning);
        }
        else
        {
            Snackbar.Add("No active or queued Plinko Bounce session to stop.", Severity.Info);
        }
    }
}

