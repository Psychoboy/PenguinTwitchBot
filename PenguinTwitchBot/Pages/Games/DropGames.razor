    private static string GetSoundFallbackInfo(DropGameSoundConfig? config)
    {
        if (config == null || !config.Enabled)
        {
            return "Disabled in overall settings";
        }
        var file = string.IsNullOrWhiteSpace(config.SoundFile) ? "(no file selected)" : config.SoundFile;
        return $"Overall active: {file} at {config.Volume}% volume";
    }
