@page "/dropgames"
@attribute [Authorize(Roles = "Streamer, Editor")]
@using PenguinTwitchBot.Bot.Actions
@using PenguinTwitchBot.Bot.Commands.Games
@using PenguinTwitchBot.Bot.Commands.Games.Common
@using PenguinTwitchBot.Bot.Commands.Games.Parachute
@using PenguinTwitchBot.Bot.Commands.Games.Plinko
@using PenguinTwitchBot.Bot.Events.Chat
@using PenguinTwitchBot.Bot.Features
@using PenguinTwitchBot.Pages.Components
@inject IDropGamesSettingsService SettingsService
@inject IParachuteDropService ParachuteDropService
@inject IPlinkoDropService PlinkoDropService
@inject IActionManagementService ActionManagementService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ILogger<DropGames> Logger

<PageTitle>Parachute Drop & Plinko Bounce</PageTitle>

<FeatureGate FeatureKey="@FeatureKeys.DropGames" DisabledMessage="Parachute Drop & Plinko Bounce is currently disabled. Enable it on the Bot Features page.">
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-8">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
            <div>
                <MudText Typo="Typo.h4">Parachute Drop & Plinko Bounce</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Customizable stream overlay minigames with seasonal themes, interactive droplets, emote support, and tamper-proof win actions.
                </MudText>
            </div>
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.RestartAlt"
                           OnClick="ResetAllSettingsToDefaultsAsync">
                    Reset to Defaults
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.OpenInNew"
                           Href="/parachute.html" Target="_blank">
                    Open Parachute Overlay
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.OpenInNew"
                           Href="/plinko.html" Target="_blank">
                    Open Plinko Overlay
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                           OnClick="SaveAllSettingsAsync">
                    Save All Settings
                </MudButton>
                <HelpButton Topic="drop-games" />
            </MudStack>
        </MudStack>

        @if (_settings == null)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else
        {
            <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-5">
                <!-- ================= TAB 1: PARACHUTE DROP ================= -->
                <MudTabPanel Text="Parachute Drop (!drop)">
                    <MudGrid Spacing="4">
                        <MudItem xs="12" md="7">
                            <MudPaper Class="pa-4" Outlined="true">
                                <MudText Typo="Typo.h6" Class="mb-3">Gameplay & Target Configuration</MudText>
                                <MudStack Spacing="3">
                                    <MudSelect T="string" Label="Active Theme" Variant="Variant.Outlined"
                                               @bind-Value="_settings.Parachute.ActiveThemeId"
                                               HelperText="Select a stock seasonal theme (Spring, Summer, Fall, Winter) or custom theme.">
                                        @foreach (var theme in _settings.Themes)
                                        {
                                            <MudSelectItem Value="@theme.Id">@theme.Name @(theme.IsStock ? "(Seasonal Stock)" : "(Custom)")</MudSelectItem>
                                        }
                                    </MudSelect>

                                    <MudGrid>
                                        <MudItem xs="12" sm="6">
                                            <MudNumericField T="double" Label="Target Width (%)" Variant="Variant.Outlined"
                                                             Min="5" Max="60" Step="1"
                                                             @bind-Value="_settings.Parachute.TargetWidthPercent"
                                                             HelperText="Width of landing platform (% of screen)" />
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudNumericField T="double" Label="Target Position X (0.15 - 0.85)" Variant="Variant.Outlined"
                                                             Min="0.15" Max="0.85" Step="0.05"
                                                             @bind-Value="_settings.Parachute.TargetCenterX"
                                                             HelperText="0.50 = Dead Center" />
                                        </MudItem>
                                    </MudGrid>

                                    <MudGrid>
                                        <MudItem xs="12" sm="4">
                                            <MudNumericField T="double" Label="Gravity (0.1 - 10.0)" Variant="Variant.Outlined"
                                                             Min="0.1" Max="10.0" Step="0.1"
                                                             @bind-Value="_settings.Parachute.Gravity"
                                                             HelperText="1.0 = Standard fall speed (higher = faster)" />
                                        </MudItem>
                                        <MudItem xs="12" sm="4">
                                            <MudNumericField T="double" Label="Bounciness (0.1 - 5.0)" Variant="Variant.Outlined"
                                                             Min="0.1" Max="5.0" Step="0.05"
                                                             @bind-Value="_settings.Parachute.Bounciness"
                                                             HelperText="Wall & mid-air collision bounce elasticity" />
                                        </MudItem>
                                        <MudItem xs="12" sm="4">
                                            <MudNumericField T="double" Label="Mass (0.1 - 10.0)" Variant="Variant.Outlined"
                                                             Min="0.1" Max="10.0" Step="0.1"
                                                             @bind-Value="_settings.Parachute.Mass"
                                                             HelperText="Higher mass resists droplet & mid-air knockback" />
                                        </MudItem>
                                    </MudGrid>
                                </MudStack>
                            </MudPaper>

                            <MudPaper Class="pa-4 mt-4" Outlined="true">
                                <MudText Typo="Typo.h6" Class="mb-3">Win Action & Chat Announcement</MudText>
                                <MudStack Spacing="3">
                                    <MudSelect T="string" Label="Direct Win Action (Optional)" Variant="Variant.Outlined"
                                               Clearable="true"
                                               @bind-Value="_settings.Parachute.WinActionName"
                                               HelperText="Action executed immediately when a viewer lands a winning drop. Variables passed: %User%, %Score%, %IsBullseye%, %DropletHits%, %Theme%.">
                                        <MudSelectItem Value="@("")">None (Use Default Command Triggers Only)</MudSelectItem>
                                        @foreach (var actName in _actionNames)
                                        {
                                            <MudSelectItem Value="@actName">@actName</MudSelectItem>
                                        }
                                    </MudSelect>

                                    <MudAlert Severity="Severity.Info" Dense="true">
                                        You can also attach triggers in <b>Manage Actions &rarr; Add Trigger &rarr; Default Command &rarr; drop</b> for <b>Win (Target Hit)</b>, <b>Bullseye Hit</b>, or <b>Missed Target (Lose)</b>!
                                    </MudAlert>

                                    <MudSwitch T="bool" Color="Color.Success"
                                               @bind-Value="_settings.Parachute.AnnounceWinsInChat"
                                               Label="Send Chat Message on Win" />

                                    @if (_settings.Parachute.AnnounceWinsInChat)
                                    {
                                        <MudTextField T="string" Label="Win Chat Message Template" Variant="Variant.Outlined"
                                                      @bind-Value="_settings.Parachute.WinChatMessageTemplate"
                                                      HelperText="Placeholders: {user}, {score}, {bullseye}, {droplethits}" />
                                    }
                                </MudStack>
                            </MudPaper>

                            <MudPaper Class="pa-4 mt-4" Outlined="true">
                                <MudText Typo="Typo.h6" Class="mb-3">Timed Session / Round Mode</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                                    Run timed drop rounds (e.g., 100 seconds). Controls when viewers can participate and how rounds start/stop.
                                </MudText>

                                <MudStack Spacing="3">
                                    <MudSwitch T="bool" Color="Color.Primary"
                                               @bind-Value="_settings.Parachute.SessionModeEnabled"
                                               Label="Enable Timed Session Mode (When disabled, drops run anytime in free-play mode)" />

                                    @if (_settings.Parachute.SessionModeEnabled)
                                    {
                                        <div>
                                            <MudSwitch T="bool" Color="Color.Secondary"
                                                       @bind-Value="_settings.Parachute.AutoStartOnCommand"
                                                       Label="Auto-start Round on Command (Starts round automatically when someone types !drop)" />
                                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block ml-3">
                                                When off, rounds can only be started/stopped via SubActions, mod commands (!drop start [seconds]), or the button below.
                                            </MudText>
                                        </div>

                                        <MudGrid>
                                            <MudItem xs="12" sm="6">
                                                <MudNumericField T="int" Label="Default Round Duration (Seconds)" Variant="Variant.Outlined"
                                                                 Min="10" Max="600" Step="5"
                                                                 @bind-Value="_settings.Parachute.DefaultSessionDurationSeconds"
                                                                 HelperText="e.g. 100 seconds" />
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                <MudNumericField T="int" Label="Max Drops Per User Per Round" Variant="Variant.Outlined"
                                                                 Min="0" Max="50"
                                                                 @bind-Value="_settings.Parachute.MaxDropsPerUserPerSession"
                                                                 HelperText="0 = Unlimited drops during the round" />
                                            </MudItem>
                                        </MudGrid>

                                        <MudSwitch T="bool" Color="Color.Info"
                                                   @bind-Value="_settings.Parachute.AnnounceSessionStatusInChat"
                                                   Label="Announce Round Start & End in Chat" />

                                        @if (_settings.Parachute.AnnounceSessionStatusInChat)
                                        {
                                            <MudTextField T="string" Label="Round Start Chat Message" Variant="Variant.Outlined"
                                                          @bind-Value="_settings.Parachute.SessionStartChatMessageTemplate"
                                                          HelperText="Placeholders: {duration}" />
                                            <MudTextField T="string" Label="Round End Chat Message" Variant="Variant.Outlined"
                                                          @bind-Value="_settings.Parachute.SessionEndChatMessageTemplate"
                                                          HelperText="Placeholders: {count}, {duration}" />
                                        }
                                    }
                                </MudStack>
                            </MudPaper>

                            <MudPaper Class="pa-4 mt-4" Outlined="true">
                                <MudText Typo="Typo.h6" Class="mb-3">Overlay Header & Display Settings</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                                    Configure the appearance, position, and visibility of the round timer, drop counters, and free-play pills.
                                </MudText>
                                <MudStack Spacing="3">
                                    <MudSwitch T="bool" Color="Color.Primary"
                                               @bind-Value="_settings.Parachute.ShowHeaderBanner"
                                               Label="Show Overlay Header Banner (Master display toggle for round banner)" />

                                    <MudSwitch T="bool" Color="Color.Secondary"
                                               @bind-Value="_settings.Parachute.AutoAvoidOverlap"
                                               Label="Auto-Avoid Overlap with Plinko (Automatically stacks headers vertically when both games run simultaneously)" />

                                    <MudGrid>
                                        <MudItem xs="12" sm="4">
                                            <MudSelect T="string" Label="Header Position" Variant="Variant.Outlined"
                                                       @bind-Value="_settings.Parachute.HeaderPosition">
                                                <MudSelectItem Value="@("TopCenter")">Top Center (Default)</MudSelectItem>
                                                <MudSelectItem Value="@("TopLeft")">Top Left</MudSelectItem>
                                                <MudSelectItem Value="@("TopRight")">Top Right</MudSelectItem>
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="12" sm="4">
                                            <MudNumericField T="int" Label="Vertical Y Offset (Pixels)" Variant="Variant.Outlined"
                                                             Min="0" Max="500" Step="2"
                                                             @bind-Value="_settings.Parachute.HeaderCustomYOffset"
                                                             HelperText="Default: 18 px" />
                                        </MudItem>
                                        <MudItem xs="12" sm="4">
                                            <MudNumericField T="int" Label="Name Font Size (Pixels)" Variant="Variant.Outlined"
                                                             Min="12" Max="36" Step="1"
                                                             @bind-Value="_settings.Parachute.NameFontSize"
                                                             HelperText="Default: 18 px (12 - 36 px)" />
                                        </MudItem>
                                    </MudGrid>

                                    <MudDivider Class="my-2" />
                                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">Component Visibility</MudText>

                                    <MudSwitch T="bool" Color="Color.Info"
                                               @bind-Value="_settings.Parachute.ShowTimer"
                                               Label="Show Round Countdown Timer (Round Ends: mm:ss)" />

                                    <MudSwitch T="bool" Color="Color.Info"
                                               @bind-Value="_settings.Parachute.ShowDropCount"
                                               Label="Show Drops Counter (Drops: N)" />

                                    <MudSwitch T="bool" Color="Color.Info"
                                               @bind-Value="_settings.Parachute.ShowFreePlayCounter"
                                               Label="Show Free-Play Counter Pill (during non-session drops)" />
                                </MudStack>
                            </MudPaper>

                            <MudPaper Class="pa-4 mt-4" Outlined="true">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                                    <div>
                                        <MudText Typo="Typo.h6">Parachute Audio & Sound Effects</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Configure optional sounds for round events, drops, and winning platform landings.</MudText>
                                    </div>
                                </MudStack>
                                <MudStack Spacing="2">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-2">
                                        <MudText Typo="Typo.caption" Style="min-width: 170px;">
                                            Max Concurrent Sounds: <b>@(_settings.Parachute.MaxConcurrentSounds)</b>
                                        </MudText>
                                        <div style="flex: 1 1 auto;">
                                            <MudSlider T="int"
                                                       Min="1" Max="5" Step="1" ValueLabel="true"
                                                       @bind-Value="_settings.Parachute.MaxConcurrentSounds"
                                                       Color="Color.Primary" />
                                        </div>
                                    </MudStack>

                                    <DropGameSoundEditor Title="Round Start Sound"
                                                         HelperText="Plays immediately when a Parachute round begins"
                                                         SoundConfig="_settings.Parachute.StartSound" />

                                    <DropGameSoundEditor Title="Round End Sound"
                                                         HelperText="Plays immediately when a Parachute round finishes"
                                                         SoundConfig="_settings.Parachute.EndSound" />

                                    <DropGameSoundEditor Title="Player Drop Sound"
                                                         HelperText="Plays when a viewer drops a parachute into the game"
                                                         SoundConfig="_settings.Parachute.DropSound" />

                                    <DropGameSoundEditor Title="Parachute Flap / Open Sound"
                                                         HelperText="Plays when a parachute canopy opens after dropping"
                                                         SoundConfig="_settings.Parachute.ParachuteFlapSound" />

                                    <DropGameSoundEditor Title="Target Platform Win Sound"
                                                         HelperText="Plays when a player successfully lands on the target platform"
                                                         SoundConfig="_settings.Parachute.WinSound" />

                                    <DropGameSoundEditor Title="Rocket Launch Sound"
                                                         HelperText="Plays when sky rockets are launched"
                                                         SoundConfig="_settings.Parachute.RocketLaunchSound" />

                                    <DropGameSoundEditor Title="Rocket Detonation Sound"
                                                         HelperText="Plays when a sky rocket explodes"
                                                         SoundConfig="_settings.Parachute.RocketExplodeSound" />

                                    <DropGameSoundEditor Title="Parachute Pop / Sabotage Sound"
                                                         HelperText="Plays when a parachute canopy is destroyed"
                                                         SoundConfig="_settings.Parachute.ParachutePopSound" />

                                    <DropGameSoundEditor Title="Cannonball Splash Sound (Water Landing)"
                                                         HelperText="Plays when a crash-landing player lands in the water pool"
                                                         SoundConfig="_settings.Parachute.CannonballSound" />

                                    <DropGameSoundEditor Title="Crash Splat Sound (Ground Landing)"
                                                         HelperText="Plays when a crash-landing player impacts the floor"
                                                         SoundConfig="_settings.Parachute.CrashLandSound" />
                                </MudStack>
                            </MudPaper>
                        </MudItem>

                        <MudItem xs="12" md="5">
                            <MudPaper Class="pa-4" Outlined="true">
                                <MudText Typo="Typo.h6" Class="mb-3">Test Parachute Drop Live</MudText>
                                <MudStack Spacing="3">
                                    <MudTextField T="string" Label="Test Player Name" Variant="Variant.Outlined"
                                                  @bind-Value="_testUsername" />
                                    <MudTextField T="string" Label="Test Emote Code or Image URL (Optional)" Variant="Variant.Outlined"
                                                  @bind-Value="_testEmoteInput"
                                                  HelperText="Leave blank to test the active theme's default character sprite, or enter an emote code / image URL." />

                                    <MudButton Variant="Variant.Filled" Color="Color.Info" FullWidth="true"
                                               StartIcon="@Icons.Material.Filled.Paragliding"
                                               OnClick="TestParachuteDropAsync">
                                        Launch Test Parachute Drop
                                    </MudButton>

                                    <MudButton Variant="Variant.Outlined" Color="Color.Success" FullWidth="true"
                                               StartIcon="@Icons.Material.Filled.GpsFixed"
                                               OnClick="TestParachuteBullseyeAsync">
                                        Launch Guaranteed Center (100 pts) Drop
                                    </MudButton>

                                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" FullWidth="true"
                                               StartIcon="@Icons.Material.Filled.WaterDrop"
                                               OnClick="TestComboDropAndDropletsAsync">
                                        Combo Test: Drop + Mid-Air Droplets Collision!
                                    </MudButton>

                                    <MudButton Variant="Variant.Filled" Color="Color.Error" FullWidth="true"
                                               StartIcon="@Icons.Material.Filled.RocketLaunch"
                                               OnClick="TestNormalParachuteDropWithRocketAsync">
                                        Combo Test: Drop + Rocket Intercept
                                    </MudButton>

                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                               StartIcon="@Icons.Material.Filled.SportsKabaddi"
                                               OnClick="TestHeadOnPlayerBounceAsync">
                                        Test: Mid-Air 2-Player Head-On Collision Bounce!
                                    </MudButton>

                                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" FullWidth="true"
                                               StartIcon="@Icons.Material.Filled.Waves"
                                               OnClick="TestUpwardFountainKnockupAsync">
                                        Test: Drop + Upward Fountain Knockup!
                                    </MudButton>

                                    <MudDivider Class="my-2" />
                                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">Session Controls</MudText>
                                    <MudStack Row="true" Spacing="2">
                                        <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true"
                                                   StartIcon="@Icons.Material.Filled.PlayArrow"
                                                   OnClick="StartParachuteSessionLiveAsync">
                                            Start Round (@(_settings.Parachute.DefaultSessionDurationSeconds)s)
                                        </MudButton>
                                        <MudButton Variant="Variant.Outlined" Color="Color.Error" FullWidth="true"
                                                   StartIcon="@Icons.Material.Filled.Stop"
                                                   OnClick="StopParachuteSessionLiveAsync">
                                            Stop Round
                                        </MudButton>
                                    </MudStack>
                                </MudStack>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                <!-- ================= TAB 2: INTERACTIVE DROPLETS ================= -->
                <MudTabPanel Text="Interactive Droplets (!droplets)">
                    <MudGrid Spacing="4">
                        <MudItem xs="12" md="7">
                            <MudPaper Class="pa-4" Outlined="true">
                                <MudText Typo="Typo.h6" Class="mb-2">Default Droplets Physics & Sub-Action Settings</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                                    Droplets physically collide with parachuting characters mid-air and alter their landing trajectory based on droplet size (mass) and speed (momentum). Can be triggered via <b>!droplets</b> or the <b>Parachute Droplets</b> Sub-Action!
                                </MudText>

                                <MudStack Spacing="3">
                                    <MudGrid>
                                        <MudItem xs="12" sm="6">
                                            <MudNumericField T="int" Label="Default Droplet Count (1 - 30)" Variant="Variant.Outlined"
                                                             Min="1" Max="30"
                                                             @bind-Value="_settings.Parachute.DefaultDropletCount" />
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudNumericField T="double" Label="Knockback Force Multiplier" Variant="Variant.Outlined"
                                                             Min="0.1" Max="5.0" Step="0.1"
                                                             @bind-Value="_settings.Parachute.DefaultKnockbackMultiplier"
                                                             HelperText="1.0 = Standard push force on collision" />
                                        </MudItem>
                                    </MudGrid>

                                    <MudGrid>
                                        <MudItem xs="12" sm="@(_settings.Parachute.DefaultDropletSize == "Random" ? 6 : 4)">
                                            <MudSelect T="string" Label="Default Droplet Size" Variant="Variant.Outlined"
                                                       @bind-Value="_settings.Parachute.DefaultDropletSize">
                                                <MudSelectItem Value="@("Small")">Small (Light nudge)</MudSelectItem>
                                                <MudSelectItem Value="@("Medium")">Medium (Standard)</MudSelectItem>
                                                <MudSelectItem Value="@("Large")">Large (Heavy bump)</MudSelectItem>
                                                <MudSelectItem Value="@("Giant")">Giant (Massive knockback)</MudSelectItem>
                                                <MudSelectItem Value="@("Random")">Random Mix</MudSelectItem>
                                            </MudSelect>
                                        </MudItem>
                                        @if (_settings.Parachute.DefaultDropletSize == "Random")
                                        {
                                            <MudItem xs="12" sm="6">
                                                <MudSelect T="string" Label="Random Sizes Pool" MultiSelection="true"
                                                           SelectedValues="_selectedRandomDropletSizes"
                                                           SelectedValuesChanged="OnSelectedRandomDropletSizesChanged"
                                                           Variant="Variant.Outlined"
                                                           HelperText="Choose which sizes can be rolled when Random is selected">
                                                    <MudSelectItem T="string" Value="@("Small")">Small (Light nudge)</MudSelectItem>
                                                    <MudSelectItem T="string" Value="@("Medium")">Medium (Standard)</MudSelectItem>
                                                    <MudSelectItem T="string" Value="@("Large")">Large (Heavy bump)</MudSelectItem>
                                                    <MudSelectItem T="string" Value="@("Giant")">Giant (Massive knockback)</MudSelectItem>
                                                </MudSelect>
                                            </MudItem>
                                        }
                                        <MudItem xs="12" sm="@(_settings.Parachute.DefaultDropletSize == "Random" ? 6 : 4)">
                                            <MudSelect T="string" Label="Default Droplet Speed" Variant="Variant.Outlined"
                                                       @bind-Value="_settings.Parachute.DefaultDropletSpeed">
                                                <MudSelectItem Value="@("Slow")">Slow (0.6x)</MudSelectItem>
                                                <MudSelectItem Value="@("Normal")">Normal (1.0x)</MudSelectItem>
                                                <MudSelectItem Value="@("Fast")">Fast (1.6x)</MudSelectItem>
                                                <MudSelectItem Value="@("Hyper")">Hyper (2.2x)</MudSelectItem>
                                                <MudSelectItem Value="@("Random")">Random Mix</MudSelectItem>
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="12" sm="@(_settings.Parachute.DefaultDropletSize == "Random" ? 6 : 4)">
                                            <MudSelect T="string" Label="Default Spawn Pattern" Variant="Variant.Outlined"
                                                       @bind-Value="_settings.Parachute.DefaultDropletPattern">
                                                <MudSelectItem Value="@("Targeted")">Targeted (Intercepts active parachutists)</MudSelectItem>
                                                <MudSelectItem Value="@("TopRain")">Top Rain (Falls from sky)</MudSelectItem>
                                                <MudSelectItem Value="@("SideWind")">Side Wind (Diagonal crosswind)</MudSelectItem>
                                                <MudSelectItem Value="@("Fountain")">Fountain (Arcs from sides)</MudSelectItem>
                                            </MudSelect>
                                        </MudItem>
                                    </MudGrid>
                                </MudStack>
                            </MudPaper>
                        </MudItem>

                        <MudItem xs="12" md="5">
                            <MudPaper Class="pa-4" Outlined="true">
                                <MudText Typo="Typo.h6" Class="mb-3">Live Droplet Barrage Tester</MudText>
                                <MudStack Spacing="2">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                               StartIcon="@Icons.Material.Filled.WaterDrop"
                                               OnClick="TestDropletsNowAsync">
                                        Fire Droplets Now (Uses Default Settings)
                                    </MudButton>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" FullWidth="true"
                                               StartIcon="@Icons.Material.Filled.Bolt"
                                               OnClick='() => TestCustomDropletsAsync("Giant", "Hyper", "Targeted", 4)'>
                                        Fire Giant Hyper Targeted Barrage (4x)
                                    </MudButton>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Info" FullWidth="true"
                                               StartIcon="@Icons.Material.Filled.Grain"
                                               OnClick='() => TestCustomDropletsAsync("Random", "Random", "SideWind", 12)'>
                                        Fire Random Side-Wind Storm (12x)
                                    </MudButton>
                                </MudStack>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                <!-- ================= TAB 3: SKY ROCKETS & SABOTAGE ================= -->
                <MudTabPanel Text="Sky Rockets & Sabotage">
                    <MudGrid Spacing="4">
                        <MudItem xs="12" md="7">
                            <MudPaper Class="pa-4" Outlined="true">
                                <MudText Typo="Typo.h6" Class="mb-2">Sky Rockets & Parachute Sabotage Settings</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                                    Rockets are launched into the sky to push players mid-air. Direct hits on a parachute canopy destroy the canopy ("canopy kill"), triggering a high-speed comedic free-fall! Triggered exclusively via the <b>Parachute Rockets</b> Sub-Action for Channel Points, Bits, Action Groups, and stream events.
                                </MudText>

                                <MudStack Spacing="3">
                                    <MudSwitch T="bool" Color="Color.Primary"
                                               @bind-Value="_settings.Parachute.EnableRockets"
                                               Label="Enable Sky Rockets & Sabotage System" />

                                    <MudGrid>
                                        <MudItem xs="12" sm="6">
                                            <MudSelect T="string" Label="Default Launch Pattern" Variant="Variant.Outlined"
                                                       @bind-Value="_settings.Parachute.RocketLaunchPattern"
                                                       HelperText="Targeted aims at active parachutists; Barrage spreads evenly; Random shoots chaotically">
                                                <MudSelectItem Value="@("Targeted")">Targeted (Lead active players)</MudSelectItem>
                                                <MudSelectItem Value="@("Barrage")">Barrage (Wide multi-rocket salvo)</MudSelectItem>
                                                <MudSelectItem Value="@("Random")">Random (Unpredictable fireworks)</MudSelectItem>
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudSelect T="CrashLandingScoreMode" Label="Crash Landing Score Outcome" Variant="Variant.Outlined"
                                                       @bind-Value="_settings.Parachute.CrashLandingScoreMode"
                                                       HelperText="How points are scored when a player crash-lands after parachute destruction">
                                                <MudSelectItem Value="@CrashLandingScoreMode.PreserveScore">Preserve Score (Retains points at impact site + Cannonball splash)</MudSelectItem>
                                                <MudSelectItem Value="@CrashLandingScoreMode.HalfScore">Half Score (50% points on impact)</MudSelectItem>
                                                <MudSelectItem Value="@CrashLandingScoreMode.ZeroScore">Zero Score (0 points on crash landing)</MudSelectItem>
                                            </MudSelect>
                                        </MudItem>
                                    </MudGrid>

                                    <MudGrid>
                                        <MudItem xs="12" sm="4">
                                            <MudNumericField T="double" Label="Knockback Multiplier" Variant="Variant.Outlined"
                                                             Min="0.1" Max="5.0" Step="0.1"
                                                             @bind-Value="_settings.Parachute.RocketKnockbackMultiplier"
                                                             HelperText="Force applied on explosive body knockback" />
                                        </MudItem>
                                        <MudItem xs="12" sm="4">
                                            <MudSwitch T="bool" Color="Color.Error"
                                                       @bind-Value="_settings.Parachute.DirectHitKillsParachute"
                                                       Label="Direct Canopy Hit Kills Parachute" />
                                        </MudItem>
                                        <MudItem xs="12" sm="4">
                                            <MudNumericField T="double" Label="Canopy Kill Chance (0.0 - 1.0)" Variant="Variant.Outlined"
                                                             Min="0.0" Max="1.0" Step="0.05"
                                                             @bind-Value="_settings.Parachute.CanopyKillChance"
                                                             HelperText="1.0 = 100% kill chance on canopy hit" />
                                        </MudItem>
                                    </MudGrid>
                                </MudStack>
                            </MudPaper>

                            <MudPaper Class="pa-4 mt-4" Outlined="true">
                                <MudText Typo="Typo.h6" Class="mb-3">Rocket & Crash Audio</MudText>
                                <MudStack Spacing="2">
                                    <DropGameSoundEditor Title="Rocket Launch Sound"
                                                         HelperText="Plays when rockets fire up into the sky"
                                                         SoundConfig="_settings.Parachute.RocketLaunchSound" />

                                    <DropGameSoundEditor Title="Rocket Detonation Sound"
                                                         HelperText="Plays when a rocket reaches fuse apex or explodes"
                                                         SoundConfig="_settings.Parachute.RocketExplodeSound" />

                                    <DropGameSoundEditor Title="Parachute Pop / Sabotage Sound"
                                                         HelperText="Plays when a canopy is shredded mid-air"
                                                         SoundConfig="_settings.Parachute.ParachutePopSound" />

                                    <DropGameSoundEditor Title="Cannonball Splash Sound (Water Landing)"
                                                         HelperText="Plays when a free-falling player splashes into the pool platform"
                                                         SoundConfig="_settings.Parachute.CannonballSound" />

                                    <DropGameSoundEditor Title="Crash Splat Sound (Ground Landing)"
                                                         HelperText="Plays when a free-falling player splats on the floor"
                                                         SoundConfig="_settings.Parachute.CrashLandSound" />
                                </MudStack>
                            </MudPaper>
                        </MudItem>

                        <MudItem xs="12" md="5">
                            <MudPaper Class="pa-4" Outlined="true">
                                <MudText Typo="Typo.h6" Class="mb-3">Live Rocket & Sabotage Tester</MudText>
                                <MudStack Spacing="3">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                               StartIcon="@Icons.Material.Filled.RocketLaunch"
                                               OnClick="TestSingleRocketAsync">
                                        Fire Single Test Rocket
                                    </MudButton>

                                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" FullWidth="true"
                                               StartIcon="@Icons.Material.Filled.Celebration"
                                               OnClick="TestRocketBarrageAsync">
                                        Fire Rocket Barrage (6 Rockets)
                                    </MudButton>

                                    <MudButton Variant="Variant.Filled" Color="Color.Error" FullWidth="true"
                                               StartIcon="@Icons.Material.Filled.RocketLaunch"
                                               OnClick="TestNormalParachuteDropWithRocketAsync">
                                        Combo Test: Drop + Rocket Intercept
                                    </MudButton>

                                    <MudDivider Class="my-2" />
                                    <MudAlert Severity="Severity.Info" Dense="true">
                                        <b>SubAction Controlled:</b> Streamers can trigger rockets via <b>SubActions &rarr; Parachute Rockets</b>. You can customize rocket count, launch pattern, targeted player, or specific fuse times for interactive bits rewards or channel points redemptions!
                                    </MudAlert>
                                </MudStack>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                <!-- ================= TAB 4: PLINKO BOUNCE ================= -->
                <MudTabPanel Text="Plinko Bounce (!plinko)">
                    <MudGrid Spacing="4">
                        <MudItem xs="12" md="7">
                            <MudPaper Class="pa-4" Outlined="true">
                                <MudText Typo="Typo.h6" Class="mb-3">Plinko Board & Win Settings</MudText>
                                <MudStack Spacing="3">
                                    <MudSelect T="string" Label="Active Theme" Variant="Variant.Outlined"
                                               @bind-Value="_settings.Plinko.ActiveThemeId">
                                        @foreach (var theme in _settings.Themes)
                                        {
                                            <MudSelectItem Value="@theme.Id">@theme.Name @(theme.IsStock ? "(Seasonal Stock)" : "(Custom)")</MudSelectItem>
                                        }
                                    </MudSelect>

                                    <MudGrid>
                                        <MudItem xs="12" sm="6">
                                            <MudNumericField T="int" Label="Peg Rows (5 - 14)" Variant="Variant.Outlined"
                                                             Min="5" Max="14"
                                                             @bind-Value="_settings.Plinko.RowCount" />
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudNumericField T="int" Label="Peg Transparency Level (0 - 100%)" Variant="Variant.Outlined"
                                                             Min="0" Max="100" Step="5"
                                                             HelperText="100% = total visible, 0% = invisible (default 15%)."
                                                             @bind-Value="_settings.Plinko.PegTransparency" />
                                        </MudItem>
                                    </MudGrid>

                                    <MudGrid>
                                        <MudItem xs="12" sm="4">
                                            <MudNumericField T="double" Label="Gravity (0.1 - 10.0)" Variant="Variant.Outlined"
                                                             Min="0.1" Max="10.0" Step="0.1"
                                                             @bind-Value="_settings.Plinko.Gravity"
                                                             HelperText="1.0 = Standard fall speed (higher = faster)" />
                                        </MudItem>
                                        <MudItem xs="12" sm="4">
                                            <MudNumericField T="double" Label="Bounciness (0.1 - 5.0)" Variant="Variant.Outlined"
                                                             Min="0.1" Max="5.0" Step="0.05"
                                                             @bind-Value="_settings.Plinko.Bounciness"
                                                             HelperText="Peg bounce height & token collision elasticity" />
                                        </MudItem>
                                        <MudItem xs="12" sm="4">
                                            <MudNumericField T="double" Label="Mass (0.1 - 10.0)" Variant="Variant.Outlined"
                                                             Min="0.1" Max="10.0" Step="0.1"
                                                             @bind-Value="_settings.Plinko.Mass"
                                                             HelperText="Token weight during mid-air collisions" />
                                        </MudItem>
                                    </MudGrid>

                                    <MudSelect T="string" Label="Direct Win Action (Optional)" Variant="Variant.Outlined"
                                               Clearable="true"
                                               @bind-Value="_settings.Plinko.WinActionName"
                                               HelperText="Action executed when a token lands in a winning bucket. Variables: %User%, %Score%, %BucketLabel%, %BucketIndex%, %Theme%.">
                                        <MudSelectItem Value="@("")">None (Use Default Command Triggers Only)</MudSelectItem>
                                        @foreach (var actName in _actionNames)
                                        {
                                            <MudSelectItem Value="@actName">@actName</MudSelectItem>
                                        }
                                    </MudSelect>

                                    <MudSwitch T="bool" Color="Color.Success"
                                               @bind-Value="_settings.Plinko.AnnounceWinsInChat"
                                               Label="Send Chat Message on Winning Bucket" />

                                    @if (_settings.Plinko.AnnounceWinsInChat)
                                    {
                                        <MudTextField T="string" Label="Win Chat Message Template" Variant="Variant.Outlined"
                                                      @bind-Value="_settings.Plinko.WinChatMessageTemplate"
                                                      HelperText="Placeholders: {user}, {score}, {bucket}" />
                                    }
                                </MudStack>
                            </MudPaper>

                            <MudPaper Class="pa-4 mt-4" Outlined="true">
                                <MudText Typo="Typo.h6" Class="mb-3">Timed Session / Round Mode</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                                    Run timed Plinko rounds (e.g., 100 seconds). Controls when viewers can participate and how rounds start/stop.
                                </MudText>

                                <MudStack Spacing="3">
                                    <MudSwitch T="bool" Color="Color.Primary"
                                               @bind-Value="_settings.Plinko.SessionModeEnabled"
                                               Label="Enable Timed Session Mode (When disabled, drops run anytime in free-play mode)" />

                                    @if (_settings.Plinko.SessionModeEnabled)
                                    {
                                        <div>
                                            <MudSwitch T="bool" Color="Color.Secondary"
                                                       @bind-Value="_settings.Plinko.AutoStartOnCommand"
                                                       Label="Auto-start Round on Command (Starts round automatically when someone types !plinko)" />
                                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block ml-3">
                                                When off, rounds can only be started/stopped via SubActions, mod commands (!plinko start [seconds]), or the button below.
                                            </MudText>
                                        </div>

                                        <MudGrid>
                                            <MudItem xs="12" sm="6">
                                                <MudNumericField T="int" Label="Default Round Duration (Seconds)" Variant="Variant.Outlined"
                                                                 Min="10" Max="600" Step="5"
                                                                 @bind-Value="_settings.Plinko.DefaultSessionDurationSeconds"
                                                                 HelperText="e.g. 100 seconds" />
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                <MudNumericField T="int" Label="Max Drops Per User Per Round" Variant="Variant.Outlined"
                                                                 Min="0" Max="50"
                                                                 @bind-Value="_settings.Plinko.MaxDropsPerUserPerSession"
                                                                 HelperText="0 = Unlimited drops during the round" />
                                            </MudItem>
                                        </MudGrid>

                                        <MudSwitch T="bool" Color="Color.Info"
                                                   @bind-Value="_settings.Plinko.AnnounceSessionStatusInChat"
                                                   Label="Announce Round Start & End in Chat" />

                                        @if (_settings.Plinko.AnnounceSessionStatusInChat)
                                        {
                                            <MudTextField T="string" Label="Round Start Chat Message" Variant="Variant.Outlined"
                                                          @bind-Value="_settings.Plinko.SessionStartChatMessageTemplate"
                                                          HelperText="Placeholders: {duration}" />
                                            <MudTextField T="string" Label="Round End Chat Message" Variant="Variant.Outlined"
                                                          @bind-Value="_settings.Plinko.SessionEndChatMessageTemplate"
                                                          HelperText="Placeholders: {count}, {duration}" />
                                        }
                                    }
                                </MudStack>
                            </MudPaper>

                            <MudPaper Class="pa-4 mt-4" Outlined="true">
                                <MudText Typo="Typo.h6" Class="mb-3">Overlay Header & Display Settings</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                                    Configure the appearance, position, and visibility of the round timer, token counters, and free-play pills.
                                </MudText>
                                <MudStack Spacing="3">
                                    <MudSwitch T="bool" Color="Color.Primary"
                                               @bind-Value="_settings.Plinko.ShowHeaderBanner"
                                               Label="Show Overlay Header Banner (Master display toggle for round banner)" />

                                    <MudSwitch T="bool" Color="Color.Secondary"
                                               @bind-Value="_settings.Plinko.AutoAvoidOverlap"
                                               Label="Auto-Avoid Overlap with Parachute (Automatically stacks headers vertically when both games run simultaneously)" />

                                    <MudGrid>
                                        <MudItem xs="12" sm="4">
                                            <MudSelect T="string" Label="Header Position" Variant="Variant.Outlined"
                                                       @bind-Value="_settings.Plinko.HeaderPosition">
                                                <MudSelectItem Value="@("TopCenter")">Top Center (Default)</MudSelectItem>
                                                <MudSelectItem Value="@("TopLeft")">Top Left</MudSelectItem>
                                                <MudSelectItem Value="@("TopRight")">Top Right</MudSelectItem>
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="12" sm="4">
                                            <MudNumericField T="int" Label="Vertical Y Offset (Pixels)" Variant="Variant.Outlined"
                                                             Min="0" Max="500" Step="2"
                                                             @bind-Value="_settings.Plinko.HeaderCustomYOffset"
                                                             HelperText="Default: 18 px" />
                                        </MudItem>
                                        <MudItem xs="12" sm="4">
                                            <MudNumericField T="int" Label="Name Font Size (Pixels)" Variant="Variant.Outlined"
                                                             Min="12" Max="36" Step="1"
                                                             @bind-Value="_settings.Plinko.NameFontSize"
                                                             HelperText="Default: 18 px (12 - 36 px)" />
                                        </MudItem>
                                    </MudGrid>

                                    <MudDivider Class="my-2" />
                                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">Component Visibility</MudText>

                                    <MudSwitch T="bool" Color="Color.Info"
                                               @bind-Value="_settings.Plinko.ShowTimer"
                                               Label="Show Round Countdown Timer (Round Ends: mm:ss)" />

                                    <MudSwitch T="bool" Color="Color.Info"
                                               @bind-Value="_settings.Plinko.ShowTokenCount"
                                               Label="Show Tokens Counter (Tokens: N)" />

                                    <MudSwitch T="bool" Color="Color.Info"
                                               @bind-Value="_settings.Plinko.ShowFreePlayCounter"
                                               Label="Show Free-Play Counter Pill (during non-session drops)" />
                                </MudStack>
                            </MudPaper>

                            <MudPaper Class="pa-4 mt-4" Outlined="true">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                                    <MudText Typo="Typo.h6">Prize Buckets (@_settings.Plinko.Buckets.Count)</MudText>
                                    <MudStack Row="true" Spacing="2">
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="ResetPlinkoBuckets">
                                            Reset Default Buckets
                                        </MudButton>
                                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                                   StartIcon="@Icons.Material.Filled.Add" OnClick="AddPlinkoBucket">
                                            Add Bucket
                                        </MudButton>
                                    </MudStack>
                                </MudStack>

                                @{
                                    var totalWeight = Math.Max(1, _settings.Plinko.Buckets.Sum(b => Math.Max(1, b.Weight)));
                                }
                                <MudStack Spacing="2">
                                    @for (var i = 0; i < _settings.Plinko.Buckets.Count; i++)
                                    {
                                        var idx = i;
                                        var bucket = _settings.Plinko.Buckets[idx];
                                        var pct = (Math.Max(1, bucket.Weight) * 100.0 / totalWeight).ToString("F1");
                                        <MudPaper @key="bucket" Class="pa-3" Outlined="true">
                                            <MudGrid Spacing="2">
                                                <MudItem xs="12" sm="3">
                                                    <MudTextField T="string" Label="Bucket Label" Margin="Margin.Dense" Variant="Variant.Outlined"
                                                                  @bind-Value="bucket.Label" />
                                                </MudItem>
                                                <MudItem xs="6" sm="2">
                                                    <MudNumericField T="int" Label="Score" Margin="Margin.Dense" Variant="Variant.Outlined"
                                                                     @bind-Value="bucket.Score" />
                                                </MudItem>
                                                <MudItem xs="6" sm="2">
                                                    <MudNumericField T="int" Label="@($"Weight ({pct}%)")" Margin="Margin.Dense" Variant="Variant.Outlined"
                                                                     Min="1" Max="1000"
                                                                     @bind-Value="bucket.Weight" />
                                                </MudItem>
                                                <MudItem xs="6" sm="2">
                                                    <MudTextField T="string" Label="Color" Margin="Margin.Dense" Variant="Variant.Outlined"
                                                                  @bind-Value="bucket.Color" />
                                                </MudItem>
                                                <MudItem xs="4" sm="2">
                                                    <MudSwitch T="bool" Color="Color.Success"
                                                               Value="bucket.IsWin"
                                                               ValueChanged="@((bool val) => OnBucketWinToggled(bucket, val))"
                                                               Label="Win" />
                                                </MudItem>
                                                <MudItem xs="2" sm="1">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                                                   Disabled="@(_settings.Plinko.Buckets.Count <= 2)"
                                                                   OnClick="@(() => _settings.Plinko.Buckets.RemoveAt(idx))" />
                                                </MudItem>
                                            </MudGrid>
                                        </MudPaper>
                                    }
                                </MudStack>
                            </MudPaper>

                            <MudPaper Class="pa-4 mt-4" Outlined="true">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                                    <div>
                                        <MudText Typo="Typo.h6">Plinko Audio & Sound Effects</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Configure optional sounds for round events, drops, peg collisions, and winning buckets.</MudText>
                                    </div>
                                </MudStack>
                                <MudStack Spacing="2">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-2">
                                        <MudText Typo="Typo.caption" Style="min-width: 170px;">
                                            Max Concurrent Sounds: <b>@(_settings.Plinko.MaxConcurrentSounds)</b>
                                        </MudText>
                                        <div style="flex: 1 1 auto;">
                                            <MudSlider T="int"
                                                       Min="1" Max="5" Step="1" ValueLabel="true"
                                                       @bind-Value="_settings.Plinko.MaxConcurrentSounds"
                                                       Color="Color.Primary" />
                                        </div>
                                    </MudStack>

                                    <DropGameSoundEditor Title="Round Start Sound"
                                                         HelperText="Plays immediately when a Plinko round begins"
                                                         SoundConfig="_settings.Plinko.StartSound" />

                                    <DropGameSoundEditor Title="Round End Sound"
                                                         HelperText="Plays immediately when a Plinko round finishes"
                                                         SoundConfig="_settings.Plinko.EndSound" />

                                    <DropGameSoundEditor Title="Token Drop Sound"
                                                         HelperText="Plays when a viewer drops a Plinko token into the board"
                                                         SoundConfig="_settings.Plinko.DropSound" />

                                    <DropGameSoundEditor Title="Winning Bucket Sound"
                                                         HelperText="Plays when a token lands into any winning bucket"
                                                         SoundConfig="_settings.Plinko.WinSound" />

                                    <DropGameSoundEditor Title="Peg Collision Bounce Sound"
                                                         HelperText="Plays when a Plinko token bounces off a board peg"
                                                         SoundConfig="_settings.Plinko.PegCollisionSound" />
                                </MudStack>
                            </MudPaper>
                        </MudItem>

                        <MudItem xs="12" md="5">
                            <MudPaper Class="pa-4" Outlined="true">
                                <MudText Typo="Typo.h6" Class="mb-3">Test Plinko Bounce Live</MudText>
                                <MudStack Spacing="3">
                                    <MudTextField T="string" Label="Test Player Name" Variant="Variant.Outlined"
                                                  @bind-Value="_testUsername" />
                                    <MudTextField T="string" Label="Test Emote Code or Image URL (Optional)" Variant="Variant.Outlined"
                                                  @bind-Value="_testEmoteInput" />

                                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" FullWidth="true"
                                               StartIcon="@Icons.Material.Filled.Apps"
                                               OnClick="TestPlinkoDropAsync">
                                        Launch Test Plinko Token (Weighted Random)
                                    </MudButton>

                                    <MudButton Variant="Variant.Outlined" Color="Color.Success" FullWidth="true"
                                               StartIcon="@Icons.Material.Filled.EmojiEvents"
                                               OnClick="TestPlinkoJackpotAsync">
                                        Launch Guaranteed Winning Bucket Token
                                    </MudButton>

                                    <MudDivider Class="my-2" />
                                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">Session Controls</MudText>
                                    <MudStack Row="true" Spacing="2">
                                        <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true"
                                                   StartIcon="@Icons.Material.Filled.PlayArrow"
                                                   OnClick="StartPlinkoSessionLiveAsync">
                                            Start Round (@(_settings.Plinko.DefaultSessionDurationSeconds)s)
                                        </MudButton>
                                        <MudButton Variant="Variant.Outlined" Color="Color.Error" FullWidth="true"
                                                   StartIcon="@Icons.Material.Filled.Stop"
                                                   OnClick="StopPlinkoSessionLiveAsync">
                                            Stop Round
                                        </MudButton>
                                    </MudStack>
                                </MudStack>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                <!-- ================= TAB 5: SEASONAL & CUSTOM THEMES ================= -->
                <MudTabPanel Text="Themes & Seasons (6 Stock + Custom)">
                    <MudGrid Spacing="4">
                        <MudItem xs="12" md="4">
                            <MudPaper Class="pa-4" Outlined="true">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                                    <MudText Typo="Typo.h6">Themes</MudText>
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Add" OnClick="CreateCustomTheme">
                                        New Theme
                                    </MudButton>
                                </MudStack>

                                <MudList T="DropGameTheme" SelectedValue="_selectedTheme" SelectedValueChanged="OnSelectedThemeChanged">
                                    @foreach (var theme in _settings.Themes)
                                    {
                                        <MudListItem Value="@theme">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                                    <span style="display:inline-block; width:16px; height:16px; border-radius:50%; background:@theme.PrimaryColor; border:2px solid @theme.SecondaryColor;"></span>
                                                    <MudText>@theme.Name</MudText>
                                                </MudStack>
                                                @if (theme.IsStock)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">Stock</MudChip>
                                                }
                                            </MudStack>
                                        </MudListItem>
                                    }
                                </MudList>

                                <MudDivider Class="my-3" />
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" FullWidth="true"
                                           OnClick="ResetStockSeasonalThemes">
                                    Restore Default Stock Themes
                                </MudButton>
                            </MudPaper>
                        </MudItem>

                        <MudItem xs="12" md="8">
                            @if (_selectedTheme != null)
                            {
                                <MudPaper Class="pa-4" Outlined="true">
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                                        <MudText Typo="Typo.h6">Editing Theme: @_selectedTheme.Name (@_selectedTheme.Id)</MudText>
                                        @if (!_selectedTheme.IsStock)
                                        {
                                            <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined"
                                                       StartIcon="@Icons.Material.Filled.Delete"
                                                       OnClick="DeleteSelectedCustomTheme">
                                                Delete Theme
                                            </MudButton>
                                        }
                                    </MudStack>

                                    <MudGrid Spacing="3">
                                        <MudItem xs="12" sm="6">
                                            <MudTextField T="string" Label="Theme Display Name" Variant="Variant.Outlined"
                                                          @bind-Value="_selectedTheme.Name" />
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudSelect T="string" Label="Seasonal Style" Variant="Variant.Outlined"
                                                       @bind-Value="_selectedTheme.SeasonPreset">
                                                <MudSelectItem Value="@("spring")">Spring (Cherry Blossoms)</MudSelectItem>
                                                <MudSelectItem Value="@("summer")">Summer (Tropical Pool Party)</MudSelectItem>
                                                <MudSelectItem Value="@("fall")">Fall (Autumn Leaf Pile)</MudSelectItem>
                                                <MudSelectItem Value="@("winter")">Winter (Snowy Frost)</MudSelectItem>
                                                <MudSelectItem Value="@("halloween")">Halloween (Spooky Cauldron)</MudSelectItem>
                                                <MudSelectItem Value="@("christmas")">Christmas (Holiday Celebration)</MudSelectItem>
                                            </MudSelect>
                                        </MudItem>

                                        <MudItem xs="12">
                                            <MudPaper Outlined="true" Class="pa-3">
                                                <MudText Typo="Typo.subtitle2" Class="mb-2"><b>Seasonal Particle Systems</b></MudText>
                                                <MudGrid Spacing="2">
                                                    <MudItem xs="12" sm="6">
                                                        <MudCard Outlined="true" Class="pa-3">
                                                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                                                <MudText Typo="Typo.body2"><b>Background Ambient Particles</b></MudText>
                                                                <MudSwitch T="bool" @bind-Value="_selectedTheme.EnableBackgroundParticles" Color="Color.Primary" />
                                                            </MudStack>
                                                            @if (_selectedTheme.EnableBackgroundParticles)
                                                            {
                                                                <MudGrid Spacing="2" Class="mt-1">
                                                                    <MudItem xs="7">
                                                                        <MudSelect T="string" Label="Type" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                                                   @bind-Value="_selectedTheme.ParticleType">
                                                                            <MudSelectItem Value="@("petals")">Blossom Petals</MudSelectItem>
                                                                            <MudSelectItem Value="@("bubbles")">Beach Bubbles</MudSelectItem>
                                                                            <MudSelectItem Value="@("leaves")">Autumn Leaves</MudSelectItem>
                                                                            <MudSelectItem Value="@("snow")">Snowflakes</MudSelectItem>
                                                                            <MudSelectItem Value="@("stars")">Sparkle Stars</MudSelectItem>
                                                                            <MudSelectItem Value="@("bats")">Spooky Bats</MudSelectItem>
                                                                            <MudSelectItem Value="@("none")">None</MudSelectItem>
