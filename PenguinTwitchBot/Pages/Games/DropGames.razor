                                                                     SoundOverride="_selectedTheme.ParachuteStartSound"
                                                                     FallbackInfo="@GetSoundFallbackInfo(_settings.Parachute.StartSound)" />
                                                <DropGameSoundEditor Title="Parachute End Sound"
                                                                     IsThemeOverride="true"
                                                                     SoundOverride="_selectedTheme.ParachuteEndSound"
                                                                     FallbackInfo="@GetSoundFallbackInfo(_settings.Parachute.EndSound)" />
                                                <DropGameSoundEditor Title="Parachute Drop Sound"
                                                                     IsThemeOverride="true"
                                                                     SoundOverride="_selectedTheme.ParachuteDropSound"
                                                                     FallbackInfo="@GetSoundFallbackInfo(_settings.Parachute.DropSound)" />
                                                <DropGameSoundEditor Title="Parachute Flap / Open Sound"
                                                                     IsThemeOverride="true"
                                                                     SoundOverride="_selectedTheme.ParachuteFlapSound"
                                                                     FallbackInfo="@GetSoundFallbackInfo(_settings.Parachute.ParachuteFlapSound)" />
                                                <DropGameSoundEditor Title="Parachute Win Sound"
                                                                     IsThemeOverride="true"
                                                                     SoundOverride="_selectedTheme.ParachuteWinSound"
                                                                     FallbackInfo="@GetSoundFallbackInfo(_settings.Parachute.WinSound)" />
                                                <DropGameSoundEditor Title="Parachute Rocket Launch Sound"
                                                                     IsThemeOverride="true"
                                                                     SoundOverride="_selectedTheme.ParachuteRocketLaunchSound"
                                                                     FallbackInfo="@GetSoundFallbackInfo(_settings.Parachute.RocketLaunchSound)" />
                                                <DropGameSoundEditor Title="Parachute Rocket Detonation Sound"
                                                                     IsThemeOverride="true"
                                                                     SoundOverride="_selectedTheme.ParachuteRocketExplodeSound"
                                                                     FallbackInfo="@GetSoundFallbackInfo(_settings.Parachute.RocketExplodeSound)" />
                                                <DropGameSoundEditor Title="Parachute Pop / Sabotage Sound"
                                                                     IsThemeOverride="true"
                                                                     SoundOverride="_selectedTheme.ParachutePopSound"
                                                                     FallbackInfo="@GetSoundFallbackInfo(_settings.Parachute.ParachutePopSound)" />
                                                <DropGameSoundEditor Title="Cannonball Splash Sound (Water Landing)"
                                                                     IsThemeOverride="true"
                                                                     SoundOverride="_selectedTheme.ParachuteCannonballSound"
                                                                     FallbackInfo="@GetSoundFallbackInfo(_settings.Parachute.CannonballSound)" />
                                                <DropGameSoundEditor Title="Crash Splat Sound (Ground Landing)"
                                                                     IsThemeOverride="true"
                                                                     SoundOverride="_selectedTheme.ParachuteCrashLandSound"
                                                                     FallbackInfo="@GetSoundFallbackInfo(_settings.Parachute.CrashLandSound)" />

                                                <MudDivider Class="my-3" />

                                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mt-2 mb-2">Plinko Sounds</MudText>
                                                <DropGameSoundEditor Title="Plinko Start Sound"
                                                                     IsThemeOverride="true"
                                                                     SoundOverride="_selectedTheme.PlinkoStartSound"
                                                                     FallbackInfo="@GetSoundFallbackInfo(_settings.Plinko.StartSound)" />
                                                <DropGameSoundEditor Title="Plinko End Sound"
                                                                     IsThemeOverride="true"
                                                                     SoundOverride="_selectedTheme.PlinkoEndSound"
                                                                     FallbackInfo="@GetSoundFallbackInfo(_settings.Plinko.EndSound)" />
                                                <DropGameSoundEditor Title="Plinko Drop Sound"
                                                                     IsThemeOverride="true"
                                                                     SoundOverride="_selectedTheme.PlinkoDropSound"
                                                                     FallbackInfo="@GetSoundFallbackInfo(_settings.Plinko.DropSound)" />
                                                <DropGameSoundEditor Title="Plinko Win Sound"
                                                                     IsThemeOverride="true"
                                                                     SoundOverride="_selectedTheme.PlinkoWinSound"
                                                                     FallbackInfo="@GetSoundFallbackInfo(_settings.Plinko.WinSound)" />
                                                <DropGameSoundEditor Title="Plinko Peg Collision Sound"
                                                                     IsThemeOverride="true"
