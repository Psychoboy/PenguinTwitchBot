    private async Task StopRaceSessionLiveAsync()
    {
        var result = await RacingGameService.StopSessionAsync(triggeredBy: "Dashboard");
        if (result != null)
            Snackbar.Add("Stopped active racing session.", Severity.Warning);
        else
            Snackbar.Add("No active racing session to stop.", Severity.Info);
    }

