@page "/community/viewers"
@using PenguinTwitchBot.Database.Bot.Models.Giveaway
@using PenguinTwitchBot.Database.Bot.Models.IpLogs
@attribute [Authorize(Roles = "Streamer, Moderator")]
@inject PenguinTwitchBot.Bot.Commands.Features.IViewerFeature viewerFeature
@inject Microsoft.AspNetCore.Components.NavigationManager navigationManager
@inject PenguinTwitchBot.Bot.Admin.IIpLogFeature ipLogFeature
@inject PenguinTwitchBot.Bot.Commands.Features.IGiveawayFeature GiveawayFeature
@inject ISnackbar Snackbar

<PageTitle>@(AppConfiguration["ApplicationTitle"] ?? "Penguin Twitch Bot") - Viewers</PageTitle>

<MudContainer Class="pa-4 pa-md-6" MaxWidth="MaxWidth.ExtraLarge">
    <MudStack Spacing="4">
        <!-- Header -->
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudStack Spacing="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Large" Color="Color.Primary" />
                    <MudText Typo="Typo.h4">Viewers</MudText>
                </MudStack>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Look up viewer profiles, activity stats, chat history, and monitor shared IP accounts.
                </MudText>
            </MudStack>
            <HelpButton Topic="viewers" />
        </MudStack>

        <!-- Viewer Search Card -->
        <MudPaper Elevation="2" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-3">Find Viewer</MudText>
            <EditForm Model="@model" OnValidSubmit="Search">
                <DataAnnotationsValidator />
                <MudGrid Spacing="2" Class="align-center">
                    <MudItem xs="12" sm="8" md="6">
                        <MudTextField @bind-Value="model.Username"
                                      For="@(() => model.Username)"
                                      Label="Username"
                                      Placeholder="Enter Twitch username (min 3 characters)..."
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      Clearable="true" />
                    </MudItem>
                    <MudItem xs="12" sm="4" md="3">
                        <MudButton ButtonType="ButtonType.Submit"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Search"
                                   Disabled="_isSearching">
                            @(_isSearching ? "Searching..." : "Search")
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </EditForm>
        </MudPaper>

        <!-- Search Results Table -->
        @if (viewers != null)
        {
            <MudPaper Elevation="2" Class="pa-4">
                <MudTable Items="@viewers" Dense="true" Hover="true" FixedHeader="true" RowsPerPage="10">
                    <ToolBarContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="pa-1">
                            <MudIcon Icon="@Icons.Material.Filled.List" Color="Color.Primary" />
                            <MudText Typo="Typo.h6">Search Results</MudText>
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Class="ml-2">@viewers.Count found</MudChip>
                        </MudStack>
                    </ToolBarContent>
                    <HeaderContent>
                        <MudTh>Viewer</MudTh>
                        <MudTh>Title</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh>Last Seen</MudTh>
                        <MudTh Style="text-align: right;">Action</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Viewer">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudAvatar Color="Color.Primary" Size="Size.Small">
                                    @(string.IsNullOrWhiteSpace(context.DisplayName) ? "U" : context.DisplayName.Substring(0, 1).ToUpperInvariant())
                                </MudAvatar>
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.subtitle2">@context.DisplayName</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@@@context.Username</MudText>
                                </MudStack>
                            </MudStack>
                        </MudTd>
                        <MudTd DataLabel="Title">
                            @if (!string.IsNullOrWhiteSpace(context.Title))
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">@context.Title</MudChip>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">-</MudText>
                            }
                        </MudTd>
                        <MudTd DataLabel="Status">
                            @if (context.isSub)
                            {
                                <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.Star">Subscriber</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Color="Color.Default" Size="Size.Small">Viewer</MudChip>
                            }
                        </MudTd>
                        <MudTd DataLabel="Last Seen">
                            <ToLocal DateTime="@context.LastSeen" />
                        </MudTd>
                        <MudTd DataLabel="Action" Style="text-align: right;">
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.AccountCircle"
                                       OnClick="() => Edit(context)">
                                View Profile
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4 text-center">
                            @(_hasSearched ? "No matching viewers found. Try a different username." : "Enter a username above to search.")
                        </MudText>
                    </NoRecordsContent>
                    <PagerContent>
                        <MudTablePager />
                    </PagerContent>
                </MudTable>
            </MudPaper>
        }

        <!-- Shared IP Detection Section (Streamer / Editor only) -->
        <AuthorizeView Roles="Streamer, Editor">
            <Authorized>
                <MudPaper Elevation="2" Class="pa-4">
                    <MudStack Spacing="2">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@Icons.Material.Filled.GroupWork" Color="Color.Warning" />
                            <MudText Typo="Typo.h6">Shared IP Accounts</MudText>
                        </MudStack>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Pairs of accounts seen communicating from the same IP address. Useful for identifying alternate accounts and managing giveaway eligibility.
                        </MudText>
                    </MudStack>

                    <MudTable ServerData="LogsReload" @ref="logsTable" Dense="true" Hover="true" FixedHeader="true" RowsPerPage="10" Class="mt-3">
                        <HeaderContent>
                            <MudTh>Account 1</MudTh>
                            <MudTh>Account 2</MudTh>
                            <MudTh>Account 1 Giveaway Status</MudTh>
                            <MudTh>Account 2 Giveaway Status</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="dupeContext">
                            <MudTd DataLabel="Account 1">
                                <MudLink Href="@LinkBuilder(dupeContext.User1)" Typo="Typo.subtitle2">
                                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="mr-1" />
                                    @dupeContext.User1
                                </MudLink>
                            </MudTd>
                            <MudTd DataLabel="Account 2">
                                <MudLink Href="@LinkBuilder(dupeContext.User2)" Typo="Typo.subtitle2">
                                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="mr-1" />
                                    @dupeContext.User2
                                </MudLink>
                            </MudTd>
                            <MudTd DataLabel="Account 1 Giveaway Status">
                                @if (dupeContext.IsGiveawayExclusion1)
                                {
                                    <MudChip T="string" Color="Color.Error" Size="Size.Small" Icon="@Icons.Material.Filled.Block">Excluded</MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle">Eligible</MudChip>
                                }
                            </MudTd>
                            <MudTd DataLabel="Account 2 Giveaway Status">
                                @if (dupeContext.IsGiveawayExclusion2)
                                {
                                    <MudChip T="string" Color="Color.Error" Size="Size.Small" Icon="@Icons.Material.Filled.Block">Excluded</MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle">Eligible</MudChip>
                                }
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4 text-center">
                                No duplicate IP records found.
                            </MudText>
                        </NoRecordsContent>
                        <LoadingContent>
                            <MudStack AlignItems="AlignItems.Center" Class="pa-4">
                                <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">Loading shared IP logs...</MudText>
                            </MudStack>
                        </LoadingContent>
                        <PagerContent>
                            <MudTablePager />
                        </PagerContent>
                    </MudTable>
                </MudPaper>
            </Authorized>
        </AuthorizeView>
    </MudStack>
</MudContainer>

@code {
    private List<PenguinTwitchBot.Database.Bot.Models.Viewer>? viewers = new();
    private SearchForm model = new();
    private MudTable<DupeIps>? logsTable;
    private List<GiveawayExclusion> giveawayExclusions = new();
    private bool _isSearching;
    private bool _hasSearched;

    public class DupeIps
    {
        public string User1 { get; set; } = "";
        public string User2 { get; set; } = "";
        public string Ip { get; set; } = "";
        public int Count { get; set; }
        public bool IsGiveawayExclusion1 { get; set; } = false;
        public bool IsGiveawayExclusion2 { get; set; } = false;
    }

    protected override async Task OnInitializedAsync()
    {
        giveawayExclusions = (await GiveawayFeature.GetAllExclusions()).ToList();
    }

    public class SearchForm
    {
        [Required]
        [StringLength(25, ErrorMessage = "Search must be between 3 and 25 characters", MinimumLength = 3)]
        public string Username { get; set; } = "";
    }

    private async Task<TableData<DupeIps>> LogsReload(TableState state, CancellationToken _token)
    {
        var response = await ipLogFeature.GetAllDuplicateIps();
        var data = response.Data
            .Select(x => new DupeIps
            {
                User1 = x.User1,
                User2 = x.User2,
                IsGiveawayExclusion1 = giveawayExclusions.Any(g => g.Username.Equals(x.User1, StringComparison.OrdinalIgnoreCase)),
                IsGiveawayExclusion2 = giveawayExclusions.Any(g => g.Username.Equals(x.User2, StringComparison.OrdinalIgnoreCase)),
            })
            .ToList();

        // Only show a pair if at least one user is new - skip pairs where both users
        // already appeared in an earlier pair (redundant connections).
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        data = data.Where(x =>
        {
            var isNew = !seen.Contains(x.User1) || !seen.Contains(x.User2);
            seen.Add(x.User1);
            seen.Add(x.User2);
            return isNew;
        }).ToList();

        return new TableData<DupeIps> { TotalItems = data.Count, Items = data };
    }

    private void Edit(PenguinTwitchBot.Database.Bot.Models.Viewer item)
    {
        navigationManager.NavigateTo($"/community/viewers/edit?id={item.Id}");
    }

    private async Task Search()
    {
        if (string.IsNullOrWhiteSpace(model.Username) || model.Username.Trim().Length < 3)
        {
            Snackbar.Add("Please enter at least 3 characters to search.", Severity.Warning);
            return;
        }

        _isSearching = true;
        _hasSearched = true;
        try
        {
            viewers = await viewerFeature.SearchForViewer(model.Username.Trim());
            if (viewers == null || viewers.Count == 0)
            {
                Snackbar.Add($"No viewers found matching '{model.Username.Trim()}'.", Severity.Info);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error searching viewers: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSearching = false;
            StateHasChanged();
        }
    }

    private string LinkBuilder(string parameter)
    {
        return $"/community/viewers/edit?name={Uri.EscapeDataString(parameter)}";
    }
}