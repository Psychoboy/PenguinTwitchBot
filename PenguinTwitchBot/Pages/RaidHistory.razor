@page "/raidhistory"
@attribute [Authorize(Roles = "Streamer, Editor")]
@using PenguinTwitchBot.Bot.Commands.Misc
@using PenguinTwitchBot.Services
@inject PenguinTwitchBot.Bot.Commands.Misc.RaidTracker RaidTracker
@inject IRaidHistorySettingsService RaidHistorySettings
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>@(AppConfiguration["ApplicationTitle"] ?? "Penguin Twitch Bot") - Raid History</PageTitle>

@if (raidHistory != null)
{
<MudContainer Class="pa-2 pa-md-3" MaxWidth="MaxWidth.ExtraExtraLarge">
    <MudStack Spacing="2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.h5">Raid History</MudText>
            <HelpButton Topic="raid-history" />
            <MudSpacer />
            <MudText Typo="Typo.body2" Color="Color.Secondary">@GetFilteredContent()?.Count creator(s)</MudText>
        </MudStack>
        <MudPaper Elevation="1">
            <MudTable Items="@(GetFilteredContent())" Dense="true" Hover="true" SortLabel="Name" FixedHeader="true" Loading="@_loading">
                <ToolBarContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="pa-2" Style="width:100%" Wrap="Wrap.Wrap">
                        <MudText Typo="Typo.subtitle1">Raid Statistics</MudText>
                        <MudSpacer />
                        <MudTextField @bind-Value="_search" Placeholder="Search creator, game, or team" Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Clearable="true"
                                      Style="max-width: 260px;" />
                        <MudCheckBox @bind-Value="OnlineOnly" Label="Online only" Color="Color.Primary" Dense="true" />
                        <MudSwitch T="bool" Value="_showLiveTeamMembers" ValueChanged="OnShowLiveTeamMembersChanged"
                                   Label="Show live team members" Color="Color.Info" Disabled="@_loading" />
                        <MudMenu Label="Clean Up" StartIcon="@Icons.Material.Filled.CleaningServices"
                                 Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small" Dense="true">
                            <MudMenuItem OnClick="() => PruneHistory(30)">Inactive > 30 days</MudMenuItem>
                            <MudMenuItem OnClick="() => PruneHistory(90)">Inactive > 90 days</MudMenuItem>
                            <MudMenuItem OnClick="() => PruneHistory(180)">Inactive > 180 days</MudMenuItem>
                            <MudMenuItem OnClick="() => PruneHistory(365)">Inactive > 1 year</MudMenuItem>
                        </MudMenu>
                    </MudStack>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>
                        <MudTableSortLabel SortBy="new Func<RaidHistoryItem, object>(x => x.DisplayName)">
                            Name
                        </MudTableSortLabel>
                    </MudTh>
                    <MudTh>
                        Online
                    </MudTh>
                    <MudTh>
                        <MudTableSortLabel SortBy="new Func<RaidHistoryItem, object>(x => x.LastGame ?? string.Empty)">
                            Game
                        </MudTableSortLabel>
                    </MudTh>
                    <MudTh>
                        <MudTableSortLabel SortBy="new Func<RaidHistoryItem, object>(x => x.TotalIncomingRaids)">
                            Incoming
                        </MudTableSortLabel>
                    </MudTh>
                    <MudTh>
                        <MudTableSortLabel SortBy="new Func<RaidHistoryItem, object>(x => x.TotalIncomingRaids > 0 ? x.TotalIncomingRaidViewers / x.TotalIncomingRaids : 0)">
                            Avg In.
                        </MudTableSortLabel>
                    </MudTh>
                    <MudTh>
                        <MudTableSortLabel SortBy="new Func<RaidHistoryItem, object>(x => x.LastIncomingRaid)" InitialDirection="SortDirection.Descending">
                            Last In.
                        </MudTableSortLabel>
                    </MudTh>
                    <MudTh>
                        <MudTableSortLabel SortBy="new Func<RaidHistoryItem, object>(x => x.TotalOutgoingRaids)">
                            Outgoing
                        </MudTableSortLabel>
                    </MudTh>
                    <MudTh>
                        <MudTableSortLabel SortBy="new Func<RaidHistoryItem, object>(x => x.TotalOutgoingRaids > 0 ? x.TotalOutGoingRaidViewers / x.TotalOutgoingRaids : 0)">
                            Avg Out.
                        </MudTableSortLabel>
                    </MudTh>
                    <MudTh>
                        <MudTableSortLabel SortBy="new Func<RaidHistoryItem, object>(x => x.LastOutgoingRaid)">
                            Last Out.
                        </MudTableSortLabel>
                    </MudTh>
                    <MudTh>
                        Actions
                    </MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudLink Href=@LinkBuilder(context.Name) Target="_blank">
                                <strong>@context.DisplayName</strong>
                            </MudLink>
                            @if (context.IsStreamTeamMember)
                            {
                                <MudTooltip Text="@GetTeamTooltip(context)">
                                    <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small"
                                             Icon="@Icons.Material.Filled.Groups">Team</MudChip>
                                </MudTooltip>
                            }
                        </MudStack>
                    </MudTd>
                    <MudTd DataLabel="Online">
                        @if (context.IsOnline)
                        {
                            <MudChip T="string" Color="Color.Success" Size="Size.Small">Online</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Color="Color.Default" Size="Size.Small">Offline</MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="Game">
                        @context.LastGame
                    </MudTd>
                    <MudTd DataLabel="Incoming">
                        <strong>@context.TotalIncomingRaids</strong>
                    </MudTd>
                    <MudTd DataLabel="Avg In.">
                        @(context.TotalIncomingRaids > 0 ? (context.TotalIncomingRaidViewers / context.TotalIncomingRaids).ToString("N0") : "0")
                    </MudTd>
                    <MudTd DataLabel="Last In.">
                        @if (context.LastIncomingRaid != DateTime.MinValue)
                        {
                            <ToLocal DateTime="context.LastIncomingRaid" Format="yyyy-mm-dd" />
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </MudTd>
                    <MudTd DataLabel="Outgoing">
                        <strong>@context.TotalOutgoingRaids</strong>
                    </MudTd>
                    <MudTd DataLabel="Avg Out.">
                        @(context.TotalOutgoingRaids > 0 ? (context.TotalOutGoingRaidViewers / context.TotalOutgoingRaids).ToString("N0") : "0")
                    </MudTd>
                    <MudTd DataLabel="Last Out.">
                        @if (context.LastOutgoingRaid != DateTime.MinValue)
                        {
                            <ToLocal DateTime="context.LastOutgoingRaid" Format="yyyy-mm-dd" />
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </MudTd>
                    <MudTd DataLabel="Actions">
                        <MudStack Row="true" Spacing="1">
                            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" @onclick="() => Raid(context)">Raid</MudButton>
                            @if (context.IsHistoryEntry)
                            {
                                <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" @onclick="() => Remove(context)">Remove</MudButton>
                            }
                        </MudStack>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Info">
                        No raid history available
                    </MudAlert>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudStack>
</MudContainer>
}

@code {
    private List<RaidHistoryItem>? raidHistory;
    private bool OnlineOnly { get; set; } = true;
    private bool _showLiveTeamMembers = true;
    private bool _loading;
    private int _refreshVersion;
    private string _search = "";

    protected override async Task OnInitializedAsync()
    {
        _showLiveTeamMembers = await RaidHistorySettings.GetShowLiveTeamMembersAsync();
        await RefreshHistoryAsync();
    }

    private async Task RefreshHistoryAsync()
    {
        while (true)
        {
            var expectedShowLiveTeamMembers = _showLiveTeamMembers;
            var requestVersion = ++_refreshVersion;
            var result = await RaidTracker.GetDisplayHistoryAsync(expectedShowLiveTeamMembers);

            if (requestVersion == _refreshVersion && expectedShowLiveTeamMembers == _showLiveTeamMembers)
            {
                raidHistory = result;
                return;
            }

            if (requestVersion != _refreshVersion)
            {
                return;
            }
        }
    }

    private async Task OnShowLiveTeamMembersChanged(bool enabled)
    {
        var previousValue = _showLiveTeamMembers;
        _showLiveTeamMembers = enabled;
        _loading = true;
        try
        {
            await RaidHistorySettings.SetShowLiveTeamMembersAsync(enabled);
        }
        catch (Exception)
        {
            _showLiveTeamMembers = previousValue;
            Snackbar.Add("Failed to save stream team display setting.", Severity.Error);
            _loading = false;
            StateHasChanged();
            return;
        }

        try
        {
            await RefreshHistoryAsync();
        }
        catch (Exception)
        {
            Snackbar.Add("Failed to refresh raid history.", Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private List<RaidHistoryItem>? GetFilteredContent()
    {
        var items = raidHistory?.AsEnumerable();
        if (items == null) return null;

        if (OnlineOnly)
        {
            items = items.Where(x => x.IsOnline);
        }

        if (!string.IsNullOrWhiteSpace(_search))
        {
            items = items.Where(x =>
                (x.DisplayName != null && x.DisplayName.Contains(_search, StringComparison.OrdinalIgnoreCase)) ||
                (x.Name != null && x.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)) ||
                (x.LastGame != null && x.LastGame.Contains(_search, StringComparison.OrdinalIgnoreCase)) ||
                x.StreamTeamNames.Any(t => t.Contains(_search, StringComparison.OrdinalIgnoreCase)));
        }

        return items.ToList();
    }

    private static string GetTeamTooltip(RaidHistoryItem item)
    {
        if (item.StreamTeamNames.Count == 0)
        {
            return "Stream Team Member";
        }

        var prefix = item.StreamTeamNames.Count == 1 ? "Stream Team: " : "Stream Teams: ";
        return prefix + string.Join(", ", item.StreamTeamNames);
    }

    private async Task PruneHistory(int olderThanDays)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Clean Up Raid History",
            $"This will remove creators whose latest raid activity (the most recent incoming or outgoing raid) occurred more than {olderThanDays} days ago.\n\nAre you sure you want to proceed?",
            yesText: "Clean Up", cancelText: "Cancel");

        if (confirmed != true) return;

        try
        {
            var cutoff = DateTime.UtcNow.AddDays(-olderThanDays);
            var removed = await RaidTracker.PruneRaidHistory(cutoff);
            await RefreshHistoryAsync();
            Snackbar.Add($"Cleaned up {removed} creator(s) with no raid activity in the last {olderThanDays} days.", Severity.Info);
            StateHasChanged();
        }
        catch (Exception)
        {
            Snackbar.Add("Failed to clean up raid history.", Severity.Error);
        }
    }

    private async Task Raid(RaidHistoryItem item)
    {
        try
        {
            await RaidTracker.Raid(item.Name);
        }
        catch (Exception ex)
        {
            // Ignore raid execution errors - UI will show appropriate state
            Console.WriteLine($"Error executing raid: {ex.Message}");
        }
    }

    private async Task Remove(RaidHistoryItem item)
    {
        if (item.HistoryEntry == null) return;

        try
        {
            await RaidTracker.RemoveRaidHistory(item.HistoryEntry);
            await RefreshHistoryAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            // Ignore remove errors - UI will show appropriate state
            Console.WriteLine($"Error removing raid history: {ex.Message}");
        }
    }

    private string LinkBuilder(string _parameter)
    {
        return "https://twitch.tv/" + _parameter;
    }
}
