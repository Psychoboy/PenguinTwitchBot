@page "/songrequests"
@using PenguinTwitchBot.Models
@using PenguinTwitchBot.Bot.Commands.Music
@using PenguinTwitchBot.Bot.Hubs
@inject IInProcessHubEventBus HubEventBus
@inject YtPlayer YtPlayer
@inject ISongCooldownService SongCooldownService
@implements IAsyncDisposable
@inject ISnackbar Snackbar
@inject ILogger<SongRequests> logger

<PageTitle>@(AppConfiguration["ApplicationTitle"] ?? "Penguin Twitch Bot") - Song Requests</PageTitle>
<MudContainer Class="pa-4 pa-md-6" MaxWidth="MaxWidth.ExtraLarge">

    <MudStack Spacing="3">
        <MudText Typo="Typo.h4" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.QueueMusic" Class="mr-2" />
            Song Requests
        </MudText>

        <MudPaper Elevation="3" Class="pa-4">
            <MudStack Spacing="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.PlayCircle" Color="Color.Success" Size="Size.Large" />
                    <MudText Typo="Typo.h6" Color="Color.Success">Now Playing</MudText>
                </MudStack>
                <MudDivider />
                @if (!currentSongLoaded)
                {
                    <MudStack Spacing="2">
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="85%" Height="28px" />
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="70%" />
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="40%" />
                    </MudStack>
                }
                else if (currentSong != null)
                {
                    <MudStack Spacing="1">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.MusicNote" Size="Size.Small" />
                            <MudText Typo="Typo.subtitle1"><strong>@currentSong.Title</strong></MudText>
                        </MudStack>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Color="Color.Primary" />
                            <MudText Typo="Typo.body2">Requested by <strong>@currentSong.RequestedBy</strong></MudText>
                        </MudStack>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Small" Color="Color.Info" />
                            <MudText Typo="Typo.body2">@currentSong.Duration</MudText>
                        </MudStack>
                    </MudStack>
                    <MudDivider />
                    <AuthorizeView Roles="Streamer,Editor">
                        <Authorized>
                            <div>
                                <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small" OnClick="AddCurrentSongToCooldown" StartIcon="@Icons.Material.Filled.Timer">
                                    Add to Cooldown
                                </MudButton>
                            </div>
                        </Authorized>
                    </AuthorizeView>
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.MusicOff">
                        No song is currently playing.
                    </MudAlert>
                }
            </MudStack>
        </MudPaper>

        <MudGrid Spacing="3">
            <MudItem xs="12" sm="6">
                <PenguinTwitchBot.Pages.ViewerViews.Components.LastPlayedSongs />
            </MudItem>

            <MudItem xs="12" sm="6">
                <PenguinTwitchBot.Pages.ViewerViews.Components.SongRequests />
            </MudItem>

            <MudItem xs="12" sm="6">
                <PenguinTwitchBot.Pages.ViewerViews.Components.TopRequestedSongs />
            </MudItem>
        </MudGrid>
    </MudStack>
</MudContainer>


@code {
    private Song? currentSong;
    private IDisposable? _hubSubscription;
    private bool currentSongLoaded;

    protected override void OnInitialized()
    {
        currentSong = YtPlayer.GetCurrentSong();
        currentSongLoaded = currentSong != null;
    }

    private async Task AddCurrentSongToCooldown()
    {
        if (currentSong == null) return;
        var settings = await SongCooldownService.GetSettingsAsync();
        await SongCooldownService.AddCooldownAsync(currentSong.SongId, currentSong.Title, TimeSpan.FromMinutes(settings.CooldownMinutes), "Now Playing UI");
        Snackbar.Add($"Added '{currentSong.Title}' to song cooldown ({settings.CooldownMinutes} min).", Severity.Success);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender == false) return;

        _hubSubscription = HubEventBus.On<Song?>(HubNames.YtHub, "CurrentSongUpdate", (song) =>
        {
            currentSong = song;
            currentSongLoaded = true;
            _ = InvokeAsync(StateHasChanged);
        });

        currentSong = YtPlayer.GetCurrentSong();
        currentSongLoaded = true;
        StateHasChanged();
    }

    public ValueTask DisposeAsync()
    {
        _hubSubscription?.Dispose();
        _hubSubscription = null;
        return ValueTask.CompletedTask;
    }
}
