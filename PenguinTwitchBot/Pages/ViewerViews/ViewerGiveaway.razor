@page "/giveaway"

@using PenguinTwitchBot.Bot.Features
@using PenguinTwitchBot.Bot.Hubs
@using PenguinTwitchBot.Pages.ViewerViews.Components
@using PenguinTwitchBot.Helpers
@using PenguinTwitchBot.Database.Bot.Models.Giveaway
@using System.ComponentModel.DataAnnotations
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject PenguinTwitchBot.Bot.Commands.Features.IGiveawayFeature GiveawayFeature;
@inject PenguinTwitchBot.Bot.Core.Points.IPointsSystem PointSystem;
@inject PenguinTwitchBot.Bot.Core.Points.ITwitchEventsBonus twitchEventsBonus
@inject NavigationManager Navigation
@inject IInProcessHubEventBus HubEventBus
@inject ISnackbar Snackbar
@inject ILogger<ViewerGiveaway> logger
@inject PenguinTwitchBot.Bot.Core.IServiceBackbone ServiceBackbone
@inject IFeatureRuntimeCoordinator FeatureRuntimeCoordinator
@implements IAsyncDisposable

<PageTitle>@(AppConfiguration["ApplicationTitle"] ?? "Penguin Twitch Bot") - Giveaway</PageTitle>

<style> 
    .stat-card {
        transition: transform 0.2s ease-in-out;
    }

    .stat-card:hover {
        transform: translateY(-4px);
    }
</style>
<FeatureGate FeatureKey="@FeatureKeys.GiveawayFeature">
    <ChildContent>
<MudContainer Class="pa-4 pa-md-6" MaxWidth="MaxWidth.ExtraLarge">
    <MudGrid Spacing="3">
        <MudItem xs="12" sm="6">
            <MudStack Spacing="3">
                <BonusTickets/>
                <MudGrid Spacing="2">
                    <MudItem xs="6">
                        <MudPaper Class="pa-3 stat-card" Elevation="2" Style="height:100%">
                            <MudStack AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Info" Size="Size.Medium" />
                                <MudText Typo="Typo.h4" Color="Color.Info">@entrants</MudText>
                                <MudText Typo="Typo.caption" Align="Align.Center">Participants</MudText>
                            </MudStack>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="6">
                        <MudPaper Class="pa-3 stat-card" Elevation="2" Style="height:100%">
                            <MudStack AlignItems="AlignItems.Center" Spacing="1">
                                <MudIcon Icon="@Icons.Material.Filled.ConfirmationNumber" Color="Color.Success" Size="Size.Medium" />
                                <MudText Typo="Typo.h4" Color="Color.Success">@entries</MudText>
                                <MudText Typo="Typo.caption" Align="Align.Center">Total @pointTypeName Entered</MudText>
                            </MudStack>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
                @if (lastLiveUpdate is DateTimeOffset lastUpdated || snapshotRefreshFailed)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="1">
                        @if (snapshotRefreshFailed)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Color="Color.Warning" Size="Size.Small" />
                            <MudText Typo="Typo.caption" Color="Color.Warning">Live data refresh failed</MudText>
                        }
                        @if (lastLiveUpdate is DateTimeOffset updatedAt)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Updated <ToLocal DateTime="@updatedAt.UtcDateTime" Format="shortTime" />
                            </MudText>
                        }
                    </MudStack>
                }
                @if (liveConnectionAttempted && !isLiveConnected)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="1">
                        <MudIcon Icon="@LiveStatusIcon" Color="@LiveStatusColor" Size="Size.Small" />
                        <MudText Typo="Typo.caption" Color="@LiveStatusColor">@LiveStatusText</MudText>
                    </MudStack>
                }
            <AuthorizeView>
                <Authorized Context="Auth">
                    <GiveawayEntryPanel PointTypeName="@pointTypeName" BroadcasterName="@ServiceBackbone.BroadcasterName" />
                </Authorized>
                <NotAuthorized>
                    <MudPaper Class="pa-5" Elevation="3">
                        <MudStack Spacing="3" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Size="Size.Large" Color="Color.Info" />
                            <MudText Typo="Typo.h6" Align="Align.Center">Sign in to participate</MudText>
                                <MudButton OnClick="Signin"
                                       Variant="Variant.Filled" 
                                       Color="Color.Primary" 
                                       Size="Size.Large"
                                       StartIcon="@Icons.Material.Filled.Login"
                                       FullWidth="true">
                                Sign In with Twitch
                            </MudButton>
                            <MudDivider />
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.body2" Align="Align.Center">
                                    <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Color="Color.Warning" />
                                    <MudLink Href="@($"https://twitch.tv/subs/{ServiceBackbone.BroadcasterName}")" Target="_blank" Color="Color.Primary">
                                        Subscribe to earn more @pointTypeName
                                    </MudLink>
                                </MudText>
                                <MudText Typo="Typo.body2" Align="Align.Center">
                                    <MudIcon Icon="@Icons.Material.Filled.Help" Size="Size.Small" Color="Color.Info" />
                                    <MudLink Href="/giveaway#howtoearn" Color="Color.Primary">
                                        How to earn @pointTypeName
                                    </MudLink>
                                </MudText>
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                </NotAuthorized>
            </AuthorizeView>
            </MudStack>

        </MudItem>
        <MudItem xs="12" sm="6">
            <MudPaper Class="pa-6" Elevation="3">
                <MudStack AlignItems="AlignItems.Center" Spacing="3">
                    <MudStack AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.CardGiftcard" Size="Size.Large" Color="Color.Primary" />
                        <MudText Typo="Typo.h4" Align="Align.Center">Current Giveaway</MudText>
                    </MudStack>
                    <MudDivider />
                    @if (!giveawayDataLoaded)
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="60%" Height="40px" />
                    }
                    else if (string.IsNullOrWhiteSpace(prize))
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Text" Icon="@Icons.Material.Filled.CardGiftcard">
                            No giveaway prize is currently listed.
                        </MudAlert>
                    }
                    else
                    {
                        <MudText Typo="Typo.h5" Align="Align.Center"><strong>@prize</strong></MudText>
                    }
                    @if (!giveawayDataLoaded)
                    {
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="300px" Class="rounded" />
                    }
                    else if (!string.IsNullOrWhiteSpace(prize))
                    {
                        @if (!string.IsNullOrWhiteSpace(imageUrl))
                        {
                            <MudImage Fluid="true" Class="rounded-lg" Src="@imageUrl" Elevation="2" />
                        }
                        else
                        {
                            <MudPaper Class="pa-4" Outlined="true" Style="width: 100%; min-height: 120px;">
                                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="1">
                                    <MudIcon Icon="@Icons.Material.Filled.ImageNotSupported" Color="Color.Default" />
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">No image for this prize</MudText>
                                </MudStack>
                            </MudPaper>
                        }
                    }
                    @if(!string.IsNullOrEmpty(prizeAdditionalDetails))
                    {
                        <MudPaper Class="pa-3" Elevation="0" Style="background-color: rgba(255,255,255,0.05);">
                            <GitHubMarkdownViewer Value="@prizeAdditionalDetails" />
                        </MudPaper>
                    }
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12">
            <Bookmark BookmarkName="howtoearn">
                <MudPaper Class="pa-5 mb-3" Elevation="3" id="howtoearn">
                    <MudStack Spacing="3">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Success" Size="Size.Large" />
                            <MudText Typo="Typo.h5">How to Earn @pointTypeName</MudText>
                        </MudStack>
                        @if(FeatureRuntimeCoordinator.IsEnabled(FeatureKeys.TwitchEventsBonus))
                        {
                            <MudDivider />
                            <MudText Typo="Typo.h6" Color="Color.Primary">Instant Rewards</MudText>
                            <MudStack Spacing="2">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudIcon Icon="@Icons.Material.Filled.Subscriptions" Color="Color.Secondary" />
                                    <MudText><strong>@TicketsPerSub @pointTypeName</strong> for every subscription</MudText>
                                </MudStack>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudIcon Icon="@Icons.Material.Filled.CardGiftcard" Color="Color.Secondary" />
                                    <MudText><strong>@TicketsPerSub @pointTypeName</strong> for every gifted sub</MudText>
                                </MudStack>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudIcon Icon="@Icons.Material.Filled.Diamond" Color="Color.Secondary" />
                                    <MudText><strong>@((int)@BitsPerPoint) @pointTypeName</strong> per 100 bits cheered</MudText>
                                </MudStack>
                            </MudStack>
                        }

                        @if (!string.IsNullOrWhiteSpace(passiveEarnings))
                        {
                            <MudText Typo="Typo.h6" Color="Color.Primary" Class="mt-2">Passive Earnings</MudText>
                            <GitHubMarkdownViewer Value="@passiveEarnings" />
                        }
                    </MudStack>
                </MudPaper>
            </Bookmark>
            @if (!string.IsNullOrWhiteSpace(rules) || !string.IsNullOrWhiteSpace(cooldowns))
            {
            <MudPaper Class="pa-5 mb-3" Elevation="3">
                <MudStack Spacing="3">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Gavel" Color="Color.Warning" Size="Size.Large" />
                        <MudText Typo="Typo.h5">Giveaway Rules</MudText>
                    </MudStack>
                    <MudDivider />
                    @if (!string.IsNullOrWhiteSpace(rules))
                    {
                        <GitHubMarkdownViewer Value="@rules" />
                    }
                    @if (!string.IsNullOrWhiteSpace(cooldowns))
                    {
                        <MudText Typo="Typo.h6" Color="Color.Primary" Class="mt-2">Prize Tiers &amp; Cooldowns</MudText>
                        <GitHubMarkdownViewer Value="@cooldowns" />
                    }
                </MudStack>
            </MudPaper>
            }
            @if (!string.IsNullOrWhiteSpace(terms))
            {
            <MudPaper Class="pa-5 mb-3" Elevation="3">
                <MudStack Spacing="3">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Info" Size="Size.Large" />
                        <MudText Typo="Typo.h5">Terms &amp; Conditions</MudText>
                    </MudStack>
                    <MudDivider />
                    <GitHubMarkdownViewer Value="@terms" />
                </MudStack>
            </MudPaper>
            }
        </MudItem>
    </MudGrid>

</MudContainer>
</ChildContent>
<DisabledContent>
        <MudContainer Class="pa-4 pa-md-6" MaxWidth="MaxWidth.Medium">
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.PowerOff">
                Giveaways are currently disabled by the streamer.
            </MudAlert>
        </MudContainer>
    </DisabledContent>
</FeatureGate>

@code {
    private readonly List<IDisposable> _hubSubscriptions = [];
    private List<GiveawayWinner> winners = new List<GiveawayWinner>();
    private string prize = "";
    private string? imageUrl;
    private string prizeAdditionalDetails = "";
    private bool giveawayDataLoaded;
    private bool isLiveConnected;
    private bool liveConnectionAttempted;
    private bool snapshotRefreshFailed;
    private DateTimeOffset? lastLiveUpdate;
    private int entries;
    private int entrants;
    private int TicketsPerSub;
    private double BitsPerPoint;
    private string passiveEarnings = "";

    private string pointTypeName = "Tickets";
    private string rules = "";
    private string cooldowns = "";
    private string terms = "";
    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        FeatureRuntimeCoordinator.StateChangedAsync += HandleFeatureStateChangedAsync;

        var pointType = await PointSystem.GetPointTypeForGame("GiveawayFeature");
        pointTypeName = pointType?.Name ?? "Tickets";
        var pointsPerEntry = await GiveawayFeature.GetPointsPerEntry();

        prize = await GiveawayFeature.GetPrize();
        imageUrl = await GiveawayFeature.GetImageUrl();
        prizeAdditionalDetails = (await GiveawayFeature.GetPrizeAdditionalDetails()).Trim();
        entries = await GiveawayFeature.GetEntriesCount();
        entrants = await GiveawayFeature.GetEntrantsCount();
        TicketsPerSub = await twitchEventsBonus.GetPointsPerSub();
        BitsPerPoint = await twitchEventsBonus.GetBitsPerPoint();
        var rawPassiveEarnings = await GiveawayFeature.GetPassiveEarnings();
        passiveEarnings = PenguinTwitchBot.Bot.Core.Points.PassivePointsTemplateReplacer.ReplaceVariables(rawPassiveEarnings, pointType, pointsPerEntry);
        rules = await GiveawayFeature.GetRules();
        cooldowns = await GiveawayFeature.GetCooldowns();
        terms = await GiveawayFeature.GetTerms();
        if (BitsPerPoint > 0) BitsPerPoint = 100 * BitsPerPoint;
        giveawayDataLoaded = true;
        lastLiveUpdate = DateTimeOffset.UtcNow;
    }

    private string LiveStatusText => !liveConnectionAttempted
        ? "Connecting to live updates"
        : isLiveConnected
            ? "Live updates connected"
            : "Live updates unavailable";

    private string LiveStatusIcon => isLiveConnected
        ? Icons.Material.Filled.Wifi
        : Icons.Material.Filled.WifiOff;

    private Color LiveStatusColor => isLiveConnected
        ? Color.Success
        : Color.Secondary;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender == false) return;

        if (EnsureHubSubscriptions())
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool EnsureHubSubscriptions()
    {
        if (_disposed || FeatureRuntimeCoordinator.IsEnabled(FeatureKeys.GiveawayFeature) == false)
        {
            return false;
        }

        if (_hubSubscriptions.Count > 0)
        {
            return false;
        }

        _hubSubscriptions.Add(HubEventBus.On<List<GiveawayWinner>>(HubNames.MainHub, "Winners", (Winners) =>
        {
            winners = Winners;
        }));
        _hubSubscriptions.Add(HubEventBus.On<string>(HubNames.MainHub, "Prize", async (updatedPrize) =>
        {
            if (_disposed) return;
            var updatedImageUrl = await GiveawayFeature.GetImageUrl();
            await InvokeAsync(() =>
            {
                if (_disposed) return;
                prize = updatedPrize;
                imageUrl = updatedImageUrl;
                MarkLiveDataUpdated();
            });
        }));
        _hubSubscriptions.Add(HubEventBus.On<string>(HubNames.MainHub, "PrizeAdditionalDetails", (PrizeAdditionalDetails) =>
        {
            if (_disposed) return;
            _ = InvokeAsync(() =>
            {
                if (_disposed) return;
                prizeAdditionalDetails = PrizeAdditionalDetails.Trim();
                MarkLiveDataUpdated();
            });
        }));
        _hubSubscriptions.Add(HubEventBus.On<int, int>(HubNames.MainHub, "UpdateTickets", (curEntries, curEntrants) =>
        {
            if (_disposed) return;
            _ = InvokeAsync(() =>
            {
                if (_disposed) return;
                entries = curEntries;
                entrants = curEntrants;
                MarkLiveDataUpdated();
            });
        }));

        isLiveConnected = true;
        liveConnectionAttempted = true;
        return true;
    }

    private void MarkLiveDataUpdated()
    {
        if (_disposed) return;

        lastLiveUpdate = DateTimeOffset.UtcNow;
        snapshotRefreshFailed = false;
        StateHasChanged();
    }

    private async Task RefreshLiveDataAsync()
    {
        try
        {
            var refreshedPrize = await GiveawayFeature.GetPrize();
            var refreshedImageUrl = await GiveawayFeature.GetImageUrl();
            var refreshedDetails = (await GiveawayFeature.GetPrizeAdditionalDetails()).Trim();
            var refreshedEntries = await GiveawayFeature.GetEntriesCount();
            var refreshedEntrants = await GiveawayFeature.GetEntrantsCount();

            if (_disposed) return;

            prize = refreshedPrize;
            imageUrl = refreshedImageUrl;
            prizeAdditionalDetails = refreshedDetails;
            entries = refreshedEntries;
            entrants = refreshedEntrants;
            lastLiveUpdate = DateTimeOffset.UtcNow;
            snapshotRefreshFailed = false;
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            logger.LogWarning(ex, "Failed to refresh giveaway data after SignalR reconnect");
            snapshotRefreshFailed = true;
        }
    }

    private static MarkupString RenderMultiline(string textWithLineBreaks)
    {
        var encodedLines = (textWithLineBreaks ?? string.Empty)
            .Split(new char[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(line => System.Web.HttpUtility.HtmlEncode(line))
            .ToArray();
        return (MarkupString)string.Join("<br />", encodedLines);
    }

    private Task HandleFeatureStateChangedAsync()
    {
        if (_disposed)
        {
            return Task.CompletedTask;
        }

        return InvokeAsync(() =>
        {
            if (_disposed)
            {
                return;
            }

            EnsureHubSubscriptions();
            StateHasChanged();
        });
    }

    public ValueTask DisposeAsync()
    {
        _disposed = true;
        FeatureRuntimeCoordinator.StateChangedAsync -= HandleFeatureStateChangedAsync;

        foreach (var subscription in _hubSubscriptions)
        {
            subscription.Dispose();
        }
        _hubSubscriptions.Clear();

        return ValueTask.CompletedTask;
    }

    private void Signin()
    {
        Navigation.NavigateToSigninWithReturnUrl();
    }
}
