@page "/wheelspin"
@using PenguinTwitchBot.Bot
@using PenguinTwitchBot.Bot.Features
@using PenguinTwitchBot.Database.Bot.Models.Wheel
@attribute [Authorize(Roles = "Streamer, Editor")]
@inject PenguinTwitchBot.Bot.Commands.WheelSpin.IWheelService WheelService
@inject IFeatureRuntimeCoordinator FeatureRuntimeCoordinator
@implements IDisposable

<PageTitle>@(AppConfiguration["ApplicationTitle"] ?? "Penguin Twitch Bot") - Wheel Spins</PageTitle>

<MudContainer Class="pa-4 pa-md-6" MaxWidth="MaxWidth.False">
    <MudStack Spacing="4">
        <!-- Header -->
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
            <MudStack Spacing="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.PieChart" Size="Size.Large" Color="Color.Primary" />
                    <MudText Typo="Typo.h4">Wheel Spins</MudText>
                </MudStack>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Manage interactive prize wheels and live viewer name wheels displayed on your stream overlay.
                </MudText>
            </MudStack>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                @if (Wheels != null)
                {
                    <MudChip T="string" Color="Color.Primary" Size="Size.Medium" Icon="@Icons.Material.Filled.Casino">
                        @Wheels.Count Configured @(Wheels.Count == 1 ? "Wheel" : "Wheels")
                    </MudChip>
                }
                <HelpButton Topic="wheelspin" />
            </MudStack>
        </MudStack>

        @if (!FeatureRuntimeCoordinator.IsEnabled(FeatureKeys.WheeledGame))
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Dense="true">
                Wheel Spin is currently disabled. The current wheel version stays available, but controls are inactive until the feature is enabled.
            </MudAlert>
        }

        <!-- Viewer Wheel Live Controls Card -->
        <MudPaper Elevation="2" Class="pa-4">
            <MudStack Spacing="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.PeopleAlt" Color="Color.Primary" />
                    <MudText Typo="Typo.h6">Viewer Name Wheel Controls</MudText>
                </MudStack>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Allows viewers to enter using <code>!join</code> in chat while open, then displays and spins the viewer roster live on stream.
                </MudText>
                <MudStack Row="true" Spacing="2" Class="flex-wrap pt-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.OpenInNew"
                               OnClick="() => OpenViewerWheel()" Disabled="@(!FeatureRuntimeCoordinator.IsEnabled(FeatureKeys.WheeledGame))">
                        Open Viewer Wheel
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Visibility"
                               OnClick="() => ShowViewerWheel()" Disabled="@(!FeatureRuntimeCoordinator.IsEnabled(FeatureKeys.WheeledGame))">
                        Show Viewer Wheel
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.Autorenew"
                               OnClick="() => SpinViewersWheel()" Disabled="@(!FeatureRuntimeCoordinator.IsEnabled(FeatureKeys.WheeledGame))">
                        Spin Viewer Wheel
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Lock"
                               OnClick="() => CloseViewersWheel()" Disabled="@(!FeatureRuntimeCoordinator.IsEnabled(FeatureKeys.WheeledGame))">
                        Close Viewer Wheel
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.VisibilityOff"
                               OnClick="() => HideWheel()" Disabled="@(!FeatureRuntimeCoordinator.IsEnabled(FeatureKeys.WheeledGame))">
                        Hide Overlay Wheel
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>

        <MudGrid Spacing="4">
            <!-- Left: Wheels Table -->
            <MudItem xs="12" lg="7">
                <MudPaper Elevation="2" Class="pa-4">
                    <MudTable Items="@Wheels" Dense="true" Hover="true" Elevation="0">
                        <ToolBarContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="w-100">
                                <MudIcon Icon="@Icons.Material.Filled.List" Color="Color.Primary" />
                                <MudText Typo="Typo.h6">Saved Wheels</MudText>
                            </MudStack>
                        </ToolBarContent>
                        <HeaderContent>
                            <MudTh>Id</MudTh>
                            <MudTh>Name</MudTh>
                            <MudTh>Slices</MudTh>
                            <MudTh Style="text-align: right;">Actions</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Id">@context.Id</MudTd>
                            <MudTd DataLabel="Name">
                                <MudText Typo="Typo.body2"><b>@context.Name</b></MudText>
                                @if (!string.IsNullOrWhiteSpace(context.WinningMessage))
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.WinningMessage</MudText>
                                }
                            </MudTd>
                            <MudTd DataLabel="Slices">
                                <MudChip T="string" Size="Size.Small" Color="Color.Default">
                                    @context.Properties.Count @(context.Properties.Count == 1 ? "slice" : "slices")
                                </MudChip>
                            </MudTd>
                            <MudTd Style="text-align: right;">
                                <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd">
                                    <MudTooltip Text="Show on Overlay">
                                        <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Primary" Size="Size.Small"
                                                       OnClick="() => ShowWheel(context)" Disabled="@(!FeatureRuntimeCoordinator.IsEnabled(FeatureKeys.WheeledGame))" />
                                    </MudTooltip>
                                    <MudTooltip Text="Spin on Overlay">
                                        <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Color="Color.Success" Size="Size.Small"
                                                       OnClick="() => SpinWheel(context)" Disabled="@(!FeatureRuntimeCoordinator.IsEnabled(FeatureKeys.WheeledGame))" />
                                    </MudTooltip>
                                    <MudTooltip Text="Edit Wheel">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Default" Size="Size.Small"
                                                       OnClick="() => EditWheel(context)" />
                                    </MudTooltip>
                                    <MudTooltip Text="Delete Wheel">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                                       OnClick="() => DeleteWheel(context)" />
                                    </MudTooltip>
                                </MudStack>
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <MudText Align="Align.Center" Color="Color.Secondary" Class="pa-4">No custom wheels found.</MudText>
                        </NoRecordsContent>
                    </MudTable>
                </MudPaper>
            </MudItem>

            <!-- Right: Wheel Editor -->
            <MudItem xs="12" lg="5">
                <MudPaper Elevation="2" Class="pa-4">
                    <EditForm Model="@newWheel" OnValidSubmit="SaveWheel">
                        <DataAnnotationsValidator />
                        <MudStack Spacing="3">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudIcon Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" />
                                    <MudText Typo="Typo.h6">
                                        @(newWheel.Id == null || newWheel.Id == 0 ? "Create Wheel" : $"Editing: {newWheel.Name}")
                                    </MudText>
                                </MudStack>
                                @if (newWheel.Id != null && newWheel.Id != 0)
                                {
                                    <MudButton Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small"
                                               OnClick="() => { newWheel = new Wheel(); propertiesToDelete = new(); }">
                                        New Wheel
                                    </MudButton>
                                }
                            </MudStack>

                            <MudTextField Label="Wheel Name" Required="true" RequiredError="Name is required"
                                          @bind-Value="newWheel.Name" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            <MudTextField Label="Winning Message" Required="true" RequiredError="Message is required"
                                          @bind-Value="newWheel.WinningMessage" Variant="Variant.Outlined" Margin="Margin.Dense"
                                          HelperText="Supports {WheelSpinResult} placeholder." />

                            <!-- Overlay Testing Controls -->
                            <MudPaper Outlined="true" Class="pa-2">
                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="flex-wrap">
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Visibility" OnClick="() => ShowWheel(newWheel)"
                                               Disabled="@(!FeatureRuntimeCoordinator.IsEnabled(FeatureKeys.WheeledGame))">
                                        Show
                                    </MudButton>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="() => SpinWheel(newWheel)"
                                               Disabled="@(!FeatureRuntimeCoordinator.IsEnabled(FeatureKeys.WheeledGame))">
                                        Spin
                                    </MudButton>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Shuffle" OnClick="() => ShuffleWheel()">
                                        Shuffle
                                    </MudButton>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.VisibilityOff" OnClick="() => HideWheel()"
                                               Disabled="@(!FeatureRuntimeCoordinator.IsEnabled(FeatureKeys.WheeledGame))">
                                        Hide
                                    </MudButton>
                                </MudStack>
                            </MudPaper>

                            <!-- Add Slices -->
                            <MudDivider />
                            <MudText Typo="Typo.subtitle2">Wheel Slices (@newWheel.Properties.Count)</MudText>

                            <MudGrid Spacing="2" Class="align-center">
                                <MudItem xs="7">
                                    <MudTextField Label="Slice Label" @bind-Value="propertyName"
                                                  Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="3">
                                    <MudNumericField Label="Weight" @bind-Value="weight" Min="1"
                                                     Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="2">
                                    <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary"
                                                   Variant="Variant.Filled" Size="Size.Medium" OnClick="() => AddProperty()" />
                                </MudItem>
                            </MudGrid>

                            <MudExpansionPanels Elevation="0" Outlined="true">
                                <MudExpansionPanel Text="Bulk Add Slices">
                                    <MudStack Spacing="2">
                                        <MudTextField Label="Bulk Slice Labels (one per line)" Lines="4"
                                                      @bind-Value="bulkPropertyNames" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                                   OnClick="() => AddProperties()">
                                            Add Slices
                                        </MudButton>
                                    </MudStack>
                                </MudExpansionPanel>
                            </MudExpansionPanels>

                            <!-- Slices Table -->
                            @if (newWheel.Properties.Count > 0)
                            {
                                <MudPaper Outlined="true" Style="max-height: 250px; overflow-y: auto;">
                                    <MudTable Items="@newWheel.Properties" Dense="true" Elevation="0">
                                        <HeaderContent>
                                            <MudTh>Label</MudTh>
                                            <MudTh>Weight</MudTh>
                                            <MudTh Style="width: 40px;"></MudTh>
                                        </HeaderContent>
                                        <RowTemplate Context="prop">
                                            <MudTd>@prop.Label</MudTd>
                                            <MudTd>@prop.Weight</MudTd>
                                            <MudTd>
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                                               Size="Size.Small" OnClick="() => RemoveProperty(prop)" />
                                            </MudTd>
                                        </RowTemplate>
                                    </MudTable>
                                </MudPaper>
                            }

                            <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit"
                                       StartIcon="@Icons.Material.Filled.Save" FullWidth="true" Class="mt-2">
                                Save Wheel
                            </MudButton>
                        </MudStack>
                    </EditForm>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudStack>
</MudContainer>
@code {
    private List<Wheel>? Wheels { get; set; } = new();
    private string propertyName { get; set; } = string.Empty;
    private string bulkPropertyNames { get; set; } = string.Empty;
    private float weight { get; set; } = 1;
    private Wheel newWheel { get; set; } = new();
    private List<WheelProperty> propertiesToDelete { get; set; } = new();
    [Inject] private IDialogService DialogService { get; set; } = default!;
    private bool _disposed;
    private bool _wasWheelFeatureEnabled;

    protected override async Task OnInitializedAsync()
    {
        _wasWheelFeatureEnabled = FeatureRuntimeCoordinator.IsEnabled(FeatureKeys.WheeledGame);
        FeatureRuntimeCoordinator.StateChanged += HandleFeatureStateChanged;
        Wheels = await WheelService.GetWheels();
    }

    private void HandleFeatureStateChanged()
    {
        if (_disposed)
        {
            return;
        }

        var isWheelFeatureEnabled = FeatureRuntimeCoordinator.IsEnabled(FeatureKeys.WheeledGame);
        if (_wasWheelFeatureEnabled && !isWheelFeatureEnabled)
        {
            newWheel = new Wheel();
            propertiesToDelete = new List<WheelProperty>();
        }

        _wasWheelFeatureEnabled = isWheelFeatureEnabled;

        InvokeAsync(StateHasChanged);
    }

    private Task OpenViewerWheel()
    {
        if (!FeatureRuntimeCoordinator.IsEnabled(FeatureKeys.WheeledGame))
        {
            return Task.CompletedTask;
        }

        return WheelService.OpenNameWheel();
    }

    private void ShowViewerWheel()
    {
        if (!FeatureRuntimeCoordinator.IsEnabled(FeatureKeys.WheeledGame))
        {
            return;
        }

        WheelService.ShowNameWheel();
    }

    private void SpinViewersWheel()
    {
        if (!FeatureRuntimeCoordinator.IsEnabled(FeatureKeys.WheeledGame))
        {
            return;
        }

        WheelService.SpinNameWheel();
    }

    private void CloseViewersWheel()
    {
        if (!FeatureRuntimeCoordinator.IsEnabled(FeatureKeys.WheeledGame))
        {
            return;
        }

        WheelService.CloseNameWheel();
    }

    private void ShuffleWheel()
    {
        var props = newWheel.Properties;
        props.Shuffle();
        newWheel.Properties = props;
    }

    private void RemoveProperty(WheelProperty property)
    {
        newWheel.Properties.Remove(property);
        propertiesToDelete.Add(property);
    }

    private void AddProperties()
    {
        var names = bulkPropertyNames.Split("\n");
        foreach (var name in names)
        {
            var trimmedName = name.Trim();
            if (string.IsNullOrWhiteSpace(trimmedName))
            {
                continue;
            }
            newWheel.Properties.Add(new WheelProperty { Label = trimmedName, Weight = 1 });
        }
        bulkPropertyNames = string.Empty;
        weight = 1;
    }

    private void AddProperty()
    {
        newWheel.Properties.Add(new WheelProperty { Label = propertyName, Weight = weight });
        propertyName = string.Empty;
        weight = 1;
    }

    public async void SaveWheel()
    {
        if (newWheel.Id == null || newWheel.Id == 0)
        {
            await WheelService.AddWheel(newWheel);
        }
        else
        {
            await WheelService.SaveWheel(newWheel);
            await WheelService.DeleteProperties(propertiesToDelete);
        }
        newWheel = new Wheel();
        propertiesToDelete = new List<WheelProperty>();
        Wheels = await WheelService.GetWheels();
        StateHasChanged();
    }

    private void ShowWheel(Wheel wheel)
    {
        if (!FeatureRuntimeCoordinator.IsEnabled(FeatureKeys.WheeledGame))
        {
            return;
        }

        WheelService.ShowWheel(wheel);
    }

    private void HideWheel()
    {
        if (!FeatureRuntimeCoordinator.IsEnabled(FeatureKeys.WheeledGame))
        {
            return;
        }

        WheelService.HideWheel();
    }

    private void SpinWheel(Wheel wheel)
    {
        if (!FeatureRuntimeCoordinator.IsEnabled(FeatureKeys.WheeledGame))
        {
            return;
        }

        WheelService.SpinWheel();
    }

    private void EditWheel(Wheel wheel)
    {
        newWheel = wheel;
        propertiesToDelete = new List<WheelProperty>();
    }

    private async Task DeleteWheel(Wheel wheel)
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
        "Warning",
        "Deleting can not be undone!",
        yesText: "Delete!", cancelText: "Cancel");
        if (result != null)
        {
            await WheelService.DeleteWheel(wheel);
            Wheels = await WheelService.GetWheels();
        }
    }

    public void Dispose()
    {
        _disposed = true;
        FeatureRuntimeCoordinator.StateChanged -= HandleFeatureStateChanged;
    }
}
