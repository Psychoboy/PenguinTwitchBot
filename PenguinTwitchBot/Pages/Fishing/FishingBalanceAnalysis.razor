@page "/fishing/balance-analysis"
@using PenguinTwitchBot.Bot.Commands.Fishing
@using PenguinTwitchBot.Database.Bot.Models.Fishing
@using System.Text.Json
@inject IFishingShopService ShopService
@inject IFishingAnalyticsService AnalyticsService
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@attribute [Authorize(Roles = "Streamer, Editor")]

<PageTitle>@(AppConfiguration["ApplicationTitle"] ?? "Penguin Twitch Bot") - Fishing Balance Analysis</PageTitle>

<MudContainer Class="pa-4" MaxWidth="MaxWidth.ExtraExtraLarge">
    <MudStack Spacing="3">
        <!-- Page Header -->
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Analytics" Size="Size.Large" Color="Color.Primary" />
                <div>
                    <MudText Typo="Typo.h4" Style="font-weight: 700;">Fishing Balance & Economy</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Comprehensive economy analysis featuring durability maintenance, accident sinks, ROI deep-dive, and real-time simulator.
                    </MudText>
                </div>
            </MudStack>
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <HelpButton Topic="fishing-balance" />
                @if (report != null)
                {
                    <MudButton Variant="Variant.Outlined" 
                               Color="Color.Info" 
                               StartIcon="@Icons.Material.Filled.Download"
                               OnClick="ExportToJson">
                        Export Report
                    </MudButton>
                }
            </MudStack>
        </MudStack>

        <!-- Date Range Filter & Analysis Trigger -->
        <MudPaper Elevation="3" Class="pa-4">
            <MudGrid>
                <MudItem xs="12" sm="4" md="3">
                    <MudDatePicker Label="Start Date" 
                                   @bind-Date="startDate" 
                                   Clearable="true"
                                   Placeholder="All time"
                                   Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="4" md="3">
                    <MudDatePicker Label="End Date" 
                                   @bind-Date="endDate" 
                                   Clearable="true"
                                   Placeholder="Now"
                                   Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="4" md="3">
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               Size="Size.Large"
                               FullWidth="true"
                               StartIcon="@Icons.Material.Filled.PlayArrow"
                               OnClick="RunAnalysis"
                               Disabled="isLoading">
                        @if (isLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <span>Analyzing...</span>
                        }
                        else
                        {
                            <span>Run Analysis</span>
                        }
                    </MudButton>
                </MudItem>
                <MudItem xs="12" sm="12" md="3">
                    @if (report != null)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Analyzed @report.RealEconomy.TotalAttemptsRecorded.ToString("N0") attempts across @report.RealEconomy.UniqueFishers fishers.
                            <br />Source: @report.RealEconomy.AttemptDataSource
                        </MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Select an optional date window or click Run Analysis to analyze all-time historical telemetry.
                        </MudText>
                    }
                </MudItem>
            </MudGrid>
        </MudPaper>

        @if (report != null)
        {
            <!-- Main Content Tabs -->
            <MudTabs Elevation="3" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-4" Color="Color.Primary">
                
                <!-- TAB 1: EXECUTIVE OVERVIEW & HEALTH DASHBOARD -->
                <MudTabPanel Text="Overview & Health" Icon="@Icons.Material.Filled.Dashboard">
                    <MudStack Spacing="3">
                        <!-- Top KPI Cards -->
                        <MudGrid>
                            <MudItem xs="12" sm="6" md="2">
                                <MudPaper Elevation="2" Class="pa-3">
                                    <MudStack Spacing="1">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Gross Gold / Catch</MudText>
                                        <MudText Typo="Typo.h5" Color="Color.Warning">
                                            @report.RealEconomy.AverageGoldPerCatch.ToString("F1")g
                                        </MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Tertiary">
                                            Median: @report.RealEconomy.MedianGoldPerCatch.ToString("F1")g
                                        </MudText>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>

                            <MudItem xs="12" sm="6" md="2">
                                <MudPaper Elevation="2" Class="pa-3">
                                    <MudStack Spacing="1">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Accident Sink / Cast</MudText>
                                        <MudText Typo="Typo.h5" Color="Color.Error">
                                            -@report.RealEconomy.AverageAccidentLossPerAttempt.ToString("F2")g
                                        </MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Tertiary">
                                            @report.RealEconomy.TotalAccidentsRecorded incidents
                                        </MudText>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>

                            <MudItem xs="12" sm="6" md="2">
                                <MudPaper Elevation="2" Class="pa-3">
                                    <MudStack Spacing="1">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Durability Upkeep / Cast</MudText>
                                        <MudText Typo="Typo.h5" Color="Color.Warning">
                                            -@report.RealEconomy.AverageDurabilityUpkeepPerAttempt.ToString("F2")g
                                        </MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Tertiary">
                                            Rate: @(report.SettingsSnapshot.RepairCostMultiplier > 0 ? $"{report.SettingsSnapshot.RepairCostMultiplier:F2}x" : "Permaloss")
                                        </MudText>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>

                            <MudItem xs="12" sm="6" md="2">
                                <MudPaper Elevation="2" Class="pa-3">
                                    <MudStack Spacing="1">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Net Gold / Cast</MudText>
                                        <MudText Typo="Typo.h5" Color="@(report.RealEconomy.NetGoldPerAttempt > 0 ? Color.Success : Color.Error)">
                                            @(report.RealEconomy.NetGoldPerAttempt > 0 ? "+" : "")@report.RealEconomy.NetGoldPerAttempt.ToString("F2")g
                                        </MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Tertiary">
                                            Profit Margin: @(report.RealEconomy.AverageGoldPerCatch > 0 ? Math.Round((report.RealEconomy.NetGoldPerAttempt / report.RealEconomy.AverageGoldPerCatch) * 100, 1) : 0)%
                                        </MudText>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>

                            <MudItem xs="12" sm="6" md="2">
                                <MudPaper Elevation="2" Class="pa-3">
                                    <MudStack Spacing="1">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Success Rate</MudText>
                                        <MudText Typo="Typo.h5" Color="Color.Info">
                                            @report.RealEconomy.ObservedSuccessRatePercent.ToString("F1")%
                                        </MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Tertiary">
                                            Model: @report.SettingsSnapshot.TheoreticalSuccessRatePercent.ToString("F1")%
                                        </MudText>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>

                            <MudItem xs="12" sm="6" md="2">
                                <MudPaper Elevation="2" Class="pa-3">
                                    <MudStack Spacing="1">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Total Catches</MudText>
                                        <MudText Typo="Typo.h5">
                                            @report.RealEconomy.TotalCatches.ToString("N0")
                                        </MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Tertiary">
                                            @report.RealEconomy.UniqueFishers unique players
                                        </MudText>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>
                        </MudGrid>

                        <!-- Health Status Banner -->
                        @{
                            var isHealthy = report.RealEconomy.NetGoldPerAttempt > 0 && report.SettingsSnapshot.CombinedAccidentRatePercent <= 7.0;
                            var isDeflation = report.RealEconomy.NetGoldPerAttempt <= 0;
                            var bannerSeverity = isDeflation ? Severity.Error : (isHealthy ? Severity.Success : Severity.Warning);
                            var bannerTitle = isDeflation ? "Economy Warning: Deflationary Death Spiral" : (isHealthy ? "Economy Status: Balanced & Sustainable" : "Economy Attention: Tight Margins / High Wear");
                        }
                        <MudAlert Severity="@bannerSeverity" Variant="Variant.Filled" Elevation="2">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <div>
                                    <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">@bannerTitle</MudText>
                                    <MudText Typo="Typo.body2">
                                        @if (isDeflation)
                                        {
                                            <span>Player casts produce less gold than durability maintenance and accident losses consume. Stream viewers will lose gold over time.</span>
                                        }
                                        else
                                        {
                                            <span>Players retain ~@report.RealEconomy.NetGoldPerAttempt.ToString("F2")g profit per cast after covering equipment durability wear and accident replacement risks.</span>
                                        }
                                    </MudText>
                                </div>
                            </MudStack>
                        </MudAlert>

                        <!-- Stream Catch Quality & Trophies Card -->
                        <MudPaper Elevation="2" Class="pa-4">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Size="Size.Medium" Color="Color.Warning" />
                                    <div>
                                        <MudText Typo="Typo.h6" Style="font-weight: 700;">Stream Catch Quality & Trophies</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            Observed catch quality experience, star ratings, and trophy weight achievements
                                        </MudText>
                                    </div>
                                </MudStack>
                                @if (!string.IsNullOrEmpty(report.RealEconomy.HeaviestFishName))
                                {
                                    <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Star">
                                        Stream Record: @report.RealEconomy.HeaviestFishName (@report.RealEconomy.HeaviestFishWeight.ToString("N1") lbs)
                                    </MudChip>
                                }
                            </MudStack>

                            <MudGrid>
                                <!-- Heaviest Catch Spotlight -->
                                <MudItem xs="12" md="4">
                                    <MudPaper Elevation="1" Class="pa-3" Style="border-left: 4px solid var(--mud-palette-warning);">
                                        <MudStack Spacing="1">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">🏆 Heaviest Fish (Stream Trophy)</MudText>
                                            @if (!string.IsNullOrEmpty(report.RealEconomy.HeaviestFishName))
                                            {
                                                <MudText Typo="Typo.h6" Style="font-weight: 700;">
                                                    @report.RealEconomy.HeaviestFishName
                                                </MudText>
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                    <MudText Typo="Typo.body2" Color="Color.Warning" Style="font-weight: 700;">
                                                        @report.RealEconomy.HeaviestFishWeight.ToString("N2") lbs
                                                    </MudText>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                        (@(new string('⭐', Math.Max(1, report.RealEconomy.HeaviestFishStars))))
                                                    </MudText>
                                                </MudStack>
                                                <MudText Typo="Typo.caption" Color="Color.Tertiary">
                                                    Caught by: <strong>@(string.IsNullOrEmpty(report.RealEconomy.HeaviestFishCatcher) ? "Anonymous" : report.RealEconomy.HeaviestFishCatcher)</strong>
                                                    @if (report.RealEconomy.HeaviestFishRarity.HasValue)
                                                    {
                                                        <span> • @report.RealEconomy.HeaviestFishRarity.Value</span>
                                                    }
                                                </MudText>
                                            }
                                            else
                                            {
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">No catches recorded in window</MudText>
                                            }
                                        </MudStack>
                                    </MudPaper>
                                </MudItem>

                                <!-- Star Breakdown -->
                                <MudItem xs="12" md="4">
                                    <MudPaper Elevation="1" Class="pa-3">
                                        <MudStack Spacing="1">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">⭐ Star Rating Breakdown</MudText>
                                            <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mt-1">
                                                <div>
                                                    <MudText Typo="Typo.caption">⭐⭐⭐ 3-Star</MudText>
                                                    <MudText Typo="Typo.h6" Color="Color.Warning">@report.RealEconomy.ObservedThreeStarPercent.ToString("F1")%</MudText>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">(@report.RealEconomy.ObservedStarCounts.GetValueOrDefault(3, 0) fish)</MudText>
                                                </div>
                                                <div>
                                                    <MudText Typo="Typo.caption">⭐⭐ 2-Star</MudText>
                                                    <MudText Typo="Typo.h6" Color="Color.Info">@report.RealEconomy.ObservedTwoStarPercent.ToString("F1")%</MudText>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">(@report.RealEconomy.ObservedStarCounts.GetValueOrDefault(2, 0) fish)</MudText>
                                                </div>
                                                <div>
                                                    <MudText Typo="Typo.caption">⭐ 1-Star</MudText>
                                                    <MudText Typo="Typo.h6" Color="Color.Default">@report.RealEconomy.ObservedOneStarPercent.ToString("F1")%</MudText>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">(@report.RealEconomy.ObservedStarCounts.GetValueOrDefault(1, 0) fish)</MudText>
                                                </div>
                                            </MudStack>
                                        </MudStack>
                                    </MudPaper>
                                </MudItem>

                                <!-- Rare+ Chance & Avg Weight -->
                                <MudItem xs="12" md="4">
                                    <MudPaper Elevation="1" Class="pa-3">
                                        <MudStack Spacing="1">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">✨ Rare+ Chance & Avg Weight</MudText>
                                            <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mt-1">
                                                <div>
                                                    <MudText Typo="Typo.caption">Rare+ Catch Rate</MudText>
                                                    <MudText Typo="Typo.h6" Color="Color.Secondary">@report.RealEconomy.ObservedRarePlusPercent.ToString("F1")%</MudText>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Rare, Epic, Leg, Myth</MudText>
                                                </div>
                                                <div>
                                                    <MudText Typo="Typo.caption">Average Catch Weight</MudText>
                                                    <MudText Typo="Typo.h6" Color="Color.Primary">@report.RealEconomy.ObservedAverageWeight.ToString("N1") lbs</MudText>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Across all catches</MudText>
                                                </div>
                                            </MudStack>
                                        </MudStack>
                                    </MudPaper>
                                </MudItem>

                                <!-- Rarity Distribution Chips -->
                                @if (report.RealEconomy.ObservedRarityPercentages.Any())
                                {
                                    <MudItem xs="12">
                                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Style="flex-wrap: wrap;">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Observed Rarity:</MudText>
                                            @foreach (var (rarity, pct) in report.RealEconomy.ObservedRarityPercentages)
                                            {
                                                var rarityColor = rarity switch
                                                {
                                                    FishRarity.Common => Color.Default,
                                                    FishRarity.Uncommon => Color.Success,
                                                    FishRarity.Rare => Color.Info,
                                                    FishRarity.Epic => Color.Secondary,
                                                    FishRarity.Legendary => Color.Warning,
                                                    FishRarity.Mythical => Color.Error,
                                                    _ => Color.Default
                                                };
                                                <MudChip T="string" Size="Size.Small" Color="@rarityColor" Variant="Variant.Outlined">
                                                    @rarity: @pct.ToString("F1")% (@report.RealEconomy.ObservedRarityCounts.GetValueOrDefault(rarity, 0))
                                                </MudChip>
                                            }
                                        </MudStack>
                                    </MudItem>
                                }
                            </MudGrid>
                        </MudPaper>

                        <!-- Automated Diagnostics & Recommendations -->
                        @if (report.Diagnostics.Any())
                        {
                            <MudPaper Elevation="1" Class="pa-4">
                                <MudText Typo="Typo.h6" Class="mb-3">
                                    <MudIcon Icon="@Icons.Material.Filled.Healing" Class="mr-2" />
                                    Diagnostics & Remediation Insights
                                </MudText>
                                <MudStack Spacing="2">
                                    @foreach (var diag in report.Diagnostics)
                                    {
                                        var alertSeverity = diag.Severity switch
                                        {
                                            DiagnosticSeverity.Error => Severity.Error,
                                            DiagnosticSeverity.Warning => Severity.Warning,
                                            DiagnosticSeverity.Success => Severity.Success,
                                            _ => Severity.Info
                                        };
                                        <MudAlert Severity="@alertSeverity" Variant="Variant.Outlined" Dense="true">
                                            <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">@diag.Title</MudText>
                                            <MudText Typo="Typo.body2">@diag.Message</MudText>
                                            @if (!string.IsNullOrWhiteSpace(diag.RemediationAdvice))
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                                                    <strong>Recommendation:</strong> @diag.RemediationAdvice
                                                </MudText>
                                            }
                                        </MudAlert>
                                    }
                                </MudStack>
                            </MudPaper>
                        }

                        <!-- Quick Summary of Theoretical Tiers -->
                        <MudPaper Elevation="1" Class="pa-4">
                            <MudText Typo="Typo.h6" Class="mb-2">
                                <MudIcon Icon="@Icons.Material.Filled.Layers" Class="mr-2" />
                                Theoretical Loadout Progression
                            </MudText>
                            <MudTable Items="@report.ProjectedEconomy.TierEconomics" Dense="true" Hover="true" Striped="true">
                                <HeaderContent>
                                    <MudTh>Loadout Tier</MudTh>
                                    <MudTh>Gear Cost</MudTh>
                                    <MudTh>Quality Boosts</MudTh>
                                    <MudTh>Rare+ %</MudTh>
                                    <MudTh>⭐⭐⭐ %</MudTh>
                                    <MudTh>Avg Weight</MudTh>
                                    <MudTh>Gross / Cast</MudTh>
                                    <MudTh>Upkeep Sink</MudTh>
                                    <MudTh>Accident Sink</MudTh>
                                    <MudTh>Net Profit / Cast</MudTh>
                                    <MudTh>Profit Margin</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd><strong>@context.TierName</strong></MudTd>
                                    <MudTd>@context.TotalLoadoutCost.ToString("N0")g</MudTd>
                                    <MudTd>
                                        @if (context.RarityBoostPercent > 0 || context.StarBoostPercent > 0 || context.WeightBoostPercent > 0)
                                        {
                                            <MudStack Row="true" Spacing="1" Style="flex-wrap: wrap;">
                                                @if (context.RarityBoostPercent > 0)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined">+@context.RarityBoostPercent.ToString("0.#")% Rarity</MudChip>
                                                }
                                                @if (context.StarBoostPercent > 0)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">+@context.StarBoostPercent.ToString("0.#")% Stars</MudChip>
                                                }
                                                @if (context.WeightBoostPercent > 0)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">+@context.WeightBoostPercent.ToString("0.#")% Wgt</MudChip>
                                                }
                                            </MudStack>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">No boosts (Base)</MudText>
                                        }
                                    </MudTd>
                                    <MudTd>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary" Style="font-weight: 600;">
                                            @context.ExpectedRarePlusPercent.ToString("F1")%
                                        </MudText>
                                    </MudTd>
                                    <MudTd>
                                        <MudText Typo="Typo.body2" Color="Color.Warning" Style="font-weight: 600;">
                                            @context.ExpectedThreeStarPercent.ToString("F1")%
                                        </MudText>
                                    </MudTd>
                                    <MudTd>@context.ExpectedAverageWeight.ToString("N1") lbs</MudTd>
                                    <MudTd>@context.GrossGoldPerAttempt.ToString("F1")g</MudTd>
                                    <MudTd><MudText Color="Color.Warning">-@context.DurabilityUpkeepPerAttempt.ToString("F2")g</MudText></MudTd>
                                    <MudTd><MudText Color="Color.Error">-@context.AccidentSinkPerAttempt.ToString("F2")g</MudText></MudTd>
                                    <MudTd>
                                        <MudText Color="@(context.NetGoldPerAttempt > 0 ? Color.Success : Color.Error)" Style="font-weight: 700;">
                                            @(context.NetGoldPerAttempt > 0 ? "+" : "")@context.NetGoldPerAttempt.ToString("F2")g
                                        </MudText>
                                    </MudTd>
                                    <MudTd>
                                        <MudChip T="string" Size="Size.Small" Color="@(context.ProfitMarginPercent >= 50 ? Color.Success : (context.ProfitMarginPercent > 0 ? Color.Warning : Color.Error))">
                                            @context.ProfitMarginPercent.ToString("F1")%
                                        </MudChip>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        </MudPaper>
                    </MudStack>
                </MudTabPanel>

                <!-- TAB 2: THEORETICAL VS REAL TELEMETRY -->
                <MudTabPanel Text="Theoretical vs Real" Icon="@Icons.Material.Filled.CompareArrows">
                    <MudStack Spacing="3">
                        <MudText Typo="Typo.h6">
                            Side-by-Side Model Comparison (Projected Expectations vs Observed Reality)
                        </MudText>

                        <MudGrid>
                            <MudItem xs="12" md="8">
                                <MudTable Items="@GetVarianceRows()" Dense="true" Hover="true" Striped="true" Elevation="2">
                                    <HeaderContent>
                                        <MudTh>Economic Metric</MudTh>
                                        <MudTh>Theoretical Model</MudTh>
                                        <MudTh>Observed History</MudTh>
                                        <MudTh>Variance / Delta</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd><strong>@context.Metric</strong></MudTd>
                                        <MudTd>@context.Theoretical</MudTd>
                                        <MudTd>@context.Observed</MudTd>
                                        <MudTd>
                                            <MudChip T="string" Size="Size.Small" Color="@context.DeltaColor">
                                                @context.Variance
                                            </MudChip>
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </MudItem>

                            <MudItem xs="12" md="4">
                                <MudPaper Elevation="2" Class="pa-4">
                                    <MudText Typo="Typo.subtitle1" Style="font-weight: 700;" Class="mb-2">
                                        <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Size="Size.Small" Color="Color.Warning" Class="mr-1" />
                                        Recorded Accident Breakdown
                                    </MudText>
                                    <MudList T="string" Dense="true">
                                        <MudListItem Text="@($"Rod Snaps: {report.RealEconomy.RodSnapsRecorded}")" Icon="@Icons.Material.Filled.BrokenImage" IconColor="Color.Error" />
                                        <MudListItem Text="@($"Line Snaps: {report.RealEconomy.LineSnapsRecorded}")" Icon="@Icons.Material.Filled.LinearScale" IconColor="Color.Error" />
                                        <MudListItem Text="@($"Reel Jams: {report.RealEconomy.ReelJamsRecorded}")" Icon="@Icons.Material.Filled.Settings" IconColor="Color.Warning" />
                                        <MudListItem Text="@($"Tackle Losses: {report.RealEconomy.TackleBoxLossesRecorded}")" Icon="@Icons.Material.Filled.Inventory2" IconColor="Color.Warning" />
                                        <MudListItem Text="@($"Net Breaks: {report.RealEconomy.NetBreaksRecorded}")" Icon="@Icons.Material.Filled.FilterNone" IconColor="Color.Warning" />
                                    </MudList>
                                    <MudDivider Class="my-2" />
                                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                                        <MudText Typo="Typo.body2">Total Gold Lost:</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Error" Style="font-weight: 700;">
                                            @report.RealEconomy.TotalGoldLostToAccidents.ToString("N0")g
                                        </MudText>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>
                        </MudGrid>

                        <!-- Player Engagement Cadence -->
                        <MudPaper Elevation="2" Class="pa-4">
                            <MudText Typo="Typo.subtitle1" Style="font-weight: 700;" Class="mb-2">
                                <MudIcon Icon="@Icons.Material.Filled.People" Class="mr-2" />
                                Observed Player Engagement Cadence
                            </MudText>
                            <MudGrid>
                                <MudItem xs="12" sm="3">
                                    <MudPaper Elevation="1" Class="pa-3">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Casual (25th Percentile)</MudText>
                                        <MudText Typo="Typo.h6">@report.RealEconomy.CasualAttemptsPerSession.ToString("F1") casts/session</MudText>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="12" sm="3">
                                    <MudPaper Elevation="1" Class="pa-3">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Active (Median Player)</MudText>
                                        <MudText Typo="Typo.h6">@report.RealEconomy.ActiveAttemptsPerSession.ToString("F1") casts/session</MudText>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="12" sm="3">
                                    <MudPaper Elevation="1" Class="pa-3">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Hardcore (75th Percentile)</MudText>
                                        <MudText Typo="Typo.h6">@report.RealEconomy.HardcoreAttemptsPerSession.ToString("F1") casts/session</MudText>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="12" sm="3">
                                    <MudPaper Elevation="1" Class="pa-3">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Observed Broadcast Cadence</MudText>
                                        <MudText Typo="Typo.h6">@report.RealEconomy.StreamsPerWeek.ToString("F1") streams/week</MudText>
                                    </MudPaper>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>

                        <!-- Multi-Month Progression Milestones -->
                        @if (report.ProgressionMilestones.Any())
                        {
                            <MudPaper Elevation="2" Class="pa-4">
                                <MudText Typo="Typo.subtitle1" Style="font-weight: 700;" Class="mb-3">
                                    <MudIcon Icon="@Icons.Material.Filled.Timeline" Class="mr-2" />
                                    Multi-Month Progression Forecast (Top Gear Total: @report.TopGearTotalCost.ToString("N0")g)
                                </MudText>

                                <MudGrid>
                                    @foreach (var milestone in report.ProgressionMilestones)
                                    {
                                        <MudItem xs="12" md="4">
                                            <MudPaper Elevation="1" Class="pa-3">
                                                <MudText Typo="Typo.h6" Class="mb-2">@milestone.Label</MudText>
                                                <MudTable Items="@milestone.Tiers" Dense="true" Hover="true" Striped="true">
                                                    <HeaderContent>
                                                        <MudTh>Player Tier</MudTh>
                                                        <MudTh>Casts</MudTh>
                                                        <MudTh>Net Gold</MudTh>
                                                        <MudTh>Progress</MudTh>
                                                    </HeaderContent>
                                                    <RowTemplate>
                                                        <MudTd>@context.TierName</MudTd>
                                                        <MudTd>@context.ProjectedAttempts.ToString("N0")</MudTd>
                                                        <MudTd>@context.ProjectedNetGold.ToString("N0")g</MudTd>
                                                        <MudTd>
                                                            <MudChip T="string" Size="Size.Small" Color="@(context.MaxGearProgressPercent >= 100 ? Color.Success : Color.Info)">
                                                                @context.MaxGearProgressPercent.ToString("F1")%
                                                            </MudChip>
                                                        </MudTd>
                                                    </RowTemplate>
                                                </MudTable>
                                            </MudPaper>
                                        </MudItem>
                                    }
                                </MudGrid>
                            </MudPaper>
                        }
                    </MudStack>
                </MudTabPanel>

                <!-- TAB 3: ITEM ECONOMY & ROI DEEP DIVE -->
                <MudTabPanel Text="Item Economy & ROI" Icon="@Icons.Material.Filled.PriceCheck">
                    <MudStack Spacing="3">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <div>
                                <MudText Typo="Typo.h6">Item Upkeep & Return on Investment (ROI)</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    Evaluates each shop item's maintenance wear, accident risk exposure, gross bonus earnings, and break-even payback period.
                                </MudText>
                            </div>
                            <MudTextField @bind-Value="itemSearchText" 
                                          Placeholder="Filter items..." 
                                          Adornment="Adornment.Start" 
                                          AdornmentIcon="@Icons.Material.Filled.Search" 
                                          Immediate="true"
                                          Variant="Variant.Outlined" 
                                          Margin="Margin.Dense" />
                        </MudStack>

                        <MudTable Items="@FilteredItemAnalysis" Dense="true" Hover="true" Striped="true" Elevation="2">
                            <HeaderContent>
                                <MudTh><MudTableSortLabel SortBy="new Func<ItemEconomyAnalysis, object>(x => x.ItemName)">Item</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel SortBy="new Func<ItemEconomyAnalysis, object>(x => x.EquipmentSlot)">Slot</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel SortBy="new Func<ItemEconomyAnalysis, object>(x => x.Cost)">Cost</MudTableSortLabel></MudTh>
                                <MudTh>Durability / Life</MudTh>
                                <MudTh><MudTableSortLabel SortBy="new Func<ItemEconomyAnalysis, object>(x => x.TotalOperatingCostPerAttempt)">Operating Cost / Cast</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel SortBy="new Func<ItemEconomyAnalysis, object>(x => x.ExpectedGrossGoldBoostPerAttempt)">Bonus Gold / Cast</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel SortBy="new Func<ItemEconomyAnalysis, object>(x => x.NetValuePerAttempt)">Net Value / Cast</MudTableSortLabel></MudTh>
                                <MudTh><MudTableSortLabel SortBy="new Func<ItemEconomyAnalysis, object>(x => x.PaybackAttempts ?? 99999)">Payback Period</MudTableSortLabel></MudTh>
                                <MudTh>Economic Rating</MudTh>
                                <MudTh>Affordability</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>
                                    <strong>@context.ItemName</strong>
                                    @if (!string.IsNullOrWhiteSpace(context.TrophyRole) && context.TrophyRole != "Fishing Gear")
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="display: block;">
                                            @context.TrophyRole
                                        </MudText>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(context.BoostSummary) && context.BoostSummary != "—")
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined" Class="mt-1">
                                            @context.BoostSummary
                                        </MudChip>
                                    }
                                </MudTd>
                                <MudTd>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@context.EquipmentSlot</MudChip>
                                </MudTd>
                                <MudTd>@context.Cost.ToString("N0")g</MudTd>
                                <MudTd>
                                    @if (context.MaxDurability.HasValue && context.MaxDurability.Value > 0)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Icon="@Icons.Material.Filled.Build">
                                            @context.MaxDurability.Value HP (-@context.DurabilityLossPerUse.ToString("0.#"))
                                        </MudChip>
                                        @if (context.DisableBreaking)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">No Snap</MudChip>
                                        }
                                    }
                                    else if (context.IsConsumable)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Info">@(context.MaxUses.HasValue ? $"{context.MaxUses} uses" : "Consumable")</MudChip>
                                    }
                                    else if (context.DisableBreaking)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Default">No Snap</MudChip>
                                    }
                                    else if (context.IsUnbreakable)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Default">Unbreakable</MudChip>
                                    }
                                </MudTd>
                                <MudTd>
                                    <MudText Typo="Typo.body2" Color="Color.Warning">
                                        @context.TotalOperatingCostPerAttempt.ToString("F2")g
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        upkeep: @context.DurabilityUpkeepPerAttempt.ToString("F2")g | risk: @context.AccidentRiskPerAttempt.ToString("F2")g
                                    </MudText>
                                </MudTd>
                                <MudTd>
                                    <MudText Typo="Typo.body2" Color="Color.Success">
                                        +@context.ExpectedGrossGoldBoostPerAttempt.ToString("F2")g
                                    </MudText>
                                    @if (context.HasEffectPreview)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @context.EffectMetric: +@context.EffectRelativeChangePercent.ToString("F1")%
                                        </MudText>
                                    }
                                </MudTd>
                                <MudTd>
                                    <MudText Typo="Typo.body2" Color="@(context.NetValuePerAttempt >= 0 ? Color.Success : Color.Error)" Style="font-weight: 700;">
                                        @(context.NetValuePerAttempt >= 0 ? "+" : "")@context.NetValuePerAttempt.ToString("F2")g
                                    </MudText>
                                </MudTd>
                                <MudTd>
                                    @if (context.PaybackAttempts.HasValue)
                                    {
                                        <MudText Typo="Typo.body2">@context.PaybackAttempts.Value.ToString("N0") casts</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            ~@((context.PaybackAttempts.Value / 30.0).ToString("F1")) sessions
                                        </MudText>
                                    }
                                    else
                                    {
                                        <MudText Color="Color.Secondary">@(context.EconomicRating.Contains("Trophy") || context.EconomicRating.Contains("Quality") || context.EconomicRating.Contains("Specialist") ? "Trophy Gear" : "Luxury Sink")</MudText>
                                    }
                                </MudTd>
                                <MudTd>
                                    <MudChip T="string" Size="Size.Small" Color="@GetEconomicRatingColor(context.EconomicRating)">
                                        @context.EconomicRating
                                    </MudChip>
                                </MudTd>
                                <MudTd>
                                    <MudText Typo="Typo.body2">@context.PercentageWhoCanAfford.ToString("F1")% can buy</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        ~@context.SessionsToAffordActive.ToString("F1") sessions
                                    </MudText>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudStack>
                </MudTabPanel>

                <!-- TAB 4: INTERACTIVE BALANCE SIMULATOR ("WHAT-IF" KNOBS) -->
                <MudTabPanel Text="Simulator (Knobs)" Icon="@Icons.Material.Filled.Tune">
                    <MudStack Spacing="3">
                        <div>
                            <MudText Typo="Typo.h6">Interactive Economy Simulator & "What-If" Tuning</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Experiment with failure rates, repair multipliers, and viewer habits in real-time. Changes here simulate scenarios without altering live settings.
                            </MudText>
                        </div>

                        <MudGrid>
                            <!-- Controls Column -->
                            <MudItem xs="12" md="6">
                                <MudPaper Elevation="2" Class="pa-4">
                                    <MudStack Spacing="3">
                                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                            <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">Simulation Controls</MudText>
                                            <MudButton Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small" OnClick="ResetSimulatorToLiveSettings">
                                                Reset to Live Settings
                                            </MudButton>
                                        </MudStack>

                                        <!-- Loadout Preset Selector -->
                                        <MudSelect T="string" Label="Simulated Player Loadout" @bind-Value="simulationScenario.SelectedLoadoutTier" Variant="Variant.Outlined" @bind-Value:after="RunSimulation">
                                            <MudSelectItem Value="@("Bare Hands")">Bare Hands (No equipment)</MudSelectItem>
                                            <MudSelectItem Value="@("Entry")">Entry Tier (Bamboo / Mono / Basic)</MudSelectItem>
                                            <MudSelectItem Value="@("Mid")">Mid Tier (Fiberglass / Braided / Circle)</MudSelectItem>
                                            <MudSelectItem Value="@("High")">High Tier (Carbon Fiber / Fluoro / Treble)</MudSelectItem>
                                            <MudSelectItem Value="@("Top")">Top Tier (Legendary / Titanium / Diamond)</MudSelectItem>
                                        </MudSelect>

                                        <!-- Accident Sliders -->
                                        <MudText Typo="Typo.subtitle2" Class="mt-2">Accident Failure Chances</MudText>
                                        
                                        <div>
                                            <MudStack Row="true" Justify="Justify.SpaceBetween">
                                                <MudText Typo="Typo.caption">Line Snap Chance: @((simulationScenario.LineSnapChance * 100).ToString("F2"))%</MudText>
                                            </MudStack>
                                            <MudSlider T="double" Min="0.0" Max="0.10" Step="0.005" @bind-Value="simulationScenario.LineSnapChance" Color="Color.Error" @bind-Value:after="RunSimulation" />
                                        </div>

                                        <div>
                                            <MudStack Row="true" Justify="Justify.SpaceBetween">
                                                <MudText Typo="Typo.caption">Rod Snap Chance: @((simulationScenario.RodSnapChance * 100).ToString("F3"))%</MudText>
                                            </MudStack>
                                            <MudSlider T="double" Min="0.0" Max="0.02" Step="0.0005" @bind-Value="simulationScenario.RodSnapChance" Color="Color.Error" @bind-Value:after="RunSimulation" />
                                        </div>

                                        <div>
                                            <MudStack Row="true" Justify="Justify.SpaceBetween">
                                                <MudText Typo="Typo.caption">Reel Jam Chance: @((simulationScenario.ReelJamChance * 100).ToString("F2"))%</MudText>
                                            </MudStack>
                                            <MudSlider T="double" Min="0.0" Max="0.10" Step="0.005" @bind-Value="simulationScenario.ReelJamChance" Color="Color.Warning" @bind-Value:after="RunSimulation" />
                                        </div>

                                        <div>
                                            <MudStack Row="true" Justify="Justify.SpaceBetween">
                                                <MudText Typo="Typo.caption">Tackle Box Lost Chance: @((simulationScenario.TackleBoxLostChance * 100).ToString("F3"))%</MudText>
                                            </MudStack>
                                            <MudSlider T="double" Min="0.0" Max="0.03" Step="0.001" @bind-Value="simulationScenario.TackleBoxLostChance" Color="Color.Warning" @bind-Value:after="RunSimulation" />
                                        </div>

                                        <div>
                                            <MudStack Row="true" Justify="Justify.SpaceBetween">
                                                <MudText Typo="Typo.caption">Net Break Chance: @((simulationScenario.NetBreakChance * 100).ToString("F2"))%</MudText>
                                            </MudStack>
                                            <MudSlider T="double" Min="0.0" Max="0.05" Step="0.005" @bind-Value="simulationScenario.NetBreakChance" Color="Color.Warning" @bind-Value:after="RunSimulation" />
                                        </div>

                                        <!-- Durability Slider -->
                                        <MudText Typo="Typo.subtitle2" Class="mt-2">Durability Maintenance</MudText>
                                        <div>
                                            <MudStack Row="true" Justify="Justify.SpaceBetween">
                                                <MudText Typo="Typo.caption">Repair Cost Multiplier: @(simulationScenario.RepairCostMultiplier.ToString("F2"))x</MudText>
                                            </MudStack>
                                            <MudSlider T="double" Min="0.0" Max="1.0" Step="0.05" @bind-Value="simulationScenario.RepairCostMultiplier" Color="Color.Primary" @bind-Value:after="RunSimulation" />
                                        </div>

                                        <!-- Player Habits -->
                                        <MudText Typo="Typo.subtitle2" Class="mt-2">Simulated Viewer Playstyle</MudText>
                                        <MudGrid>
                                            <MudItem xs="6">
                                                <MudNumericField T="double" Label="Casts / Stream" @bind-Value="simulationScenario.AttemptsPerSession" Min="1" Max="300" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value:after="RunSimulation" />
                                            </MudItem>
                                            <MudItem xs="6">
                                                <MudNumericField T="double" Label="Streams / Week" @bind-Value="simulationScenario.StreamsPerWeek" Min="0.5" Max="14" Step="0.5" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value:after="RunSimulation" />
                                            </MudItem>
                                        </MudGrid>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>

                            <!-- Results Column -->
                            <MudItem xs="12" md="6">
                                @if (simulationResult != null)
                                {
                                    <MudStack Spacing="3">
                                        <!-- Financial Status Alert -->
                                        @{
                                            var simSeverity = simulationResult.NetGoldPerAttempt <= 0 ? Severity.Error : (simulationResult.ProfitMarginPercent >= 40 ? Severity.Success : Severity.Warning);
                                        }
                                        <MudAlert Severity="@simSeverity" Variant="Variant.Filled" Elevation="2">
                                            <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">@simulationResult.FinancialStatus</MudText>
                                            <MudText Typo="Typo.body2">
                                                Combined Failure Rate: @simulationResult.CombinedAccidentRatePercent.ToString("F2")% | Catch Success: @simulationResult.SuccessRatePercent.ToString("F2")%
                                            </MudText>
                                        </MudAlert>

                                        <!-- Key Output Metrics -->
                                        <MudGrid>
                                            <MudItem xs="6" sm="4">
                                                <MudPaper Elevation="1" Class="pa-3">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Gross Gold / Cast</MudText>
                                                    <MudText Typo="Typo.h6">@simulationResult.GrossGoldPerAttempt.ToString("F2")g</MudText>
                                                </MudPaper>
                                            </MudItem>
                                            <MudItem xs="6" sm="4">
                                                <MudPaper Elevation="1" Class="pa-3">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Upkeep Sink / Cast</MudText>
                                                    <MudText Typo="Typo.h6" Color="Color.Warning">-@simulationResult.DurabilityUpkeepPerAttempt.ToString("F2")g</MudText>
                                                </MudPaper>
                                            </MudItem>
                                            <MudItem xs="6" sm="4">
                                                <MudPaper Elevation="1" Class="pa-3">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Accident Sink / Cast</MudText>
                                                    <MudText Typo="Typo.h6" Color="Color.Error">-@simulationResult.AccidentSinkPerAttempt.ToString("F2")g</MudText>
                                                </MudPaper>
                                            </MudItem>
                                            <MudItem xs="6" sm="4">
                                                <MudPaper Elevation="1" Class="pa-3">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Net Gold / Cast</MudText>
                                                    <MudText Typo="Typo.h6" Color="@(simulationResult.NetGoldPerAttempt >= 0 ? Color.Success : Color.Error)">
                                                        @(simulationResult.NetGoldPerAttempt >= 0 ? "+" : "")@simulationResult.NetGoldPerAttempt.ToString("F2")g
                                                    </MudText>
                                                </MudPaper>
                                            </MudItem>
                                            <MudItem xs="6" sm="4">
                                                <MudPaper Elevation="1" Class="pa-3">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Net Gold / Stream</MudText>
                                                    <MudText Typo="Typo.h6" Color="@(simulationResult.NetGoldPerSession >= 0 ? Color.Success : Color.Error)">
                                                        @(simulationResult.NetGoldPerSession >= 0 ? "+" : "")@simulationResult.NetGoldPerSession.ToString("N0")g
                                                    </MudText>
                                                </MudPaper>
                                            </MudItem>
                                            <MudItem xs="6" sm="4">
                                                <MudPaper Elevation="1" Class="pa-3">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Net Gold / Week</MudText>
                                                    <MudText Typo="Typo.h6" Color="@(simulationResult.NetGoldPerWeek >= 0 ? Color.Success : Color.Error)">
                                                        @(simulationResult.NetGoldPerWeek >= 0 ? "+" : "")@simulationResult.NetGoldPerWeek.ToString("N0")g
                                                    </MudText>
                                                </MudPaper>
                                            </MudItem>
                                        </MudGrid>

                                        <!-- Simulated Catch Quality & Trophies -->
                                        <MudPaper Elevation="1" Class="pa-4">
                                            <MudText Typo="Typo.subtitle1" Style="font-weight: 700;" Class="mb-1">
                                                Simulated Catch Quality & Trophy Experience
                                            </MudText>
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                                Expected catch outcomes and gear boosts for this loadout:
                                            </MudText>
                                            <MudGrid Class="mt-1">
                                                <MudItem xs="6" sm="3">
                                                    <MudPaper Elevation="0" Class="pa-2" Style="background-color: var(--mud-palette-background-grey);">
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">⭐⭐⭐ 3-Star Chance</MudText>
                                                        <MudText Typo="Typo.h6" Color="Color.Warning">@simulationResult.ExpectedThreeStarPercent.ToString("F1")%</MudText>
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Boost: +@simulationResult.StarBoostPercent.ToString("0.#")%</MudText>
                                                    </MudPaper>
                                                </MudItem>
                                                <MudItem xs="6" sm="3">
                                                    <MudPaper Elevation="0" Class="pa-2" Style="background-color: var(--mud-palette-background-grey);">
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Rare+ Catch Chance</MudText>
                                                        <MudText Typo="Typo.h6" Color="Color.Secondary">@simulationResult.ExpectedRarePlusPercent.ToString("F1")%</MudText>
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Boost: +@simulationResult.RarityBoostPercent.ToString("0.#")%</MudText>
                                                    </MudPaper>
                                                </MudItem>
                                                <MudItem xs="6" sm="3">
                                                    <MudPaper Elevation="0" Class="pa-2" Style="background-color: var(--mud-palette-background-grey);">
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Expected Avg Weight</MudText>
                                                        <MudText Typo="Typo.h6" Color="Color.Primary">@simulationResult.ExpectedAverageWeight.ToString("N1") lbs</MudText>
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Boost: +@simulationResult.WeightBoostPercent.ToString("0.#")%</MudText>
                                                    </MudPaper>
                                                </MudItem>
                                                <MudItem xs="6" sm="3">
                                                    <MudPaper Elevation="0" Class="pa-2" Style="background-color: var(--mud-palette-background-grey);">
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Equipment Cost</MudText>
                                                        <MudText Typo="Typo.h6">@simulationResult.TotalLoadoutCost.ToString("N0")g</MudText>
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@simulationResult.EquippedItemNames.Count items equipped</MudText>
                                                    </MudPaper>
                                                </MudItem>
                                            </MudGrid>
                                        </MudPaper>

                                        <!-- Progression Pace to Endgame -->
                                        <MudPaper Elevation="1" Class="pa-4">
                                            <MudText Typo="Typo.subtitle1" Style="font-weight: 700;" Class="mb-1">
                                                Endgame Progression Pace
                                            </MudText>
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                                At this simulated cadence (@simulationScenario.AttemptsPerSession casts/stream, @simulationScenario.StreamsPerWeek streams/week):
                                            </MudText>
                                            <MudStack Row="true" Spacing="4" Class="mt-2">
                                                <div>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Streams to Top Gear</MudText>
                                                    <MudText Typo="Typo.h5">
                                                        @(simulationResult.SessionsToAffordTopGear > 900 ? "∞" : simulationResult.SessionsToAffordTopGear.ToString("F1"))
                                                    </MudText>
                                                </div>
                                                <div>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Weeks to Top Gear</MudText>
                                                    <MudText Typo="Typo.h5" Color="@(simulationResult.WeeksToAffordTopGear <= 30 ? Color.Success : Color.Warning)">
                                                        @(simulationResult.WeeksToAffordTopGear > 900 ? "∞" : simulationResult.WeeksToAffordTopGear.ToString("F1"))
                                                    </MudText>
                                                </div>
                                                <div>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Profit Margin</MudText>
                                                    <MudText Typo="Typo.h5" Color="@(simulationResult.ProfitMarginPercent >= 50 ? Color.Success : Color.Warning)">
                                                        @simulationResult.ProfitMarginPercent.ToString("F1")%
                                                    </MudText>
                                                </div>
                                            </MudStack>
                                        </MudPaper>

                                        <!-- Loadout Equipment Chip List -->
                                        <MudPaper Elevation="1" Class="pa-4">
                                            <MudText Typo="Typo.subtitle2" Class="mb-2">Simulated Equipment Loadout</MudText>
                                            @if (simulationResult.EquippedItemNames.Any())
                                            {
                                                <MudStack Row="true" Spacing="1" Style="flex-wrap: wrap;">
                                                    @foreach (var item in simulationResult.EquippedItemNames)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@item</MudChip>
                                                    }
                                                </MudStack>
                                            }
                                            else
                                            {
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">No equipment (Bare hands)</MudText>
                                            }
                                        </MudPaper>
                                    </MudStack>
                                }
                            </MudItem>
                        </MudGrid>
                    </MudStack>
                </MudTabPanel>

                <!-- TAB 5: DYNAMIC PRICING & REBALANCER -->
                <MudTabPanel Text="Dynamic Pricing" Icon="@Icons.Material.Filled.TrendingUp">
                    <MudStack Spacing="3">
                        <div>
                            <MudText Typo="Typo.h6">Durability-Aware Dynamic Pricing Tuner</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Automatically scales permanent shop item costs to target your preferred endgame progression horizon, factoring in durability upkeep and accident sinks.
                            </MudText>
                        </div>

                        <MudPaper Elevation="2" Class="pa-4">
                            <MudGrid>
                                <MudItem xs="12" sm="4">
                                    <MudSelect T="int" Label="Target Endgame Progression Time" @bind-Value="targetWeeks" Variant="Variant.Outlined">
                                        <MudSelectItem Value="12">3 Months (12 weeks)</MudSelectItem>
                                        <MudSelectItem Value="26">6 Months (26 weeks)</MudSelectItem>
                                        <MudSelectItem Value="39">9 Months (39 weeks)</MudSelectItem>
                                        <MudSelectItem Value="52">1 Year (52 weeks)</MudSelectItem>
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudButton Variant="Variant.Filled" 
                                               Color="Color.Primary" 
                                               Size="Size.Large"
                                               StartIcon="@Icons.Material.Filled.Calculate"
                                               OnClick="CalculateRecommendedPrices"
                                               Disabled="isCalculatingPricing">
                                        @if (isCalculatingPricing)
                                        {
                                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                            <span>Calculating...</span>
                                        }
                                        else
                                        {
                                            <span>Calculate Prices</span>
                                        }
                                    </MudButton>
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    @if (recommendedPrices != null && recommendedPrices.Any())
                                    {
                                        <MudButton Variant="Variant.Filled" 
                                                   Color="Color.Success" 
                                                   Size="Size.Large"
                                                   StartIcon="@Icons.Material.Filled.Check"
                                                   OnClick="ApplyRecommendedPrices"
                                                   Disabled="isApplyingPricing">
                                            @if (isApplyingPricing)
                                            {
                                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                                <span>Applying...</span>
                                            }
                                            else
                                            {
                                                <span>Apply Recommendations</span>
                                            }
                                        </MudButton>
                                    }
                                </MudItem>
                            </MudGrid>
                        </MudPaper>

                        @if (pricingPreviewItems.Any())
                        {
                            <MudPaper Elevation="2" Class="pa-4">
                                <MudText Typo="Typo.subtitle1" Style="font-weight: 700;" Class="mb-2">
                                    Price Preview (Permanent Equipment Items)
                                </MudText>
                                <MudTable Items="@pricingPreviewItems" Dense="true" Hover="true" Striped="true">
                                    <HeaderContent>
                                        <MudTh>Item</MudTh>
                                        <MudTh>Slot</MudTh>
                                        <MudTh>Current Price</MudTh>
                                        <MudTh></MudTh>
                                        <MudTh>Recommended Price</MudTh>
                                        <MudTh>Delta</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd><strong>@context.ItemName</strong></MudTd>
                                        <MudTd><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@context.Slot</MudChip></MudTd>
                                        <MudTd>@context.CurrentPrice.ToString("N0")g</MudTd>
                                        <MudTd><MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" /></MudTd>
                                        <MudTd><strong>@context.RecommendedPrice.ToString("N0")g</strong></MudTd>
                                        <MudTd>
                                            <MudChip T="string" Size="Size.Small" Color="@(context.Delta > 0 ? Color.Error : Color.Success)">
                                                @(context.Delta > 0 ? "+" : "")@context.Delta.ToString("N0")g
                                            </MudChip>
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </MudPaper>
                        }
                    </MudStack>
                </MudTabPanel>
            </MudTabs>
        }
        else if (!isLoading)
        {
            <MudPaper Elevation="3" Class="pa-8">
                <MudStack AlignItems="AlignItems.Center" Spacing="3">
                    <MudIcon Icon="@Icons.Material.Filled.Analytics" Size="Size.Large" Color="Color.Primary" />
                    <MudText Typo="Typo.h5" Style="font-weight: 700;">Ready to Analyze Economy</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                        Click "Run Analysis" above to evaluate real historical catches, durability upkeep rates, and simulated progression horizons.
                    </MudText>
                </MudStack>
            </MudPaper>
        }
    </MudStack>
</MudContainer>

@code {
    private DateTime? startDate;
    private DateTime? endDate;
    private FishingBalanceReport? report;
    private bool isLoading = false;
    private string itemSearchText = string.Empty;

    // Simulator State
    private BalanceSimulationScenario simulationScenario = new();
    private BalanceSimulationResult? simulationResult;

    // Pricing State
    private int targetWeeks = 26;
    private bool isCalculatingPricing = false;
    private bool isApplyingPricing = false;
    private Dictionary<string, int>? recommendedPrices;
    private List<PricingPreviewRow> pricingPreviewItems = new();

    private class PricingPreviewRow
    {
        public string ItemName { get; set; } = string.Empty;
        public string Slot { get; set; } = string.Empty;
        public int CurrentPrice { get; set; }
        public int RecommendedPrice { get; set; }
        public int Delta => RecommendedPrice - CurrentPrice;
    }

    private IEnumerable<ItemEconomyAnalysis> FilteredItemAnalysis
    {
        get
        {
            if (report?.ItemAnalysis == null) return Enumerable.Empty<ItemEconomyAnalysis>();
            if (string.IsNullOrWhiteSpace(itemSearchText)) return report.ItemAnalysis;

            return report.ItemAnalysis.Where(i => 
                i.ItemName.Contains(itemSearchText, StringComparison.OrdinalIgnoreCase) ||
                i.EquipmentSlot.Contains(itemSearchText, StringComparison.OrdinalIgnoreCase) ||
                i.EconomicRating.Contains(itemSearchText, StringComparison.OrdinalIgnoreCase));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Auto-run analysis on load
        await RunAnalysis();
    }

    private async Task RunAnalysis()
    {
        isLoading = true;
        try
        {
            report = await AnalyticsService.AnalyzeGameBalance(startDate, endDate);
            
            // Sync simulator defaults from live report snapshot
            if (report != null)
            {
                simulationScenario.LineSnapChance = report.SettingsSnapshot.LineSnapChance;
                simulationScenario.RodSnapChance = report.SettingsSnapshot.RodSnapChance;
                simulationScenario.ReelJamChance = report.SettingsSnapshot.ReelJamChance;
                simulationScenario.TackleBoxLostChance = report.SettingsSnapshot.TackleBoxLostChance;
                simulationScenario.NetBreakChance = report.SettingsSnapshot.NetBreakChance;
                simulationScenario.RepairCostMultiplier = report.SettingsSnapshot.RepairCostMultiplier;
                simulationScenario.AttemptsPerSession = report.RealEconomy.ActiveAttemptsPerSession > 0 ? report.RealEconomy.ActiveAttemptsPerSession : 30.0;
                simulationScenario.StreamsPerWeek = report.RealEconomy.StreamsPerWeek > 0 ? report.RealEconomy.StreamsPerWeek : 3.0;

                await RunSimulation();
            }

            Snackbar.Add("Balance analysis completed successfully!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error running analysis: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RunSimulation()
    {
        try
        {
            simulationResult = await AnalyticsService.SimulateScenario(simulationScenario);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Simulator error: {ex.Message}", Severity.Error);
        }
    }

    private async Task ResetSimulatorToLiveSettings()
    {
        if (report == null) return;

        simulationScenario.LineSnapChance = report.SettingsSnapshot.LineSnapChance;
        simulationScenario.RodSnapChance = report.SettingsSnapshot.RodSnapChance;
        simulationScenario.ReelJamChance = report.SettingsSnapshot.ReelJamChance;
        simulationScenario.TackleBoxLostChance = report.SettingsSnapshot.TackleBoxLostChance;
        simulationScenario.NetBreakChance = report.SettingsSnapshot.NetBreakChance;
        simulationScenario.RepairCostMultiplier = report.SettingsSnapshot.RepairCostMultiplier;
        simulationScenario.SelectedLoadoutTier = "Mid";

        await RunSimulation();
        Snackbar.Add("Simulator reset to current live settings", Severity.Info);
    }

    private async Task CalculateRecommendedPrices()
    {
        isCalculatingPricing = true;
        try
        {
            recommendedPrices = await AnalyticsService.CalculateRecommendedPricing(targetWeeks);
            var allItems = await ShopService.GetAllShopItems();

            pricingPreviewItems = allItems
                .Where(i => !i.IsConsumable && i.EquipmentSlot.HasValue && i.EquipmentSlot != EquipmentSlot.Bait && i.EquipmentSlot != EquipmentSlot.Lure)
                .Select(item =>
                {
                    var recPrice = recommendedPrices.TryGetValue(item.Name, out var p) ? p : item.Cost;
                    return new PricingPreviewRow
                    {
                        ItemName = item.Name,
                        Slot = item.EquipmentSlot?.ToString() ?? "Gear",
                        CurrentPrice = item.Cost,
                        RecommendedPrice = recPrice
                    };
                })
                .OrderBy(p => p.Slot)
                .ThenBy(p => p.CurrentPrice)
                .ToList();

            Snackbar.Add($"Generated price recommendations for {pricingPreviewItems.Count} permanent items", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error calculating prices: {ex.Message}", Severity.Error);
        }
        finally
        {
            isCalculatingPricing = false;
        }
    }

    private async Task ApplyRecommendedPrices()
    {
        if (recommendedPrices == null || !recommendedPrices.Any())
        {
            Snackbar.Add("Please calculate prices first", Severity.Warning);
            return;
        }

        isApplyingPricing = true;
        try
        {
            var updatedCount = await ShopService.UpdateShopItemPrices(recommendedPrices);
            Snackbar.Add($"Successfully updated {updatedCount} item prices!", Severity.Success);
            
            // Re-run analysis to reflect new prices
            await RunAnalysis();
            pricingPreviewItems.Clear();
            recommendedPrices = null;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error applying prices: {ex.Message}", Severity.Error);
        }
        finally
        {
            isApplyingPricing = false;
        }
    }

    private async Task ExportToJson()
    {
        if (report == null) return;

        var jsonOptions = new JsonSerializerOptions 
        { 
            WriteIndented = true,
            PropertyNamingPolicy = JsonNamingPolicy.CamelCase
        };
        var json = JsonSerializer.Serialize(report, jsonOptions);
        var fileName = $"FishingBalanceReport_{DateTime.Now:yyyyMMdd_HHmmss}.json";
        
        await JSRuntime.InvokeVoidAsync("downloadFile", fileName, json);
        Snackbar.Add($"Report exported as {fileName}", Severity.Success);
    }

    private class VarianceRow
    {
        public string Metric { get; set; } = string.Empty;
        public string Theoretical { get; set; } = string.Empty;
        public string Observed { get; set; } = string.Empty;
        public string Variance { get; set; } = string.Empty;
        public Color DeltaColor { get; set; } = Color.Default;
    }

    private List<VarianceRow> GetVarianceRows()
    {
        if (report == null) return new();

        var successDelta = report.Variance.SuccessRateVariancePercent;
        var goldDelta = report.Variance.GrossGoldCatchVariancePercent;
        var accidentDelta = report.Variance.AccidentRateVariancePercent;
        var netDelta = report.Variance.NetGoldAttemptVariancePercent;

        return new List<VarianceRow>
        {
            new()
            {
                Metric = "Catch Success Rate",
                Theoretical = $"{report.SettingsSnapshot.TheoreticalSuccessRatePercent:F1}%",
                Observed = $"{report.RealEconomy.ObservedSuccessRatePercent:F1}%",
                Variance = $"{(successDelta >= 0 ? "+" : "")}{successDelta:F1}%",
                DeltaColor = Math.Abs(successDelta) <= 2.0 ? Color.Success : (successDelta < -5.0 ? Color.Error : Color.Warning)
            },
            new()
            {
                Metric = "Gross Gold / Catch",
                Theoretical = $"{report.ProjectedEconomy.BaselineGrossGoldPerCatch:F1}g (Baseline)",
                Observed = $"{report.RealEconomy.AverageGoldPerCatch:F1}g",
                Variance = $"{(goldDelta >= 0 ? "+" : "")}{goldDelta:F1}%",
                DeltaColor = goldDelta >= 0 ? Color.Success : Color.Warning
            },
            new()
            {
                Metric = "Combined Accident Rate",
                Theoretical = $"{report.SettingsSnapshot.CombinedAccidentRatePercent:F1}%",
                Observed = $"{(100.0 - report.RealEconomy.ObservedSuccessRatePercent):F1}%",
                Variance = $"{(accidentDelta >= 0 ? "+" : "")}{accidentDelta:F1}%",
                DeltaColor = accidentDelta <= 1.0 ? Color.Success : Color.Warning
            },
            new()
            {
                Metric = "Net Gold / Cast",
                Theoretical = $"{report.ProjectedEconomy.BaselineGrossGoldPerAttempt:F1}g (Baseline)",
                Observed = $"{report.RealEconomy.NetGoldPerAttempt:F1}g",
                Variance = $"{(netDelta >= 0 ? "+" : "")}{netDelta:F1}%",
                DeltaColor = report.RealEconomy.NetGoldPerAttempt > 0 ? Color.Success : Color.Error
            },
            new()
            {
                Metric = "3-Star Catch Rate",
                Theoretical = "5.0% (Baseline)",
                Observed = $"{report.RealEconomy.ObservedThreeStarPercent:F1}%",
                Variance = $"{(report.RealEconomy.ObservedThreeStarPercent >= 5.0 ? "+" : "")}{(report.RealEconomy.ObservedThreeStarPercent - 5.0):F1}%",
                DeltaColor = report.RealEconomy.ObservedThreeStarPercent >= 5.0 ? Color.Success : Color.Warning
            },
            new()
            {
                Metric = "Rare+ Catch Rate",
                Theoretical = $"{report.ProjectedEconomy.TierEconomics.FirstOrDefault(t => t.TierName == "Bare Hands")?.ExpectedRarePlusPercent ?? 5.4:F1}% (Baseline)",
                Observed = $"{report.RealEconomy.ObservedRarePlusPercent:F1}%",
                Variance = $"{(report.RealEconomy.ObservedRarePlusPercent >= 5.4 ? "+" : "")}{(report.RealEconomy.ObservedRarePlusPercent - (report.ProjectedEconomy.TierEconomics.FirstOrDefault(t => t.TierName == "Bare Hands")?.ExpectedRarePlusPercent ?? 5.4)):F1}%",
                DeltaColor = Color.Info
            },
            new()
            {
                Metric = "Average Catch Weight",
                Theoretical = $"{report.ProjectedEconomy.TierEconomics.FirstOrDefault(t => t.TierName == "Bare Hands")?.ExpectedAverageWeight ?? 0:N1} lbs (Baseline)",
                Observed = $"{report.RealEconomy.ObservedAverageWeight:N1} lbs",
                Variance = $"{(report.RealEconomy.ObservedAverageWeight >= (report.ProjectedEconomy.TierEconomics.FirstOrDefault(t => t.TierName == "Bare Hands")?.ExpectedAverageWeight ?? 0) ? "+" : "")}{(report.RealEconomy.ObservedAverageWeight - (report.ProjectedEconomy.TierEconomics.FirstOrDefault(t => t.TierName == "Bare Hands")?.ExpectedAverageWeight ?? 0)):N1} lbs",
                DeltaColor = Color.Primary
            }
        };
    }

    private Color GetEconomicRatingColor(string rating)
    {
        return rating switch
        {
            "Profitable Investment" => Color.Success,
            "Great Value" => Color.Success,
            "Good Value" => Color.Success,
            "Fair Upgrade" => Color.Info,
            "Fair Trade" => Color.Info,
            "Elite Trophy Gear" => Color.Warning,
            "Master Quality Gear" => Color.Warning,
            "Big Game Specialist" => Color.Primary,
            "Prestige Trophy Gear" => Color.Secondary,
            "Luxury Sink" => Color.Default,
            "Consumable Sink" => Color.Error,
            _ => Color.Default
        };
    }
}
