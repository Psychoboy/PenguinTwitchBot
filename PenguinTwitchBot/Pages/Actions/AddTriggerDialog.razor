    {
        _selectedTwitchEvent = eventName;
        _triggerName = eventName;
    }

    private void OnTwitchEventConfigChanged(Bot.Actions.Triggers.TwitchEventTriggerConfig config)
    {
        _twitchEventConfig = config;
    }

    private Task<IEnumerable<DefaultCommand>> SearchDefaultCommands(string value, CancellationToken token)
    {
        var supportedCommandNames = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
        {
            "gamble", "defuse", "roll", "dice", "slot", "slots", "steal", "heist", "death", "spinwheel", "drop", "plinko", "balloon", "curl", "golf", "joinclaw",
            "race", "racing", "kart", "grandprix", "timetrial", "tt"
        };

        var supportedCommands = _defaultCommands
            .Where(d => supportedCommandNames.Contains(d.CommandName));

        if (string.IsNullOrWhiteSpace(value))
        {
            return Task.FromResult(supportedCommands);
        }

        var filtered = supportedCommands.Where(d => 
            d.CommandName.Contains(value, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(filtered);
    }

    private bool IsRacingTrigger() =>
        _selectedType == TriggerTypes.DefaultCommand &&
        (_selectedDefaultCommand?.CommandName?.Equals("race", StringComparison.OrdinalIgnoreCase) == true ||
         _selectedDefaultCommand?.CommandName?.Equals("racing", StringComparison.OrdinalIgnoreCase) == true ||
         _selectedDefaultCommand?.CommandName?.Equals("timetrial", StringComparison.OrdinalIgnoreCase) == true ||
         (!string.IsNullOrEmpty(_selectedEventType) && _selectedEventType.StartsWith("Racing.", StringComparison.OrdinalIgnoreCase)));

    private void OnRacingPlacementPresetChanged(string preset)
    {
        _racingPlacementPreset = preset;
        switch (preset)
        {
            case "First":
                _racingPlacements = new HashSet<int> { 1 };
                _racingMinPlacement = null;
                _racingMaxPlacement = null;
                break;
            case "Second":
                _racingPlacements = new HashSet<int> { 2 };
                _racingMinPlacement = null;
                _racingMaxPlacement = null;
                break;
            case "Third":
                _racingPlacements = new HashSet<int> { 3 };
                _racingMinPlacement = null;
                _racingMaxPlacement = null;
                break;
            case "Podium":
                _racingPlacements = new HashSet<int> { 1, 2, 3 };
                _racingMinPlacement = null;
                _racingMaxPlacement = null;
                break;
            case "Top5":
                _racingPlacements = new HashSet<int> { 1, 2, 3, 4, 5 };
                _racingMinPlacement = null;
                _racingMaxPlacement = null;
                break;
            case "Participation":
                _racingPlacements = new HashSet<int>();
                _racingMinPlacement = 4;
                _racingMaxPlacement = null;
                break;
            case "Any":
                _racingPlacements = new HashSet<int>();
                _racingMinPlacement = null;
                _racingMaxPlacement = null;
                break;
            case "Custom":
                break;
        }
    }

    private void OnDefaultCommandChanged(DefaultCommand? defaultCommand)
    {
        _selectedDefaultCommand = defaultCommand;
        _selectedEventType = "";

        UpdateDefaultCommandTriggerName();

        if (IsRacingTrigger())
        {
            OnRacingPlacementPresetChanged("Any");
        }
    }

    private void UpdateDefaultCommandTriggerName()
    {
        if (_selectedDefaultCommand != null && !string.IsNullOrEmpty(_selectedEventType))
        {
            _triggerName = TriggerCatalog.GetDefaultCommandTriggerName(_selectedDefaultCommand.CommandName, _selectedEventType);
        }
    }

    private void OnEventTypeChanged(string eventType)
    {
        _selectedEventType = eventType;
        UpdateDefaultCommandTriggerName();

        if (IsRacingTrigger())
        {
            if (eventType == DefaultCommandEventTypes.RacingWin)
                OnRacingPlacementPresetChanged("First");
            else if (eventType == DefaultCommandEventTypes.RacingPodium)
                OnRacingPlacementPresetChanged("Podium");
            else if (_racingPlacementPreset == "First" || _racingPlacementPreset == "Podium")
                OnRacingPlacementPresetChanged("Any");
        }
    }

