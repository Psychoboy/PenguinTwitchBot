@using PenguinTwitchBot.Database.Bot.Models.Actions.Triggers
@using PenguinTwitchBot.Database.Bot.Models.Commands
@using PenguinTwitchBot.Bot.Commands
@using PenguinTwitchBot.Database.Bot.Models.Timers
@using PenguinTwitchBot.Bot.Actions.Triggers
@using PenguinTwitchBot.Database.Bot.Actions.Triggers.Configurations
@using PenguinTwitchBot.Bot.Features
@using PenguinTwitchBot.Database.Bot.Models.Fishing
@using PenguinTwitchBot.Bot.Commands.Fishing
@using MudBlazor
@using PenguinTwitchBot.Pages.Components

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            @if (_currentStep == WizardStep.SelectCategory)
            {
                <MudText Typo="Typo.h6">Select Trigger Type</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Choose a category or search for a trigger</MudText>

                <MudTextField @bind-Value="_searchText" Placeholder="Search triggers..."
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Clearable="true" Immediate="true" Margin="Margin.Dense" Class="trigger-search" />

                <div style="max-height: 400px; overflow-y: auto;">
                    <MudList T="string">
                        @if (string.IsNullOrWhiteSpace(_searchText))
                        {
                            @foreach (var cat in GetAvailableCategories())
                            {
                                <MudListItem T="string" class="@($"trigger-item trigger-category trigger-category-{cat.Id} trigger-{cat.Id}-category")" OnClick="@(() => SelectCategory(cat))">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudIcon Icon="@cat.Icon" Color="@cat.Color" />
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.body1"><b>@cat.Name</b></MudText>
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">@cat.Description</MudText>
                                        </MudStack>
                                        <MudSpacer />
                                        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Default" />
                                    </MudStack>
                                </MudListItem>
                                <MudDivider />
                            }
                        }
                        else
                        {
                            @foreach (var item in GetSearchResults())
                            {
                                <MudListItem T="string" class="@($"trigger-item trigger-{item.Id}")" OnClick="@(() => SelectTrigger(item))">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudIcon Icon="@item.Icon" Color="@item.Color" />
                                        <MudStack Spacing="0">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                <MudText Typo="Typo.body1"><b>@item.DisplayName</b></MudText>
                                                <MudChip T="string" Size="Size.Small" Color="@item.Color" Variant="Variant.Outlined" Class="ml-1 px-1 py-0" Style="font-size: 0.7rem; height: 18px;">@item.CategoryName</MudChip>
                                            </MudStack>
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">@item.Description</MudText>
                                        </MudStack>
                                    </MudStack>
                                </MudListItem>
                                <MudDivider />
                            }
                        }
                    </MudList>
                </div>
            }
            else if (_currentStep == WizardStep.SelectTrigger && _selectedCategory != null)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-1">
                    <MudIcon Icon="@_selectedCategory.Icon" Color="@_selectedCategory.Color" />
                    <MudText Typo="Typo.h6">@_selectedCategory.Name Triggers</MudText>
                </MudStack>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">Select a trigger from @_selectedCategory.Name</MudText>
                <div style="max-height: 400px; overflow-y: auto;">
                    <MudList T="string">
                        @foreach (var item in GetCategoryTriggers(_selectedCategory))
                        {
                            <MudListItem T="string" class="@($"trigger-item trigger-{item.Id}")" OnClick="@(() => SelectTrigger(item))">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudIcon Icon="@item.Icon" Color="@item.Color" />
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.body1"><b>@item.DisplayName</b></MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">@item.Description</MudText>
                                    </MudStack>
                                </MudStack>
                            </MudListItem>
                            <MudDivider />
                        }
                    </MudList>
                </div>
            }
            else if (_currentStep == WizardStep.Configure)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3 configure-step">
                    <MudIcon Icon="@GetConfigureIcon()" Color="@GetConfigureColor()" />
                    <MudText Typo="Typo.h6">Configure @GetConfigureTitle()</MudText>
                </MudStack>

                <!-- Trigger Configuration based on type -->
                @if (_selectedType == TriggerTypes.Command)
                {
                    <CommandSelector SelectedCommandId="_selectedCommandId" 
                                     SelectedCommandIdChanged="OnCommandSelected"
                                     OnCommandCreated="OnCommandCreated"
                                     SelectLabel="Select Command"
                                     Required="true"
                                     AllowNone="true"
                                     AllowCreate="true"/>

                    <MudTextField @bind-Value="_triggerName" Label="Trigger Name" Variant="Variant.Outlined" 
                                  Required="true" Placeholder="e.g., My Command Trigger" ReadOnly="true" />
                }
                else if (_selectedType == TriggerTypes.Timer)
                {
                    <MudAutocomplete T="TimerGroup" 
                                     Value="_selectedTimerGroup" 
                                     ValueChanged="OnTimerGroupChanged"
                                     Label="Select Timer Group" 
                                     Variant="Variant.Outlined" 
                                     Required="true" 
                                     SearchFunc="SearchTimerGroups"
                                     ToStringFunc="@(t => t?.Name ?? string.Empty)"
                                     MaxItems="null"
                                     ResetValueOnEmptyText="true"
                                     CoerceValue="false" />

                    <MudTextField @bind-Value="_triggerName" Label="Trigger Name" Variant="Variant.Outlined" 
                                  Required="true" Placeholder="e.g., My Timer Trigger" ReadOnly="true" />
                }
                else if (_selectedType == TriggerTypes.Keyword)
                {
                    <KeywordSelector SelectedKeywordId="_selectedKeywordId" 
                                     SelectedKeywordIdChanged="OnKeywordSelected"
                                     OnKeywordCreated="OnKeywordCreated"
                                     SelectLabel="Select Keyword"
                                     Required="true"
                                     AllowNone="true"
                                     AllowCreate="true" />

                    <MudTextField @bind-Value="_triggerName" Label="Trigger Name" Variant="Variant.Outlined" 
                                  Required="true" Placeholder="e.g., My Keyword Trigger" ReadOnly="true" />
                }
                else if (_selectedType == TriggerTypes.TwitchEvent)
                {
                    <TwitchEventTriggerConfigComponent SelectedEventName="@_selectedTwitchEvent"
                                                       SelectedEventNameChanged="OnTwitchEventSelected"
                                                       Config="@_twitchEventConfig"
                                                       ConfigChanged="@OnTwitchEventConfigChanged" />
                }
                else if (_selectedType == TriggerTypes.DefaultCommand)
                {
                    <MudAutocomplete T="DefaultCommand" 
                                     Value="_selectedDefaultCommand" 
                                     ValueChanged="OnDefaultCommandChanged"
                                     Label="Select Default Command" 
                                     Variant="Variant.Outlined" 
                                     Required="true" 
                                     SearchFunc="SearchDefaultCommands"
                                     ToStringFunc="@(d => d?.CommandName ?? string.Empty)"
                                     MaxItems="null"
                                     ResetValueOnEmptyText="true"
                                     CoerceValue="false" />

                    @if (_selectedDefaultCommand != null)
                    {
                        <MudSelect T="string" 
                                   Value="_selectedEventType"
                                   ValueChanged="OnEventTypeChanged"
                                   Label="Select Event Type" 
                                   Variant="Variant.Outlined" 
                                   Required="true">
                            @foreach (var eventType in GetEventTypesForCommand(_selectedDefaultCommand.CommandName))
                            {
                                <MudSelectItem Value="@eventType">@GetEventTypeDisplayName(eventType)</MudSelectItem>
                            }
                        </MudSelect>
                    }

                    <MudTextField @bind-Value="_triggerName" Label="Trigger Name" Variant="Variant.Outlined" 
                                  Required="true" Placeholder="e.g., Gamble Jackpot Win" ReadOnly="true" />

                    @if (IsRacingTrigger())
                    {
                        <MudPaper Outlined="true" Class="pa-3 mt-3">
                            <MudText Typo="Typo.subtitle2" Class="mb-2">🏁 Racing Trigger Filters (Optional)</MudText>
                            
                            <MudSelect T="string" Label="Placement Filter" Variant="Variant.Outlined" Margin="Margin.Dense"
                                       Value="_racingPlacementPreset" ValueChanged="OnRacingPlacementPresetChanged" Class="mb-2"
                                       HelperText="Filter when this trigger fires based on final placement.">
                                <MudSelectItem Value="@("Any")">Any Placement (All Finishers)</MudSelectItem>
                                <MudSelectItem Value="@("First")">1st Place Only (Winner)</MudSelectItem>
                                <MudSelectItem Value="@("Second")">2nd Place Only</MudSelectItem>
                                <MudSelectItem Value="@("Third")">3rd Place Only</MudSelectItem>
                                <MudSelectItem Value="@("Podium")">Top 3 (Podium - 1st, 2nd, or 3rd)</MudSelectItem>
                                <MudSelectItem Value="@("Top5")">Top 5 (1st through 5th)</MudSelectItem>
                                <MudSelectItem Value="@("Participation")">4th Place or Worse (Participation)</MudSelectItem>
                                <MudSelectItem Value="@("Custom")">Specific Custom Placements...</MudSelectItem>
                            </MudSelect>

                            @if (_racingPlacementPreset == "Custom")
                            {
                                <MudGrid Spacing="2" Class="mb-2">
                                    <MudItem xs="12">
                                        <MudSelect T="int" @bind-SelectedValues="_racingPlacements"
                                                   Label="Specific Placements" MultiSelection="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                   HelperText="Select exact placements that will trigger this action">
                                            @for (int i = 1; i <= 16; i++)
                                            {
                                                var place = i;
                                                var suffix = place switch { 1 => "st", 2 => "nd", 3 => "rd", _ => "th" };
                                                <MudSelectItem T="int" Value="@place">@($"{place}{suffix} Place")</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="6">
                                        <MudNumericField T="int?" @bind-Value="_racingMinPlacement" Label="Min Placement (>=)" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="32" HelperText="e.g. 4 for 4th or worse" />
                                    </MudItem>
                                    <MudItem xs="6">
                                        <MudNumericField T="int?" @bind-Value="_racingMaxPlacement" Label="Max Placement (<=)" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="32" HelperText="e.g. 3 for top 3" />
                                    </MudItem>
                                </MudGrid>
                            }

                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6">
                                    <MudSelect T="string" @bind-SelectedValues="_racingGameModes"
                                               Label="Game Mode Filter" MultiSelection="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                               HelperText="Leave empty to trigger on all game modes">
                                        <MudSelectItem T="string" Value="@("GrandPrix")">Grand Prix</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("DestructionDerby")">Destruction Derby</MudSelectItem>
                                        <MudSelectItem T="string" Value="@("TimeTrial")">Time Trial</MudSelectItem>
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudSelect T="string" @bind-Value="_racingOutcomeFilter"
                                               Label="Outcome Status" Variant="Variant.Outlined" Margin="Margin.Dense"
                                               HelperText="Filter by vehicle outcome condition">
                                        <MudSelectItem Value="@("Any")">Any Outcome</MudSelectItem>
                                        <MudSelectItem Value="@("Survived")">Survived Only (Not Totaled)</MudSelectItem>
                                        <MudSelectItem Value="@("Totaled")">Totaled / Eliminated Only</MudSelectItem>
                                        <MudSelectItem Value="@("CleanRace")">Clean Race Only (0 Wrecks)</MudSelectItem>
                                    </MudSelect>
                                </MudItem>
                                @if (_selectedEventType == DefaultCommandEventTypes.RacingDerbyKnockout || _racingGameModes.Contains("DestructionDerby"))
                                {
                                    <MudItem xs="12">
                                        <MudNumericField T="int?" @bind-Value="_racingMinKnockouts" Label="Min Knockouts Required" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="20" HelperText="Only fire if racer scored at least this many knockouts" />
                                    </MudItem>
                                }
                            </MudGrid>
                        </MudPaper>
                    }

                    @if (!string.IsNullOrEmpty(_selectedEventType))
                    {
                        var vars = GetDefaultCommandVariablesSummary(_selectedEventType);
                        if (!string.IsNullOrEmpty(vars))
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                                Variables added: @vars
                            </MudAlert>
                        }
                    }
                }
                else if (_selectedType == TriggerTypes.FishingTournamentCatch)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        Variables added: %fishing_tournament_eligible%, %fishing_tournament_match_count%, %fishing_tournament_ids%,
                        %fishing_tournament_names%, %fishing_tournament_primary_score_categories%, %fishing_tournament_id%,
                        %fishing_tournament_name%, %fishing_tournament_primary_score_category%,
                        %fishing_tournament_qualifying% (has rank), %fishing_tournament_qualifying_rank%,
                        %fishing_tournament_qualifying_match_count%, %fishing_tournament_qualifying_ids%,
                        %fishing_tournament_qualifying_names%,
                        %fishing_tournament_reward_qualifying% (would win reward now), %fishing_tournament_reward_qualifying_match_count%,
                        %fishing_tournament_reward_qualifying_ids%, %fishing_tournament_reward_qualifying_names%,
                        %fishing_tournament_reward_qualifying_max_place%.
                    </MudAlert>

                    <MudSwitch T="bool"
                               @bind-Value="_fishingTournamentCatchConfig.RequireEligibleTournamentFish"
                               Color="Color.Primary"
                               Label="Require Eligible Tournament Fish" />

                    <MudSwitch T="bool"
                               @bind-Value="_fishingTournamentCatchConfig.RequireQualifyingPosition"
                               Color="Color.Info"
                               Label="Require Reward-Qualifying Position" />

                    <MudNumericField T="int"
                                     @bind-Value="_fishingTournamentCatchConfig.QualifyingPlacementOverride"
                                     Label="Qualifying Max Place Override"
                                     Min="0"
                                     HelperText="0 uses reward-rule placements; values above 0 force a top-N cutoff." />

                    <MudTextField @bind-Value="_triggerName" Label="Trigger Name" Variant="Variant.Outlined"
                                  Required="true" ReadOnly="true" />
                }
                else if (_selectedType == TriggerTypes.FishingTournamentStart)
                {
                    <MudAlert Severity="Severity.Info">
                        Fires when any fishing tournament starts.
                    </MudAlert>

                    <MudAlert Severity="Severity.Info" Dense="true">
                        Variables added: %fishing_tournament_id%, %fishing_tournament_name%, %fishing_tournament_description%,
                        %fishing_tournament_status%, %fishing_tournament_enabled%, %fishing_tournament_primary_score_category%,
                        %fishing_tournament_starts_at_utc%, %fishing_tournament_ends_at_utc%,
                        %fishing_tournament_eligible_fish_count%, %fishing_tournament_eligible_fish_names%,
                        %fishing_tournament_eligible_fish_preview%, %fishing_tournament_eligible_fish_over_three%,
                        %fishing_tournament_reward_winner_count%, %fishing_tournament_reward_winner_names%,
                        %fishing_tournament_reward_winner_ids%, %fishing_tournament_reward_summary%.
                    </MudAlert>

                    <MudTextField @bind-Value="_triggerName" Label="Trigger Name" Variant="Variant.Outlined"
                                  Required="true" ReadOnly="true" />
                }
                else if (_selectedType == TriggerTypes.FishingTournamentEnd)
                {
                    <MudAlert Severity="Severity.Info">
                        Fires when a fishing tournament ends and reward winners are computed.
                    </MudAlert>

                    <MudAlert Severity="Severity.Info" Dense="true">
                        Variables added: %fishing_tournament_id%, %fishing_tournament_name%, %fishing_tournament_description%,
                        %fishing_tournament_status%, %fishing_tournament_enabled%, %fishing_tournament_primary_score_category%,
                        %fishing_tournament_starts_at_utc%, %fishing_tournament_ends_at_utc%,
                        %fishing_tournament_eligible_fish_count%, %fishing_tournament_eligible_fish_names%,
                        %fishing_tournament_eligible_fish_preview%, %fishing_tournament_eligible_fish_over_three%,
                        %fishing_tournament_reward_winner_count%, %fishing_tournament_reward_winner_names%,
                        %fishing_tournament_reward_winner_ids%, %fishing_tournament_reward_summary%.
                    </MudAlert>

                    <MudTextField @bind-Value="_triggerName" Label="Trigger Name" Variant="Variant.Outlined"
                                  Required="true" ReadOnly="true" />
                }
                else if (_selectedType == TriggerTypes.FishCatch)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        Fires whenever a fish is successfully caught. All filters are optional — leave empty to match any catch.
                        Variables added: %fish_type%, %fish_type_id%, %fish_rarity%, %fish_stars%, %fish_weight%, %fish_gold%, %fish_categories%.
                    </MudAlert>

                    @if (_fishTypes.Count > 0)
                    {
                        <MudSelect T="int" @bind-SelectedValues="_fishCatchFishTypeIds"
                                   Label="Specific Fish Types" MultiSelection="true" Variant="Variant.Outlined"
                                   ToStringFunc="GetFishTypeNameById"
                                   HelperText="Leave empty to include all fish types">
                            @foreach (var fish in _fishTypes)
                            {
                                <MudSelectItem T="int" Value="@fish.Id">@fish.Name (@fish.Rarity)</MudSelectItem>
                            }
                        </MudSelect>
                    }

                    @if (FishCatchAvailableCategories.Count > 0)
                    {
                        <MudSelect T="string" @bind-SelectedValues="_fishCatchCategories"
                                   Label="Category Filter" MultiSelection="true" Variant="Variant.Outlined"
                                   HelperText="Only fire for fish belonging to at least one selected category">
                            @foreach (var cat in FishCatchAvailableCategories)
                            {
                                <MudSelectItem T="string" Value="@cat">@cat</MudSelectItem>
                            }
                        </MudSelect>
                    }

                    <MudSelect T="string" @bind-SelectedValues="_fishCatchRarities"
                               Label="Rarity Filter" MultiSelection="true" Variant="Variant.Outlined"
                               HelperText="Only fire for fish with one of these rarities">
                        @foreach (var rarity in Enum.GetNames<FishRarity>())
                        {
                            <MudSelectItem T="string" Value="@rarity">@rarity</MudSelectItem>
                        }
                    </MudSelect>

                    <MudNumericField T="int" @bind-Value="_fishCatchMinStars"
                                     Label="Minimum Stars" Min="0" Max="3" Variant="Variant.Outlined"
                                     HelperText="0 = any number of stars" />

                    <MudNumericField T="double" @bind-Value="_fishCatchMinWeight"
                                     Label="Minimum Weight (kg)" Min="0" Variant="Variant.Outlined"
                                     HelperText="0 = any weight" />

                    <MudNumericField T="int" @bind-Value="_fishCatchMinGold"
                                     Label="Minimum Gold Earned" Min="0" Variant="Variant.Outlined"
                                     HelperText="0 = any gold amount" />

                    <MudSwitch T="bool" @bind-Value="_fishCatchRequireActiveTournament" Color="Color.Primary"
                               Label="Only fire when fish is eligible for an active tournament" />

                    <MudTextField @bind-Value="_triggerName" Label="Trigger Name" Variant="Variant.Outlined"
                                  Required="true" ReadOnly="true" />
                }
                else if (_selectedType == TriggerTypes.FishingItemBroken)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        Fires whenever an equipped item's durability reaches 0% (breaks).
                        Variables added: %user%, %userid%, %broken_item_name%, %broken_item_slot%, %broken_item_shop_id%, %broken_item_boost_id%, %broken_item_cost%, %broken_item_replaced%, %broken_items_count%.
                    </MudAlert>

                    <MudSelect T="string" @bind-SelectedValues="_fishingItemBrokenSlots"
                               Label="Equipment Slot Filter" MultiSelection="true" Variant="Variant.Outlined"
                               HelperText="Leave empty to trigger on any slot">
                        @foreach (var slot in Enum.GetNames<EquipmentSlot>())
                        {
                            <MudSelectItem T="string" Value="@slot">@slot</MudSelectItem>
                        }
                    </MudSelect>

                    <MudTextField @bind-Value="_triggerName" Label="Trigger Name" Variant="Variant.Outlined"
                                  Required="true" ReadOnly="true" />
                }
                else if (_selectedType == TriggerTypes.FishingAccident)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        Fires whenever a fishing accident occurs (line snap, rod break, reel jam, tackle box loss, net break).
                        Variables added: %user%, %userid%, %accident_type%, %accident_name%, %accident_reason%, %accident_gear%, %accident_items_lost%, %accident_gold_lost%.
                    </MudAlert>

                    <MudSelect T="FishingAttemptOutcome" @bind-SelectedValues="_fishingAccidentOutcomes"
                               Label="Accident Types Filter" MultiSelection="true" Variant="Variant.Outlined"
                               HelperText="Leave empty to trigger on all accidents">
                        <MudSelectItem T="FishingAttemptOutcome" Value="@FishingAttemptOutcome.LineSnapped">Line Snapped</MudSelectItem>
                        <MudSelectItem T="FishingAttemptOutcome" Value="@FishingAttemptOutcome.RodSnapped">Rod Snapped</MudSelectItem>
                        <MudSelectItem T="FishingAttemptOutcome" Value="@FishingAttemptOutcome.ReelJammed">Reel Jammed</MudSelectItem>
                        <MudSelectItem T="FishingAttemptOutcome" Value="@FishingAttemptOutcome.TackleBoxLost">Tackle Box Lost</MudSelectItem>
                        <MudSelectItem T="FishingAttemptOutcome" Value="@FishingAttemptOutcome.NetBroken">Net Broken</MudSelectItem>
                    </MudSelect>

                    <MudTextField @bind-Value="_triggerName" Label="Trigger Name" Variant="Variant.Outlined"
                                  Required="true" ReadOnly="true" />
                }
                else if (_selectedType == TriggerTypes.BannedSongRequest)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        Fires whenever someone requests a song that is on the banned songs list.
                        Variables added: %user%, %banned_song_id%, %banned_song_title%, %banned_song_reason%,
                        %banned_song_banned_by%, %banned_song_url%, %banned_song_request%.
                    </MudAlert>

                    <MudTextField @bind-Value="_triggerName" Label="Trigger Name" Variant="Variant.Outlined"
                                  Required="true" ReadOnly="true" />
                }
                else if (_selectedType == TriggerTypes.Manual)
                {
                    <MudAlert Severity="Severity.Info">
                        Fires manually when triggered from the dashboard or via an API call.
                    </MudAlert>

                    <MudTextField @bind-Value="_triggerName" Label="Trigger Name" Variant="Variant.Outlined" 
                                  Required="true" Placeholder="e.g., Manual Trigger" />
                }
                else
                {
                    <MudAlert Severity="Severity.Info">
                        Configure @_selectedType trigger settings.
                    </MudAlert>

                    <MudTextField @bind-Value="_triggerName" Label="Trigger Name" Variant="Variant.Outlined" 
                                  Required="true" Placeholder="e.g., My Trigger" />
                }
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        @if (_currentStep != WizardStep.SelectCategory && !IsEditMode)
        {
            <MudButton class="btn-back" OnClick="GoBack" StartIcon="@Icons.Material.Filled.ArrowBack">Back</MudButton>
        }
        <MudButton OnClick="Cancel">Cancel</MudButton>
        @if (_currentStep == WizardStep.Configure)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" 
                       Disabled="@(!CanSubmit())">
                @(IsEditMode ? "Update Trigger" : "Add Trigger")
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] 
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public int ActionId { get; set; }
    [Parameter] public TriggerType? ExistingTrigger { get; set; }
    [Inject] private IActionCommandService CommandService { get; set; } = null!;
    [Inject] private IActionKeywordService KeywordService { get; set; } = null!;
    [Inject] private PenguinTwitchBot.Bot.Commands.Misc.IAutoTimers TimersService { get; set; } = null!;
    [Inject] private ICommandHandler CommandHandler { get; set; } = null!;
    [Inject] private IFeatureRuntimeCoordinator FeatureRuntimeCoordinator { get; set; } = null!;
    [Inject] private IFishingService FishingService { get; set; } = null!;

    private enum WizardStep
    {
        SelectCategory,
        SelectTrigger,
        Configure
    }

    private WizardStep _currentStep = WizardStep.SelectCategory;
    private WizardStep _previousStep = WizardStep.SelectCategory;
    private TriggerCategoryInfo? _selectedCategory;
    private TriggerItemInfo? _selectedItem;
    private string _searchText = "";

    private TriggerTypes? _selectedType;
    private List<ActionCommand> _commands = new();
    private List<ActionKeyword> _keywords = new();
    private List<TimerGroup> _timerGroups = new();
    private List<DefaultCommand> _defaultCommands = new();
    private int? _selectedCommandId;
    private int? _selectedKeywordId;
    private TimerGroup? _selectedTimerGroup;
    private DefaultCommand? _selectedDefaultCommand;
    private string _selectedEventType = "";
    private string _selectedTwitchEvent = "";
    private Bot.Actions.Triggers.TwitchEventTriggerConfig _twitchEventConfig = new();
    private FishingTournamentCatchTriggerConfiguration _fishingTournamentCatchConfig = new();
    private string _triggerName = "";

    // Racing Trigger Filters
    private string _racingPlacementPreset = "Any";
    private IReadOnlyCollection<int> _racingPlacements = new HashSet<int>();
    private int? _racingMinPlacement;
    private int? _racingMaxPlacement;
