        .OrderBy(c => c, StringComparer.OrdinalIgnoreCase)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        // Load all action commands for the dropdown
        _commands = (await CommandService.GetAllAsync()).OrderBy(c => c.CommandName).ToList();

        // Load all action keywords for the dropdown
        _keywords = (await KeywordService.GetAllAsync()).OrderBy(k => k.CommandName).ToList();

        // Load all timer groups for the dropdown
        _timerGroups = (await TimersService.GetTimerGroupsAsync()).OrderBy(t => t.Name).ToList();

        // Load all default commands for the dropdown
        _defaultCommands = (await CommandHandler.GetDefaultCommandsFromDb()).OrderBy(d => d.CommandName).ToList();

        // Load fish types for FishCatch trigger configuration
        if (IsTriggerTypeAvailable(TriggerTypes.FishCatch))
        {
            _fishTypes = await FishingService.GetAllFishTypes();
        }

        if (IsEditMode && ExistingTrigger != null)
        {
            LoadFromExistingTrigger(ExistingTrigger);
        }
    }

    private void LoadFromExistingTrigger(TriggerType trigger)
    {
        _selectedType = trigger.Type;
        _currentStep = WizardStep.Configure;
        _triggerName = trigger.Name;

        _selectedCommandId = trigger.CommandId;
        _selectedKeywordId = trigger.KeywordId;
        _selectedDefaultCommand = _defaultCommands.FirstOrDefault(c => c.Id == trigger.DefaultCommandId);
        _selectedTimerGroup = _timerGroups.FirstOrDefault(t => t.Id == trigger.TimerGroupId);

        if (trigger.Type == TriggerTypes.TwitchEvent)
        {
            if (Bot.Actions.Triggers.TwitchEventTriggerConfig.TryFromJson(trigger.Configuration, out var config) && config != null)
            {
                _twitchEventConfig = config;
                _selectedTwitchEvent = config.EventName;
                if (!string.IsNullOrWhiteSpace(config.EventName))
                {
                    _triggerName = config.EventName;
                }
            }
            else
            {
                _selectedTwitchEvent = trigger.Name;
            }
            _selectedItem = TriggerCatalog.FindItem(trigger.Type, twitchEventName: _selectedTwitchEvent);
        }
        else if (trigger.Type == TriggerTypes.DefaultCommand)
        {
            try
            {
                var config = System.Text.Json.JsonSerializer.Deserialize<DefaultCommandTriggerConfiguration>(trigger.Configuration);
                if (config != null)
                {
                    _selectedEventType = config.EventType;
                    _selectedDefaultCommand ??= _defaultCommands.FirstOrDefault(c =>
                        string.Equals(c.CommandName, config.DefaultCommandName, StringComparison.OrdinalIgnoreCase));
                    _selectedItem = TriggerCatalog.FindItem(trigger.Type, config.DefaultCommandName, config.EventType);

                    // Load Racing Filters
                    _racingPlacements = new HashSet<int>(config.Placements ?? []);
                    _racingMinPlacement = config.MinPlacement;
                    _racingMaxPlacement = config.MaxPlacement;
                    _racingGameModes = new HashSet<string>(config.RacingGameModes ?? [], StringComparer.OrdinalIgnoreCase);
                    _racingOutcomeFilter = string.IsNullOrWhiteSpace(config.RacingOutcomeFilter) ? "Any" : config.RacingOutcomeFilter;
                    _racingMinKnockouts = config.MinKnockouts;

                    // Infer preset
                    if (_racingPlacements.Count == 1 && _racingPlacements.Contains(1) && _racingMinPlacement == null && _racingMaxPlacement == null)
                        _racingPlacementPreset = "First";
                    else if (_racingPlacements.Count == 1 && _racingPlacements.Contains(2) && _racingMinPlacement == null && _racingMaxPlacement == null)
                        _racingPlacementPreset = "Second";
                    else if (_racingPlacements.Count == 1 && _racingPlacements.Contains(3) && _racingMinPlacement == null && _racingMaxPlacement == null)
                        _racingPlacementPreset = "Third";
                    else if (_racingPlacements.Count == 3 && _racingPlacements.All(p => p is >= 1 and <= 3) && _racingMinPlacement == null && _racingMaxPlacement == null)
                        _racingPlacementPreset = "Podium";
                    else if (_racingPlacements.Count == 5 && _racingPlacements.All(p => p is >= 1 and <= 5) && _racingMinPlacement == null && _racingMaxPlacement == null)
                        _racingPlacementPreset = "Top5";
                    else if (_racingMinPlacement == 4 && _racingPlacements.Count == 0 && _racingMaxPlacement == null)
                        _racingPlacementPreset = "Participation";
                    else if (_racingPlacements.Count > 0 || _racingMinPlacement.HasValue || _racingMaxPlacement.HasValue)
                        _racingPlacementPreset = "Custom";
                    else
                        _racingPlacementPreset = "Any";
                }
            }
            catch { }
        }
        else if (trigger.Type == TriggerTypes.FishingTournamentCatch)
        {
            try
            {
                _fishingTournamentCatchConfig = System.Text.Json.JsonSerializer.Deserialize<FishingTournamentCatchTriggerConfiguration>(trigger.Configuration)
                    ?? new FishingTournamentCatchTriggerConfiguration();
            }
            catch
            {
                _fishingTournamentCatchConfig = new FishingTournamentCatchTriggerConfiguration();
            }
            _selectedItem = TriggerCatalog.FindItem(trigger.Type);
        }
        else if (trigger.Type == TriggerTypes.FishCatch)
        {
            try
            {
                var config = System.Text.Json.JsonSerializer.Deserialize<FishCatchTriggerConfiguration>(trigger.Configuration)
                    ?? new FishCatchTriggerConfiguration();
                _fishCatchFishTypeIds = new HashSet<int>(config.FishTypeIds);
                _fishCatchCategories = new HashSet<string>(config.Categories, StringComparer.OrdinalIgnoreCase);
                _fishCatchRarities = new HashSet<string>(config.Rarities, StringComparer.OrdinalIgnoreCase);
                _fishCatchMinStars = config.MinStars;
                _fishCatchMinWeight = config.MinWeight;
                _fishCatchMinGold = config.MinGold;
                _fishCatchRequireActiveTournament = config.RequireActiveTournament;
            }
            catch
            {
                _fishCatchFishTypeIds = new HashSet<int>();
                _fishCatchCategories = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
                _fishCatchRarities = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
                _fishCatchMinStars = 0;
                _fishCatchMinWeight = 0;
                _fishCatchMinGold = 0;
                _fishCatchRequireActiveTournament = false;
            }
            _selectedItem = TriggerCatalog.FindItem(trigger.Type);
        }
        else if (trigger.Type == TriggerTypes.FishingItemBroken)
        {
            try
            {
                var config = System.Text.Json.JsonSerializer.Deserialize<FishingItemBrokenTriggerConfiguration>(trigger.Configuration)
                    ?? new FishingItemBrokenTriggerConfiguration();
                _fishingItemBrokenSlots = new HashSet<string>(config.EquipmentSlots ?? []);
                _fishingItemBrokenShopItemIds = config.ShopItemIds ?? [];
            }
            catch
            {
                _fishingItemBrokenSlots = new HashSet<string>();
                _fishingItemBrokenShopItemIds = new List<int>();
            }
            _selectedItem = TriggerCatalog.FindItem(trigger.Type);
        }
        else if (trigger.Type == TriggerTypes.FishingAccident)
        {
            try
            {
                var config = System.Text.Json.JsonSerializer.Deserialize<FishingAccidentTriggerConfiguration>(trigger.Configuration)
                    ?? new FishingAccidentTriggerConfiguration();
                _fishingAccidentOutcomes = new HashSet<FishingAttemptOutcome>(config.AccidentTypes);
            }
            catch
            {
                _fishingAccidentOutcomes = new HashSet<FishingAttemptOutcome>();
            }
            _selectedItem = TriggerCatalog.FindItem(trigger.Type);
        }
        else
        {
            _selectedItem = TriggerCatalog.FindItem(trigger.Type);
        }
    }

