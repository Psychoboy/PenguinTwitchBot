    private bool CanSubmit()
    {
        if (_currentStep != WizardStep.Configure) return false;
        if (string.IsNullOrWhiteSpace(_triggerName)) return false;
        if (_selectedType.HasValue && !IsTriggerTypeAvailable(_selectedType.Value)) return false;

        // For command type, require a command to be selected
        if (_selectedType == TriggerTypes.Command && !_selectedCommandId.HasValue)
            return false;

        // For keyword type, require a keyword to be selected
        if (_selectedType == TriggerTypes.Keyword && !_selectedKeywordId.HasValue)
            return false;

        // For timer type, require a timer group to be selected
        if (_selectedType == TriggerTypes.Timer && _selectedTimerGroup == null)
            return false;

        // For Twitch event type, require an event to be selected
        if (_selectedType == TriggerTypes.TwitchEvent && string.IsNullOrEmpty(_selectedTwitchEvent))
            return false;

        // For default command type, require a command and event type to be selected
        if (_selectedType == TriggerTypes.DefaultCommand && 
            (_selectedDefaultCommand == null || string.IsNullOrEmpty(_selectedEventType)))
            return false;

        return true;
    }

    private async Task Submit()
    {
        if (!CanSubmit() || !_selectedType.HasValue) return;

        var configuration = "";
        int? commandIdRef = null;
        int? keywordIdRef = null;
        int? timerGroupIdRef = null;
        int? defaultCommandIdRef = null;

        // Build configuration JSON based on trigger type
        if (_selectedType == TriggerTypes.Command && _selectedCommandId.HasValue)
        {
            var command = _commands.FirstOrDefault(c => c.Id == _selectedCommandId);
            if (command != null)
            {
                commandIdRef = command.Id;
                configuration = System.Text.Json.JsonSerializer.Serialize(new
                {
                    CommandId = command.Id,
                    CommandName = command.CommandName
                });
            }
        }
        else if (_selectedType == TriggerTypes.Keyword && _selectedKeywordId.HasValue)
        {
            var keyword = _keywords.FirstOrDefault(k => k.Id == _selectedKeywordId);
            if (keyword != null)
            {
                keywordIdRef = keyword.Id;
                configuration = System.Text.Json.JsonSerializer.Serialize(new
                {
                    KeywordId = keyword.Id,
                    KeywordName = keyword.CommandName
                });
            }
        }
        else if (_selectedType == TriggerTypes.Timer && _selectedTimerGroup?.Id.HasValue == true)
        {
            timerGroupIdRef = _selectedTimerGroup.Id;
            configuration = System.Text.Json.JsonSerializer.Serialize(new
            {
                TimerGroupId = _selectedTimerGroup.Id.Value,
                TimerGroupName = _selectedTimerGroup.Name
            });
        }
        else if (_selectedType == TriggerTypes.TwitchEvent && !string.IsNullOrEmpty(_selectedTwitchEvent))
        {
            _twitchEventConfig.EventName = _selectedTwitchEvent;
            _triggerName = _selectedTwitchEvent;
            configuration = _twitchEventConfig.ToJson();
        }
        else if (_selectedType == TriggerTypes.DefaultCommand && _selectedDefaultCommand != null)
        {
            defaultCommandIdRef = _selectedDefaultCommand.Id;
            var defaultCmdConfig = new DefaultCommandTriggerConfiguration
            {
                DefaultCommandName = _selectedDefaultCommand.CommandName,
                EventType = _selectedEventType
            };

            if (IsRacingTrigger())
            {
                defaultCmdConfig.Placements = _racingPlacements.ToList();
                defaultCmdConfig.MinPlacement = _racingMinPlacement;
                defaultCmdConfig.MaxPlacement = _racingMaxPlacement;
                defaultCmdConfig.RacingGameModes = _racingGameModes.ToList();
                defaultCmdConfig.RacingOutcomeFilter = _racingOutcomeFilter;
                defaultCmdConfig.MinKnockouts = _racingMinKnockouts;
            }

            configuration = System.Text.Json.JsonSerializer.Serialize(defaultCmdConfig);
        }
        else if (_selectedType == TriggerTypes.FishingTournamentCatch)
        {
            configuration = System.Text.Json.JsonSerializer.Serialize(_fishingTournamentCatchConfig);
            _triggerName = "FishingTournament.EligibleCatch";
        }
        else if (_selectedType == TriggerTypes.FishingTournamentStart)
        {
            _triggerName = "FishingTournament.Start";
        }
        else if (_selectedType == TriggerTypes.FishingTournamentEnd)
        {
            _triggerName = "FishingTournament.End";
        }
        else if (_selectedType == TriggerTypes.FishCatch)
        {
            var config = new FishCatchTriggerConfiguration
            {
                FishTypeIds = _fishCatchFishTypeIds.ToList(),
                Categories = _fishCatchCategories.ToList(),
                Rarities = _fishCatchRarities.ToList(),
                MinStars = _fishCatchMinStars,
                MinWeight = _fishCatchMinWeight,
                MinGold = _fishCatchMinGold,
                RequireActiveTournament = _fishCatchRequireActiveTournament
            };
            configuration = System.Text.Json.JsonSerializer.Serialize(config);
            _triggerName = "Fishing.FishCaught";
        }
        else if (_selectedType == TriggerTypes.FishingItemBroken)
        {
            var config = new FishingItemBrokenTriggerConfiguration
            {
                EquipmentSlots = _fishingItemBrokenSlots.ToList(),
                ShopItemIds = _fishingItemBrokenShopItemIds
            };
            configuration = System.Text.Json.JsonSerializer.Serialize(config);
            _triggerName = "Fishing.ItemBroken";
        }
        else if (_selectedType == TriggerTypes.FishingAccident)
        {
            var config = new FishingAccidentTriggerConfiguration
            {
                AccidentTypes = _fishingAccidentOutcomes.ToList()
            };
            configuration = System.Text.Json.JsonSerializer.Serialize(config);
            _triggerName = "Fishing.Accident";
        }
        else if (_selectedType == TriggerTypes.BannedSongRequest)
        {
            _triggerName = "Song.BannedRequest";
        }

        var result = new
        {
            TriggerName = _triggerName,
            TriggerType = _selectedType.Value,
            Configuration = configuration,
            CommandId = commandIdRef,
            KeywordId = keywordIdRef,
            TimerGroupId = timerGroupIdRef,
            DefaultCommandId = defaultCommandIdRef
        };

        MudDialog.Close(DialogResult.Ok(result));
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private bool IsTriggerTypeAvailable(TriggerTypes triggerType)
    {
        return TriggerFeatureGate.IsAvailable(triggerType, FeatureRuntimeCoordinator);
    }

    private string GetFishTypeNameById(int fishTypeId)
    {
        var fish = _fishTypes.FirstOrDefault(f => f.Id == fishTypeId);
        return fish == null ? fishTypeId.ToString() : $"{fish.Name} ({fish.Rarity})";
    }
