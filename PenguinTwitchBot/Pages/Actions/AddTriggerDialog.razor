    private void OnCommandSelected(int? commandId)
    {
        _selectedCommandId = commandId;

        // Auto-populate trigger name with command name (with !)
        if (commandId.HasValue)
        {
            var command = _commands.FirstOrDefault(c => c.Id == commandId);
            if (command != null)
            {
                _triggerName = $"!{command.CommandName}";
            }
        }
    }

    private void OnKeywordSelected(int? keywordId)
    {
        _selectedKeywordId = keywordId;

        // Auto-populate trigger name with keyword name
        if (keywordId.HasValue)
        {
            var keyword = _keywords.FirstOrDefault(k => k.Id == keywordId);
            if (keyword != null)
            {
                _triggerName = keyword.CommandName;
            }
        }
    }

    private Task OnCommandCreated(ActionCommand command)
    {
        _commands.Add(command);
        _selectedCommandId = command.Id;
        _triggerName = $"!{command.CommandName}";
        return Task.CompletedTask;
    }

    private Task OnKeywordCreated(ActionKeyword keyword)
    {
        _keywords.Add(keyword);
        _selectedKeywordId = keyword.Id;
        _triggerName = keyword.CommandName;
        return Task.CompletedTask;
    }

    private Task<IEnumerable<TimerGroup>> SearchTimerGroups(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return Task.FromResult(_timerGroups.AsEnumerable());
        }

        var filtered = _timerGroups.Where(t => 
            t.Name.Contains(value, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(filtered);
    }

    private void OnTimerGroupChanged(TimerGroup? timerGroup)
    {
        _selectedTimerGroup = timerGroup;

        // Auto-populate trigger name with timer group format
        if (timerGroup?.Id.HasValue == true)
        {
            _triggerName = $"TimerGroup_{timerGroup.Id.Value}";
        }
    }

