    private void SelectCategory(TriggerCategoryInfo category)
    {
        _selectedCategory = category;
        _previousStep = _currentStep;
        _currentStep = WizardStep.SelectTrigger;
    }

    private void SelectTrigger(TriggerItemInfo item)
    {
        _selectedItem = item;
        _selectedType = item.Type;
        _previousStep = _currentStep;
        _currentStep = WizardStep.Configure;

        // Pre-populate fields based on selected catalog item
        if (item.Type == TriggerTypes.DefaultCommand && !string.IsNullOrEmpty(item.DefaultCommandName) && !string.IsNullOrEmpty(item.DefaultCommandEventType))
        {
            _selectedDefaultCommand = _defaultCommands.FirstOrDefault(c => string.Equals(c.CommandName, item.DefaultCommandName, StringComparison.OrdinalIgnoreCase));
            _selectedEventType = item.DefaultCommandEventType;
            UpdateDefaultCommandTriggerName();

            if (IsRacingTrigger())
            {
                if (item.DefaultCommandEventType == DefaultCommandEventTypes.RacingWin)
                    OnRacingPlacementPresetChanged("First");
                else if (item.DefaultCommandEventType == DefaultCommandEventTypes.RacingPodium)
                    OnRacingPlacementPresetChanged("Podium");
                else
                    OnRacingPlacementPresetChanged("Any");
            }
        }
        else if (item.Type == TriggerTypes.TwitchEvent && !string.IsNullOrEmpty(item.TwitchEventName))
        {
            _selectedTwitchEvent = item.TwitchEventName;
            _twitchEventConfig = new Bot.Actions.Triggers.TwitchEventTriggerConfig { EventName = item.TwitchEventName };
            _triggerName = item.TwitchEventName;
        }
        else
        {
            _triggerName = item.Type switch
            {
                TriggerTypes.FishingTournamentCatch => "FishingTournament.EligibleCatch",
                TriggerTypes.FishingTournamentStart => "FishingTournament.Start",
                TriggerTypes.FishingTournamentEnd => "FishingTournament.End",
                TriggerTypes.FishCatch => "Fishing.FishCaught",
                TriggerTypes.FishingItemBroken => "Fishing.ItemBroken",
                TriggerTypes.FishingAccident => "Fishing.Accident",
                TriggerTypes.BannedSongRequest => "Song.BannedRequest",
                TriggerTypes.Manual => "Manual",
                _ => $"{item.DisplayName}"
            };
        }
    }

    private void GoBack()
    {
        if (_currentStep == WizardStep.Configure)
        {
            _currentStep = _previousStep;
        }
        else if (_currentStep == WizardStep.SelectTrigger)
        {
            _currentStep = WizardStep.SelectCategory;
        }
    }

    private string GetConfigureTitle()
    {
        if (_selectedItem != null)
        {
            return _selectedItem.DisplayName;
        }

        if (_selectedType == TriggerTypes.DefaultCommand && _selectedDefaultCommand != null && !string.IsNullOrEmpty(_selectedEventType))
        {
            return $"{_selectedDefaultCommand.CommandName} - {GetEventTypeDisplayName(_selectedEventType)}";
        }

        if (_selectedType == TriggerTypes.TwitchEvent && !string.IsNullOrEmpty(_selectedTwitchEvent))
        {
            var eventInfo = TwitchEventTypeInfo.GetEventInfo(_selectedTwitchEvent);
            return eventInfo?.DisplayName ?? _selectedTwitchEvent;
        }

        return _selectedType?.ToString() ?? "Trigger";
    }

