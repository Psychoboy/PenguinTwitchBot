@using PenguinTwitchBot.Bot.Actions
@using PenguinTwitchBot.Bot.Actions.Recipes
@using PenguinTwitchBot.Bot.Actions.Variables
@using PenguinTwitchBot.Bot.Commands
@using PenguinTwitchBot.Bot.Queues
@using PenguinTwitchBot.Database.Bot.Models.Commands
@using PenguinTwitchBot.Database.Bot.Models.Points
@using PenguinTwitchBot.Database.Bot.Models
@using PenguinTwitchBot.Database.Bot.Models.Queues
@using PenguinTwitchBot.Database.Bot.Models.Actions.Triggers
@using PenguinTwitchBot.Database.Bot.Actions.SubActions.Types
@using PenguinTwitchBot.Database.Bot.Actions.SubActions.UI
@using PenguinTwitchBot.Helpers
@using PenguinTwitchBot.Database.Repository
@using Microsoft.Extensions.DependencyInjection
@using System.Text.Json
@using PenguinTwitchBot.Bot.WebSocketEvents
@inject IActionRecipeRegistry RecipeRegistry
@inject IActionManagementService ActionService
@inject IActionCommandService CommandService
@inject IQueueManager QueueManager
@inject PenguinTwitchBot.Bot.Commands.Misc.IAutoTimers TimerService
@inject IRaffleSetupService RaffleSetupService
@inject IActionRecipeTagStore RecipeTagStore
@inject IDialogService DialogService
@inject IServiceScopeFactory ScopeFactory
@inject PenguinTwitchBot.Bot.Notifications.IWebSocketMessenger WebSocketMessenger
@inject ISnackbar Snackbar
@inject IActionVariableResolver VariableResolver
@inject PenguinTwitchBot.Bot.TwitchServices.ITwitchService TwitchService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Create from recipe</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudProgressLinear Value="@((_step + 1) * 33.3)" Color="Color.Primary" />
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }

                @if (_step == 0)
                {
                    <MudText Typo="Typo.subtitle1">1. Choose a recipe</MudText>
                    <MudSelect T="string" Label="Recipe" Variant="Variant.Outlined"
                               Value="_selectedRecipeId" ValueChanged="OnRecipeChanged">
                        @foreach (var recipe in _recipes)
                        {
                            <MudSelectItem T="string" Value="@recipe.Id">@recipe.Title</MudSelectItem>
                        }
                    </MudSelect>
                    @if (SelectedRecipe is { } recipe)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">@recipe.Description</MudAlert>
                    }
                }
                else if (_step == 1)
                {
                    <MudText Typo="Typo.subtitle1">2. Configure</MudText>
                    <MudTextField T="string" Label="Action name" Variant="Variant.Outlined"
                                  @bind-Value="_actionName" Required="true" />
                    <MudAutocomplete T="string" Label="Group (optional)" Variant="Variant.Outlined"
                                     Value="_groupName" ValueChanged="OnGroupChanged"
                                     SearchFunc="SearchGroups" Clearable="true"
                                     CoerceText="false" CoerceValue="true" MaxItems="null"
                                     HelperText="Suggested group is preselected; choose an existing group or enter a new one." />
                    @if (SelectedRecipe?.RequiresCommand != false)
                    {
                        <MudTextField T="string" Label="Command" Variant="Variant.Outlined"
                                      Value="_commandName" ValueChanged="OnCommandNameChanged"
                                      HelperText="Enter the name without !; an existing custom command will be reused." Required="true" />
                    }
                    @if (SelectedRecipe?.SupportsCommandSettings == true)
                    {
                        <MudDivider />
                        <MudText Typo="Typo.subtitle2">New command settings</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            These settings apply only when the wizard creates a new command. Reused commands keep their current settings.
                        </MudText>
                        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                            <MudNumericField T="int" Label="User cooldown (seconds)" Min="0" Max="86400"
                                             @bind-Value="_commandUserCooldown" Variant="Variant.Outlined" />
                            <MudNumericField T="int" Label="Global cooldown (seconds)" Min="0" Max="86400"
                                             @bind-Value="_commandGlobalCooldown" Variant="Variant.Outlined" />
                            <MudSelect T="Rank" Label="Minimum rank" @bind-Value="_commandMinimumRank" Variant="Variant.Outlined">
                                @foreach (var rank in Enum.GetValues<Rank>())
                                {
                                    <MudSelectItem T="Rank" Value="@rank">@rank</MudSelectItem>
                                }
                            </MudSelect>
                        </MudStack>
                    }

                    @if (SelectedRecipe is { } recipe)
                    {
                        @if (recipe is AlertRecipe)
                        {
                            <MudTextField T="string" Label="Chat command (optional)" Variant="Variant.Outlined"
                                          Value="@GetParameter("CommandName")"
                                          ValueChanged="@(value => OnRecipeParameterChanged("CommandName", value))"
                                          HelperText="Enter a command without !, or leave blank to use another trigger." />
                            <AlertSubActionEditor Alert="@_alertRecipeSettings"
                                                  AlertChanged="OnAlertSettingsChanged" />
                        }
                        else if (recipe is SoundCommandRecipe)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                                <MudTextField T="string" Label="Audio file" Variant="Variant.Outlined"
                                              Value="@GetParameter("File")" ReadOnly="true" Required="true" />
                                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PhotoLibrary"
                                           OnClick="OpenSoundLibraryAsync">
                                    Browse Media Library
                                </MudButton>
                            </MudStack>
                        }
                        else if (recipe is ObsSourceVisibilityRecipe)
                        {
                            <MudTextField T="string" Label="Chat command (optional)" Variant="Variant.Outlined"
                                          Value="@GetParameter("CommandName")"
                                          ValueChanged="@(value => OnRecipeParameterChanged("CommandName", value))"
                                          HelperText="Enter a command without !, or leave blank to use another trigger." />
                            <MudSelect T="string" Label="OBS connection" Variant="Variant.Outlined"
                                       Value="@GetParameter("OBSConnectionId")" ValueChanged="OnObsConnectionChanged" Required="true">
                                @foreach (var connection in _obsConnectionOptions)
                                {
                                    <MudSelectItem T="string" Value="@connection.Id.ToString()">@connection.Name</MudSelectItem>
                                }
                            </MudSelect>
                            <MudSelect T="string" Label="Scene" Variant="Variant.Outlined"
                                       Value="@GetParameter("SceneName")" ValueChanged="OnObsSceneChanged" Required="true"
                                       Disabled="@string.IsNullOrWhiteSpace(GetParameter("OBSConnectionId"))">
                                @foreach (var scene in _obsSceneOptions)
                                {
                                    <MudSelectItem T="string" Value="@(scene.Value ?? scene.Name)">@scene.Name</MudSelectItem>
                                }
                            </MudSelect>
                            <MudAutocomplete T="string" Label="Source" Variant="Variant.Outlined"
                                             Value="@GetParameter("SourceName")" ValueChanged="OnObsSourceChanged"
                                             SearchFunc="SearchObsSources" CoerceValue="true" Clearable="true" Required="true"
                                             Disabled="@string.IsNullOrWhiteSpace(GetParameter("SceneName"))"
                                             HelperText="Choose a source reported by OBS, or enter its exact name." />
                            <MudNumericField T="int" Label="Visible for (seconds)" Min="1" Max="3600"
                                             Value="@GetObsDurationSeconds()" ValueChanged="OnObsDurationChanged"
                                             Variant="Variant.Outlined" Required="true" />
                            @if (_obsConnectionOptions.Count == 0)
                            {
                                <MudAlert Severity="Severity.Warning" Dense="true">
                                    No OBS connections are configured. Add and connect one in OBS Connections, then reopen this recipe.
                                </MudAlert>
                            }
                        }
                        else if (recipe is ChannelPointActionRecipe)
                        {
                            <MudSelect T="string" Label="Reward setup" Variant="Variant.Outlined"
                                       Value="@GetParameter("RewardMode")" ValueChanged="OnChannelPointRewardModeChanged">
                                <MudSelectItem T="string" Value="@("Existing")">Use existing reward</MudSelectItem>
                                <MudSelectItem T="string" Value="@("CreateNew")">Create new reward</MudSelectItem>
                            </MudSelect>
                            @if (IsCreatingChannelPointReward)
                            {
                                <MudTextField T="string" Label="New reward title" Variant="Variant.Outlined"
                                              Value="@GetParameter("NewRewardTitle")"
                                              ValueChanged="@(value => OnRecipeParameterChanged("NewRewardTitle", value))" Required="true" />
                                <MudNumericField T="int" Label="Cost" Min="1"
                                                 Value="@GetChannelPointRewardCost()" ValueChanged="OnChannelPointRewardCostChanged" Required="true" />
                                <MudTextField T="string" Label="Prompt (optional)" Variant="Variant.Outlined"
                                              Value="@GetParameter("RewardPrompt")"
                                              ValueChanged="@(value => OnRecipeParameterChanged("RewardPrompt", value))" />
                                <MudSwitch T="bool" Value="@GetRewardBoolean("RewardRequiresInput")"
                                           ValueChanged="@(value => OnRewardBooleanChanged("RewardRequiresInput", value))"
                                           Label="Require viewer input" Color="Color.Primary" />
                                <MudSwitch T="bool" Value="@GetRewardBoolean("RewardSkipQueue")"
                                           ValueChanged="@(value => OnRewardBooleanChanged("RewardSkipQueue", value))"
                                           Label="Skip Queue" Color="Color.Primary" />
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    Skip Queue is a Twitch reward setting; Twitch handles fulfillment when redemptions bypass its request queue.
                                </MudText>
                            }
                            else
                            {
                                <MudSelect T="string" Label="Existing channel point reward" Variant="Variant.Outlined"
                                           Value="@GetParameter("RewardTitle")" ValueChanged="OnChannelPointRewardTitleChanged" Required="true">
                                    @foreach (var rewardTitle in _channelPointRewardTitles)
                                    {
                                        <MudSelectItem T="string" Value="@rewardTitle">@rewardTitle</MudSelectItem>
                                    }
                                </MudSelect>
                                @if (_channelPointRewardTitles.Count == 0)
                                {
                                    <MudAlert Severity="Severity.Warning" Dense="true">
                                        No manageable rewards found. Choose “Create new reward” or add one in <MudLink Href="/settings/channel-points">Channel Points</MudLink>.
                                    </MudAlert>
                                }
                            }
                            <MudTextField T="string" Label="Chat message" Variant="Variant.Outlined" Lines="3"
                                          Value="@GetParameter("MessageText")"
                                          ValueChanged="@(value => OnRecipeParameterChanged("MessageText", value))"
                                          HelperText="Use redemption variables such as %user%, %RewardName%, and %UserInput%." Required="true" />
                            <MudSwitch T="bool" Value="@IsTwitchAlertEnabled" ValueChanged="OnTwitchAlertEnabledChanged"
                                       Color="Color.Primary" Label="Add an overlay alert" />
                            @if (IsTwitchAlertEnabled)
                            {
                                <AlertSubActionEditor Alert="@_alertRecipeSettings" AlertChanged="OnAlertSettingsChanged" />
                            }
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                                <MudTextField T="string" Label="Additional sound" Variant="Variant.Outlined"
                                              Value="@GetParameter("SoundFile")" ReadOnly="true" />
                                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PhotoLibrary"
                                           OnClick="OpenTwitchSoundLibraryAsync">Browse Media Library</MudButton>
                            </MudStack>
                            <MudNumericField T="int" Label="Fireworks bursts" Min="0" Max="100"
                                             Value="@GetTwitchFireworksCount()" ValueChanged="OnTwitchFireworksCountChanged" />
                        }
                        else if (recipe is TwitchEventReactionRecipe)
                        {
                            <MudTextField T="string" Label="Chat message" Variant="Variant.Outlined"
                                          Lines="3" Value="@GetParameter("MessageText")"
                                          ValueChanged="@(value => OnRecipeParameterChanged("MessageText", value))"
                                          HelperText="Use event variables such as %user%, %amount%, or %numberofviewers%." Required="true" />
                            <MudSwitch T="bool" Value="@IsTwitchAlertEnabled" ValueChanged="OnTwitchAlertEnabledChanged"
                                       Color="Color.Primary" Label="Add an overlay alert" />
                            @if (IsTwitchAlertEnabled)
                            {
                                <AlertSubActionEditor Alert="@_alertRecipeSettings" AlertChanged="OnAlertSettingsChanged" />
                            }
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                                <MudTextField T="string" Label="Additional sound" Variant="Variant.Outlined"
                                              Value="@GetParameter("SoundFile")" ReadOnly="true"
                                              HelperText="Optional sound to play with the event response." />
                                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PhotoLibrary"
                                           OnClick="OpenTwitchSoundLibraryAsync">
                                    Browse Media Library
                                </MudButton>
                                @if (!string.IsNullOrWhiteSpace(GetParameter("SoundFile")))
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" aria-label="Clear selected sound"
                                                   OnClick="ClearTwitchSound" />
                                }
                            </MudStack>
                            <MudNumericField T="int" Label="Fireworks bursts" Min="0" Max="100"
                                             Value="@GetTwitchFireworksCount()" ValueChanged="OnTwitchFireworksCountChanged"
                                             HelperText="Set to 0 for none. A Fireworks overlay widget is required." />
                            @if (GetTwitchFireworksCount() > 0 && !_fireworksWidgetPresent)
                            {
                                <MudAlert Severity="Severity.Warning" Dense="true">
                                    No enabled Fireworks widget is configured. Add one in the <MudLink Href="/overlay/editor">Overlay Editor</MudLink> or set bursts to 0.
                                </MudAlert>
                            }
                        }
                        else if (recipe is PointsRewardRecipe)
                        {
                            <MudTextField T="string" Label="Chat command (optional)" Variant="Variant.Outlined"
                                          Value="@GetParameter("CommandName")"
                                          ValueChanged="@(value => OnRecipeParameterChanged("CommandName", value))"
                                          HelperText="Leave blank to add an event trigger instead." />
                            <MudSelect T="string" Label="Point type" Variant="Variant.Outlined"
                                       Value="@GetParameter("PointTypeName")" ValueChanged="OnPointTypeChanged" Required="true">
                                @foreach (var pointType in _pointTypeNames)
                                {
                                    <MudSelectItem T="string" Value="@pointType">@pointType</MudSelectItem>
                                }
                            </MudSelect>
                            <MudSelect T="string" Label="Operation" Variant="Variant.Outlined"
                                       Value="@GetParameter("Operation")" ValueChanged="@(value => OnRecipeParameterChanged("Operation", value))">
                                @foreach (var operation in Enum.GetNames<ManagePointsOperation>())
                                {
                                    <MudSelectItem T="string" Value="@operation">@operation</MudSelectItem>
                                }
                            </MudSelect>
                            <MudTextField T="string" Label="Amount or formula" Variant="Variant.Outlined"
                                          Value="@GetParameter("Amount")"
                                          ValueChanged="@(value => OnRecipeParameterChanged("Amount", value))"
                                          HelperText="Examples: 10, %Score%, $math(%Score% * 2)$" Required="true" />
                            @if (!GetParameter("Operation").Equals(nameof(ManagePointsOperation.AddActive), StringComparison.OrdinalIgnoreCase))
                            {
                                <MudTextField T="string" Label="Target user" Variant="Variant.Outlined"
                                              Value="@GetParameter("TargetUser")"
                                              ValueChanged="@(value => OnRecipeParameterChanged("TargetUser", value))"
                                              HelperText="Defaults to %user%." />
                            }
                            <MudTextField T="string" Label="Chat message (optional)" Variant="Variant.Outlined" Lines="3"
                                          Value="@GetParameter("MessageText")"
                                          ValueChanged="@(value => OnRecipeParameterChanged("MessageText", value))" />
                            @if (_pointTypeNames.Count == 0)
                            {
                                <MudAlert Severity="Severity.Warning" Dense="true">
                                    No point types exist yet. Create one in <MudLink Href="/settings/points">Point Settings</MudLink> first.
                                </MudAlert>
                            }
                        }
                        else if (recipe is KeywordReactionRecipe)
                        {
                            <MudTextField T="string" Label="Chat message" Variant="Variant.Outlined" Lines="3"
                                          Value="@GetParameter("MessageText")"
                                          ValueChanged="@(value => OnRecipeParameterChanged("MessageText", value))"
                                          HelperText="Use variables such as %user%." Required="true" />
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                                <MudTextField T="string" Label="Sound file (optional)" Variant="Variant.Outlined"
                                              Value="@GetParameter("SoundFile")" ReadOnly="true" />
                                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PhotoLibrary"
                                           OnClick="OpenKeywordSoundLibraryAsync">
                                    Browse Media Library
                                </MudButton>
                                @if (!string.IsNullOrWhiteSpace(GetParameter("SoundFile")))
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" aria-label="Clear selected sound"
                                                   OnClick="ClearKeywordSound" />
                                }
                            </MudStack>
                        }
                        else if (recipe is CommandAliasRecipe)
                        {
                            <MudSelect T="string" Label="Command to run" Variant="Variant.Outlined"
                                       Value="@GetParameter("TargetCommand")" ValueChanged="OnAliasTargetCommandChanged" Required="true">
                                @foreach (var commandName in _enabledCommandNames)
                                {
                                    <MudSelectItem T="string" Value="@commandName">!@commandName</MudSelectItem>
                                }
                            </MudSelect>
                            @if (_enabledCommandNames.Count == 0)
                            {
                                <MudAlert Severity="Severity.Warning" Dense="true">
                                    No enabled custom commands are available to alias.
                                </MudAlert>
                            }
                            <MudTextField T="string" Label="Arguments to pass" Variant="Variant.Outlined"
                                          Value="@GetParameter("Arguments")"
                                          ValueChanged="@(value => OnRecipeParameterChanged("Arguments", value))"
                                          HelperText="Defaults to %message% so arguments after the alias are forwarded." />
                        }
                        else if (recipe is CommandGroupToggleRecipe)
                        {
                            <MudSelect T="string" Label="Commands" Variant="Variant.Outlined" MultiSelection="true"
                                       SelectedValues="@GetSelectedToggleCommands()" SelectedValuesChanged="OnToggleCommandsChanged"
                                       ToStringFunc="@(commandName => $"!{commandName}")" Required="true">
                                @foreach (var commandName in _commandNames)
                                {
                                    <MudSelectItem T="string" Value="@commandName">!@commandName</MudSelectItem>
                                }
                            </MudSelect>
                            <MudSelect T="string" Label="Change" Variant="Variant.Outlined"
                                       Value="@GetParameter("Operation")"
                                       ValueChanged="@(value => OnRecipeParameterChanged("Operation", value))">
                                <MudSelectItem T="string" Value="@("Disable")">Disable selected commands</MudSelectItem>
                                <MudSelectItem T="string" Value="@("Enable")">Enable selected commands</MudSelectItem>
                            </MudSelect>
                        }
                        else if (recipe is CounterCommandRecipe)
                        {
                            <MudSelect T="string" Label="Counter" Variant="Variant.Outlined"
                                       Value="@GetParameter("CounterName")" ValueChanged="OnCounterNameChanged" Required="true">
                                @foreach (var counterName in _counterNames)
                                {
                                    <MudSelectItem T="string" Value="@counterName">@counterName</MudSelectItem>
                                }
                            </MudSelect>
                            <MudNumericField T="int" Label="Increment amount" Min="1"
                                             Value="@GetCounterStep()" ValueChanged="OnCounterStepChanged"
                                             Variant="Variant.Outlined" Required="true" />
                            <MudTextField T="string" Label="Display message" Variant="Variant.Outlined" Lines="3"
                                          Value="@GetParameter("ResponseMessage")"
                                          ValueChanged="@(value => OnRecipeParameterChanged("ResponseMessage", value))"
                                          HelperText="Available variables: %counter_display_name%, %counter_value%, %counter_old_value%." />
                            @if (_counterNames.Count == 0)
                            {
                                <MudAlert Severity="Severity.Warning" Dense="true">
                                    Create a counter in <MudLink Href="/actions/counters">Counters</MudLink> before adding its command.
                                </MudAlert>
                            }
                        }
                        else if (recipe is TimedAnnouncementRecipe)
                        {
                            <MudTextField T="string" Label="Timer name" Variant="Variant.Outlined"
                                          Value="@GetParameter("TimerName")"
                                          ValueChanged="@(value => OnRecipeParameterChanged("TimerName", value))" Required="true" />
                            <MudNumericField T="int" Label="Interval (seconds)" Min="30" Max="86400"
                                             Value="@GetTimedAnnouncementNumber("IntervalSeconds", 300)"
                                             ValueChanged="@(value => OnTimedAnnouncementNumberChanged("IntervalSeconds", value))" />
                            <MudNumericField T="int" Label="Minimum chat messages" Min="0" Max="10000"
                                             Value="@GetTimedAnnouncementNumber("MinimumMessages", 15)"
                                             ValueChanged="@(value => OnTimedAnnouncementNumberChanged("MinimumMessages", value))" />
                            @for (var index = 1; index <= 5; index++)
                            {
                                var messageNumber = index;
                                var parameterKey = $"Message{messageNumber}";
                                <MudTextField T="string" Label="@($"Announcement {messageNumber}")" Variant="Variant.Outlined" Lines="2"
                                              Value="@GetParameter(parameterKey)"
                                              ValueChanged="@(value => OnRecipeParameterChanged(parameterKey, value))"
                                              Required="@(messageNumber == 1)" />
                            }
                        }
                                    else if (recipe is TimedRaffleRecipe)
                                    {
                                        <MudTextField T="string" Label="Raffle name" Variant="Variant.Outlined"
                                                      Value="@GetParameter("RaffleName")" ValueChanged="@(value => OnRecipeParameterChanged("RaffleName", value))" Required="true" />
                                        <MudTextField T="string" Label="Raffle key" Variant="Variant.Outlined"
                                                      Value="@GetParameter("RaffleKey")" ValueChanged="@(value => OnRecipeParameterChanged("RaffleKey", value))" Required="true" />
                                        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                                            <MudTextField T="string" Label="Join command" Variant="Variant.Outlined"
                                                          Value="@GetParameter("JoinCommandName")" ValueChanged="@(value => OnRecipeParameterChanged("JoinCommandName", value))" Required="true" />
                                            <MudTextField T="string" Label="Start command" Variant="Variant.Outlined"
                                                          Value="@GetParameter("StartCommandName")" ValueChanged="@(value => OnRecipeParameterChanged("StartCommandName", value))" Required="true" />
                                            <MudTextField T="string" Label="End command" Variant="Variant.Outlined"
                                                          Value="@GetParameter("EndCommandName")" ValueChanged="@(value => OnRecipeParameterChanged("EndCommandName", value))" Required="true" />
                                        </MudStack>
                                        <MudSelect T="string" Label="Award point type" Variant="Variant.Outlined"
                                                   Value="@GetParameter("PointTypeId")" ValueChanged="OnRafflePointTypeChanged">
                                            <MudSelectItem T="string" Value="@string.Empty">Default point type</MudSelectItem>
                                            @foreach (var pointType in _rafflePointTypes)
                                            {
                                                <MudSelectItem T="string" Value="@pointType.Id.ToString()">@pointType.Name</MudSelectItem>
                                            }
                                        </MudSelect>
                                        @if (_rafflePointTypes.Count == 0)
                                        {
                                            <MudAlert Severity="Severity.Info" Dense="true">
                                                No point types found. The raffle will use the default point type.
                                            </MudAlert>
                                        }
                                        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                                            <MudNumericField T="int" Label="Duration (seconds)" Min="60" Max="86400"
                                                             Value="@GetTimedAnnouncementNumber("DurationSeconds", 600)"
                                                             ValueChanged="@(value => OnTimedAnnouncementNumberChanged("DurationSeconds", value))" />
                                            <MudNumericField T="int" Label="Announcement cadence (seconds)" Min="30" Max="3600"
                                                             Value="@GetTimedAnnouncementNumber("AnnouncementIntervalSeconds", 120)"
                                                             ValueChanged="@(value => OnTimedAnnouncementNumberChanged("AnnouncementIntervalSeconds", value))" />
                                        </MudStack>
                                        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                                            <MudNumericField T="int" Label="Winner count" Min="1" Max="100"
                                                             Value="@GetTimedAnnouncementNumber("WinnerCount", 1)"
                                                             ValueChanged="@(value => OnTimedAnnouncementNumberChanged("WinnerCount", value))" />
                                            <MudSwitch T="bool" Value="@GetRewardBoolean("UseRandomTotalAward")"
                                                       ValueChanged="@(value => OnRewardBooleanChanged("UseRandomTotalAward", value))"
                                                       Label="Randomize total award" Color="Color.Primary" />
                                        </MudStack>
                                        @if (GetRewardBoolean("UseRandomTotalAward"))
                                        {
                                            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                                                <MudNumericField T="int" Label="Inclusive award minimum" Min="0" Max="1000000"
                                                                 Value="@GetTimedAnnouncementNumber("RandomTotalAwardMinimum", 1)"
                                                                 ValueChanged="@(value => OnTimedAnnouncementNumberChanged("RandomTotalAwardMinimum", value))" />
                                                <MudNumericField T="int" Label="Inclusive award maximum" Min="1" Max="1000000"
                                                                 Value="@GetTimedAnnouncementNumber("RandomTotalAwardMaximum", 100)"
                                                                 ValueChanged="@(value => OnTimedAnnouncementNumberChanged("RandomTotalAwardMaximum", value))" />
                                            </MudStack>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">One total award is rolled when the raffle starts and split among winners.</MudText>
                                        }
                                        else
                                        {
                                            <MudNumericField T="long" Label="Total award" Min="0"
                                                             Value="@GetTimedRaffleAward()" ValueChanged="OnTimedRaffleAwardChanged" />
                                        }
                                        @for (var index = 1; index <= 3; index++)
                                        {
                                            var messageNumber = index;
                                            var parameterKey = $"Announcement{messageNumber}";
                                            <MudTextField T="string" Label="@($"Periodic announcement {messageNumber}")" Variant="Variant.Outlined" Lines="2"
                                                          Value="@GetParameter(parameterKey)"
                                                          ValueChanged="@(value => OnRecipeParameterChanged(parameterKey, value))"
                                                          Required="@(messageNumber == 1)" />
                                        }
                                        <MudAlert Severity="Severity.Info" Dense="true">
                                            The host start action uses the Raffles queue until the raffle closes. Viewer joins stay on Default so entries remain responsive.
                                        </MudAlert>
                                        <MudSwitch T="bool" Value="@GetRewardBoolean("IncludeStarterMessages")"
                                                   ValueChanged="@(value => OnRewardBooleanChanged("IncludeStarterMessages", value))"
                                                   Label="Include raffle chat messages" Color="Color.Primary" />
                                    }
                        else
                        {
                            @foreach (var parameter in recipe.Parameters)
                            {
                                <MudTextField T="string" Label="@parameter.Label" Variant="Variant.Outlined"
                                              Lines="@(parameter.Type == ActionRecipeParameterType.Multiline ? 3 : 1)"
                                              Value="@GetParameter(parameter.Key)"
                                              ValueChanged="@(value => OnRecipeParameterChanged(parameter.Key, value))"
                                              HelperText="@parameter.HelperText"
                                              Required="@parameter.Required" />
                            }
                        }
                    }

                    @if (SelectedRecipe is { SupportsVariables: true } variableRecipe &&
                         variableRecipe.VariableParameterKeys.Count > 0 && _availableVariables.Count > 0)
                    {
                        <MudExpansionPanels Elevation="0" Outlined="true">
                            <MudExpansionPanel Text="@($"Insert Variables ({_availableVariables.Count})")"
                                               Icon="@Icons.Material.Filled.DataObject">
                                <MudStack Spacing="2">
                                    <MudSelect T="string" Label="Insert into" Variant="Variant.Outlined"
                                               Value="_variableTargetKey" ValueChanged="OnVariableTargetChanged">
                                        @foreach (var key in variableRecipe.VariableParameterKeys)
                                        {
                                            <MudSelectItem T="string" Value="@key">@GetVariableTargetLabel(key)</MudSelectItem>
                                        }
                                    </MudSelect>
                                    <ActionVariablesReference Variables="_availableVariables"
                                                              OnVariableSelected="InsertVariableAsync" />
                                </MudStack>
                            </MudExpansionPanel>
                        </MudExpansionPanels>
                    }

                    @if (SelectedRecipe is { AllowsAdditionalTriggers: true } triggerRecipe)
                    {
                        <MudDivider Class="my-2" />
                        <MudText Typo="Typo.subtitle1">@(triggerRecipe.RequiresTrigger ? "Required trigger" : "Additional triggers")</MudText>
                        @if (triggerRecipe.RequiresTrigger && !_additionalTriggers.Any(triggerRecipe.IsRequiredTrigger))
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true">
                                Add a @triggerRecipe.TriggerRequirementDescription to continue. Filters are available in the trigger setup.
                            </MudAlert>
                        }
                        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                            @foreach (var trigger in _additionalTriggers)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info">@trigger.Name</MudChip>
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                                   aria-label="Remove trigger"
                                                   OnClick="@(() => RemoveAdditionalTriggerAsync(trigger))" />
                                </MudStack>
                            }
                        </MudStack>
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="AddAdditionalTriggerAsync">
                            @(triggerRecipe.RequiresTrigger ? triggerRecipe.TriggerButtonLabel : "Add trigger")
                        </MudButton>
                    }

                    @if (SelectedRecipe is FireworksShowRecipe && !_fireworksWidgetPresent)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true">
                            No enabled Fireworks widget is configured in an overlay layout.
                            <MudButton Variant="Variant.Text" Href="/overlay/editor">Open Overlay Editor</MudButton>
                        </MudAlert>
                    }

                    <MudSelect T="string" Label="Queue" Variant="Variant.Outlined"
                               Value="_selectedQueueName" ValueChanged="OnQueueChanged">
                        <MudSelectItem T="string" Value="@("Default")">Default</MudSelectItem>
                        @if (_pendingQueue is not null)
                        {
                            <MudSelectItem T="string" Value="@_pendingQueue.Name">@_pendingQueue.Name (new)</MudSelectItem>
                        }
                        @foreach (var queue in _queues.OrderBy(queue => queue.Name, StringComparer.OrdinalIgnoreCase))
                        {
                            <MudSelectItem T="string" Value="@queue.Name">@queue.Name @(queue.Enabled ? "" : "(disabled)")</MudSelectItem>
                        }
                    </MudSelect>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Default is shared across actions. Keep alerts and messages on Default; create a dedicated blocking queue only when execution must be serialized.
                    </MudText>
                    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="CreateBlockingQueueAsync">
                            Create queue
                        </MudButton>
                        @if (RecommendedQueueNeedsCreation)
                        {
                            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="CreateRecommendedQueueAsync">
                                Create recommended '@SelectedRecipe?.RecommendedQueueName'
                            </MudButton>
                        }
                    </MudStack>
                    @if (_pendingQueue is not null)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">
                            Queue '@_pendingQueue.Name' will be created when you confirm this action.
                        </MudAlert>
                    }
                    @if (PendingQueueIsDisabled)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true">
                            This new queue is disabled. Select another queue or create a new enabled queue.
                        </MudAlert>
                    }
                    else if (SavedQueueIsDisabled)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true">
                            This queue is disabled. Choose an enabled queue or enable it in Actions &gt; Queues.
                        </MudAlert>
                    }
                    @if (RecommendedQueueDisabled)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true">
                            The recommended queue '@SelectedRecipe?.RecommendedQueueName' is disabled. Default is selected; enable the recommended queue in Actions &gt; Queues if desired.
                        </MudAlert>
                    }
                }
                else
                {
                    <MudText Typo="Typo.subtitle1">3. Review</MudText>
                    <MudList T="string" Dense="true">
                        <MudListItem T="string">Recipe: @SelectedRecipe?.Title</MudListItem>
                        <MudListItem T="string">Queue: @EffectiveQueueName</MudListItem>
                        <MudListItem T="string">Group: @(string.IsNullOrWhiteSpace(EffectiveGroupName) ? "Ungrouped" : EffectiveGroupName)</MudListItem>
                        <MudListItem T="string">Action: @_actionName</MudListItem>
                        @if (!string.IsNullOrWhiteSpace(RecipeCommandName))
                        {
                            <MudListItem T="string">Command: !@RecipeCommandName</MudListItem>
                        }
                        @if (SelectedRecipe?.SupportsCommandSettings == true)
                        {
                            <MudListItem T="string">New command minimum rank: @_commandMinimumRank</MudListItem>
                            <MudListItem T="string">New command cooldowns: user @_commandUserCooldown s, global @_commandGlobalCooldown s</MudListItem>
                        }
                        @foreach (var trigger in _additionalTriggers)
                        {
                            <MudListItem T="string">Trigger: @trigger.Name</MudListItem>
                        }
                        @foreach (var parameter in (SelectedRecipe?.Parameters ?? [])
                            .Where(parameter => SelectedRecipe is not ObsSourceVisibilityRecipe || parameter.Key == "CommandName")
                            .Where(parameter => SelectedRecipe is ChannelPointActionRecipe
                                ? parameter.Key == "MessageText"
                                : SelectedRecipe is not TwitchResponseRecipeBase || parameter.Key == "MessageText")
                            .Where(parameter => SelectedRecipe is not KeywordReactionRecipe || parameter.Key == "MessageText")
                            .Where(parameter => SelectedRecipe is not CommandGroupToggleRecipe || parameter.Key == "Operation")
                            .Where(parameter => SelectedRecipe is not PointsRewardRecipe || parameter.Key != "Amount"))
                        {
                            <MudListItem T="string">@parameter.Label: @GetParameter(parameter.Key)</MudListItem>
                        }
                        @if (SelectedRecipe is PointsRewardRecipe)
                        {
                            <MudListItem T="string">Amount: @GetParameter("Amount")
                            </MudListItem>
                        }
                        @if (SelectedRecipe is TwitchResponseRecipeBase)
                        {
                            <MudListItem T="string">Overlay alert: @(IsTwitchAlertEnabled ? _alertRecipeSettings.Text : "Off")</MudListItem>
                            <MudListItem T="string">Additional sound: @(string.IsNullOrWhiteSpace(GetParameter("SoundFile")) ? "None" : GetParameter("SoundFile"))</MudListItem>
                            <MudListItem T="string">Fireworks bursts: @GetTwitchFireworksCount()</MudListItem>
                        }
                        @if (SelectedRecipe is ChannelPointActionRecipe)
                        {
                            var isNewReward = IsCreatingChannelPointReward;
                            var rewardTitle = isNewReward ? GetParameter("NewRewardTitle") : GetParameter("RewardTitle");
                            var existingRewardCost = _channelPointRewards.FirstOrDefault(reward =>
                                reward.Title.Equals(rewardTitle, StringComparison.OrdinalIgnoreCase))?.Cost;
                            <MudListItem T="string">Reward: @rewardTitle</MudListItem>
                            <MudListItem T="string">Setup: @(isNewReward ? "Create new reward" : "Existing reward")</MudListItem>
                            <MudListItem T="string">Cost: @(isNewReward ? GetChannelPointRewardCost() : existingRewardCost) points</MudListItem>
                            @if (isNewReward)
                            {
                                <MudListItem T="string">Skip Queue: @(GetRewardBoolean("RewardSkipQueue") ? "On" : "Off")</MudListItem>
                            }
                        }
                        @if (SelectedRecipe is KeywordReactionRecipe)
                        {
                            <MudListItem T="string">Sound: @(string.IsNullOrWhiteSpace(GetParameter("SoundFile")) ? "None" : GetParameter("SoundFile"))</MudListItem>
                        }
                        @if (SelectedRecipe is CommandGroupToggleRecipe)
                        {
                            <MudListItem T="string">Commands: @string.Join(", ", GetSelectedToggleCommands().Select(commandName => $"!{commandName}"))</MudListItem>
                            <MudListItem T="string">Change: @GetParameter("Operation")</MudListItem>
                        }
                        @if (SelectedRecipe is ObsSourceVisibilityRecipe)
                        {
                            <MudListItem T="string">OBS connection: @_obsConnectionOptions.FirstOrDefault(connection => connection.Id.ToString() == GetParameter("OBSConnectionId"))?.Name</MudListItem>
                            <MudListItem T="string">Source: @GetParameter("SceneName") / @GetParameter("SourceName")</MudListItem>
                            <MudListItem T="string">Visibility duration: @GetParameter("DurationSeconds") seconds</MudListItem>
                        }
                        @if (SelectedRecipe is AlertRecipe)
                        {
                            <MudListItem T="string">Alert text: @_alertRecipeSettings.Text</MudListItem>
                            <MudListItem T="string">Media: @(string.IsNullOrWhiteSpace(_alertRecipeSettings.File) ? "Text only" : _alertRecipeSettings.File)</MudListItem>
                            <MudListItem T="string">Audio: @(string.IsNullOrWhiteSpace(_alertRecipeSettings.AudioFile) ? "None selected" : _alertRecipeSettings.AudioFile)</MudListItem>
                            <MudListItem T="string">Duration: @_alertRecipeSettings.Duration seconds</MudListItem>
                            <MudListItem T="string">Channel: @(string.IsNullOrWhiteSpace(_alertRecipeSettings.AlertChannel) ? "Default" : _alertRecipeSettings.AlertChannel)</MudListItem>
                        }
                    </MudList>
                    <MudAlert Severity="Severity.Info" Dense="true">
                        Nothing is created until you confirm. Created actions will be tagged with their recipe and remain editable in Manage Actions.
                    </MudAlert>
                    @if (SelectedRecipe is not (ITimerGroupActionRecipe or IRaffleSetupActionRecipe or ChannelPointActionRecipe) &&
                        string.IsNullOrWhiteSpace(RecipeCommandName) && _additionalTriggers.Count == 0)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true">
                            This action has no trigger yet. You can create it now and link it to an event later in Manage Actions.
                        </MudAlert>
                    }
                    @if (SelectedRecipe is not ChannelPointActionRecipe &&
                        SelectedRecipe is { RequiresTrigger: true } requiredTriggerRecipe &&
                         !_additionalTriggers.Any(requiredTriggerRecipe.IsRequiredTrigger))
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true">
                            This recipe needs a @requiredTriggerRecipe.TriggerRequirementDescription before it can be created.
                        </MudAlert>
                    }
                    @if (SelectedRecipe is FireworksShowRecipe)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.PlayArrow"
                                   Disabled="@(!_fireworksWidgetPresent || _isBusy)"
                                   OnClick="TestFireworksAsync">
                            Test fire
                        </MudButton>
                    }
                }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_isBusy">Cancel</MudButton>
        @if (_step > 0)
        {
            <MudButton OnClick="Previous" Disabled="_isBusy">Back</MudButton>
        }
        @if (_step < 2)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Next" Disabled="@(!CanContinue || _isBusy)">Next</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateAsync" Disabled="@(_isBusy || !CanContinue)">
                @if (_isBusy)
            {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
                Create action
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Inject] private NavigationManager NavigationManager { get; set; } = null!;
    [Parameter] public string? InitialRecipeId { get; set; }

    private IReadOnlyList<IActionRecipe> _recipes = [];
    private readonly Dictionary<string, string> _parameters = new(StringComparer.OrdinalIgnoreCase);
    private readonly List<TriggerType> _additionalTriggers = [];
    private List<QueueConfiguration> _queues = [];
    private List<string> _groups = [];
    private string _selectedRecipeId = string.Empty;
    private string _actionName = string.Empty;
    private string _groupName = string.Empty;
    private string _commandName = string.Empty;
    private string _selectedQueueName = "Default";
    private string _variableTargetKey = string.Empty;
    private string _error = string.Empty;
    private int _commandUserCooldown;
    private int _commandGlobalCooldown;
    private Rank _commandMinimumRank = Rank.Viewer;
    private int _step;
    private QueueConfiguration? _pendingQueue;
    private bool _isBusy;
    private bool _fireworksWidgetPresent;
    private AlertType _alertRecipeSettings = CreateDefaultAlertSettings();

    private IActionRecipe? SelectedRecipe =>
        _recipes.FirstOrDefault(recipe => string.Equals(recipe.Id, _selectedRecipeId, StringComparison.OrdinalIgnoreCase));

    private static string GetDefaultActionName(IActionRecipe recipe) =>
        recipe.Id == "chat-command-reply" ? "Chat Reply" : recipe.Title;

    private static AlertType CreateDefaultAlertSettings() => new()
    {
        Duration = 6,
        CSS = AlertCssHelper.GenerateCss(AlertCssHelper.Presets["Classic White with Outline"])
    };

    private string NormalizedCommandName => ChatCommandRecipeBase.NormalizeCommandName(_commandName);
    private string RecipeCommandName => SelectedRecipe?.RequiresCommand == false
        ? ChatCommandRecipeBase.NormalizeCommandName(GetParameter("CommandName"))
        : NormalizedCommandName;
    private string EffectiveQueueName => _selectedQueueName.Trim();
    private string EffectiveGroupName => _groupName?.Trim() ?? string.Empty;
    private bool PendingQueueIsDisabled => _pendingQueue is { Enabled: false } &&
        _pendingQueue.Name.Equals(_selectedQueueName, StringComparison.OrdinalIgnoreCase);
    private bool SavedQueueIsDisabled => _queues.FirstOrDefault(queue =>
        string.Equals(queue.Name, _selectedQueueName, StringComparison.OrdinalIgnoreCase)) is { Enabled: false };
    private bool SelectedQueueIsDisabled => PendingQueueIsDisabled || SavedQueueIsDisabled;
    private bool RecommendedQueueNeedsCreation => SelectedRecipe?.RecommendedQueueName is { } recommendedName &&
        _pendingQueue is null && !_queues.Any(queue => queue.Name.Equals(recommendedName, StringComparison.OrdinalIgnoreCase));
    private bool RecommendedQueueDisabled => SelectedRecipe?.RecommendedQueueName is { } recommendedName &&
        string.Equals(_selectedQueueName, "Default", StringComparison.OrdinalIgnoreCase) &&
        _queues.Any(queue => !queue.Enabled && queue.Name.Equals(recommendedName, StringComparison.OrdinalIgnoreCase));

    private bool CanContinue => _step switch
    {
        0 => SelectedRecipe != null,
        1 => ValidateConfiguration(out _),
        _ => SelectedRecipe != null && ValidateConfiguration(out _)
    };

    protected override async Task OnInitializedAsync()
    {
        _recipes = RecipeRegistry.GetAll();
        _queues = await QueueManager.GetAllQueuesAsync();
        _groups = (await ActionService.GetActionSummariesAsync())
            .Select(action => action.Group?.Trim())
            .Where(group => !string.IsNullOrWhiteSpace(group))
            .Select(group => group!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(group => group, StringComparer.OrdinalIgnoreCase)
            .ToList();
        _selectedRecipeId = _recipes.FirstOrDefault(recipe => string.Equals(recipe.Id, InitialRecipeId, StringComparison.OrdinalIgnoreCase))?.Id
            ?? _recipes.FirstOrDefault()?.Id
            ?? string.Empty;
        InitializeParameters();
        await LoadObsSourceOptionsAsync();
        await LoadPointTypeNamesAsync();
        await LoadCommandNamesAsync();
        await LoadCounterNamesAsync();
        await LoadRafflePointTypesAsync();
        await LoadChannelPointRewardsAsync();
        await LoadFireworksWidgetPresenceAsync();
        await LoadAvailableVariablesAsync();
    }

    private async Task OnRecipeChanged(string? recipeId)
    {
        var oldRecipe = SelectedRecipe;
        _selectedRecipeId = recipeId ?? string.Empty;
        _parameters.Clear();
        _additionalTriggers.Clear();
        _pendingQueue = null;
        _selectedQueueName = "Default";
        _commandUserCooldown = 0;
        _commandGlobalCooldown = 0;
        _commandMinimumRank = Rank.Viewer;
        if (oldRecipe != null && string.Equals(_actionName, GetDefaultActionName(oldRecipe), StringComparison.OrdinalIgnoreCase))
            _actionName = string.Empty;
        _alertRecipeSettings = SelectedRecipe is AlertRecipe or TwitchResponseRecipeBase ? CreateDefaultAlertSettings() : new AlertType();
        InitializeParameters();
        await LoadObsSourceOptionsAsync();
        await LoadPointTypeNamesAsync();
        await LoadCommandNamesAsync();
        await LoadCounterNamesAsync();
        await LoadRafflePointTypesAsync();
        await LoadChannelPointRewardsAsync();
        await LoadAvailableVariablesAsync();
    }

    private void InitializeParameters()
    {
        if (SelectedRecipe == null) return;
        foreach (var parameter in SelectedRecipe.Parameters)
        {
            _parameters[parameter.Key] = parameter.DefaultValue;
        }

        _additionalTriggers.Clear();

        _groupName = SelectedRecipe.SuggestedGroupName ?? string.Empty;
        _variableTargetKey = SelectedRecipe.VariableParameterKeys.FirstOrDefault() ?? string.Empty;

        if (!string.IsNullOrWhiteSpace(SelectedRecipe.RecommendedQueueName))
        {
            var recommendedQueue = _queues.FirstOrDefault(queue => queue.Name.Equals(SelectedRecipe.RecommendedQueueName, StringComparison.OrdinalIgnoreCase));
            if (recommendedQueue is { Enabled: true })
            {
                _selectedQueueName = recommendedQueue.Name;
            }
            else if (recommendedQueue is null)
            {
                _pendingQueue = new QueueConfiguration
                {
                    Name = SelectedRecipe.RecommendedQueueName,
                    IsBlocking = true,
                    Enabled = true,
                    MaxConcurrentActions = 1
                };
                _selectedQueueName = _pendingQueue.Name;
            }
            else if (recommendedQueue is { Enabled: false })
            {
                _selectedQueueName = "Default";
            }
        }

        if (string.IsNullOrWhiteSpace(_actionName))
        {
            _actionName = GetDefaultActionName(SelectedRecipe);
        }
    }

    private string GetParameter(string key) => _parameters.GetValueOrDefault(key, string.Empty);

    private void SetParameter(string key, string? value) => _parameters[key] = value ?? string.Empty;

    private Task OnAlertSettingsChanged(AlertType alert)
    {
        _alertRecipeSettings = alert;
        SyncAlertRecipeParameters();
        return Task.CompletedTask;
    }

    private void SyncAlertRecipeParameters()
    {
        if (SelectedRecipe is AlertRecipe)
        {
            _parameters["AlertText"] = _alertRecipeSettings.Text ?? string.Empty;
            _parameters["File"] = _alertRecipeSettings.File ?? string.Empty;
            _parameters["AudioFile"] = _alertRecipeSettings.AudioFile ?? string.Empty;
            _parameters["Duration"] = _alertRecipeSettings.Duration.ToString(System.Globalization.CultureInfo.InvariantCulture);
            _parameters["Volume"] = _alertRecipeSettings.Volume.ToString(System.Globalization.CultureInfo.InvariantCulture);
            _parameters["CSS"] = _alertRecipeSettings.CSS ?? string.Empty;
            _parameters["AlertChannel"] = _alertRecipeSettings.AlertChannel ?? string.Empty;
            _parameters["Enabled"] = _alertRecipeSettings.Enabled.ToString();
        }
        else if (SelectedRecipe is TwitchResponseRecipeBase)
        {
            _parameters["AlertText"] = _alertRecipeSettings.Text ?? string.Empty;
            _parameters["AlertFile"] = _alertRecipeSettings.File ?? string.Empty;
            _parameters["AlertAudioFile"] = _alertRecipeSettings.AudioFile ?? string.Empty;
            _parameters["AlertDuration"] = _alertRecipeSettings.Duration.ToString(System.Globalization.CultureInfo.InvariantCulture);
            _parameters["AlertVolume"] = _alertRecipeSettings.Volume.ToString(System.Globalization.CultureInfo.InvariantCulture);
            _parameters["AlertCss"] = _alertRecipeSettings.CSS ?? string.Empty;
        }
    }

    private void OnQueueChanged(string? queueName)
    {
        _selectedQueueName = queueName ?? "Default";
        if (_pendingQueue is not null && _pendingQueue.Name.Equals(_selectedQueueName, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }
        _pendingQueue = null;
    }

    private void Next()
    {
        _error = string.Empty;
        if (_step == 1 && !ValidateConfiguration(out var error))
        {
            _error = error;
            return;
        }

        _step = Math.Min(2, _step + 1);
    }

    private void Previous()
    {
        _error = string.Empty;
        _step = Math.Max(0, _step - 1);
    }

    private void Cancel() => MudDialog.Cancel();
}