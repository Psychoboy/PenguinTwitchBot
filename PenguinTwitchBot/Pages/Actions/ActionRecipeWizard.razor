@using PenguinTwitchBot.Bot.Actions
@using PenguinTwitchBot.Bot.Actions.Recipes
@using PenguinTwitchBot.Bot.Commands
@using PenguinTwitchBot.Bot.Queues
@using PenguinTwitchBot.Database.Bot.Models.Commands
@using PenguinTwitchBot.Database.Bot.Models.Points
@using PenguinTwitchBot.Database.Bot.Models.Queues
@using PenguinTwitchBot.Database.Bot.Models.Actions.Triggers
@using PenguinTwitchBot.Database.Bot.Actions.SubActions.Types
@using PenguinTwitchBot.Helpers
@using PenguinTwitchBot.Database.Repository
@using Microsoft.Extensions.DependencyInjection
@using System.Text.Json
@using PenguinTwitchBot.Bot.WebSocketEvents
@inject IActionRecipeRegistry RecipeRegistry
@inject IActionManagementService ActionService
@inject IActionCommandService CommandService
@inject IQueueManager QueueManager
@inject IActionRecipeTagStore RecipeTagStore
@inject IDialogService DialogService
@inject IServiceScopeFactory ScopeFactory
@inject PenguinTwitchBot.Bot.Notifications.IWebSocketMessenger WebSocketMessenger
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Create from recipe</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudProgressLinear Value="@((_step + 1) * 33.3)" Color="Color.Primary" />
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }

                @if (_step == 0)
                {
                    <MudText Typo="Typo.subtitle1">1. Choose a recipe</MudText>
                    <MudSelect T="string" Label="Recipe" Variant="Variant.Outlined"
                               Value="_selectedRecipeId" ValueChanged="OnRecipeChanged">
                        @foreach (var recipe in _recipes)
                        {
                            <MudSelectItem T="string" Value="@recipe.Id">@recipe.Title</MudSelectItem>
                        }
                    </MudSelect>
                    @if (SelectedRecipe is { } recipe)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">@recipe.Description</MudAlert>
                    }
                }
                else if (_step == 1)
                {
                    <MudText Typo="Typo.subtitle1">2. Configure</MudText>
                    <MudTextField T="string" Label="Action name" Variant="Variant.Outlined"
                                  @bind-Value="_actionName" Required="true" />
                    @if (SelectedRecipe?.RequiresCommand != false)
                    {
                        <MudTextField T="string" Label="Command" Variant="Variant.Outlined"
                                      @bind-Value="_commandName" HelperText="Enter the name without !; an existing custom command will be reused." Required="true" />
                    }

                    @if (SelectedRecipe is { } recipe)
                    {
                        @if (recipe is AlertRecipe)
                        {
                            <MudTextField T="string" Label="Chat command (optional)" Variant="Variant.Outlined"
                                          Value="@GetParameter("CommandName")"
                                          ValueChanged="@(value => SetParameter("CommandName", value))"
                                          HelperText="Enter a command without !, or leave blank to use another trigger." />
                            <AlertSubActionEditor Alert="@_alertRecipeSettings"
                                                  AlertChanged="OnAlertSettingsChanged" />
                        }
                        else
                        {
                            @foreach (var parameter in recipe.Parameters)
                            {
                                <MudTextField T="string" Label="@parameter.Label" Variant="Variant.Outlined"
                                              Lines="@(parameter.Type == ActionRecipeParameterType.Multiline ? 3 : 1)"
                                              Value="@GetParameter(parameter.Key)"
                                              ValueChanged="@(value => SetParameter(parameter.Key, value))"
                                              HelperText="@parameter.HelperText"
                                              Required="@parameter.Required" />
                            }
                        }
                    }

                    @if (SelectedRecipe?.AllowsAdditionalTriggers == true)
                    {
                        <MudDivider Class="my-2" />
                        <MudText Typo="Typo.subtitle1">Additional triggers</MudText>
                        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                            @foreach (var trigger in _additionalTriggers)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info">@trigger.Name</MudChip>
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                                   aria-label="Remove trigger"
                                                   OnClick="@(() => RemoveAdditionalTrigger(trigger))" />
                                </MudStack>
                            }
                        </MudStack>
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="AddAdditionalTriggerAsync">
                            Add trigger
                        </MudButton>
                    }

                    @if (SelectedRecipe is FireworksShowRecipe && !_fireworksWidgetPresent)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true">
                            No enabled Fireworks widget is configured in an overlay layout.
                            <MudButton Variant="Variant.Text" Href="/overlay/editor">Open Overlay Editor</MudButton>
                        </MudAlert>
                    }

                    <MudSelect T="string" Label="Queue" Variant="Variant.Outlined"
                               Value="_selectedQueueName" ValueChanged="OnQueueChanged" Disabled="_createQueue">
                        <MudSelectItem T="string" Value="@("Default")">Default</MudSelectItem>
                        @foreach (var queue in _queues.OrderBy(queue => queue.Name, StringComparer.OrdinalIgnoreCase))
                        {
                            <MudSelectItem T="string" Value="@queue.Name">@queue.Name @(queue.Enabled ? "" : "(disabled)")</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSwitch T="bool" Color="Color.Primary" @bind-Value="_createQueue" Label="Create a dedicated queue" />
                    @if (_createQueue)
                    {
                        <MudTextField T="string" Label="New queue name" Variant="Variant.Outlined"
                                      @bind-Value="_newQueueName" HelperText="Created as a blocking queue with one action at a time." Required="true" />
                    }
                    @if (SelectedQueueIsDisabled)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true">
                            This queue is disabled. Choose an enabled queue or enable it in Actions &gt; Queues.
                        </MudAlert>
                    }
                    @if (RecommendedQueueDisabled)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true">
                            The recommended queue '@SelectedRecipe?.RecommendedQueueName' is disabled. Default is selected; enable the recommended queue in Actions &gt; Queues if desired.
                        </MudAlert>
                    }
                }
                else
                {
                    <MudText Typo="Typo.subtitle1">3. Review</MudText>
                    <MudList T="string" Dense="true">
                        <MudListItem T="string">Recipe: @SelectedRecipe?.Title</MudListItem>
                        <MudListItem T="string">Queue: @EffectiveQueueName</MudListItem>
                        <MudListItem T="string">Action: @_actionName</MudListItem>
                        @if (!string.IsNullOrWhiteSpace(RecipeCommandName))
                        {
                            <MudListItem T="string">Command: !@RecipeCommandName</MudListItem>
                        }
                        @foreach (var trigger in _additionalTriggers)
                        {
                            <MudListItem T="string">Trigger: @trigger.Name</MudListItem>
                        }
                        @foreach (var parameter in SelectedRecipe?.Parameters ?? [])
                        {
                            <MudListItem T="string">@parameter.Label: @GetParameter(parameter.Key)</MudListItem>
                        }
                        @if (SelectedRecipe is AlertRecipe)
                        {
                            <MudListItem T="string">Alert text: @_alertRecipeSettings.Text</MudListItem>
                            <MudListItem T="string">Media: @(string.IsNullOrWhiteSpace(_alertRecipeSettings.File) ? "Text only" : _alertRecipeSettings.File)</MudListItem>
                            <MudListItem T="string">Audio: @(string.IsNullOrWhiteSpace(_alertRecipeSettings.AudioFile) ? "None selected" : _alertRecipeSettings.AudioFile)</MudListItem>
                            <MudListItem T="string">Duration: @_alertRecipeSettings.Duration seconds</MudListItem>
                            <MudListItem T="string">Channel: @(string.IsNullOrWhiteSpace(_alertRecipeSettings.AlertChannel) ? "Default" : _alertRecipeSettings.AlertChannel)</MudListItem>
                        }
                    </MudList>
                    <MudAlert Severity="Severity.Info" Dense="true">
                        Nothing is created until you confirm. Created actions will be tagged with their recipe and remain editable in Manage Actions.
                    </MudAlert>
                    @if (string.IsNullOrWhiteSpace(RecipeCommandName) && _additionalTriggers.Count == 0)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true">
                            This action has no trigger yet. You can create it now and link it to an event later in Manage Actions.
                        </MudAlert>
                    }
                    @if (SelectedRecipe is FireworksShowRecipe)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.PlayArrow"
                                   Disabled="@(!_fireworksWidgetPresent || _isBusy)"
                                   OnClick="TestFireworksAsync">
                            Test fire
                        </MudButton>
                    }
                }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_isBusy">Cancel</MudButton>
        @if (_step > 0)
        {
            <MudButton OnClick="Previous" Disabled="_isBusy">Back</MudButton>
        }
        @if (_step < 2)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Next" Disabled="@(!CanContinue || _isBusy)">Next</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateAsync" Disabled="@(_isBusy || !CanContinue)">
                @if (_isBusy)
            {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
                Create action
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Inject] private NavigationManager NavigationManager { get; set; } = null!;
    [Parameter] public string? InitialRecipeId { get; set; }

    private IReadOnlyList<IActionRecipe> _recipes = [];
    private readonly Dictionary<string, string> _parameters = new(StringComparer.OrdinalIgnoreCase);
    private readonly List<TriggerType> _additionalTriggers = [];
    private List<QueueConfiguration> _queues = [];
    private string _selectedRecipeId = string.Empty;
    private string _actionName = string.Empty;
    private string _commandName = string.Empty;
    private string _selectedQueueName = "Default";
    private string _newQueueName = string.Empty;
    private string _error = string.Empty;
    private int _step;
    private bool _createQueue;
    private bool _isBusy;
    private bool _fireworksWidgetPresent;
    private AlertType _alertRecipeSettings = CreateDefaultAlertSettings();

    private IActionRecipe? SelectedRecipe =>
        _recipes.FirstOrDefault(recipe => string.Equals(recipe.Id, _selectedRecipeId, StringComparison.OrdinalIgnoreCase));

    private static string GetDefaultActionName(IActionRecipe recipe) =>
        recipe.Id == "chat-command-reply" ? "Chat Reply" : recipe.Title;

    private static AlertType CreateDefaultAlertSettings() => new()
    {
        Duration = 6,
        CSS = AlertCssHelper.GenerateCss(AlertCssHelper.Presets["Classic White with Outline"])
    };

    private string NormalizedCommandName => ChatReplyRecipe.NormalizeCommandName(_commandName);
    private string RecipeCommandName => SelectedRecipe?.RequiresCommand == false
        ? ChatReplyRecipe.NormalizeCommandName(GetParameter("CommandName"))
        : NormalizedCommandName;
    private string EffectiveQueueName => (_createQueue ? _newQueueName : _selectedQueueName).Trim();
    private bool SelectedQueueIsDisabled => !_createQueue && _queues.FirstOrDefault(queue =>
        string.Equals(queue.Name, _selectedQueueName, StringComparison.OrdinalIgnoreCase)) is { Enabled: false };
    private bool RecommendedQueueDisabled => SelectedRecipe?.RecommendedQueueName is { } recommendedName &&
        string.Equals(_selectedQueueName, "Default", StringComparison.OrdinalIgnoreCase) &&
        _queues.Any(queue => !queue.Enabled && queue.Name.Equals(recommendedName, StringComparison.OrdinalIgnoreCase));

    private bool CanContinue => _step switch
    {
        0 => SelectedRecipe != null,
        1 => ValidateConfiguration(out _),
        _ => SelectedRecipe != null && ValidateConfiguration(out _)
    };

    protected override async Task OnInitializedAsync()
    {
        _recipes = RecipeRegistry.GetAll();
        _queues = await QueueManager.GetAllQueuesAsync();
        _selectedRecipeId = _recipes.FirstOrDefault(recipe => string.Equals(recipe.Id, InitialRecipeId, StringComparison.OrdinalIgnoreCase))?.Id
            ?? _recipes.FirstOrDefault()?.Id
            ?? string.Empty;
        InitializeParameters();
        await LoadFireworksWidgetPresenceAsync();
    }

    private void OnRecipeChanged(string? recipeId)
    {
        var oldRecipe = SelectedRecipe;
        _selectedRecipeId = recipeId ?? string.Empty;
        _parameters.Clear();
        _additionalTriggers.Clear();
        _createQueue = false;
        _newQueueName = string.Empty;
        _selectedQueueName = "Default";
        if (oldRecipe != null && string.Equals(_actionName, GetDefaultActionName(oldRecipe), StringComparison.OrdinalIgnoreCase))
            _actionName = string.Empty;
        _alertRecipeSettings = SelectedRecipe is AlertRecipe ? CreateDefaultAlertSettings() : new AlertType();
        InitializeParameters();
    }

    private void InitializeParameters()
    {
        if (SelectedRecipe == null) return;
        foreach (var parameter in SelectedRecipe.Parameters)
        {
            _parameters[parameter.Key] = parameter.DefaultValue;
        }

        _additionalTriggers.Clear();

        if (!string.IsNullOrWhiteSpace(SelectedRecipe.RecommendedQueueName))
        {
            var recommendedQueue = _queues.FirstOrDefault(queue => queue.Name.Equals(SelectedRecipe.RecommendedQueueName, StringComparison.OrdinalIgnoreCase));
            if (recommendedQueue is { Enabled: true })
            {
                _selectedQueueName = recommendedQueue.Name;
            }
            else if (recommendedQueue == null)
            {
                _createQueue = true;
                _newQueueName = SelectedRecipe.RecommendedQueueName;
            }
            else
            {
                _createQueue = false;
                _newQueueName = string.Empty;
                _selectedQueueName = "Default";
            }
        }

        if (string.IsNullOrWhiteSpace(_actionName))
        {
            _actionName = GetDefaultActionName(SelectedRecipe);
        }
    }

    private string GetParameter(string key) => _parameters.GetValueOrDefault(key, string.Empty);

    private void SetParameter(string key, string? value) => _parameters[key] = value ?? string.Empty;

    private Task OnAlertSettingsChanged(AlertType alert)
    {
        _alertRecipeSettings = alert;
        SyncAlertRecipeParameters();
        return Task.CompletedTask;
    }

    private void SyncAlertRecipeParameters()
    {
        if (SelectedRecipe is not AlertRecipe) return;
        _parameters["AlertText"] = _alertRecipeSettings.Text ?? string.Empty;
        _parameters["File"] = _alertRecipeSettings.File ?? string.Empty;
        _parameters["AudioFile"] = _alertRecipeSettings.AudioFile ?? string.Empty;
        _parameters["Duration"] = _alertRecipeSettings.Duration.ToString(System.Globalization.CultureInfo.InvariantCulture);
        _parameters["Volume"] = _alertRecipeSettings.Volume.ToString(System.Globalization.CultureInfo.InvariantCulture);
        _parameters["CSS"] = _alertRecipeSettings.CSS ?? string.Empty;
        _parameters["AlertChannel"] = _alertRecipeSettings.AlertChannel ?? string.Empty;
        _parameters["Enabled"] = _alertRecipeSettings.Enabled.ToString();
    }

    private void OnQueueChanged(string? queueName)
    {
        _selectedQueueName = queueName ?? "Default";
        _createQueue = false;
    }

    private static TriggerType CloneTrigger(TriggerType trigger) => new()
    {
        Name = trigger.Name,
        Type = trigger.Type,
        Configuration = trigger.Configuration,
        Enabled = true,
        CommandId = trigger.CommandId,
        DefaultCommandId = trigger.DefaultCommandId,
        KeywordId = trigger.KeywordId,
        TimerGroupId = trigger.TimerGroupId
    };

    private void RemoveAdditionalTrigger(TriggerType trigger) => _additionalTriggers.Remove(trigger);

    private async Task AddAdditionalTriggerAsync()
    {
        var parameters = new DialogParameters<AddTriggerDialog>
        {
            { dialog => dialog.DisableResourceCreation, true }
        };
        var dialog = await DialogService.ShowAsync<AddTriggerDialog>("Add Trigger", parameters, new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        });
        var result = await dialog.Result;
        if (result is not { Canceled: false, Data: not null }) return;

        dynamic data = result.Data;
        var trigger = new TriggerType
        {
            Name = (string)data.TriggerName,
            Type = (TriggerTypes)data.TriggerType,
            Configuration = (string)data.Configuration,
            Enabled = true,
            CommandId = (Guid?)data.CommandId,
            DefaultCommandId = (Guid?)data.DefaultCommandId,
            KeywordId = (Guid?)data.KeywordId,
            TimerGroupId = (Guid?)data.TimerGroupId
        };
        _additionalTriggers.Add(trigger);
    }

    private async Task LoadFireworksWidgetPresenceAsync()
    {
        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var unitOfWork = scope.ServiceProvider.GetRequiredService<IUnitOfWork>();
            var layouts = await unitOfWork.OverlayLayouts.GetAllWithWidgetsAsync();
            _fireworksWidgetPresent = layouts.SelectMany(layout => layout.Widgets).Any(widget =>
                widget.IsEnabled && widget.WidgetType.Equals("fireworks", StringComparison.OrdinalIgnoreCase));
        }
        catch
        {
            _fireworksWidgetPresent = false;
        }
    }

    private async Task TestFireworksAsync()
    {
        if (!_fireworksWidgetPresent || _isBusy) return;
        try
        {
            var count = ParseTestValue("BurstCount", 1, 100, 1);
            var delay = ParseTestValue("DelayMilliseconds", 0, 60000, 100);
            await WebSocketMessenger.AddToQueue(new WsEvent
            {
                Event = new WsEventType { Source = "SubAction", Type = "Fireworks" },
                Data = new Dictionary<string, object>
                {
                    ["jobId"] = Guid.NewGuid().ToString("N"),
                    ["count"] = count,
                    ["delayMs"] = delay,
                    ["shell"] = GetParameter("Shell").Trim(),
                    ["size"] = GetParameter("Size").Trim()
                }
            });
            Snackbar.Add("Fireworks test show queued.", Severity.Success);
        }
        catch (Exception ex)
        {
            _error = $"Could not send the Fireworks test: {ex.Message}";
        }
    }

    private int ParseTestValue(string key, int min, int max, int fallback) =>
        int.TryParse(GetParameter(key), out var value) ? Math.Clamp(value, min, max) : fallback;

    private void Next()
    {
        _error = string.Empty;
        if (_step == 1 && !ValidateConfiguration(out var error))
        {
            _error = error;
            return;
        }

        _step = Math.Min(2, _step + 1);
    }

    private void Previous()
    {
        _error = string.Empty;
        _step = Math.Max(0, _step - 1);
    }

    private bool ValidateConfiguration(out string error)
    {
        error = string.Empty;
        if (SelectedRecipe == null)
        {
            error = "Choose a recipe.";
            return false;
        }
        SyncAlertRecipeParameters();
        if (SelectedRecipe is AlertRecipe &&
            (string.IsNullOrWhiteSpace(_alertRecipeSettings.Text) ||
             _alertRecipeSettings.Duration is < 1 or > 60 ||
             _alertRecipeSettings.Volume is < 0 or > 1))
        {
            error = "Enter alert text, a duration from 1 to 60 seconds, and a volume from 0 to 100%.";
            return false;
        }
        if (string.IsNullOrWhiteSpace(_actionName))
        {
            error = "Action name is required.";
            return false;
        }
        if (SelectedRecipe.RequiresCommand &&
            (string.IsNullOrWhiteSpace(NormalizedCommandName) || NormalizedCommandName.Any(char.IsWhiteSpace)))
        {
            error = "Enter a single command name without spaces.";
            return false;
        }
        if (!SelectedRecipe.RequiresCommand && RecipeCommandName.Any(char.IsWhiteSpace))
        {
            error = "Enter a single command name without spaces, or leave it blank.";
            return false;
        }
        if (string.IsNullOrWhiteSpace(EffectiveQueueName))
        {
            error = "Select or enter a queue name.";
            return false;
        }
        if (SelectedQueueIsDisabled)
        {
            error = "The selected queue is disabled. Choose an enabled queue or enable it in Actions > Queues.";
            return false;
        }
        foreach (var parameter in SelectedRecipe.Parameters.Where(parameter => parameter.Required))
        {
            if (string.IsNullOrWhiteSpace(GetParameter(parameter.Key)))
            {
                error = $"{parameter.Label} is required.";
                return false;
            }
        }

        return true;
    }

    private async Task CreateAsync()
    {
        if (_isBusy || !ValidateConfiguration(out _)) return;
        _isBusy = true;
        _error = string.Empty;
        try
        {
            var recipe = SelectedRecipe!;
            var actionName = _actionName.Trim();
            var queueName = EffectiveQueueName;
            var existingActions = await ActionService.GetActionSummariesAsync();
            if (existingActions.Any(action => string.Equals(action.Name, actionName, StringComparison.OrdinalIgnoreCase)))
            {
                _error = "An action with that name already exists.";
                return;
            }

            ActionCommand? command = null;
            if (!string.IsNullOrWhiteSpace(RecipeCommandName))
            {
                command = await CommandService.GetByCommandNameAsync(RecipeCommandName);
                if (command == null && await CommandService.CommandExistsAsync(RecipeCommandName))
                {
                    _error = $"The command !{RecipeCommandName} is already used by another command type.";
                    return;
                }
            }

            if (_createQueue)
            {
                if (queueName.Equals("Default", StringComparison.OrdinalIgnoreCase))
                {
                    _error = "Default is reserved. Choose another queue name.";
                    return;
                }
                if (_queues.Any(queue => queue.Name.Equals(queueName, StringComparison.OrdinalIgnoreCase)))
                {
                    _error = "A queue with that name already exists. Select it instead.";
                    return;
                }

                var createdQueue = await QueueManager.CreateQueueAsync(new QueueConfiguration
                {
                    Name = queueName,
                    IsBlocking = true,
                    Enabled = true,
                    MaxConcurrentActions = 1
                });
                _queues.Add(createdQueue);
                _selectedQueueName = createdQueue.Name;
                _createQueue = false;
                _newQueueName = string.Empty;
            }

            if (command == null && !string.IsNullOrWhiteSpace(RecipeCommandName))
            {
                command = await CreateRecipeCommandAsync(RecipeCommandName, recipe);
            }

            var action = recipe.Build(
                new ActionRecipeContext(actionName, queueName, command?.CommandName ?? string.Empty, command?.Id ?? Guid.Empty),
                _parameters);
            action.Triggers ??= [];
            action.Triggers.AddRange(_additionalTriggers.Select(CloneTrigger));
            var createdAction = await ActionService.CreateActionAsync(action);
            try
            {
                await RecipeTagStore.TagAsync(createdAction.Id, recipe.Id, _parameters);
            }
            catch (Exception tagException)
            {
                Snackbar.Add($"Action created, but its recipe tag could not be saved: {tagException.Message}", Severity.Warning);
            }

            Snackbar.Add($"Created action '{createdAction.Name}' from {recipe.Title}.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(createdAction.Id));
        }
        catch (Exception ex)
        {
            _error = $"Could not create the recipe action: {ex.Message}";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task<ActionCommand> CreateRecipeCommandAsync(string commandName, IActionRecipe recipe) =>
        await CommandService.AddAsync(new ActionCommand
        {
            CommandName = commandName,
            Category = $"Recipes / {recipe.Category}",
            Description = $"Created by recipe: {recipe.Id}",
            Disabled = false,
            MinimumRank = Rank.Viewer,
            SourceOnly = true
        });

    private void Cancel() => MudDialog.Cancel();
}