@using PenguinTwitchBot.Bot.Actions
@using PenguinTwitchBot.Database.Bot.Actions.SubActions.Types
@using PenguinTwitchBot.Database.Bot.Models.Actions.Triggers
@using PenguinTwitchBot.Bot.Commands
@using PenguinTwitchBot.Bot.Commands.Misc
@using PenguinTwitchBot.Database.Bot.Models
@using PenguinTwitchBot.Database.Bot.Models.Commands
@using PenguinTwitchBot.Database.Bot.Models.Timers
@using PenguinTwitchBot.Database.Bot.Actions.Triggers.Configurations
@using PenguinTwitchBot.Models.Actions
@using System.Text.Json
@inject IJSRuntime JSRuntime
@inject IActionCommandService CommandService
@inject IActionKeywordService KeywordService
@inject IAutoTimers TimerService
@inject ICommandHandler CommandHandler

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.FileDownload" Class="mr-2" />
            Export Actions
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudSelect T="ExportScope" @bind-Value="_scope" Label="Export Scope" Variant="Variant.Outlined">
                @if (SelectedAction != null)
                {
                    <MudSelectItem T="ExportScope" Value="ExportScope.SelectedAction">
                        Selected Action: "@SelectedAction.Name"
                    </MudSelectItem>
                }
                @if (!string.IsNullOrWhiteSpace(SelectedGroup))
                {
                    <MudSelectItem T="ExportScope" Value="ExportScope.SelectedGroup">
                        Group: "@SelectedGroup" (@AllActions.Count(a => (a.Group ?? string.Empty).Trim() == SelectedGroup.Trim()) actions)
                    </MudSelectItem>
                }
                <MudSelectItem T="ExportScope" Value="ExportScope.AllActions">
                    All Actions (@AllActions.Count)
                </MudSelectItem>
            </MudSelect>

            <MudDivider />

            <MudText Typo="Typo.subtitle2">Include in Export</MudText>
            <MudSwitch @bind-Value="_includeTriggers" Label="Triggers" Color="Color.Primary" />
            @if (_includeTriggers)
            {
                <MudAlert Severity="Severity.Info" Dense="true">
                    Export includes portable trigger definitions for commands, keywords, timer groups, and default-command events so imports can recreate or remap them safely.
                </MudAlert>
            }
            <MudSwitch @bind-Value="_includeQueueName" Label="Queue Name" Color="Color.Primary" />
            <MudSwitch @bind-Value="_includeGroup" Label="Group" Color="Color.Primary" />

            <MudAlert Severity="Severity.Info" Dense="true">
                @GetActionCount() action(s) will be exported.
            </MudAlert>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Export"
                   StartIcon="@Icons.Material.Filled.FileDownload"
                   Disabled="@(GetActionCount() == 0)">
            Export
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public List<ActionType> AllActions { get; set; } = [];
    [Parameter] public ActionType? SelectedAction { get; set; }
    [Parameter] public string? SelectedGroup { get; set; }

    private ExportScope _scope;
    private bool _includeTriggers = true;
    private bool _includeQueueName = true;
    private bool _includeGroup = true;

    protected override void OnInitialized()
    {
        if (SelectedAction != null)
            _scope = ExportScope.SelectedAction;
        else if (!string.IsNullOrWhiteSpace(SelectedGroup))
            _scope = ExportScope.SelectedGroup;
        else
            _scope = ExportScope.AllActions;
    }

    private int GetActionCount() => _scope switch
    {
        ExportScope.SelectedAction => SelectedAction != null ? 1 : 0,
        ExportScope.SelectedGroup => AllActions.Count(a => (a.Group ?? string.Empty).Trim() == (SelectedGroup ?? string.Empty).Trim()),
        ExportScope.AllActions => AllActions.Count,
        _ => 0
    };

    private List<ActionType> GetActionsToExport() => _scope switch
    {
        ExportScope.SelectedAction => SelectedAction != null ? [SelectedAction] : [],
        ExportScope.SelectedGroup => AllActions.Where(a => (a.Group ?? string.Empty).Trim() == (SelectedGroup ?? string.Empty).Trim()).ToList(),
        ExportScope.AllActions => AllActions,
        _ => []
    };

    private async Task Export()
    {
        var actionsToExport = GetActionsToExport();
        var actionIdToNameMap = AllActions
            .Where(action => action.Id.HasValue)
            .ToDictionary(action => action.Id!.Value, action => action.Name);

        // Preload related resources so trigger exports can carry portable definitions.
        Dictionary<int, ActionCommand> commandById = new();
        Dictionary<int, ActionKeyword> keywordById = new();
        Dictionary<int, TimerGroup> timerGroupById = new();
        Dictionary<string, DefaultCommand> defaultCommandByName = new(StringComparer.OrdinalIgnoreCase);
        if (_includeTriggers)
        {
            var allCommands = await CommandService.GetAllAsync();
            commandById = allCommands
                .Where(c => c.Id.HasValue)
                .ToDictionary(c => c.Id!.Value);

            var allKeywords = await KeywordService.GetAllAsync();
            keywordById = allKeywords
                .Where(k => k.Id.HasValue)
                .ToDictionary(k => k.Id!.Value);

            var timerGroups = await TimerService.GetTimerGroupsAsync();
            timerGroupById = timerGroups
                .Where(t => t.Id.HasValue)
                .ToDictionary(t => t.Id!.Value);

            defaultCommandByName = (await CommandHandler.GetDefaultCommandsFromDb())
                .GroupBy(command => command.CommandName, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(group => group.Key, group => group.First(), StringComparer.OrdinalIgnoreCase);
        }

        var package = new ActionsImportExportPackage
        {
            ExportedAt = DateTime.UtcNow,
            Actions = actionsToExport.Select(a => new ActionImportExportDto
            {
                Name = a.Name,
                Group = _includeGroup ? a.Group : null,
                Enabled = a.Enabled,
                RandomAction = a.RandomAction,
                ConcurrentAction = a.ConcurrentAction,
                OnlineOnly = a.OnlineOnly,
                QueueName = _includeQueueName ? a.QueueName : null,
                SubActions = PrepareSubActionsForExport(a.SubActions.OrderBy(s => s.Index).ToList(), actionIdToNameMap),
                CatchSubActions = PrepareSubActionsForExport(a.CatchSubActions.OrderBy(s => s.Index).ToList(), actionIdToNameMap),
                Triggers = _includeTriggers
                    ? a.Triggers
                        .Select(t =>
                        {
                            ActionCommandImportExportDto? commandDef = null;
                            ActionKeywordImportExportDto? keywordDef = null;
                            TimerGroupImportExportDto? timerGroupDef = null;
                            DefaultCommandTriggerImportExportDto? defaultCommandDef = null;

                            if (t.Type == TriggerTypes.Command)
                            {
                                var fallbackCommandName = ExtractStringValue(t.Configuration, "CommandName") ?? t.Name.TrimStart('!');
                                commandDef = t.CommandId.HasValue && commandById.TryGetValue(t.CommandId.Value, out var command)
                                    ? ActionCommandImportExportDto.FromCommand(command)
                                    : string.IsNullOrWhiteSpace(fallbackCommandName)
                                        ? null
                                        : new ActionCommandImportExportDto { CommandName = fallbackCommandName };
                            }
                            else if (t.Type == TriggerTypes.Keyword)
                            {
                                var fallbackKeywordName = ExtractStringValue(t.Configuration, "KeywordName") ?? t.Name;
                                keywordDef = t.KeywordId.HasValue && keywordById.TryGetValue(t.KeywordId.Value, out var keyword)
                                    ? ActionKeywordImportExportDto.FromKeyword(keyword)
                                    : string.IsNullOrWhiteSpace(fallbackKeywordName)
                                        ? null
                                        : new ActionKeywordImportExportDto { CommandName = fallbackKeywordName };
                            }
                            else if (t.Type == TriggerTypes.Timer)
                            {
                                var fallbackTimerGroupName = ExtractStringValue(t.Configuration, "TimerGroupName");
                                timerGroupDef = t.TimerGroupId.HasValue && timerGroupById.TryGetValue(t.TimerGroupId.Value, out var timerGroup)
                                    ? TimerGroupImportExportDto.FromTimerGroup(timerGroup)
                                    : string.IsNullOrWhiteSpace(fallbackTimerGroupName)
                                        ? null
                                        : new TimerGroupImportExportDto { Name = fallbackTimerGroupName };
                            }
                            else if (t.Type == TriggerTypes.DefaultCommand)
                            {
                                var config = DeserializeDefaultCommandConfiguration(t.Configuration);
                                if (config != null && !string.IsNullOrWhiteSpace(config.DefaultCommandName))
                                {
                                    defaultCommandByName.TryGetValue(config.DefaultCommandName, out _);
                                    defaultCommandDef = new DefaultCommandTriggerImportExportDto
                                    {
                                        DefaultCommandName = config.DefaultCommandName,
                                        EventType = config.EventType
                                    };
                                }
                            }

                            return new TriggerImportExportDto
                            {
                                Name = t.Name,
                                Type = t.Type,
                                Configuration = t.Configuration,
                                Enabled = t.Enabled,
                                CommandDefinition = commandDef,
                                KeywordDefinition = keywordDef,
                                TimerGroupDefinition = timerGroupDef,
                                DefaultCommandDefinition = defaultCommandDef
                            };
                        }).ToList()
                    : []
            }).ToList()
        };

        var options = new JsonSerializerOptions
        {
            WriteIndented = true,
            TypeInfoResolver = new SubActionTypeResolver()
        };

        var json = JsonSerializer.Serialize(package, options);

        var fileName = _scope switch
        {
            ExportScope.SelectedAction => $"Action_{SanitizeName(SelectedAction?.Name)}_{DateTime.Now:yyyyMMdd_HHmmss}.json",
            ExportScope.SelectedGroup => $"ActionGroup_{SanitizeName(SelectedGroup)}_{DateTime.Now:yyyyMMdd_HHmmss}.json",
            _ => $"Actions_{DateTime.Now:yyyyMMdd_HHmmss}.json"
        };

        await JSRuntime.InvokeVoidAsync("downloadFile", fileName, json);
        MudDialog.Close(DialogResult.Ok(true));
    }

    private static string SanitizeName(string? name) =>
        string.IsNullOrWhiteSpace(name)
            ? "export"
            : string.Concat(name.Select(c => char.IsLetterOrDigit(c) || c == '_' ? c : '_'));

    private static string? ExtractStringValue(string configuration, string propertyName)
    {
        if (string.IsNullOrWhiteSpace(configuration))
            return null;

        try
        {
            var element = JsonSerializer.Deserialize<JsonElement>(configuration);
            if (element.ValueKind == JsonValueKind.Object &&
                element.TryGetProperty(propertyName, out var propertyValue) &&
                propertyValue.ValueKind == JsonValueKind.String)
            {
                return propertyValue.GetString();
            }
        }
        catch
        {
        }

        return null;
    }

    private static DefaultCommandTriggerConfiguration? DeserializeDefaultCommandConfiguration(string configuration)
    {
        if (string.IsNullOrWhiteSpace(configuration))
            return null;
        try
        {
            return JsonSerializer.Deserialize<DefaultCommandTriggerConfiguration>(configuration);
        }
        catch
        {
            return null;
        }
    }

    private static List<SubActionType> PrepareSubActionsForExport(List<SubActionType> subActions, Dictionary<int, string> actionIdToNameMap)
    {
        PopulateActionReferenceNames(subActions, actionIdToNameMap);
        return subActions;
    }

    private static void PopulateActionReferenceNames(IEnumerable<SubActionType> subActions, Dictionary<int, string> actionIdToNameMap)
    {
        foreach (var subAction in subActions)
        {
            if (subAction is ExecuteActionType executeAction &&
                executeAction.ActionId.HasValue &&
                actionIdToNameMap.TryGetValue(executeAction.ActionId.Value, out var executeActionName))
            {
                executeAction.ActionName = executeActionName;
            }
            else if (subAction is ForEachViewerType forEachViewer &&
                     forEachViewer.ActionId.HasValue &&
                     actionIdToNameMap.TryGetValue(forEachViewer.ActionId.Value, out var forEachViewerActionName))
            {
                forEachViewer.ActionName = forEachViewerActionName;
            }
            else if (subAction is LogicIfElseType logic)
            {
                PopulateActionReferenceNames(logic.TrueSubActions, actionIdToNameMap);
                PopulateActionReferenceNames(logic.FalseSubActions, actionIdToNameMap);
            }
        }
    }

    private void Cancel() => MudDialog.Cancel();

    public enum ExportScope { SelectedAction, SelectedGroup, AllActions }
}
