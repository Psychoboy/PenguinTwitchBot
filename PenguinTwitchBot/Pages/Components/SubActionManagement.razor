@using PenguinTwitchBot.Database.Bot.Actions.SubActions.Types
@using PenguinTwitchBot.Bot.Actions.SubActions
@using PenguinTwitchBot.Bot.Features
@using PenguinTwitchBot.Database.Bot.Models.Actions.Triggers
@using PenguinTwitchBot.Pages.Actions
@inject MudBlazor.ISnackbar Snackbar
@inject IDialogService DialogService
@inject IFeatureRuntimeCoordinator FeatureRuntimeCoordinator
@inject SubActionReferenceNames ReferenceNames

<MudPaper Class="pa-4 mb-4">
    <MudStack Spacing="2">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h6">SubActions (@SubActions.Count)</MudText>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudButton StartIcon="@Icons.Material.Filled.DataObject" Color="Color.Info" Size="Size.Small" 
                           OnClick="OpenAvailableVariablesDialog" Variant="Variant.Outlined">
                    Available Variables
                </MudButton>
                <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Size="Size.Small" 
                           OnClick="OpenAddSubActionDialog" Variant="Variant.Filled">
                    Add SubAction
                </MudButton>
            </MudStack>
        </MudStack>

        @if (SubActions.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">No subactions configured. Click "Add SubAction" to get started.</MudText>
        }
        else
        {
            <MudStack Spacing="2">
                @for (int i = 0; i < SubActions.Count; i++)
                {
                    var index = i;
                    var subAction = SubActions[i];
                    <div @key="subAction"
                         class="@_drag.GetItemCssClass(index)"
                         data-drag-item="true"
                         data-drag-index="@index"
                         draggable="@(!ReadOnly ? "true" : "false")"
                         @ondragstart="@(() => { if (!ReadOnly) _drag.Start(index); })"
                         @ondragenter="@(() => { if (!ReadOnly) _drag.Enter(index); })"
                         ondragover="event.preventDefault()"
                         @ondrop="@(() => OnDropSubActionAsync(index))"
                         @ondrop:preventDefault="true"
                         @ondragend="@(() => _drag.End())">
                        <MudPaper Outlined="true" Class="pa-2" Style="@(IsDisabled(subAction) ? "opacity: 0.6;" : null)">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    @if (!ReadOnly)
                                    {
                                        <span class="drag-reorder-handle" data-drag-handle="true" title="Drag to reorder">
                                            <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" />
                                        </span>
                                    }
                                    <MudStack Spacing="0">
                                        <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" 
                                                       Disabled="@(index == 0 || ReadOnly)" OnClick="@(() => MoveUp(index))" />
                                        <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" 
                                                       Disabled="@(index == SubActions.Count - 1 || ReadOnly)" OnClick="@(() => MoveDown(index))" />
                                    </MudStack>
                                    <MudStack Spacing="0">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                            <MudText Typo="Typo.body1" Style="@(IsDisabled(subAction) ? "text-decoration: line-through;" : null)">@(index + 1). @GetSubActionTypeName(subAction)</MudText>
                                            @if (IsDisabled(subAction))
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">Disabled</MudChip>
                                            }
                                            @if (IsDisabledByFeature(subAction))
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">Feature Disabled</MudChip>
                                            }
                                        </MudStack>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">@SubActionHelpers.GetSubActionDescription(subAction, ReferenceNames)</MudText>
                                    </MudStack>
                                </MudStack>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudTooltip Text="@(subAction.Enabled ? "Disable sub-action" : "Enable sub-action")">
                                        <MudSwitch T="bool"
                                                   Value="@subAction.Enabled"
                                                   ValueChanged="@(v => ToggleSubActionEnabled(subAction, v))"
                                                   Color="Color.Success"
                                                   Disabled="@ReadOnly" />
                                    </MudTooltip>
                                    @if (subAction is LogicIfElseType)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" Color="Color.Info" 
                                                       OnClick="@(() => EditLogicIfElse(index))" 
                                                       aria-label="Edit True/False branches" />
                                    }
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" 
                                                   OnClick="@(() => EditSubAction(index))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" 
                                                   OnClick="@(() => DeleteSubAction(index))" />
                                </MudStack>
                            </MudStack>
                        </MudPaper>
                    </div>
                }
            </MudStack>
        }
    </MudStack>
</MudPaper>

@code {
    [Parameter]
    public List<SubActionType> SubActions { get; set; } = new();

    [Parameter]
    public EventCallback<List<SubActionType>> SubActionsChanged { get; set; }

    [Parameter]
    public bool ReadOnly { get; set; } = false;

    [Parameter]
    public Guid? ActionId { get; set; }

    [Parameter]
    public string? ActionName { get; set; }

    [Parameter]
    public IEnumerable<TriggerType>? Triggers { get; set; }

    [Parameter]
    public bool IsCatchSubAction { get; set; }

    private readonly DragReorderState _drag = new();

    protected override Task OnInitializedAsync() => ReferenceNames.LoadAsync();

    private async Task OnDropSubActionAsync(int targetIndex)
    {
        if (ReadOnly || !_drag.TryCompleteDrop(SubActions, targetIndex, out _, out _))
        {
            return;
        }

        for (int i = 0; i < SubActions.Count; i++)
        {
            SubActions[i].Index = i;
        }

        await NotifyChanged();
    }

    private async Task OpenAvailableVariablesDialog()
    {
        var parameters = new DialogParameters<AvailableVariablesDialog>
        {
            { x => x.ActionId, ActionId },
            { x => x.ActionName, ActionName },
            { x => x.Triggers, Triggers },
            { x => x.PreviousSubActions, SubActions },
            { x => x.IsCatchSubAction, IsCatchSubAction }
        };

        await DialogService.ShowAsync<AvailableVariablesDialog>("Available Variables", parameters, new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseButton = true
        });
    }

    private async Task MoveUp(int index)
    {
        if (index > 0)
        {
            var temp = SubActions[index];
            SubActions[index] = SubActions[index - 1];
            SubActions[index - 1] = temp;

            // Update Index properties to reflect new positions
            SubActions[index].Index = index;
            SubActions[index - 1].Index = index - 1;

            await NotifyChanged();
        }
    }

    private async Task MoveDown(int index)
    {
        if (index < SubActions.Count - 1)
        {
            var temp = SubActions[index];
            SubActions[index] = SubActions[index + 1];
            SubActions[index + 1] = temp;

            // Update Index properties to reflect new positions
            SubActions[index].Index = index;
            SubActions[index + 1].Index = index + 1;

            await NotifyChanged();
        }
    }

    private async Task OpenAddSubActionDialog()
    {
        var parameters = new DialogParameters<AddSubActionDialog>
        {
            { x => x.ActionId, ActionId },
            { x => x.Triggers, Triggers },
            { x => x.PreviousSubActions, SubActions },
            { x => x.IsCatchSubAction, IsCatchSubAction }
        };

        var dialog = await DialogService.ShowAsync<AddSubActionDialog>("Add SubAction", parameters, new DialogOptions 
        { 
            MaxWidth = MaxWidth.Medium, 
            FullWidth = true 
        });

        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is SubActionType newSubAction)
        {
            newSubAction.Index = SubActions.Count;
            SubActions.Add(newSubAction);
            await NotifyChanged();
            Snackbar.Add($"{GetSubActionTypeName(newSubAction)} added successfully", Severity.Success);
        }
    }

    private async Task EditSubAction(int index)
    {
        if (index < 0 || index >= SubActions.Count) return;

        var parameters = new DialogParameters<AddSubActionDialog>
        {
            { x => x.ExistingSubAction, SubActions[index] },
            { x => x.ActionId, ActionId },
            { x => x.Triggers, Triggers },
            { x => x.PreviousSubActions, SubActions.Take(index).ToList() },
            { x => x.IsCatchSubAction, IsCatchSubAction }
        };

        var dialog = await DialogService.ShowAsync<AddSubActionDialog>("Edit SubAction", parameters, new DialogOptions 
        { 
            MaxWidth = MaxWidth.Medium, 
            FullWidth = true 
        });

        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is SubActionType updatedSubAction)
        {
            SubActions[index] = updatedSubAction;
            await NotifyChanged();
            Snackbar.Add($"{GetSubActionTypeName(updatedSubAction)} updated successfully", Severity.Success);
        }
    }

    private async Task DeleteSubAction(int index)
    {
        SubActions.RemoveAt(index);

        // Reindex all subactions after the deleted one
        for (int i = index; i < SubActions.Count; i++)
        {
            SubActions[i].Index = i;
        }

        await NotifyChanged();
        Snackbar.Add("SubAction removed", Severity.Success);
    }

    private async Task EditLogicIfElse(int index)
    {
        if (index < 0 || index >= SubActions.Count) return;

        if (SubActions[index] is not LogicIfElseType ifElseType)
        {
            Snackbar.Add("This subaction is not a Logic If/Else type", Severity.Error);
            return;
        }

        var parameters = new DialogParameters<LogicIfElseEditor>
        {
            { x => x.IfElseType, ifElseType },
            { x => x.ActionId, ActionId },
            { x => x.Triggers, Triggers },
            { x => x.ParentPreviousSubActions, SubActions.Take(index).ToList() },
            { x => x.IsCatchSubAction, IsCatchSubAction },
            { x => x.ReadOnly, ReadOnly }
        };

        var dialog = await DialogService.ShowAsync<LogicIfElseEditor>("Edit True/False Branches", parameters, new DialogOptions 
        { 
            MaxWidth = MaxWidth.Large, 
            FullWidth = true 
        });

        await dialog.Result;
        if (!ReadOnly)
        {
            await NotifyChanged();
        }
    }

    private async Task NotifyChanged()
    {
        await SubActionsChanged.InvokeAsync(SubActions);
    }

    private string GetSubActionTypeName(SubActionType subAction)
    {
        return PenguinTwitchBot.Database.Bot.Actions.SubActions.SubActionRegistry.GetMetadata(subAction.SubActionTypes)?.DisplayName
            ?? subAction.GetType().Name.Replace("Type", "");
    }

    private async Task ToggleSubActionEnabled(SubActionType subAction, bool enabled)
    {
        if (ReadOnly) return;
        subAction.Enabled = enabled;
        await NotifyChanged();
    }

    private static bool IsDisabled(SubActionType subAction) => !subAction.Enabled;

    private bool IsDisabledByFeature(SubActionType subAction)
    {
        return !SubActionFeatureGate.IsAvailable(subAction.SubActionTypes, FeatureRuntimeCoordinator);
    }
}
