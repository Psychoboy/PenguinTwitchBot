@using PenguinTwitchBot.Bot.Core
@inject ISubscriptionTracker SubscriptionTracker

<MudPaper Elevation="3">
    <MudTable Items="_entries" Loading="_isLoading" Dense="true" Hover="true" Elevation="0">
        <ToolBarContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Style="width: 100%;" Wrap="Wrap.Wrap" Spacing="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@GetIcon()" Color="@GetColor()" />
                    <MudText Typo="Typo.h6">@Title</MudText>
                </MudStack>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    @if (IsToggleMode)
                    {
                        <MudButton Variant="@(_activeMetric == SubscriberLeaderboardMetric.TotalMonths ? Variant.Filled : Variant.Outlined)"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   OnClick="@(() => SetMetricAsync(SubscriberLeaderboardMetric.TotalMonths))">
                            Total
                        </MudButton>
                        <MudButton Variant="@(_activeMetric == SubscriberLeaderboardMetric.ConsecutiveMonths ? Variant.Filled : Variant.Outlined)"
                                   Color="Color.Secondary"
                                   Size="Size.Small"
                                   OnClick="@(() => SetMetricAsync(SubscriberLeaderboardMetric.ConsecutiveMonths))">
                            Consecutive
                        </MudButton>
                    }
                    @if (ShowViewAllLink)
                    {
                        <MudButton Href="/leaderboards"
                                   Variant="Variant.Text"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   EndIcon="@Icons.Material.Filled.ArrowForward">
                            Leaderboards
                        </MudButton>
                    }
                </MudStack>
            </MudStack>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Rank</MudTh>
            <MudTh>Subscriber</MudTh>
            <MudTh Style="text-align: right;">@GetMetricHeader()</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Rank">
                @RenderRankBadge(context.Rank)
            </MudTd>
            <MudTd DataLabel="Subscriber">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudText Typo="Typo.body2">@context.DisplayName</MudText>
                    @if (!string.IsNullOrWhiteSpace(context.Tier))
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@GetTierColor(context.Tier)">@FormatTier(context.Tier)</MudChip>
                    }
                </MudStack>
            </MudTd>
            <MudTd DataLabel="@GetMetricHeader()" Style="text-align: right;">
                @{
                    var months = _activeMetric == SubscriberLeaderboardMetric.ConsecutiveMonths
                        ? context.ConsecutiveMonths
                        : context.TotalMonths;
                }
                <MudText Typo="Typo.body2"><strong>@months</strong> @(months == 1 ? "month" : "months")</MudText>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="ma-2">
                No current subscriber month data recorded yet.
            </MudAlert>
        </NoRecordsContent>
        <LoadingContent>
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
        </LoadingContent>
    </MudTable>
</MudPaper>

@code {
    [Parameter]
    public string Title { get; set; } = "Top Subscribers";

    /// <summary>
    /// "total", "consecutive", or "toggle"
    /// </summary>
    [Parameter]
    public string Mode { get; set; } = "total";

    [Parameter]
    public int Limit { get; set; } = 10;

    [Parameter]
    public bool ShowViewAllLink { get; set; }

    private List<SubscriberLeaderboardEntry> _entries = [];
    private SubscriberLeaderboardMetric _activeMetric = SubscriberLeaderboardMetric.TotalMonths;
    private string? _lastMode;
    private int _lastLimit;
    private bool _isLoading = true;

    private bool IsToggleMode => string.Equals(Mode, "toggle", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnParametersSetAsync()
    {
        var normalizedMode = (Mode ?? "total").Trim().ToLowerInvariant();
        if (_lastMode != normalizedMode || _lastLimit != Limit)
        {
            _lastMode = normalizedMode;
            _lastLimit = Limit;
            _activeMetric = normalizedMode == "consecutive"
                ? SubscriberLeaderboardMetric.ConsecutiveMonths
                : SubscriberLeaderboardMetric.TotalMonths;
            await LoadEntriesAsync();
        }
    }

    private async Task SetMetricAsync(SubscriberLeaderboardMetric metric)
    {
        if (_activeMetric == metric)
        {
            return;
        }

        _activeMetric = metric;
        await LoadEntriesAsync();
    }

    private async Task LoadEntriesAsync()
    {
        _isLoading = true;
        try
        {
            _entries = await SubscriptionTracker.GetTopCurrentSubscribersAsync(_activeMetric, Math.Clamp(Limit, 1, 100));
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string GetMetricHeader() => _activeMetric == SubscriberLeaderboardMetric.ConsecutiveMonths
        ? "Consecutive Months"
        : "Total Months";

    private string GetIcon() => _activeMetric == SubscriberLeaderboardMetric.ConsecutiveMonths
        ? Icons.Material.Filled.LocalFireDepartment
        : Icons.Material.Filled.CardMembership;

    private Color GetColor() => _activeMetric == SubscriberLeaderboardMetric.ConsecutiveMonths
        ? Color.Warning
        : Color.Success;

    private static string FormatTier(string tier) => tier switch
    {
        "1000" => "T1",
        "2000" => "T2",
        "3000" => "T3",
        _ => tier
    };

    private static Color GetTierColor(string tier) => tier switch
    {
        "3000" => Color.Warning,
        "2000" => Color.Secondary,
        _ => Color.Default
    };

    private RenderFragment RenderRankBadge(int rank) => __builder =>
    {
        if (rank == 1)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Color="Color.Warning" Size="Size.Small" />
                <MudText><strong>#@rank</strong></MudText>
            </MudStack>
        }
        else if (rank == 2)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Style="color: silver;" Size="Size.Small" />
                <MudText><strong>#@rank</strong></MudText>
            </MudStack>
        }
        else if (rank == 3)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Style="color: #CD7F32;" Size="Size.Small" />
                <MudText><strong>#@rank</strong></MudText>
            </MudStack>
        }
        else
        {
            <MudText><strong>#@rank</strong></MudText>
        }
    };
}
