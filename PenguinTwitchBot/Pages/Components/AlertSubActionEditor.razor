@using MudBlazor
@using Microsoft.AspNetCore.Components.Forms
@using PenguinTwitchBot.Database.Bot.Actions.SubActions.Types
@using PenguinTwitchBot.Services
@using PenguinTwitchBot.Helpers
@inject MediaUploadService MediaUploadService
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject IDialogService DialogService
@implements IDisposable

<MudStack Spacing="3">
    <!-- Alert Text -->
    <MudTextField @bind-Value="Alert.Text"
                  @bind-Value:after="NotifyChanged"
                  Label="Alert Text"
                  Required="true"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  HelperText="Text to display on screen during the alert"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.TextFields" />

    <!-- Image / Video File Picker -->
    <MudStack Spacing="1">
        <MudText Typo="Typo.caption" Color="Color.Secondary"><b>Media File (Image or Video)</b></MudText>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
            <div style="flex: 1 1 auto; min-width: 0;">
                <MudAutocomplete T="string"
                                 Value="@Alert.File"
                                 ValueChanged="OnMediaFileSelected"
                                 SearchFunc="@SearchMediaFiles"
                                 Label="Image / Video File"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Clearable="true"
                                 ResetValueOnEmptyText="true"
                                 CoerceText="false"
                                 CoerceValue="false"
                                 MaxItems="100"
                                 Adornment="Adornment.Start"
                                 AdornmentIcon="@(IsVideo(Alert.File) ? Icons.Material.Filled.Videocam : Icons.Material.Filled.Image)"
                                 Placeholder="Search or select image/video..." />
            </div>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.PhotoLibrary"
                       OnClick="OpenMediaLibraryAsync">
                Browse Media Library
            </MudButton>

            <!-- Upload Media Button -->
            <MudFileUpload T="IBrowserFile"
                           FilesChanged="UploadMediaFile"
                           Accept=".gif,.png,.jpg,.jpeg,.webp,.webm,.mp4,.ogg,.ogv"
                           Disabled="@_isUploadingMedia"
                           Class="d-inline-flex">
                <CustomContent>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@(_isUploadingMedia ? null : Icons.Material.Filled.CloudUpload)"
                               OnClick="@context.OpenFilePickerAsync"
                               Disabled="@_isUploadingMedia"
                               Size="Size.Medium"
                               Style="height: 40px; white-space: nowrap;">
                        @if (_isUploadingMedia)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <text>Uploading...</text>
                        }
                        else
                        {
                            <text>Upload Legacy Media</text>
                        }
                    </MudButton>
                </CustomContent>
                <SelectedTemplate Context="_"></SelectedTemplate>
            </MudFileUpload>
        </MudStack>

        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="px-3" Style="margin-top: -2px;">
            Use the Media Library for assets in wwwroot/media. Existing wwwroot/gifs files remain supported with their legacy companion-audio matching.
        </MudText>
    </MudStack>

    <!-- Companion Sound (Optional, tied to selected Image/Video) -->
    @if (!string.IsNullOrWhiteSpace(Alert.File) && !IsMediaLibraryFile && string.IsNullOrWhiteSpace(Alert.AudioFile))
    {
        <MudPaper Outlined="true" Class="pa-3" Style="background: var(--mud-palette-background-grey);">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Audiotrack" Color="Color.Secondary" />
                    <div>
                        <MudText Typo="Typo.subtitle2">
                            @(string.IsNullOrEmpty(_companionAudioFile) ? "Companion Sound (Optional)" : $"Companion Sound: {_companionAudioFile}")
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @(string.IsNullOrEmpty(_companionAudioFile)
                                ? $"Upload a sound effect to play alongside '{Path.GetFileNameWithoutExtension(Alert.File)}' (will be named '{Path.GetFileNameWithoutExtension(Alert.File)}.<ext>')"
                                : $"Automatically played with this alert. Matched by filename before extension.")
                        </MudText>
                    </div>
                </MudStack>

                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    @if (!string.IsNullOrEmpty(_companionAudioFile))
                    {
                        <MudTooltip Text="@(_isPlayingCompanionSound ? "Stop Sound" : "Preview Sound")">
                            <MudIconButton Icon="@(_isPlayingCompanionSound ? Icons.Material.Filled.Stop : Icons.Material.Filled.PlayArrow)"
                                           Color="@(_isPlayingCompanionSound ? Color.Error : Color.Secondary)"
                                           Variant="Variant.Filled"
                                           Size="Size.Small"
                                           OnClick="ToggleCompanionSoundPreview" />
                        </MudTooltip>
                    }

                    <MudFileUpload T="IBrowserFile"
                                   FilesChanged="UploadCompanionAudioFile"
                                   Accept=".mp3,.wav,.ogg,.aac,.webm,.opus,.m4a"
                                   Disabled="@_isUploadingAudio"
                                   Class="d-inline-flex">
                        <CustomContent>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Secondary"
                                       Size="Size.Small"
                                       StartIcon="@(_isUploadingAudio ? null : Icons.Material.Filled.UploadFile)"
                                       OnClick="@context.OpenFilePickerAsync"
                                       Disabled="@_isUploadingAudio">
                                @if (_isUploadingAudio)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                                    <text>Uploading...</text>
                                }
                                else
                                {
                                    <text>@(string.IsNullOrEmpty(_companionAudioFile) ? "Upload Sound" : "Replace Sound")</text>
                                }
                            </MudButton>
                        </CustomContent>
                        <SelectedTemplate Context="_"></SelectedTemplate>
                    </MudFileUpload>
                </MudStack>
            </MudStack>

            @if (!string.IsNullOrEmpty(_standaloneAudioUrl))
            {
                <audio @key="_standaloneAudioKey" autoplay src="@_standaloneAudioUrl" @onended="OnCompanionAudioEnded" style="display: none;"></audio>
            }
        </MudPaper>
    }

    <MudPaper Outlined="true" Class="pa-3" Style="background: var(--mud-palette-background-grey);">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
            <div>
                <MudText Typo="Typo.subtitle2">Explicit Audio (Optional)</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Select any audio file from the Media Library. It does not need to share a name with the image or video.
                </MudText>
                @if (!string.IsNullOrWhiteSpace(Alert.AudioFile))
                {
                    <MudText Typo="Typo.body2" Class="mt-1">@Alert.AudioFile</MudText>
                }
            </div>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                @if (!string.IsNullOrWhiteSpace(Alert.AudioFile))
                {
                    <MudTooltip Text="Clear selected audio">
                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                       Color="Color.Error"
                                       OnClick="ClearExplicitAudioAsync" />
                    </MudTooltip>
                }
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.AudioFile"
                           OnClick="OpenAudioLibraryAsync">
                    @(string.IsNullOrWhiteSpace(Alert.AudioFile) ? "Select Audio" : "Change Audio")
                </MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>

    <!-- Numeric Settings: Duration & Volume -->
    <MudGrid>
        <MudItem xs="12" sm="6">
            <MudNumericField @bind-Value="Alert.Duration"
                             @bind-Value:after="NotifyChanged"
                             Label="Duration (seconds)"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Min="1"
                             Max="60"
                             HelperText="How long the alert stays visible (1 - 60s)" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudStack Spacing="0">
                <MudStack Row="true" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Audio Volume</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Primary"><b>@((int)(Alert.Volume * 100))%</b></MudText>
                </MudStack>
                <MudSlider @bind-Value="Alert.Volume"
                           @bind-Value:after="NotifyChanged"
                           Min="0.0f"
                           Max="1.0f"
                           Step="0.05f"
                           Color="Color.Primary" />
            </MudStack>
        </MudItem>
    </MudGrid>

    <!-- Custom CSS & CSS Generator -->
    <MudStack Spacing="1">
        <MudText Typo="Typo.subtitle2"><b>Text Styling</b></MudText>
        <MudExpansionPanels Elevation="0" Outlined="true">
            <MudExpansionPanel Text="Advanced: Custom CSS">
                <MudTextField @bind-Value="Alert.CSS"
                              @bind-Value:after="NotifyChanged"
                              Label="Custom CSS"
                              Lines="2"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              HelperText="Inline CSS applied directly to the alert text." />
            </MudExpansionPanel>
        </MudExpansionPanels>

        <AlertCssGenerator Css="@Alert.CSS"
                           CssChanged="OnGeneratedCssChanged"
                           SampleText="@Alert.Text"
                           OnChanged="NotifyChanged" />
    </MudStack>

    <!-- Additional Options -->
    <MudGrid>
        <MudItem xs="12" sm="8">
            <MudTextField @bind-Value="Alert.AlertChannel"
                          @bind-Value:after="NotifyChanged"
                          Label="Alert Channel (Optional)"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          HelperText="Route to specific overlay channel; leave blank for default" />
        </MudItem>
        <MudItem xs="12" sm="4" Class="d-flex align-center">
            <MudSwitch @bind-Value="Alert.Enabled"
                       @bind-Value:after="NotifyChanged"
                       Label="Enabled"
                       Color="Color.Success" />
        </MudItem>
    </MudGrid>

    <MudDivider Class="my-2" />

    <!-- Alert Preview Section -->
    <MudStack Spacing="2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <div>
                <MudText Typo="Typo.subtitle1"><b>Alert Preview</b></MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Simulate how this alert appears on the OBS overlay with custom CSS and synced audio.
                </MudText>
            </div>
            <MudStack Row="true" Spacing="2">
                @if (_isPreviewing)
                {
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Icon="@Icons.Material.Filled.Timer">
                        Playing: @_previewTimeRemaining s
                    </MudChip>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Error"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Stop"
                               OnClick="StopAlertPreview">
                        Stop Preview
                    </MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.PlayArrow"
                               OnClick="StartAlertPreview"
                               Disabled="@(string.IsNullOrWhiteSpace(Alert.Text) && string.IsNullOrWhiteSpace(Alert.File))">
                        Preview Alert
                    </MudButton>
                }
            </MudStack>
        </MudStack>

        <!-- Preview stage runs the same alerts.html renderer used by OBS. -->
        <div style="width: 100%; height: 320px; background-color: #0a0a0a; background-image: radial-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 0); background-size: 16px 16px; border: 2px dashed rgba(255, 255, 255, 0.2); border-radius: 8px; position: relative; overflow: hidden; display: flex; flex-direction: column; align-items: center; justify-content: center;">
            @if (_isPreviewing)
            {
                <iframe @ref="_previewFrame"
                        src="/alerts.html?preview=1"
                    @onload="OnPreviewFrameLoaded"
                        title="Alert preview"
                        style="position: absolute; inset: 0; width: 100%; height: 100%; border: 0; background: transparent;"></iframe>
            }
            else
            {
                <MudStack AlignItems="AlignItems.Center" Spacing="1" Style="opacity: 0.6;">
                    <MudIcon Icon="@Icons.Material.Filled.Tv" Size="Size.Large" Color="Color.Default" />
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Alert preview is idle</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Click 'Preview Alert' to test animation, styling, and audio</MudText>
                </MudStack>
            }
        </div>
    </MudStack>
</MudStack>

@code {
    [Parameter] public AlertType Alert { get; set; } = new();
    [Parameter] public EventCallback<AlertType> AlertChanged { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private List<string> _availableMediaFiles = new();
    private string? _companionAudioFile;
    private bool _isUploadingMedia = false;
    private bool _isUploadingAudio = false;

    // Preview state
    private bool _isPreviewing = false;
    private int _previewTimeRemaining = 0;
    private CancellationTokenSource? _previewCts;
    private ElementReference _previewFrame;

    // Standalone audio preview (small play button on companion audio row)
    private bool _isPlayingCompanionSound = false;
    private string? _standaloneAudioUrl;
    private string _standaloneAudioKey = Guid.NewGuid().ToString();
    private bool IsMediaLibraryFile => Alert.File.StartsWith("/media/", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        LoadMediaFiles();
        CheckCompanionAudio();
    }

    protected override void OnParametersSet()
    {
        CheckCompanionAudio();
    }

    private void LoadMediaFiles()
    {
        _availableMediaFiles = MediaUploadService.GetAlertMediaFiles();
    }

    private void CheckCompanionAudio()
    {
        _companionAudioFile = IsMediaLibraryFile ? null : MediaUploadService.GetCompanionAudioFileName(Alert.File);
    }

    private Task<IEnumerable<string>> SearchMediaFiles(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return Task.FromResult<IEnumerable<string>>(_availableMediaFiles);
        }

        var filtered = _availableMediaFiles
            .Where(f => f.Contains(value, StringComparison.OrdinalIgnoreCase))
            .ToList();

        return Task.FromResult<IEnumerable<string>>(filtered);
    }

    private async Task OnMediaFileSelected(string? value)
    {
        StopAlertPreview();
        StopCompanionSoundPreview();
        Alert.File = value ?? "";
        CheckCompanionAudio();
        await NotifyChanged();
    }

    private async Task OpenMediaLibraryAsync()
    {
        StopAlertPreview();
        StopCompanionSoundPreview();
        var parameters = new DialogParameters<MediaBrowserDialog>
        {
            { dialog => dialog.SelectionMode, true },
            { dialog => dialog.ImageVideoOnly, true }
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = true,
            CloseOnEscapeKey = true
        };

        var dialog = await DialogService.ShowAsync<MediaBrowserDialog>("Browse Media Library", parameters, options);
        var result = await dialog.Result;
        if (result is not { Canceled: false, Data: MediaFileInfo selectedFile }) return;

        Alert.File = selectedFile.RelativeUrl;
        CheckCompanionAudio();
        await NotifyChanged();
    }

    private async Task OpenAudioLibraryAsync()
    {
        StopAlertPreview();
        StopCompanionSoundPreview();
        var parameters = new DialogParameters<MediaBrowserDialog>
        {
            { dialog => dialog.SelectionMode, true },
            { dialog => dialog.AudioOnly, true }
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = true,
            CloseOnEscapeKey = true
        };

        var dialog = await DialogService.ShowAsync<MediaBrowserDialog>("Select Alert Audio", parameters, options);
        var result = await dialog.Result;
        if (result is not { Canceled: false, Data: MediaFileInfo selectedFile }) return;

        Alert.AudioFile = selectedFile.RelativeUrl;
        await NotifyChanged();
    }

    private async Task ClearExplicitAudioAsync()
    {
        StopAlertPreview();
        Alert.AudioFile = string.Empty;
        await NotifyChanged();
    }

    private async Task NotifyChanged()
    {
        await AlertChanged.InvokeAsync(Alert);
        await OnChanged.InvokeAsync();
    }

    private bool IsVideo(string? fileName)
    {
        if (string.IsNullOrWhiteSpace(fileName)) return false;
        var ext = Path.GetExtension(fileName).ToLowerInvariant();
        return MediaUploadService.SupportedVideoExtensions.Contains(ext);
    }

    #region Upload Handlers

    private async Task UploadMediaFile(IBrowserFile? file)
    {
        if (file == null) return;

        StopAlertPreview();
        StopCompanionSoundPreview();
        _isUploadingMedia = true;
        StateHasChanged();

        try
        {
            // Max 50MB for video/gifs
            using var stream = file.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024);
            var result = await MediaUploadService.UploadAlertMediaAsync(stream, file.Name);

            if (result.Success && !string.IsNullOrEmpty(result.FileName))
            {
                LoadMediaFiles();
                Alert.File = result.FileName;
                CheckCompanionAudio();
                await NotifyChanged();

                Snackbar.Add($"Media '{result.FileName}' uploaded and verified successfully!", Severity.Success);
            }
            else
            {
                Snackbar.Add(result.ErrorMessage ?? "Failed to upload media file.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Upload error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isUploadingMedia = false;
            StateHasChanged();
        }
    }

    private async Task UploadCompanionAudioFile(IBrowserFile? file)
    {
        if (file == null) return;

        if (string.IsNullOrWhiteSpace(Alert.File))
        {
            Snackbar.Add("Please select or upload an Image/Video file first.", Severity.Warning);
            return;
        }

        StopAlertPreview();
        StopCompanionSoundPreview();
        _isUploadingAudio = true;
        StateHasChanged();

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024);
            var result = await MediaUploadService.UploadAlertCompanionAudioAsync(stream, Alert.File, file.Name);

            if (result.Success && !string.IsNullOrEmpty(result.FileName))
            {
                CheckCompanionAudio();
                await NotifyChanged();

                Snackbar.Add($"Companion audio '{result.FileName}' uploaded and paired with alert!", Severity.Success);
            }
            else
            {
                Snackbar.Add(result.ErrorMessage ?? "Failed to upload companion audio.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Upload error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isUploadingAudio = false;
            StateHasChanged();
        }
    }

    #endregion

    #region Companion Sound Standalone Preview

    private void ToggleCompanionSoundPreview()
    {
        if (_isPlayingCompanionSound)
        {
            StopCompanionSoundPreview();
        }
        else
        {
            StartCompanionSoundPreview();
        }
    }

    private void StartCompanionSoundPreview()
    {
        if (string.IsNullOrEmpty(_companionAudioFile)) return;

        var url = MediaUploadService.ResolveAlertSoundUrl(_companionAudioFile);
        if (string.IsNullOrEmpty(url)) return;

        _standaloneAudioKey = Guid.NewGuid().ToString();
        _standaloneAudioUrl = $"{url}?t={DateTime.UtcNow.Ticks}";
        _isPlayingCompanionSound = true;
    }

    private void StopCompanionSoundPreview()
    {
        _isPlayingCompanionSound = false;
        _standaloneAudioUrl = null;
    }

    private void OnCompanionAudioEnded()
    {
        _isPlayingCompanionSound = false;
        _standaloneAudioUrl = null;
        StateHasChanged();
    }

    #endregion

    #region Full Alert Preview (Non-autoplay)

    private async Task StartAlertPreview()
    {
        StopAlertPreview();
        StopCompanionSoundPreview();

        _isPreviewing = true;
        _previewTimeRemaining = Math.Max(1, Alert.Duration);
        _previewCts = new CancellationTokenSource();
        var token = _previewCts.Token;

        StateHasChanged();

        // Run countdown timer for the configured duration
        _ = Task.Run(async () =>
        {
            try
            {
                while (_previewTimeRemaining > 0 && !token.IsCancellationRequested)
                {
                    await Task.Delay(1000, token);
                    _previewTimeRemaining--;
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (OperationCanceledException) { }
            finally
            {
                await InvokeAsync(StopAlertPreview);
            }
        }, token);
    }

    private async Task OnGeneratedCssChanged(string newCss)
    {
        Alert.CSS = newCss;
        await NotifyChanged();
    }

    private async Task OnPreviewFrameLoaded()
    {
        if (!_isPreviewing) return;
        await JSRuntime.InvokeVoidAsync("alertPreviewBridge.send", _previewFrame, new
        {
            file = Alert.File,
            audioFile = Alert.AudioFile,
            duration = Alert.Duration,
            volume = Alert.Volume,
            css = Alert.CSS,
            text = Alert.Text
        });
    }

    private void StopAlertPreview() => StopAlertPreviewCore(true);

    private void StopAlertPreviewCore(bool notify)
    {
        if (_previewCts != null)
        {
            _previewCts.Cancel();
            _previewCts.Dispose();
            _previewCts = null;
        }

        _isPreviewing = false;
        _previewTimeRemaining = 0;
        if (notify)
        {
            StateHasChanged();
        }
    }

    #endregion

    public void Dispose()
    {
        StopAlertPreviewCore(false);
        StopCompanionSoundPreview();
    }
}
