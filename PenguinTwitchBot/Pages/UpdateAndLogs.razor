@page "/settings/updates"
@using PenguinTwitchBot.Bot.ServiceTools
@using PenguinTwitchBot.Shared.Help
@attribute [Authorize(Roles = "Streamer, Editor")]
@inject IVersionCheckService VersionCheckService
@inject IUpdateChannelSettingsService UpdateChannelSettingsService
@inject IJSRuntime JS
@inject IDialogService DialogService
@implements IDisposable

<PageTitle>@(AppConfiguration["ApplicationTitle"] ?? "Penguin Twitch Bot") - Updates & Logs</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <div>
            <MudText Typo="Typo.h4">Updates &amp; Logs</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Check for application releases, manage release channels, and monitor real-time system logs.</MudText>
        </div>
        <HelpButton Topic="updates-logs" />
    </MudStack>

<MudPaper Elevation="1" Class="pa-4 mb-4">
    <MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <div>
                <MudText Typo="Typo.h6">Application Updates</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Current version: <strong>v@VersionCheckService.CurrentVersion</strong> (@(VersionCheckService.CurrentRid ?? "unknown platform")).
                </MudText>
            </div>
            @if (VersionCheckService.IsUpToDate)
            {
                <MudChip T="string" Color="Color.Success" Size="Size.Medium" Icon="@Icons.Material.Filled.CheckCircle">Up to Date</MudChip>
            }
            else
            {
                <MudChip T="string" Color="Color.Warning" Size="Size.Medium" Icon="@Icons.Material.Filled.Upgrade">Update Available</MudChip>
            }
        </MudStack>

        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="CheckForUpdatesAsync" Disabled="_checkingUpdates" StartIcon="@Icons.Material.Filled.Refresh">
                @(_checkingUpdates ? "Checking..." : "Check For Updates")
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="StartUpdateAsync" Disabled="_startingUpdate || !VersionCheckService.CanUserInitiateUpdate" StartIcon="@Icons.Material.Filled.SystemUpdate">
                Update Now
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="RestoreLatestRecoveryAsync" Disabled="_restoringRecovery || !VersionCheckService.HasRecoveryBundle" StartIcon="@Icons.Material.Filled.Restore">
                Restore Last Recovery
            </MudButton>
        </MudStack>

        @if (_startingUpdate)
        {
            <MudStack Spacing="1">
                <MudProgressLinear Value="@_updateProgressPercent" Color="Color.Secondary" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @_updateProgressMessage
                </MudText>
            </MudStack>
        }

        <MudDivider />

        <MudStack Spacing="1">
            <MudText Typo="Typo.subtitle2">Release Channel Settings</MudText>
            <MudSwitch T="bool" Label="Include pre-releases (Beta / Preview builds)" Value="_includePreviewReleases" ValueChanged="OnIncludePreviewReleasesChanged" Disabled="_savingPreviewSetting" Color="Color.Primary" />
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                When disabled (default), only official released versions are checked and installed. When enabled, pre-releases are also checked.
            </MudText>
        </MudStack>

        <MudText Typo="Typo.caption" Color="Color.Secondary">
            Target Release: @(_latestLabel) | Recovery bundle: @(VersionCheckService.LatestRecoveryBundleName ?? "None")
        </MudText>

        @if (!string.IsNullOrWhiteSpace(VersionCheckService.UpdateBlockedReason))
        {
            <MudAlert Severity="Severity.Info" Dense="true">@VersionCheckService.UpdateBlockedReason</MudAlert>
        }
    </MudStack>
</MudPaper>

<!-- Release Notes & Previous Releases Browser -->
<MudPaper Elevation="1" Class="pa-4 mb-4">
    <MudStack Spacing="3">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <div>
                <MudText Typo="Typo.h6">Release Notes & History</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Browse release notes and changelogs for the latest and previous bot versions.
                </MudText>
            </div>
            @if (VersionCheckService.AvailableReleases.Count > 0)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Showing @(FilteredReleases.Count()) of @VersionCheckService.AvailableReleases.Count releases
                </MudText>
            }
        </MudStack>

        @if (VersionCheckService.AvailableReleases.Count > 0)
        {
            <MudGrid Spacing="3">
                <!-- Left panel: List of releases -->
                <MudItem xs="12" md="4" lg="3">
                    <MudStack Spacing="2">
                        <MudTextField @bind-Value="_releaseSearchText"
                                      @bind-Value:after="UpdateSelectedRelease"
                                      Placeholder="Filter releases..."
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      Clearable="true"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search" />

                        <MudPaper Outlined="true" Class="pa-1" Style="max-height: 520px; overflow-y: auto;">
                            @if (FilteredReleases.Any())
                            {
                                <MudList T="ReleaseInfo" SelectedValue="_selectedRelease" SelectedValueChanged="OnSelectedReleaseChanged" Dense="true">
                                    @foreach (var rel in FilteredReleases)
                                    {
                                        var isSelected = _selectedRelease?.TagName == rel.TagName;
                                        var isCurrent = string.Equals(rel.Version, VersionCheckService.CurrentVersion, StringComparison.OrdinalIgnoreCase);
                                        var isLatest = string.Equals(rel.Version, VersionCheckService.LatestVersion, StringComparison.OrdinalIgnoreCase);

                                        <MudListItem T="ReleaseInfo" Value="@rel" Class="@(isSelected ? "mud-theme-primary-hover" : "")" Style="@(isSelected ? "background-color: var(--mud-palette-action-default-hover); border-radius: 4px;" : "")">
                                            <div style="width: 100%;">
                                                <div style="display: flex; justify-content: space-between; align-items: center;">
                                                    <MudText Typo="Typo.subtitle2" Style="@(isSelected ? "font-weight: 700;" : "")">@rel.TagName</MudText>
                                                    @if (rel.PublishedAt.HasValue)
                                                    {
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@rel.PublishedAt.Value.ToString("MMM d, yyyy")</MudText>
                                                    }
                                                </div>
                                                <div style="display: flex; gap: 4px; margin-top: 4px; flex-wrap: wrap;">
                                                    @if (isCurrent)
                                                    {
                                                        <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled">Current</MudChip>
                                                    }
                                                    @if (isLatest)
                                                    {
                                                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">Latest</MudChip>
                                                    }
                                                    @if (rel.IsPreRelease)
                                                    {
                                                        <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Outlined">Pre-release</MudChip>
                                                    }
                                                </div>
                                            </div>
                                        </MudListItem>
                                        <MudDivider />
                                    }
                                </MudList>
                            }
                            else
                            {
                                <div class="pa-4 text-center">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">No releases match your filter.</MudText>
                                </div>
                            }
                        </MudPaper>
                    </MudStack>
                </MudItem>

                <!-- Right panel: Selected release details -->
                <MudItem xs="12" md="8" lg="9">
                    @if (_selectedRelease is not null)
                    {
                        var isCurrent = string.Equals(_selectedRelease.Version, VersionCheckService.CurrentVersion, StringComparison.OrdinalIgnoreCase);
                        var isLatest = string.Equals(_selectedRelease.Version, VersionCheckService.LatestVersion, StringComparison.OrdinalIgnoreCase);

                        <MudPaper Class="pa-4" Outlined="true">
                            <MudStack Spacing="2">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                                    <div>
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                            <MudText Typo="Typo.h6">@_selectedRelease.Title</MudText>
                                            @if (isCurrent)
                                            {
                                                <MudChip T="string" Color="Color.Primary" Size="Size.Small">Installed Version</MudChip>
                                            }
                                            @if (isLatest)
                                            {
                                                <MudChip T="string" Color="Color.Success" Size="Size.Small">Target Latest</MudChip>
                                            }
                                            @if (_selectedRelease.IsPreRelease)
                                            {
                                                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Outlined">Pre-release</MudChip>
                                            }
                                        </MudStack>
                                        @if (_selectedRelease.PublishedAt.HasValue)
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                Published on @_selectedRelease.PublishedAt.Value.ToString("MMMM d, yyyy h:mm tt UTC")
                                            </MudText>
                                        }
                                    </div>
                                    <MudStack Row="true" Spacing="2">
                                        @if (!string.IsNullOrWhiteSpace(_selectedRelease.HtmlUrl))
                                        {
                                            <MudButton Href="@_selectedRelease.HtmlUrl" Target="_blank" Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Custom.Brands.GitHub" Size="Size.Small">
                                                View on GitHub
                                            </MudButton>
                                        }
                                        @if (isLatest && VersionCheckService.CanUserInitiateUpdate)
                                        {
                                            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small" OnClick="StartUpdateAsync" StartIcon="@Icons.Material.Filled.SystemUpdate">
                                                Update to this version
                                            </MudButton>
                                        }
                                    </MudStack>
                                </MudStack>

                                <MudDivider Class="my-2" />

                                @if (!string.IsNullOrWhiteSpace(_selectedRelease.Body))
                                {
                                    <div class="pa-2" style="max-height: 520px; overflow-y: auto;">
                                        <GitHubMarkdownViewer Value="@_selectedRelease.Body" />
                                    </div>
                                }
                                else
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="py-6 text-center">
                                        No release notes were provided for this release.
                                    </MudText>
                                }
                            </MudStack>
                        </MudPaper>
                    }
                    else
                    {
                        <MudPaper Class="pa-6 text-center" Outlined="true">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Select a release from the list to view its notes.</MudText>
                        </MudPaper>
                    }
                </MudItem>
            </MudGrid>
        }
        else if (!string.IsNullOrWhiteSpace(VersionCheckService.LatestReleaseNotes))
        {
            <MudPaper Class="pa-4" Outlined="true">
                <MudText Typo="Typo.subtitle2" Class="mb-2">Latest Release Notes (v@VersionCheckService.LatestVersion)</MudText>
                <GitHubMarkdownViewer Value="@VersionCheckService.LatestReleaseNotes" />
            </MudPaper>
        }
        else
        {
            <MudAlert Severity="Severity.Normal" Dense="true">
                No release information has been downloaded yet. Click <strong>Check For Updates</strong> above to fetch the latest release notes.
            </MudAlert>
        }
    </MudStack>
</MudPaper>

<MudPaper Elevation="1" Class="pa-4 mb-4">
    <MudStack Spacing="2">
        <MudText Typo="Typo.h6">Diagnostics</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Download the newest all_*.log file to share for support.
        </MudText>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="DownloadLatestAllLogAsync" StartIcon="@Icons.Material.Filled.Download">
            Download Latest all Log
        </MudButton>
    </MudStack>
</MudPaper>
</MudContainer>

@code {
    [Inject] private ISnackbar Snackbar { get; set; } = null!;

    // Blazor Server streams downloads over SignalR, so cap the payload to keep large logs downloadable.
    private const long MaxLogDownloadBytes = 5L * 1024 * 1024;

    private bool _checkingUpdates;
    private bool _startingUpdate;
    private bool _restoringRecovery;
    private bool _includePreviewReleases;
    private bool _savingPreviewSetting;
    private string _updateProgressMessage = string.Empty;
    private int _updateProgressPercent;
    private string _releaseSearchText = string.Empty;
    private ReleaseInfo? _selectedRelease;

    private string _latestLabel => string.IsNullOrWhiteSpace(VersionCheckService.LatestVersion)
        ? "Unknown"
        : $"v{VersionCheckService.LatestVersion} ({VersionCheckService.CurrentRid ?? "unsupported"})";

    private IEnumerable<ReleaseInfo> FilteredReleases
    {
        get
        {
            var releases = VersionCheckService.AvailableReleases.AsEnumerable();
            if (!_includePreviewReleases)
            {
                releases = releases.Where(r => !r.IsPreRelease);
            }
            if (!string.IsNullOrWhiteSpace(_releaseSearchText))
            {
                var search = _releaseSearchText.Trim();
                releases = releases.Where(r =>
                    r.TagName.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    r.Title.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    (r.Body?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false));
            }
            return releases;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        VersionCheckService.VersionStatusChanged += HandleVersionStatusChanged;
        try
        {
            _includePreviewReleases = await UpdateChannelSettingsService.GetIncludePreviewReleasesAsync(defaultValue: false);
        }
        catch
        {
            _includePreviewReleases = VersionCheckService.IncludePreviewReleases;
        }
        UpdateSelectedRelease();
    }

    private void HandleVersionStatusChanged()
    {
        UpdateSelectedRelease();
        InvokeAsync(StateHasChanged);
    }

    private void OnSelectedReleaseChanged(ReleaseInfo? release)
    {
        _selectedRelease = release;
    }

    private void UpdateSelectedRelease()
    {
        var currentFiltered = FilteredReleases.ToList();
        var matching = _selectedRelease is null
            ? null
            : currentFiltered.FirstOrDefault(r => r.TagName == _selectedRelease.TagName);

        _selectedRelease = matching
            ?? currentFiltered.FirstOrDefault(r => r.Version == VersionCheckService.LatestVersion)
            ?? currentFiltered.FirstOrDefault();
    }

    private async Task CheckForUpdatesAsync()
    {
        _checkingUpdates = true;
        var refreshed = await VersionCheckService.RefreshNowAsync();
        if (!refreshed)
        {
            Snackbar.Add("Unable to refresh release information right now.", Severity.Warning);
        }
        else
        {
            UpdateSelectedRelease();
            Snackbar.Add("Update status refreshed.", Severity.Success);
        }
        _checkingUpdates = false;
    }

    private async Task OnIncludePreviewReleasesChanged(bool value)
    {
        _savingPreviewSetting = true;
        try
        {
            await VersionCheckService.SetIncludePreviewReleasesAsync(value);
            _includePreviewReleases = VersionCheckService.IncludePreviewReleases;
            UpdateSelectedRelease();
            Snackbar.Add("Update channel preference saved.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to save update channel preference: {ex.Message}", Severity.Error);
        }
        finally
        {
            _savingPreviewSetting = false;
        }
    }

    private async Task StartUpdateAsync()
    {
        if (_startingUpdate)
        {
            return;
        }

        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            "Start Update",
            "This will download the update package, run a backup, create recovery data, and restart the app process. Continue?",
            yesText: "Start Update",
            cancelText: "Cancel");

        if (confirmed != true)
        {
            return;
        }

        _startingUpdate = true;
        _updateProgressPercent = 0;
        _updateProgressMessage = "Starting update...";
        try
        {
            var progress = new Progress<UpdateProgressState>(state =>
            {
                _updateProgressMessage = state.Message;
                _updateProgressPercent = Math.Clamp(state.Percent, 0, 100);
                InvokeAsync(StateHasChanged);
            });

            var result = await VersionCheckService.StartManualUpdateAsync(progress: progress);
            Snackbar.Add(result.Message, result.Started ? Severity.Info : Severity.Error);
        }
        finally
        {
            _startingUpdate = false;
            _updateProgressMessage = string.Empty;
            _updateProgressPercent = 0;
        }
    }

    private async Task RestoreLatestRecoveryAsync()
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            "Restore Last Recovery",
            "This will stop the app and restore files from the most recent recovery bundle. Continue?",
            yesText: "Restore",
            cancelText: "Cancel");

        if (confirmed != true)
        {
            return;
        }

        _restoringRecovery = true;
        try
        {
            var result = await VersionCheckService.StartRestoreLatestRecoveryAsync();
            Snackbar.Add(result.Message, result.Started ? Severity.Warning : Severity.Error);
        }
        finally
        {
            _restoringRecovery = false;
        }
    }

    private async Task DownloadLatestAllLogAsync()
    {
        try
        {
            var baseDir = AppContext.BaseDirectory;
            var logsDir = Path.Combine(baseDir, "Logs");

            if (!Directory.Exists(logsDir))
            {
                Snackbar.Add("Logs directory was not found.", Severity.Warning);
                return;
            }

            var latest = Directory.GetFiles(logsDir, "all_*.log", SearchOption.TopDirectoryOnly)
                .OrderByDescending(File.GetLastWriteTimeUtc)
                .FirstOrDefault();

            if (string.IsNullOrWhiteSpace(latest) || !File.Exists(latest))
            {
                Snackbar.Add("No all_*.log files were found.", Severity.Warning);
                return;
            }

            await using var source = new FileStream(
                latest,
                FileMode.Open,
                FileAccess.Read,
                FileShare.ReadWrite | FileShare.Delete,
                bufferSize: 64 * 1024,
                useAsync: true);

            var truncated = source.Length > MaxLogDownloadBytes;
            if (truncated)
            {
                source.Seek(source.Length - MaxLogDownloadBytes, SeekOrigin.Begin);
            }

            var buffer = new MemoryStream(capacity: (int)Math.Min(source.Length, MaxLogDownloadBytes) + 1024);
            await using (buffer.ConfigureAwait(false))
            {
                await source.CopyToAsync(buffer);
                buffer.Position = 0;

                if (truncated)
                {
                    SkipPartialFirstLine(buffer);
                }

                var fileName = truncated
                    ? $"{Path.GetFileNameWithoutExtension(latest)}_tail{Path.GetExtension(latest)}"
                    : Path.GetFileName(latest);

                using var streamRef = new DotNetStreamReference(buffer, leaveOpen: true);
                await JS.InvokeVoidAsync("downloadFile", fileName, streamRef);
            }

            Snackbar.Add(
                truncated
                    ? $"Log download started (last {MaxLogDownloadBytes / (1024 * 1024)} MB only)."
                    : "Log download started.",
                Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to download latest log: {ex.Message}", Severity.Error);
        }
    }

    private static void SkipPartialFirstLine(MemoryStream buffer)
    {
        var data = buffer.GetBuffer();
        var length = (int)buffer.Length;
        for (var i = 0; i < length; i++)
        {
            if (data[i] == (byte)'\n')
            {
                buffer.Position = i + 1;
                return;
            }
        }
    }

    public void Dispose()
    {
        VersionCheckService.VersionStatusChanged -= HandleVersionStatusChanged;
    }
}
