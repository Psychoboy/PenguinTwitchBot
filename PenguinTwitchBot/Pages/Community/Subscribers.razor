@page "/community/subscribers"
@using PenguinTwitchBot.Bot.Core
@attribute [Authorize(Roles = "Streamer, Editor")]
@inject ISubscriptionTracker SubscriptionTracker
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@implements IDisposable

<PageTitle>@(AppConfiguration["ApplicationTitle"] ?? "Penguin Twitch Bot") - Subscribers</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudStack Spacing="4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="2">
            <div>
                <MudText Typo="Typo.h4">
                    <MudIcon Icon="@Icons.Material.Filled.CardMembership" Class="mr-2" />Subscribers
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    View all current channel subscribers, known past subscribers, and tracked subscription months.
                </MudText>
            </div>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                @if (_isSyncing)
                {
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.Cancel"
                               OnClick="CancelSync">
                        Cancel
                    </MudButton>
                }
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Sync"
                           OnClick="StartSyncAsync"
                           Disabled="@(_isSyncing || SubscriptionTracker.IsSyncInProgress)">
                    @if (_isSyncing || SubscriptionTracker.IsSyncInProgress)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ml-2">Syncing...</MudText>
                    }
                    else
                    {
                        <span>Sync from Twitch</span>
                    }
                </MudButton>
            </MudStack>
        </MudStack>

        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
            <strong>Sync from Twitch</strong> fetches every current subscriber (with tier and gift status) and marks ended subscriptions as Past Subscribers.
            <strong>Total Months</strong> and <strong>Consecutive Months</strong> populate automatically from resub events and subscriber chat badges, and can also be edited manually.
        </MudAlert>

        <MudGrid Spacing="3">
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Elevation="2" Class="pa-4 h-100">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <div>
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Current Subscribers</MudText>
                            <MudText Typo="Typo.h4" Class="mt-1">
                                @_currentCount.ToString("N0")
                            </MudText>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Large" Color="Color.Success" />
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="4">
                <MudPaper Elevation="2" Class="pa-4 h-100">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <div>
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Past Subscribers (Known)</MudText>
                            <MudText Typo="Typo.h4" Class="mt-1">
                                @_pastCount.ToString("N0")
                            </MudText>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Large" Color="Color.Secondary" />
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" sm="6" md="4">
                <MudPaper Elevation="2" Class="pa-4 h-100">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <div>
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Last Sync</MudText>
                            @if (_lastResult != null)
                            {
                                <MudText Typo="Typo.h6" Class="mt-1">
                                    <ToLocal DateTime="_lastResult.CompletedAtUtc" Format="m/d/yyyy h:MM TT" />
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @_lastResult.SubPoints.ToString("N0") sub pts &middot; @_lastResult.AddedCount.ToString("N0") added, @_lastResult.UpdatedCount.ToString("N0") updated@(_lastResult.MarkedPastCount > 0 ? $", {_lastResult.MarkedPastCount:N0} ended" : "")
                                </MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mt-1">Never (this session)</MudText>
                            }
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.Sync" Size="Size.Large" Color="Color.Info" />
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                @_errorMessage
            </MudAlert>
        }

        <MudPaper Elevation="2" Class="pa-4">
            <MudTable T="SubscriberListItem"
                      @ref="_subscribersTable"
                      ServerData="LoadSubscribersAsync"
                      Dense="true"
                      Hover="true"
                      FixedHeader="true"
                      RowsPerPage="25">
                <ToolBarContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Style="width: 100%;" Wrap="Wrap.Wrap" Spacing="2">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Wrap="Wrap.Wrap">
                            <MudButton Variant="@(_filter == SubscriberFilter.Current ? Variant.Filled : Variant.Outlined)"
                                       Color="Color.Success"
                                       Size="Size.Small"
                                       OnClick="@(() => OnFilterChangedAsync(SubscriberFilter.Current))">
                                Current (@_currentCount.ToString("N0"))
                            </MudButton>
                            <MudButton Variant="@(_filter == SubscriberFilter.Past ? Variant.Filled : Variant.Outlined)"
                                       Color="Color.Secondary"
                                       Size="Size.Small"
                                       OnClick="@(() => OnFilterChangedAsync(SubscriberFilter.Past))">
                                Past (@_pastCount.ToString("N0"))
                            </MudButton>
                            <MudButton Variant="@(_filter == SubscriberFilter.All ? Variant.Filled : Variant.Outlined)"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="@(() => OnFilterChangedAsync(SubscriberFilter.All))">
                                All (@((_currentCount + _pastCount).ToString("N0")))
                            </MudButton>
                        </MudStack>
                        <MudTextField T="string"
                                      Value="_searchText"
                                      ValueChanged="OnSearchChangedAsync"
                                      Placeholder="Search by username..."
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      DebounceInterval="300"
                                      Clearable="true"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      Style="max-width: 320px;" />
                    </MudStack>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>
                        <MudTableSortLabel T="SubscriberListItem" SortLabel="username">Subscriber</MudTableSortLabel>
                    </MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>
                        <MudTableSortLabel T="SubscriberListItem" SortLabel="tier">Tier</MudTableSortLabel>
                    </MudTh>
                    <MudTh>
                        <MudTableSortLabel T="SubscriberListItem" SortLabel="totalmonths" InitialDirection="SortDirection.Descending">Total Months</MudTableSortLabel>
                    </MudTh>
                    <MudTh>
                        <MudTableSortLabel T="SubscriberListItem" SortLabel="consecutivemonths">Consecutive</MudTableSortLabel>
                    </MudTh>
                    <MudTh>
                        <MudTableSortLabel T="SubscriberListItem" SortLabel="lastsub">Last Subscribed</MudTableSortLabel>
                    </MudTh>
                    <MudTh Style="text-align: right;">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Subscriber">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudAvatar Color="@(context.IsActive ? Color.Success : Color.Default)" Size="Size.Small">
                                @(string.IsNullOrWhiteSpace(context.DisplayName) ? "U" : context.DisplayName.Substring(0, 1).ToUpperInvariant())
                            </MudAvatar>
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.subtitle2">@(string.IsNullOrWhiteSpace(context.DisplayName) ? context.Username : context.DisplayName)</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@@@context.Username</MudText>
                            </MudStack>
                        </MudStack>
                    </MudTd>
                    <MudTd DataLabel="Status">
                        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                            @if (context.IsActive)
                            {
                                <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.Star">Current</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Color="Color.Default" Size="Size.Small">Past</MudChip>
                            }
                            @if (context.IsGift)
                            {
                                <MudTooltip Text="@(string.IsNullOrWhiteSpace(context.GifterName) ? "Gifted subscription" : $"Gifted by {context.GifterName}")">
                                    <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.CardGiftcard">Gifted</MudChip>
                                </MudTooltip>
                            }
                        </MudStack>
                    </MudTd>
                    <MudTd DataLabel="Tier">
                        @if (!string.IsNullOrWhiteSpace(context.Tier))
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@GetTierColor(context.Tier)">@FormatTier(context.Tier)</MudChip>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">-</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Total Months">
                        @if (context.TotalMonths > 0)
                        {
                            <MudText Typo="Typo.body2"><strong>@context.TotalMonths</strong> mo</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">-</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Consecutive">
                        @if (context.ConsecutiveMonths > 0)
                        {
                            <MudText Typo="Typo.body2"><strong>@context.ConsecutiveMonths</strong> mo</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">-</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Last Subscribed">
                        @if (context.LastSub != DateTime.MinValue)
                        {
                            <ToLocal DateTime="@context.LastSub" />
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">-</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Actions" Style="text-align: right;">
                        <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1">
                            <MudTooltip Text="Edit total / consecutive months">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               OnClick="@(() => OpenEditMonthsDialogAsync(context))" />
                            </MudTooltip>
                            @if (context.ViewerId.HasValue)
                            {
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.AccountCircle"
                                           OnClick="@(() => OpenViewerProfile(context.ViewerId.Value))">
                                    Profile
                                </MudButton>
                            }
                        </MudStack>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4 text-center">
                        @if (!string.IsNullOrWhiteSpace(_searchText))
                        {
                            <span>No subscribers found matching '@_searchText'.</span>
                        }
                        else if (_filter == SubscriberFilter.Current)
                        {
                            <span>No current subscribers tracked yet. Click "Sync from Twitch" above to fetch active subscribers.</span>
                        }
                        else if (_filter == SubscriberFilter.Past)
                        {
                            <span>No past subscribers recorded yet.</span>
                        }
                        else
                        {
                            <span>No subscriber records found yet. Click "Sync from Twitch" above to populate current subscribers.</span>
                        }
                    </MudText>
                </NoRecordsContent>
                <LoadingContent>
                    <MudStack AlignItems="AlignItems.Center" Class="pa-4">
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">Loading subscribers...</MudText>
                    </MudStack>
                </LoadingContent>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new[] { 10, 25, 50, 100 }" />
                </PagerContent>
            </MudTable>
        </MudPaper>
    </MudStack>
</MudContainer>

@code {
    private MudTable<SubscriberListItem>? _subscribersTable;
    private SubscriberFilter _filter = SubscriberFilter.Current;
    private string _searchText = string.Empty;
    private int _currentCount;
    private int _pastCount;
    private bool _isSyncing;
    private SubscriberSyncResult? _lastResult;
    private string? _errorMessage;
    private CancellationTokenSource? _syncCts;
    private bool _disposed;

    protected override void OnInitialized()
    {
        SubscriptionTracker.SyncStateChanged += OnSyncStateChanged;
        _lastResult = SubscriptionTracker.LastSyncResult;
    }

    private void OnSyncStateChanged()
    {
        if (_disposed)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            if (_disposed)
            {
                return;
            }

            _lastResult = SubscriptionTracker.LastSyncResult;
            if (!SubscriptionTracker.IsSyncInProgress && !_isSyncing && _subscribersTable != null)
            {
                await _subscribersTable.ReloadServerData();
            }

            StateHasChanged();
        });
    }

    private async Task<TableData<SubscriberListItem>> LoadSubscribersAsync(TableState state, CancellationToken cancellationToken)
    {
        var sortBy = string.IsNullOrWhiteSpace(state.SortLabel) ? "totalmonths" : state.SortLabel;
        var sortDescending = state.SortDirection != SortDirection.Ascending;

        var page = await SubscriptionTracker.GetSubscribersPageAsync(
            page: state.Page,
            pageSize: state.PageSize,
            filter: _filter,
            search: _searchText,
            sortBy: sortBy,
            sortDescending: sortDescending,
            cancellationToken: cancellationToken);

        if (_currentCount != page.CurrentCount || _pastCount != page.PastCount)
        {
            _currentCount = page.CurrentCount;
            _pastCount = page.PastCount;
            StateHasChanged();
        }

        return new TableData<SubscriberListItem>
        {
            TotalItems = page.TotalCount,
            Items = page.Items
        };
    }

    private async Task OnFilterChangedAsync(SubscriberFilter filter)
    {
        if (_filter == filter)
        {
            return;
        }

        _filter = filter;
        if (_subscribersTable != null)
        {
            await _subscribersTable.ReloadServerData();
        }
    }

    private async Task OnSearchChangedAsync(string value)
    {
        _searchText = value ?? string.Empty;
        if (_subscribersTable != null)
        {
            await _subscribersTable.ReloadServerData();
        }
    }

    private async Task OpenEditMonthsDialogAsync(SubscriberListItem item)
    {
        var parameters = new DialogParameters<EditSubscriberMonthsDialog>
        {
            { x => x.Username, item.Username },
            { x => x.DisplayName, item.DisplayName },
            { x => x.TotalMonths, item.TotalMonths },
            { x => x.ConsecutiveMonths, item.ConsecutiveMonths }
        };

        var dialog = await DialogService.ShowAsync<EditSubscriberMonthsDialog>("Edit Subscription Months", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: EditSubscriberMonthsDialog.EditSubscriberMonthsResult updated })
        {
            try
            {
                await SubscriptionTracker.UpdateSubscriberMonthsAsync(item.Id, updated.TotalMonths, updated.ConsecutiveMonths);
                Snackbar.Add($"Updated months for {item.DisplayName}.", Severity.Success);
                if (_subscribersTable != null)
                {
                    await _subscribersTable.ReloadServerData();
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Failed to update months: {ex.Message}", Severity.Error);
            }
        }
    }

    private void OpenViewerProfile(Guid viewerId)
    {
        NavigationManager.NavigateTo($"/community/viewers/edit?id={viewerId}");
    }

    private async Task StartSyncAsync()
    {
        if (_isSyncing || SubscriptionTracker.IsSyncInProgress)
        {
            return;
        }

        _errorMessage = null;
        _isSyncing = true;
        _syncCts?.Dispose();
        _syncCts = new CancellationTokenSource();

        try
        {
            _lastResult = await SubscriptionTracker.SyncSubscribersFromTwitchAsync(_syncCts.Token);
            _currentCount = _lastResult.ActiveCount;
            _pastCount = _lastResult.PastCount;
            Snackbar.Add(
                $"Synced {_lastResult.TotalTwitchSubscribers:N0} subscribers ({_lastResult.AddedCount:N0} added, {_lastResult.MarkedPastCount:N0} ended).",
                Severity.Success);
        }
        catch (OperationCanceledException)
        {
            Snackbar.Add("Subscriber sync cancelled.", Severity.Warning);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Subscriber sync failed: {ex.Message}";
            Snackbar.Add("Subscriber sync failed.", Severity.Error);
        }
        finally
        {
            _isSyncing = false;
            if (!_disposed)
            {
                if (_subscribersTable != null)
                {
                    await _subscribersTable.ReloadServerData();
                }
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void CancelSync()
    {
        _syncCts?.Cancel();
    }

    private static string FormatTier(string tier) => tier switch
    {
        "1000" => "Tier 1",
        "2000" => "Tier 2",
        "3000" => "Tier 3",
        _ => tier
    };

    private static Color GetTierColor(string tier) => tier switch
    {
        "3000" => Color.Warning,
        "2000" => Color.Secondary,
        _ => Color.Primary
    };

    public void Dispose()
    {
        _disposed = true;
        SubscriptionTracker.SyncStateChanged -= OnSyncStateChanged;
        _syncCts?.Dispose();
    }
}
