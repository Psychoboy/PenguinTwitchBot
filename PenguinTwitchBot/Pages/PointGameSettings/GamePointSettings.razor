@attribute [Authorize(Roles = "Streamer, Editor")]
@using PenguinTwitchBot.Bot.Core.Points
@using PenguinTwitchBot.Database.Bot.Models.Games
@using PenguinTwitchBot.Database.Bot.Models.Points
@using PenguinTwitchBot.Bot.Commands.Games
@using PenguinTwitchBot.Bot.Actions
@using PenguinTwitchBot.Database.Bot.Actions

<MudPaper Elevation="2">
    <MudTable Items="@PointSettings" CanCancelEdit="true" EditTrigger="TableEditTrigger.EditButton" RowEditCommit="ItemHasBeenCommitted">
        <ToolBarContent>
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">Misc Point Assignments</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Edit miscellaneous point mappings here. Dedicated games, activities, giveaways, and raffle point types are managed in their own settings or actions.</MudText>
            </MudStack>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Point Type</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">
                @context.Assignment.Setting.GameName
                @if (context.IsRaffleMapping)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" Class="ml-2">Raffle action</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="PointType">@context.Assignment.PointType.Name</MudTd>
        </RowTemplate>
        <RowEditingTemplate>
            <MudTd DataLabel="Name">@context.Assignment.Setting.GameName</MudTd>
            <MudTd DataLabel="PointType">
                <MudSelect Label="Point Type" @bind-Value="context.Assignment.PointType" ToStringFunc="@ConvertFunction">
                    @foreach (var pointType in PointTypes)
                    {
                        <MudSelectItem Value="@pointType" />
                    }
                </MudSelect>
            </MudTd>
        </RowEditingTemplate>
        <EditButtonContent Context="button">
            <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" Class="pa-0" OnClick="@button.ButtonAction" Disabled="@(button.Item is not MiscPointAssignment item || !item.CanEdit)" />
        </EditButtonContent>
    </MudTable>
</MudPaper>

@code {
    private IEnumerable<PointType> PointTypes { get; set; } = [];
    [Inject] IPointsSystem pointSystem { get; set; } = default!;
    [Inject] IActionManagementService actionManagementService { get; set; } = default!;
    private IReadOnlyList<MiscPointAssignment> PointSettings { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        var assignmentsTask = pointSystem.GetPointTypesForGames();
        var actionsTask = actionManagementService.GetAllActionsAsync();
        await Task.WhenAll(assignmentsTask, actionsTask);
        PointSettings = MiscPointAssignmentFilter.Filter(assignmentsTask.Result, actionsTask.Result);
        PointTypes = await pointSystem.GetPointTypes();
    }

    private async void ItemHasBeenCommitted(object element)
    {
        var assignment = (MiscPointAssignment)element;
        if (!assignment.CanEdit)
        {
            return;
        }

        await pointSystem.SetPointTypeForGame(assignment.Assignment.Setting.GameName, assignment.Assignment.PointType.Id);
    }

    private string ConvertFunction(PointType? pointType)
    {
        if (pointType != null)
        {
            return pointType.Name;
        }
        return "";
    }
}
