@page "/settings/points"
@using PenguinTwitchBot.Bot.Core.Points
@using PenguinTwitchBot.Database.Bot.Models.Points
@using PenguinTwitchBot.Pages.PointGameSettings.Providers
@attribute [Authorize(Roles = "Streamer, Editor")]

<PageTitle>@(AppConfiguration["ApplicationTitle"] ?? "Penguin Twitch Bot") - Point Settings</PageTitle>

<MudContainer Class="pa-6" MaxWidth="MaxWidth.False">
    <MudGrid>

        @* -- Page header -- *@
        <MudItem xs="12">
            <MudPaper Class="pa-4" Elevation="2">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.h5">Point Settings</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Manage point types and the remaining miscellaneous point mappings. Dedicated games and reward settings have their own point-type controls. The first point type cannot be deleted; rename or repurpose it as needed.
                        </MudText>
                    </MudStack>
                    <HelpButton Topic="point-settings" />
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12">
            <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" KeepPanelsAlive="true" Class="pa-4">

                @* -- Tab 1: Point Types -- *@
                <MudTabPanel Text="Point Types" Icon="@Icons.Material.Filled.MonetizationOn">
                    <MudGrid>
                        <MudItem xs="12" md="8">
                            <MudPaper Elevation="1">
                                <MudTable Items="@PointTypes" Elevation="0" Hover="true">
                                    <ToolBarContent>
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.h6">Point Types</MudText>
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                                Each type has its own set of chat commands. Expand a row to view them.
                                            </MudText>
                                        </MudStack>
                                    </ToolBarContent>
                                    <HeaderContent>
                                        <MudTh>Id</MudTh>
                                        <MudTh>Name</MudTh>
                                        <MudTh>Description</MudTh>
                                        <MudTh></MudTh>
                                        <MudTh></MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel="Id">@context.Id</MudTd>
                                        <MudTd DataLabel="Name"><b>@context.Name</b></MudTd>
                                        <MudTd DataLabel="Description">@context.Description</MudTd>
                                        <MudTd>
                                            <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" Color="Color.Primary" OnClick="() => EditPointType(context)" />
                                        </MudTd>
                                        <MudTd>
                                            <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => DeletePointType(context)" />
                                        </MudTd>
                                    </RowTemplate>
                                    <ChildRowContent>
                                        <MudTr>
                                            <td colspan="5">
                                                <MudCard Elevation="0" Class="pa-2 ml-4">
                                                    <MudCardHeader>
                                                        <CardHeaderContent>
                                                            <MudText Typo="Typo.subtitle2">Chat commands for <strong>@context.Name</strong></MudText>
                                                        </CardHeaderContent>
                                                    </MudCardHeader>
                                                    <MudCardContent Class="pa-0">
                                                        <MudTable Items="@context.PointCommands.ToList()" Context="CommandContext" Elevation="0" Dense="true">
                                                            <HeaderContent>
                                                                <MudTh>Command</MudTh>
                                                                <MudTh>Type</MudTh>
                                                            </HeaderContent>
                                                            <RowTemplate>
                                                                <MudTd><code>!@CommandContext.CommandName</code></MudTd>
                                                                <MudTd>@CommandContext.CommandType</MudTd>
                                                            </RowTemplate>
                                                        </MudTable>
                                                    </MudCardContent>
                                                </MudCard>
                                            </td>
                                        </MudTr>
                                    </ChildRowContent>
                                </MudTable>
                            </MudPaper>
                        </MudItem>

                        <MudItem xs="12" md="4">
                            <MudPaper Class="pa-4" Elevation="1">
                                <MudText Typo="Typo.h6" Class="mb-3">
                                    @(newPointType.Id == Guid.Empty ? "Create Point Type" : $"Editing: {newPointType.Name}")
                                </MudText>
                                <EditForm Model="@newPointType" OnValidSubmit="SavePointType">
                                    <DataAnnotationsValidator />
                                    <MudStack Spacing="2">
                                        <MudTextField Label="Name" @bind-Value="newPointType.Name" Variant="Variant.Outlined" />
                                        <MudTextField Label="Description" @bind-Value="newPointType.Description" Variant="Variant.Outlined" Lines="2" />
                                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" FullWidth="true"
                                                   OnClick="GenerateCommands" StartIcon="@Icons.Material.Filled.AutoAwesome">
                                            Auto-Generate Commands
                                        </MudButton>
                                        <MudDivider />
                                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">
                                            Chat Commands <MudText Typo="Typo.caption" Color="Color.Secondary" Inline="true">(stored without ! prefix)</MudText>
                                        </MudText>
                                        <MudTextField Label="Add" @bind-Value="newPointType.PointCommands.First(x => x.CommandType == PointCommandType.Add).CommandName" Variant="Variant.Outlined" HelperText="e.g. addpoints" />
                                        <MudTextField Label="Remove" @bind-Value="newPointType.PointCommands.First(x => x.CommandType == PointCommandType.Remove).CommandName" Variant="Variant.Outlined" HelperText="e.g. removepoints" />
                                        <MudTextField Label="Get (viewers check balance)" @bind-Value="newPointType.PointCommands.First(x => x.CommandType == PointCommandType.Get).CommandName" Variant="Variant.Outlined" HelperText="e.g. points" />
                                        <MudTextField Label="Set (mod override)" @bind-Value="newPointType.PointCommands.First(x => x.CommandType == PointCommandType.Set).CommandName" Variant="Variant.Outlined" HelperText="e.g. setpoints" />
                                        <MudTextField Label="Add Active" @bind-Value="newPointType.PointCommands.First(x => x.CommandType == PointCommandType.AddActive).CommandName" Variant="Variant.Outlined" HelperText="e.g. addactivepoints" />
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit"
                                                   FullWidth="true" StartIcon="@Icons.Material.Filled.Save">
                                            Save
                                        </MudButton>
                                        @if (newPointType.Id != Guid.Empty)
                                        {
                                            <MudButton Variant="Variant.Text" Color="Color.Default" FullWidth="true" OnClick="CancelEdit">
                                                Cancel
                                            </MudButton>
                                        }
                                    </MudStack>
                                </EditForm>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                @* -- Tab 2: Misc Point Assignments -- *@
                <MudTabPanel Text="Misc Point Assignments" Icon="@Icons.Material.Filled.Tune">
                    <GamePointSettings />
                </MudTabPanel>

                <MudTabPanel Text="Tax" Icon="@Icons.Material.Filled.ReceiptLong">
                    <TaxPointTypeSettings />
                </MudTabPanel>

                @* -- Tab 3: Passive Points -- *@
                <MudTabPanel Text="Passive Points" Icon="@Icons.Material.Filled.Schedule">
                    <PassivePointSettings PointTypes="@PointTypes" OnPointTypesUpdated="RefreshPointType" />
                </MudTabPanel>

                <MudTabPanel Text="Point Activities" Icon="@Icons.Material.Filled.GroupAdd">
                    <MudStack Spacing="3" Class="pa-4">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Configure activity rewards and moderator-run point distribution. These settings are shared across point types.
                        </MudText>
                        @if (_selectedActivityProvider == null)
                        {
                            <MudGrid Spacing="2">
                                @foreach (var provider in _activityProviders)
                                {
                                    var selected = provider;
                                    <MudItem xs="12" sm="6" md="4">
                                        <MudPaper Class="pa-3" Outlined="true" Style="height:100%;">
                                            <MudStack Spacing="2" Style="height:100%;">
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                                    <MudIcon Icon="@provider.Icon" Color="Color.Primary" />
                                                    <MudText Typo="Typo.subtitle1"><b>@provider.DisplayName</b></MudText>
                                                </MudStack>
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">@provider.Description</MudText>
                                                <MudSpacer />
                                                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Settings"
                                                           OnClick="@(() => _selectedActivityProvider = selected)">
                                                    Configure
                                                </MudButton>
                                            </MudStack>
                                        </MudPaper>
                                    </MudItem>
                                }
                            </MudGrid>
                        }
                        else
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudButton StartIcon="@Icons.Material.Filled.ArrowBack"
                                           OnClick="@(() => _selectedActivityProvider = null)">
                                    All Point Activities
                                </MudButton>
                                <MudIcon Icon="@_selectedActivityProvider.Icon" Color="Color.Primary" />
                                <MudText Typo="Typo.h6">@_selectedActivityProvider.DisplayName</MudText>
                            </MudStack>
                            <GameSettingsPanel @key="_selectedActivityProvider" Provider="_selectedActivityProvider" />
                        }
                    </MudStack>
                </MudTabPanel>

            </MudTabs>
        </MudItem>

    </MudGrid>
</MudContainer>

@code {
    private List<PointType> PointTypes { get; set; } = [];
    private PointType newPointType = CreateNewPointType();
    private IGameSettingsFormProvider? _selectedActivityProvider;
    private readonly List<IGameSettingsFormProvider> _activityProviders =
    [
        new AddActiveSettingsProvider(),
        new ModSpamSettingsProvider(),
    ];

    [Inject] IPointsSystem pointSystem { get; set; } = default!;
    [Inject] ISnackbar Snackbar { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        PointTypes = (await pointSystem.GetPointTypes()).ToList();
        newPointType = CreateNewPointType();
    }

    private async Task RefreshPointType(PointType savedPointType)
    {
        if (savedPointType.Id != Guid.Empty)
        {
            var latest = await pointSystem.GetPointTypeById(savedPointType.Id);
            if (latest != null)
            {
                var idx = PointTypes.FindIndex(p => p.Id == latest.Id);
                if (idx >= 0)
                {
                    PointTypes[idx] = latest;
                }
                if (newPointType.Id == latest.Id)
                {
                    newPointType.PassivePointsEnabled = latest.PassivePointsEnabled;
                    newPointType.PassivePointsIntervalMinutes = latest.PassivePointsIntervalMinutes;
                    newPointType.PassivePointsAllViewers = latest.PassivePointsAllViewers;
                    newPointType.PassivePointsActiveViewers = latest.PassivePointsActiveViewers;
                    newPointType.PassivePointsSubscribers = latest.PassivePointsSubscribers;
                }
            }
        }
    }

    private async Task SavePointType()
    {
        if (newPointType.Id != Guid.Empty)
        {
            var existingInList = PointTypes.FirstOrDefault(p => p.Id == newPointType.Id);
            if (existingInList != null)
            {
                newPointType.PassivePointsEnabled = existingInList.PassivePointsEnabled;
                newPointType.PassivePointsIntervalMinutes = existingInList.PassivePointsIntervalMinutes;
                newPointType.PassivePointsAllViewers = existingInList.PassivePointsAllViewers;
                newPointType.PassivePointsActiveViewers = existingInList.PassivePointsActiveViewers;
                newPointType.PassivePointsSubscribers = existingInList.PassivePointsSubscribers;
            }
        }
        await pointSystem.UpdatePointType(newPointType);
        newPointType = CreateNewPointType();
        PointTypes = (await pointSystem.GetPointTypes()).ToList();
    }

    private static PointType CreateNewPointType()
    {
        return new PointType
            {
                PointCommands = new List<PointCommand>
                {
                    new PointCommand { CommandType = PointCommandType.Add },
                    new PointCommand { CommandType = PointCommandType.Remove },
                    new PointCommand { CommandType = PointCommandType.Get },
                    new PointCommand { CommandType = PointCommandType.Set },
                    new PointCommand { CommandType = PointCommandType.AddActive }
                }
            };
    }

    private void EditPointType(PointType pointType)
    {
        var clone = new PointType
        {
            Id = pointType.Id,
            Name = pointType.Name,
            Description = pointType.Description,
            PassivePointsEnabled = pointType.PassivePointsEnabled,
            PassivePointsIntervalMinutes = pointType.PassivePointsIntervalMinutes,
            PassivePointsAllViewers = pointType.PassivePointsAllViewers,
            PassivePointsActiveViewers = pointType.PassivePointsActiveViewers,
            PassivePointsSubscribers = pointType.PassivePointsSubscribers,
            PointCommands = pointType.PointCommands
                .Select(c => new PointCommand
                {
                    Id = c.Id,
                    CommandName = c.CommandName,
                    CommandType = c.CommandType,
                    PointTypeId = c.PointTypeId,
                    PointType = c.PointType
                })
                .ToList()
        };

        var requiredTypes = new[] { PointCommandType.Add, PointCommandType.Remove, PointCommandType.Get, PointCommandType.Set, PointCommandType.AddActive };
        foreach (var type in requiredTypes)
        {
            if (!clone.PointCommands.Any(c => c.CommandType == type))
                clone.PointCommands.Add(new PointCommand { CommandType = type });
        }
        newPointType = clone;
    }

    private void CancelEdit()
    {
        newPointType = CreateNewPointType();
    }

    private async Task DeletePointType(PointType pointType)
    {
        if (pointType.Name.Equals("Points", StringComparison.OrdinalIgnoreCase))
        {
            Snackbar.Add("You can not delete the primary points. You can edit/rename it only.", Severity.Error);
            return;
        }
        await pointSystem.DeletePointType(pointType.Id);
        PointTypes = (await pointSystem.GetPointTypes()).ToList();
    }

    private void GenerateCommands()
    {
        if (string.IsNullOrWhiteSpace(newPointType.Name)) return;
        var name = newPointType.Name.ToLower();
        newPointType.PointCommands.First(x => x.CommandType == PointCommandType.Add).CommandName = $"add{name}";
        newPointType.PointCommands.First(x => x.CommandType == PointCommandType.Remove).CommandName = $"remove{name}";
        newPointType.PointCommands.First(x => x.CommandType == PointCommandType.Get).CommandName = $"get{name}";
        newPointType.PointCommands.First(x => x.CommandType == PointCommandType.Set).CommandName = $"set{name}";
        newPointType.PointCommands.First(x => x.CommandType == PointCommandType.AddActive).CommandName = $"addactive{name}";
    }
}
