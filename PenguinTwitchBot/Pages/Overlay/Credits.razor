@page "/overlay/credits"
@attribute [Authorize(Roles = "Streamer, Editor")]
@using System.Text
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using PenguinTwitchBot.Bot.Overlay
@using PenguinTwitchBot.Bot.Overlay.Credits
@using PenguinTwitchBot.Database.Bot.Models.Credits
@using PenguinTwitchBot.Pages.Overlay.CreditsComponents
@inject ICreditsService CreditsService
@inject IOverlaySecurityService OverlaySecurityService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>@(AppConfiguration["ApplicationTitle"] ?? "Penguin Twitch Bot") - Stream Credits</PageTitle>

<MudContainer Class="pa-4" MaxWidth="MaxWidth.ExtraLarge">
    <MudStack Spacing="3">
        <!-- Page Header -->
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudText Typo="Typo.h4">
                    <MudIcon Icon="@Icons.Material.Filled.MovieFilter" Class="mr-2" />
                    Stream Credits Designer
                </MudText>
                <HelpButton Topic="credits" />
            </MudStack>
            @if (_selectedProfile != null)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Wrap="Wrap.Wrap">
                    <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="CopyObsUrlAsync">
                        Copy OBS URL
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.OpenInNew"
                               Href="@GetStandaloneUrl(autoStart: true)" Target="_blank">
                        Open Standalone
                    </MudButton>
                </MudStack>
            }
        </MudStack>

        @if (_isLoading)
        {
            <MudPaper Elevation="2" Class="pa-6">
                <MudStack AlignItems="AlignItems.Center" Spacing="2">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Loading Stream Credits profiles &amp; themes...</MudText>
                </MudStack>
            </MudPaper>
        }
        else if (_selectedProfile != null)
        {
            <!-- Profile & Live Roll Control Bar -->
            <MudPaper Elevation="2" Class="pa-3">
                <MudStack Spacing="2">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="2">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap" Style="flex: 1 1 auto;">
                            <MudSelect T="Guid" Value="_selectedProfileId" ValueChanged="OnProfileSelectedAsync"
                                       Label="Active Credits Profile" Variant="Variant.Outlined" Margin="Margin.Dense"
                                       Disabled="@_isSaving"
                                       Style="min-width: 220px;">
                                @foreach (var p in _profiles)
                                {
                                    <MudSelectItem T="Guid" Value="@p.Id">
                                        @p.Name @(p.IsDefault ? "(Default)" : "")
                                    </MudSelectItem>
                                }
                            </MudSelect>

                            <MudTextField @bind-Value="_profileNameDraft" Label="Profile Name" Variant="Variant.Outlined"
                                          Margin="Margin.Dense" Style="min-width: 180px;" />

                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Save" Disabled="@_isSaving"
                                       OnClick="SaveProfileAsync">
                                Save Profile
                            </MudButton>

                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="@(() => { _showNewProfileForm = !_showNewProfileForm; _showCloneProfileForm = false; })">
                                New
                            </MudButton>

                            <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.ContentCopy"
                                       OnClick="@(() => { _cloneProfileName = $"{_selectedProfile.Name} Copy"; _showCloneProfileForm = !_showCloneProfileForm; _showNewProfileForm = false; })">
                                Clone
                            </MudButton>

                            @if (!_selectedProfile.IsDefault)
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Star" OnClick="SetDefaultProfileAsync">
                                    Set Default
                                </MudButton>
                            }

                            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Delete"
                                       Disabled="@(_profiles.Count <= 1)"
                                       OnClick="DeleteProfileAsync">
                                Delete
                            </MudButton>

                            <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Download" OnClick="ExportProfileAsync">
                                Export
                            </MudButton>

                            <MudFileUpload T="IBrowserFile" FilesChanged="ImportProfileAsync" Accept=".json" Class="d-inline-flex">
                                <CustomContent>
                                    <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Upload" OnClick="@context.OpenFilePickerAsync">
                                        Import
                                    </MudButton>
                                </CustomContent>
                                <SelectedTemplate Context="_"></SelectedTemplate>
                            </MudFileUpload>
                        </MudStack>
                    </MudStack>

                    @if (_showNewProfileForm)
                    {
                        <MudPaper Outlined="true" Class="pa-2">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                                <MudTextField @bind-Value="_newProfileName" Label="New Profile Name" Variant="Variant.Outlined"
                                              Margin="Margin.Dense" Placeholder="e.g. Subathon Credits, Raid Credits" Style="min-width: 240px;" />
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="CreateProfileAsync">
                                    Create Profile
                                </MudButton>
                                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => _showNewProfileForm = false)">
                                    Cancel
                                </MudButton>
                            </MudStack>
                        </MudPaper>
                    }

                    @if (_showCloneProfileForm)
                    {
                        <MudPaper Outlined="true" Class="pa-2">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                                <MudTextField @bind-Value="_cloneProfileName" Label="Cloned Profile Name" Variant="Variant.Outlined"
                                              Margin="Margin.Dense" Style="min-width: 240px;" />
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="CloneProfileAsync">
                                    Clone Profile
                                </MudButton>
                                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => _showCloneProfileForm = false)">
                                    Cancel
                                </MudButton>
                            </MudStack>
                        </MudPaper>
                    }

                    <MudDivider />

                    <!-- Live Overlay Broadcast Controls -->
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="2">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Wrap="Wrap.Wrap">
                            <MudText Typo="Typo.subtitle2" Class="mr-1">Live OBS Overlay:</MudText>
                            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.PlayArrow"
                                       OnClick="@(() => TriggerLiveOverlayAsync(CreditSampleModes.Off))">
                                Roll Live
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Science"
                                       OnClick="@(() => TriggerLiveOverlayAsync(CreditSampleModes.Fake))">
                                Test Roll (Fake)
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Storage"
                                       OnClick="@(() => TriggerLiveOverlayAsync(CreditSampleModes.DatabaseViewers))">
                                Test Roll (DB Viewers)
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Pause"
                                       OnClick="ToggleLivePauseAsync">
                                Pause / Resume
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Replay"
                                       OnClick="RestartLiveAsync">
                                Restart
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Stop"
                                       OnClick="StopLiveAsync">
                                Stop / Hide
                            </MudButton>
                        </MudStack>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Theme: <b>@GetActiveThemeName()</b> • Animations &amp; audio trigger directly in OBS / unified Overlay.
                        </MudText>
                    </MudStack>
                </MudStack>
            </MudPaper>

            <!-- Main Split-Screen Designer & Live Preview -->
            <MudGrid Spacing="3">
                <MudItem xs="12" lg="7">
                    <MudPaper Elevation="2">
                        <MudTabs Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-4" Border="true">
                            <!-- TAB 1: Playback & Time Window -->
                            <MudTabPanel Text="Playback & Window" Icon="@Icons.Material.Filled.Schedule">
                                <MudStack Spacing="3">
                                    <MudPaper Outlined="true" Class="pa-3">
                                        <MudText Typo="Typo.subtitle1" Class="mb-2">Time Window (When Credits Start)</MudText>
                                        <MudGrid Spacing="2">
                                            <MudItem xs="12" sm="6">
                                                <MudSelect T="string" @bind-Value="_profileConfig.TimeWindow.Mode" Label="Window Mode"
                                                           Variant="Variant.Outlined" Margin="Margin.Dense">
                                                    <MudSelectItem T="string" Value="@CreditTimeWindowModes.SinceStreamStart">Since Stream Start (Recommended)</MudSelectItem>
                                                    <MudSelectItem T="string" Value="@CreditTimeWindowModes.LastCompletedStream">Last Completed Stream</MudSelectItem>
                                                    <MudSelectItem T="string" Value="@CreditTimeWindowModes.RollingLookback">Rolling Lookback (Minutes / Hours / Days)</MudSelectItem>
                                                    <MudSelectItem T="string" Value="@CreditTimeWindowModes.SinceManualCheckpoint">Since Manual Checkpoint</MudSelectItem>
                                                    <MudSelectItem T="string" Value="@CreditTimeWindowModes.CustomDateRange">Custom UTC Date Range</MudSelectItem>
                                                    <MudSelectItem T="string" Value="@CreditTimeWindowModes.SpecificSession">Specific Recorded Session</MudSelectItem>
                                                </MudSelect>
                                            </MudItem>

                                            @if (_profileConfig.TimeWindow.Mode == CreditTimeWindowModes.SinceStreamStart)
                                            {
                                                <MudItem xs="12" sm="6">
                                                    <MudNumericField T="int" @bind-Value="_profileConfig.TimeWindow.PreStreamGraceMinutes"
                                                                     Label="Pre-Stream Grace (minutes)" Min="0" Max="180"
                                                                     Variant="Variant.Outlined" Margin="Margin.Dense"
                                                                     HelperText="Include pre-stream events before going live." />
                                                </MudItem>
                                            }
                                            else if (_profileConfig.TimeWindow.Mode == CreditTimeWindowModes.RollingLookback)
                                            {
                                                <MudItem xs="6" sm="3">
                                                    <MudNumericField T="int" @bind-Value="_profileConfig.TimeWindow.LookbackValue"
                                                                     Label="Lookback Length" Min="1" Max="10000"
                                                                     Variant="Variant.Outlined" Margin="Margin.Dense" />
                                                </MudItem>
                                                <MudItem xs="6" sm="3">
                                                    <MudSelect T="string" @bind-Value="_profileConfig.TimeWindow.LookbackUnit" Label="Unit"
                                                               Variant="Variant.Outlined" Margin="Margin.Dense">
                                                        <MudSelectItem T="string" Value="@CreditLookbackUnits.Minutes">Minutes</MudSelectItem>
                                                        <MudSelectItem T="string" Value="@CreditLookbackUnits.Hours">Hours</MudSelectItem>
                                                        <MudSelectItem T="string" Value="@CreditLookbackUnits.Days">Days</MudSelectItem>
                                                    </MudSelect>
                                                </MudItem>
                                            }
                                            else if (_profileConfig.TimeWindow.Mode == CreditTimeWindowModes.SinceManualCheckpoint)
                                            {
                                                <MudItem xs="12" sm="6">
                                                    <MudStack Spacing="1">
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                            Current Checkpoint: @(_profileConfig.TimeWindow.ManualCheckpointUtc?.ToString("u") ?? "Not set yet")
                                                        </MudText>
                                                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                                                   StartIcon="@Icons.Material.Filled.Flag" OnClick="MarkCheckpointNowAsync">
                                                            Mark Checkpoint Now
                                                        </MudButton>
                                                    </MudStack>
                                                </MudItem>
                                            }
                                            else if (_profileConfig.TimeWindow.Mode == CreditTimeWindowModes.CustomDateRange)
                                            {
                                                <MudItem xs="12" sm="6">
                                                    <MudTextField T="string" @bind-Value="_customStartUtcInput"
                                                                  InputType="InputType.DateTimeLocal" Label="Start (UTC)"
                                                                  Variant="Variant.Outlined" Margin="Margin.Dense" />
                                                </MudItem>
                                                <MudItem xs="12" sm="6">
                                                    <MudTextField T="string" @bind-Value="_customEndUtcInput"
                                                                  InputType="InputType.DateTimeLocal" Label="End (UTC, optional = Now)"
                                                                  Variant="Variant.Outlined" Margin="Margin.Dense" />
                                                </MudItem>
                                            }
                                            else if (_profileConfig.TimeWindow.Mode == CreditTimeWindowModes.SpecificSession)
                                            {
                                                <MudItem xs="12" sm="6">
                                                    <MudSelect T="Guid?" @bind-Value="_profileConfig.TimeWindow.SpecificSessionId"
                                                               Label="Recorded Session" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                               Clearable="true">
                                                        @foreach (var s in _sessions)
                                                        {
                                                            <MudSelectItem T="Guid?" Value="@((Guid?)s.Id)">
                                                                @FormatSessionLabel(s)
                                                            </MudSelectItem>
                                                        }
                                                    </MudSelect>
                                                </MudItem>
                                            }
                                        </MudGrid>
                                    </MudPaper>

                                    <MudPaper Outlined="true" Class="pa-3">
                                        <MudText Typo="Typo.subtitle1" Class="mb-2">Playback &amp; Animation</MudText>
                                        <MudGrid Spacing="2">
                                            <MudItem xs="12" sm="6">
                                                <MudSelect T="string" @bind-Value="_profileConfig.Playback.AnimationMode" Label="Animation Style"
                                                           Variant="Variant.Outlined" Margin="Margin.Dense">
                                                    <MudSelectItem T="string" Value="@CreditAnimationModes.InheritTheme">Inherit Active Theme</MudSelectItem>
                                                    <MudSelectItem T="string" Value="@CreditAnimationModes.SmoothScroll">Classic Smooth Vertical Scroll</MudSelectItem>
                                                    <MudSelectItem T="string" Value="@CreditAnimationModes.Crawl3D">3D Perspective Star-Crawl</MudSelectItem>
                                                    <MudSelectItem T="string" Value="@CreditAnimationModes.PagedSlideshow">Paged Slideshow</MudSelectItem>
                                                </MudSelect>
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                <MudSelect T="string" @bind-Value="_profileConfig.Playback.SpeedMode" Label="Speed Timing"
                                                           Variant="Variant.Outlined" Margin="Margin.Dense">
                                                    <MudSelectItem T="string" Value="@CreditSpeedModes.FixedSpeed">Fixed Scroll Speed (px/sec)</MudSelectItem>
                                                    <MudSelectItem T="string" Value="@CreditSpeedModes.TargetDuration">Fit Fixed Total Duration (seconds)</MudSelectItem>
                                                </MudSelect>
                                            </MudItem>
                                            @if (_profileConfig.Playback.SpeedMode == CreditSpeedModes.TargetDuration)
                                            {
                                                <MudItem xs="12" sm="6">
                                                    <MudNumericField T="double" @bind-Value="_profileConfig.Playback.TargetDurationSeconds"
                                                                     Label="Total Roll Duration (sec)" Min="10" Max="1800"
                                                                     Variant="Variant.Outlined" Margin="Margin.Dense" />
                                                </MudItem>
                                            }
                                            else
                                            {
                                                <MudItem xs="12" sm="6">
                                                    <MudNumericField T="double" @bind-Value="_profileConfig.Playback.ScrollSpeedPxPerSec"
                                                                     Label="Scroll Speed (px/sec)" Min="15" Max="500"
                                                                     Variant="Variant.Outlined" Margin="Margin.Dense" />
                                                </MudItem>
                                            }
                                            <MudItem xs="12" sm="6">
                                                <MudNumericField T="double" @bind-Value="_profileConfig.Playback.PageDurationSeconds"
                                                                 Label="Slideshow Page Duration (sec)" Min="2" Max="60"
                                                                 Variant="Variant.Outlined" Margin="Margin.Dense" />
                                            </MudItem>
                                            <MudItem xs="12" sm="4">
                                                <MudSelect T="string" @bind-Value="_profileConfig.Playback.StartBehavior" Label="On Overlay Load"
                                                           Variant="Variant.Outlined" Margin="Margin.Dense">
                                                    <MudSelectItem T="string" Value="@CreditStartBehaviors.WaitForTrigger">Wait for Roll Trigger / Action</MudSelectItem>
                                                    <MudSelectItem T="string" Value="@CreditStartBehaviors.AutoStartOnLoad">Auto-Start When Browser Loads</MudSelectItem>
                                                </MudSelect>
                                            </MudItem>
                                            <MudItem xs="12" sm="4">
                                                <MudSelect T="string" @bind-Value="_profileConfig.Playback.EndBehavior" Label="When Credits Finish"
                                                           Variant="Variant.Outlined" Margin="Margin.Dense">
                                                    <MudSelectItem T="string" Value="@CreditEndBehaviors.FadeOutAndHide">Fade Out &amp; Hide</MudSelectItem>
                                                    <MudSelectItem T="string" Value="@CreditEndBehaviors.HoldFooter">Hold Final Footer Screen</MudSelectItem>
                                                    <MudSelectItem T="string" Value="@CreditEndBehaviors.Loop">Loop Continuously</MudSelectItem>
                                                    <MudSelectItem T="string" Value="@CreditEndBehaviors.FreezeOnEnd">Freeze on Last Frame</MudSelectItem>
                                                </MudSelect>
                                            </MudItem>
                                            <MudItem xs="12" sm="4">
                                                <MudSelect T="string" @bind-Value="_profileConfig.Playback.TestModeDefault" Label="Default Data Source"
                                                           Variant="Variant.Outlined" Margin="Margin.Dense">
                                                    <MudSelectItem T="string" Value="@CreditSampleModes.Off">Live Captured Events (Default)</MudSelectItem>
                                                    <MudSelectItem T="string" Value="@CreditSampleModes.Fake">Fake Sample Data</MudSelectItem>
                                                    <MudSelectItem T="string" Value="@CreditSampleModes.DatabaseViewers">Real DB Viewers (Test Mode)</MudSelectItem>
                                                </MudSelect>
                                            </MudItem>
                                        </MudGrid>
                                    </MudPaper>

                                    <MudPaper Outlined="true" Class="pa-3">
                                        <MudText Typo="Typo.subtitle1" Class="mb-2">Global Filtering &amp; Retention</MudText>
                                        <MudGrid Spacing="2">
                                            <MudItem xs="12" sm="4">
                                                <MudSwitch T="bool" @bind-Value="_profileConfig.Exclusions.ExcludeKnownBots" Color="Color.Primary" Label="Exclude Known Bots" />
                                            </MudItem>
                                            <MudItem xs="12" sm="4">
                                                <MudSwitch T="bool" @bind-Value="_profileConfig.Exclusions.ExcludeBroadcaster" Color="Color.Primary" Label="Exclude Broadcaster" />
                                            </MudItem>
                                            <MudItem xs="12" sm="4">
                                                <MudSwitch T="bool" @bind-Value="_profileConfig.Exclusions.ExcludeBotAccount" Color="Color.Primary" Label="Exclude Bot Account" />
                                            </MudItem>
                                            <MudItem xs="12" sm="4">
                                                <MudSwitch T="bool" @bind-Value="_profileConfig.Exclusions.IncludeAnonymous" Color="Color.Primary" Label="Include Anonymous Gifters" />
                                            </MudItem>
                                            <MudItem xs="12" sm="4">
                                                <MudTextField @bind-Value="_profileConfig.Exclusions.AnonymousLabel" Label="Anonymous Label"
                                                              Variant="Variant.Outlined" Margin="Margin.Dense" />
                                            </MudItem>
                                            <MudItem xs="12" sm="4">
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                    <MudNumericField T="int" @bind-Value="_retentionDays" Label="Event Retention (days)"
                                                                     Min="1" Max="3650" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                                    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="SaveRetentionDaysAsync">Save</MudButton>
                                                </MudStack>
                                            </MudItem>
                                            <MudItem xs="12">
                                                <MudTextField @bind-Value="_excludedUsernamesText" Label="Excluded Usernames (comma or newline separated)"
                                                              Lines="2" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                              Placeholder="nightbot, streamelements" />
                                            </MudItem>
                                        </MudGrid>
                                    </MudPaper>
                                </MudStack>
                            </MudTabPanel>

                            <!-- TAB 2: Sections -->
                            <MudTabPanel Text="@($"Sections ({_profileConfig.Sections.Count})")" Icon="@Icons.Material.Filled.ViewList">
                                <MudStack Spacing="2">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="2">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            Sections render top-to-bottom. Combine multiple topics into one section or split them. Enabled sections with 0 matching items stay hidden when <b>Hide when empty</b> is on.
                                        </MudText>
                                        <MudStack Row="true" Spacing="1">
                                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.Add" OnClick="AddSectionAsync">
                                                Add Section
                                            </MudButton>
                                            <MudMenu Label="Add Common Preset" Variant="Variant.Outlined" Color="Color.Secondary"
                                                     Size="Size.Small" EndIcon="@Icons.Material.Filled.ArrowDropDown">
                                                <MudMenuItem OnClick="@(() => AddPresetSection("Subscribers", new[] { CreditSectionSources.NewSubscribers, CreditSectionSources.Resubscribers }, "{name} x{amount}"))">Subscribers (New + Resubs)</MudMenuItem>
                                                <MudMenuItem OnClick="@(() => AddPresetSection("Sub Gifters", new[] { CreditSectionSources.SubGifters }, "{name} x{amount}"))">Sub Gifters</MudMenuItem>
                                                <MudMenuItem OnClick="@(() => AddPresetSection("Cheers & Bits", new[] { CreditSectionSources.CheersAndBits, CreditSectionSources.BitsPowerUps }, "{name} — {amount} bits"))">Cheers &amp; Bits</MudMenuItem>
                                                <MudMenuItem OnClick="@(() => AddPresetSection("Raids", new[] { CreditSectionSources.IncomingRaids }, "{name} x{amount}"))">Incoming Raids</MudMenuItem>
                                                <MudMenuItem OnClick="@(() => AddPresetSection("New Followers", new[] { CreditSectionSources.NewFollowers }, "{name}"))">New Followers</MudMenuItem>
                                                <MudMenuItem OnClick="@(() => AddPresetSection("Channel Points", new[] { CreditSectionSources.ChannelPointRedemptions }, "{name} — {detail}"))">Channel Point Redemptions</MudMenuItem>
                                                <MudMenuItem OnClick="@(() => AddPresetSection("Watch Streaks", new[] { CreditSectionSources.WatchStreaks }, "{name} ({amount}x)"))">Watch Streaks</MudMenuItem>
                                                <MudMenuItem OnClick="@(() => AddPresetSection("Top Supporters", new[] { CreditSectionSources.TopSupporters }, "{name}"))">Top Supporters</MudMenuItem>
                                                <MudMenuItem OnClick="@(() => AddPresetSection("Active Chatters", new[] { CreditSectionSources.ActiveChatters }, "{name}"))">Active Chatters</MudMenuItem>
                                                <MudMenuItem OnClick="@(() => AddPresetSection("Moderators & VIPs", new[] { CreditSectionSources.Moderators, CreditSectionSources.Vips }, "{name}"))">Moderators &amp; VIPs</MudMenuItem>
                                                <MudMenuItem OnClick="@(() => AddPresetSection("Bot Games & Music", new[] { CreditSectionSources.GiveawayWinners, CreditSectionSources.FishingTopAnglers, CreditSectionSources.DropGameWinners, CreditSectionSources.SongRequesters }, "{name} — {detail}"))">Bot Games &amp; Song Requests</MudMenuItem>
                                                <MudMenuItem OnClick="@(() => AddPresetSection("Special Thanks", new[] { CreditSectionSources.CustomStatic }, "{name} — {detail}"))">Custom / Static Cast</MudMenuItem>
                                                <MudMenuItem OnClick="@(() => AddPresetSection("Featured Shoutouts", new[] { CreditSectionSources.ManualActionEntries }, "{name} — {detail}"))">Action-Added Entries</MudMenuItem>
                                            </MudMenu>
                                        </MudStack>
                                    </MudStack>

                                    @if (_profileConfig.Sections.Count == 0)
                                    {
                                        <MudAlert Severity="Severity.Info">No sections configured yet. Click <b>Add Section</b> or pick a preset above.</MudAlert>
                                    }
                                    else
                                    {
                                        @for (var i = 0; i < _profileConfig.Sections.Count; i++)
                                        {
                                            var idx = i;
                                            var sec = _profileConfig.Sections[idx];
                                            <div @key="sec.Id"
                                                 class="@_sectionDrag.GetItemCssClass(idx)"
                                                 data-drag-item="true"
                                                 data-drag-index="@idx"
                                                 draggable="true"
                                                 @ondragstart="@(() => _sectionDrag.Start(idx))"
                                                 @ondragenter="@(() => _sectionDrag.Enter(idx))"
                                                 ondragover="event.preventDefault()"
                                                 @ondrop="@(() => _sectionDrag.TryCompleteDrop(_profileConfig.Sections, idx, out _, out _))"
                                                 @ondrop:preventDefault="true"
                                                 @ondragend="@(() => _sectionDrag.End())">
                                                <MudPaper Outlined="true" Class="pa-3">
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="2">
                                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="flex: 1 1 280px;">
                                                        <span class="drag-reorder-handle" data-drag-handle="true" title="Drag to reorder">
                                                            <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" />
                                                        </span>
                                                        <MudSwitch T="bool" @bind-Value="sec.Enabled" Color="Color.Success" />
                                                        <MudStack Spacing="0">
                                                            <MudText Typo="Typo.subtitle1"><b>@sec.Title</b></MudText>
                                                            @if (!string.IsNullOrWhiteSpace(sec.Subtitle))
                                                            {
                                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@sec.Subtitle</MudText>
                                                            }
                                                            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-1">
                                                                @foreach (var srcKey in sec.SourceTypes)
                                                                {
                                                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                                                                        @GetSourceDisplayName(srcKey)
                                                                    </MudChip>
                                                                }
                                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                                                         Color="@(sec.HideWhenEmpty ? Color.Success : Color.Warning)">
                                                                    @(sec.HideWhenEmpty ? "Hides when empty" : "Shows fallback when empty")
                                                                </MudChip>
                                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text">
                                                                    Format: @sec.EntryFormatTemplate
                                                                </MudChip>
                                                            </MudStack>
                                                        </MudStack>
                                                    </MudStack>

                                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                        <MudTooltip Text="Move Up">
                                                            <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small"
                                                                           Disabled="@(idx == 0)" OnClick="@(() => MoveSection(idx, -1))" />
                                                        </MudTooltip>
                                                        <MudTooltip Text="Move Down">
                                                            <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small"
                                                                           Disabled="@(idx == _profileConfig.Sections.Count - 1)" OnClick="@(() => MoveSection(idx, 1))" />
                                                        </MudTooltip>
                                                        <MudTooltip Text="Edit Section">
                                                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                                                           OnClick="@(() => EditSectionAsync(idx))" />
                                                        </MudTooltip>
                                                        <MudTooltip Text="Duplicate Section">
                                                            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                                                                           OnClick="@(() => DuplicateSection(idx))" />
                                                        </MudTooltip>
                                                        <MudTooltip Text="Delete Section">
                                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                                           OnClick="@(() => _profileConfig.Sections.RemoveAt(idx))" />
                                                        </MudTooltip>
                                                    </MudStack>
                                                </MudStack>
                                                </MudPaper>
                                            </div>
                                        }
                                    }
                                </MudStack>
                            </MudTabPanel>

                            <!-- TAB 3: Header, Footer & Media -->
                            <MudTabPanel Text="Header, Footer & Media" Icon="@Icons.Material.Filled.Image">
                                <MudStack Spacing="3">
                                    <MudPaper Outlined="true" Class="pa-3">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                                            <MudText Typo="Typo.subtitle1">Credits Header</MudText>
                                            <MudSwitch T="bool" @bind-Value="_profileConfig.Header.Enabled" Color="Color.Success" Label="Show Header" />
                                        </MudStack>
                                        <MudGrid Spacing="2">
                                            <MudItem xs="12" sm="6">
                                                <MudTextField @bind-Value="_profileConfig.Header.Title" Label="Header Title"
                                                              Variant="Variant.Outlined" Margin="Margin.Dense" />
                                            </MudItem>
                                            <MudItem xs="12" sm="6">
                                                <MudTextField @bind-Value="_profileConfig.Header.Subtitle" Label="Header Subtitle"
                                                              Variant="Variant.Outlined" Margin="Margin.Dense" />
                                            </MudItem>
                                            <MudItem xs="12">
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="1">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Insert subtitle token:</MudText>
                                                    @foreach (var tok in new[] { "{broadcaster}", "{date}", "{streamTitle}", "{totalSupporters}" })
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                                                 OnClick="@(() => AppendHeaderSubtitleToken(tok))">@tok</MudChip>
                                                    }
                                                </MudStack>
                                            </MudItem>
                                            <MudItem xs="12" sm="4">
                                                <MudSwitch T="bool" @bind-Value="_profileConfig.Header.ShowBroadcasterAvatar" Color="Color.Primary"
                                                           Label="Show Broadcaster Avatar" />
                                            </MudItem>
                                            <MudItem xs="6" sm="4">
                                                <MudNumericField T="int" @bind-Value="_profileConfig.Header.ImageMaxHeightPx"
                                                                 Label="Logo Max Height (px)" Min="32" Max="600"
                                                                 Variant="Variant.Outlined" Margin="Margin.Dense" />
                                            </MudItem>
                                            <MudItem xs="6" sm="4">
                                                <MudNumericField T="double" @bind-Value="_profileConfig.Header.IntroDelaySeconds"
                                                                 Label="Intro Delay (sec)" Min="0" Max="15" Step="0.5"
                                                                 Variant="Variant.Outlined" Margin="Margin.Dense" />
                                            </MudItem>
                                            <MudItem xs="12">
                                                <MediaUrlPicker @bind-Value="_profileConfig.Header.ImageUrl"
                                                                Label="Header Logo / Banner Image (optional)"
                                                                ShowPreview="true" AllowBrowse="true" />
                                            </MudItem>
                                        </MudGrid>
                                    </MudPaper>

                                    <MudPaper Outlined="true" Class="pa-3">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                                            <MudText Typo="Typo.subtitle1">Credits Footer</MudText>
                                            <MudSwitch T="bool" @bind-Value="_profileConfig.Footer.Enabled" Color="Color.Success" Label="Show Footer" />
                                        </MudStack>
                                        <MudGrid Spacing="2">
                                            <MudItem xs="12" sm="6">
                                                <MudTextField @bind-Value="_profileConfig.Footer.Title" Label="Footer Headline"
                                                              Variant="Variant.Outlined" Margin="Margin.Dense" />
                                            </MudItem>
                                            <MudItem xs="6" sm="3">
                                                <MudNumericField T="double" @bind-Value="_profileConfig.Footer.HoldSeconds"
                                                                 Label="Hold at End (sec)" Min="0" Max="60" Step="0.5"
                                                                 Variant="Variant.Outlined" Margin="Margin.Dense" />
                                            </MudItem>
                                            <MudItem xs="6" sm="3">
                                                <MudNumericField T="int" @bind-Value="_profileConfig.Footer.ImageMaxHeightPx"
                                                                 Label="Logo Height (px)" Min="32" Max="600"
                                                                 Variant="Variant.Outlined" Margin="Margin.Dense" />
                                            </MudItem>
                                            <MudItem xs="12">
                                                <MudTextField @bind-Value="_footerLinesText" Label="Footer Lines (one per line — supports {broadcaster}, {date}, {totalSupporters})"
                                                              Lines="3" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                            </MudItem>
                                            <MudItem xs="12">
                                                <MediaUrlPicker @bind-Value="_profileConfig.Footer.ImageUrl"
                                                                Label="Footer Image / End Graphic (optional)"
                                                                ShowPreview="true" AllowBrowse="true" />
                                            </MudItem>
                                        </MudGrid>
                                    </MudPaper>

                                    <MudPaper Outlined="true" Class="pa-3">
                                        <MudText Typo="Typo.subtitle1" Class="mb-2">Profile Background Override &amp; Audio</MudText>
                                        <MudGrid Spacing="2">
                                            <MudItem xs="12" sm="6">
                                                <MudSelect T="string" @bind-Value="_profileConfig.Media.BackgroundTypeOverride"
                                                           Label="Background Override" Variant="Variant.Outlined" Margin="Margin.Dense">
                                                    <MudSelectItem T="string" Value="@CreditBackgroundTypes.InheritTheme">Inherit Active Theme</MudSelectItem>
                                                    <MudSelectItem T="string" Value="@CreditBackgroundTypes.Transparent">Transparent (for OBS Scenes)</MudSelectItem>
                                                    <MudSelectItem T="string" Value="@CreditBackgroundTypes.Solid">Solid Color Override</MudSelectItem>
                                                    <MudSelectItem T="string" Value="@CreditBackgroundTypes.Gradient">CSS Gradient Override</MudSelectItem>
                                                    <MudSelectItem T="string" Value="@CreditBackgroundTypes.Image">Background Image Override</MudSelectItem>
                                                    <MudSelectItem T="string" Value="@CreditBackgroundTypes.Starfield">Animated Starfield</MudSelectItem>
                                                </MudSelect>
                                            </MudItem>
                                            @if (_profileConfig.Media.BackgroundTypeOverride == CreditBackgroundTypes.Solid)
                                            {
                                                <MudItem xs="12" sm="6">
                                                    <MudTextField @bind-Value="_profileConfig.Media.BackgroundColorOverride"
                                                                  Label="Solid Color (hex or rgba)" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                                  Placeholder="#090b10" />
                                                </MudItem>
                                            }
                                            else if (_profileConfig.Media.BackgroundTypeOverride == CreditBackgroundTypes.Gradient)
                                            {
                                                <MudItem xs="12" sm="6">
                                                    <MudTextField @bind-Value="_profileConfig.Media.BackgroundGradientOverride"
                                                                  Label="CSS Gradient Value" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                                  Placeholder="linear-gradient(180deg, #0b0f1c 0%, #020307 100%)" />
                                                </MudItem>
                                            }
                                            else if (_profileConfig.Media.BackgroundTypeOverride == CreditBackgroundTypes.Image)
                                            {
                                                <MudItem xs="12">
                                                    <MediaUrlPicker @bind-Value="_profileConfig.Media.BackgroundImageUrlOverride"
                                                                    Label="Profile Background Image Override"
                                                                    ShowPreview="true" AllowBrowse="true" />
                                                </MudItem>
                                            }

                                            <MudItem xs="12">
                                                <MudDivider Class="my-1" />
                                            </MudItem>
                                            <MudItem xs="12" sm="10">
                                                <MediaUrlPicker @bind-Value="_profileConfig.Media.BackgroundAudioUrl"
                                                                Label="Credits Background Audio (Optional)"
                                                                HelperText="Upload MP3/OGG/WAV or paste a URL to play music when credits roll."
                                                                Accept=".mp3,.wav,.ogg,.aac,.opus,.webm,.m4a"
                                                                ShowPreview="false" AllowBrowse="true" />
                                            </MudItem>
                                            <MudItem xs="12" sm="2" Class="d-flex align-center">
                                                <MudButton Variant="Variant.Outlined"
                                                           Color="@(_isAudioPreviewing ? Color.Error : Color.Primary)"
                                                           StartIcon="@(_isAudioPreviewing ? Icons.Material.Filled.Stop : Icons.Material.Filled.PlayArrow)"
                                                           Disabled="@string.IsNullOrWhiteSpace(_profileConfig.Media.BackgroundAudioUrl)"
                                                           OnClick="ToggleAudioPreview" FullWidth="true">
                                                    @(_isAudioPreviewing ? "Stop" : "Test")
                                                </MudButton>
                                            </MudItem>
                                            <MudItem xs="12" sm="4">
                                                <MudText Typo="Typo.caption">Audio Volume: @((int)Math.Round(_profileConfig.Media.AudioVolume * 100))%</MudText>
                                                <MudSlider T="double" @bind-Value="_profileConfig.Media.AudioVolume" Min="0" Max="1" Step="0.05" Color="Color.Primary" />
                                            </MudItem>
                                            <MudItem xs="12" sm="2" Class="d-flex align-center">
                                                <MudSwitch T="bool" @bind-Value="_profileConfig.Media.AudioLoop" Color="Color.Primary" Label="Loop Audio" />
                                            </MudItem>
                                            <MudItem xs="6" sm="3">
                                                <MudNumericField T="double" @bind-Value="_profileConfig.Media.AudioFadeInSeconds"
                                                                 Label="Fade In (sec)" Min="0" Max="15" Step="0.5"
                                                                 Variant="Variant.Outlined" Margin="Margin.Dense" />
                                            </MudItem>
                                            <MudItem xs="6" sm="3">
                                                <MudNumericField T="double" @bind-Value="_profileConfig.Media.AudioFadeOutSeconds"
                                                                 Label="Fade Out (sec)" Min="0" Max="15" Step="0.5"
                                                                 Variant="Variant.Outlined" Margin="Margin.Dense" />
                                            </MudItem>
                                        </MudGrid>
                                        @if (_isAudioPreviewing && !string.IsNullOrWhiteSpace(_profileConfig.Media.BackgroundAudioUrl))
                                        {
                                            <audio autoplay src="@_profileConfig.Media.BackgroundAudioUrl" @onended="StopAudioPreview" style="display:none;"></audio>
                                        }
                                    </MudPaper>
                                </MudStack>
                            </MudTabPanel>

                            <!-- TAB 4: Themes & Styling -->
                            <MudTabPanel Text="Themes & Styling" Icon="@Icons.Material.Filled.Palette">
                                <MudStack Spacing="3">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="2">
                                        <MudText Typo="Typo.subtitle1">Theme Presets &amp; Custom Templates</MudText>
                                        <MudStack Row="true" Spacing="1">
                                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.Add"
                                                       OnClick="@(() => _showNewThemeForm = !_showNewThemeForm)">
                                                New Theme
                                            </MudButton>
                                            <MudFileUpload T="IBrowserFile" FilesChanged="ImportThemeAsync" Accept=".json" Class="d-inline-flex">
                                                <CustomContent>
                                                    <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                                                               StartIcon="@Icons.Material.Filled.Upload" OnClick="@context.OpenFilePickerAsync">
                                                        Import Theme JSON
                                                    </MudButton>
                                                </CustomContent>
                                                <SelectedTemplate Context="_"></SelectedTemplate>
                                            </MudFileUpload>
                                        </MudStack>
                                    </MudStack>

                                    @if (_showNewThemeForm)
                                    {
                                        <MudPaper Outlined="true" Class="pa-3">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                                                <MudTextField @bind-Value="_newThemeName" Label="New Custom Theme Name"
                                                              Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 240px;" />
                                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="CreateThemeFromCurrentAsync">
                                                    Create From Current Styling
                                                </MudButton>
                                                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => _showNewThemeForm = false)">
                                                    Cancel
                                                </MudButton>
                                            </MudStack>
                                        </MudPaper>
                                    }

                                    <MudGrid Spacing="2">
                                        @foreach (var theme in _themes)
                                        {
                                            var cfg = CreditsDataBuilder.DeserializeThemeConfig(theme.ThemeJson);
                                            var isApplied = _selectedThemeId == theme.Id;
                                            var isEditing = _editingTheme?.Id == theme.Id;
                                            <MudItem xs="12" sm="6">
                                                <MudPaper Outlined="true" Class="pa-3"
                                                          Style="@(isApplied ? "border-color: var(--mud-palette-primary); border-width: 2px;" : "")">
                                                    <MudStack Spacing="2">
                                                        <!-- Live mini visual swatch -->
                                                        <div style="@BuildThemeSwatchStyle(cfg)">
                                                            <div style="font-size: 13px; font-weight: 700; color: @cfg.SectionTitleColor;">
                                                                @theme.Name
                                                            </div>
                                                            <div style="font-size: 11px; color: @cfg.TextColor; opacity: 0.9;">
                                                                @(cfg.AnimationMode == CreditAnimationModes.Crawl3D ? "3D Perspective Crawl" : cfg.AnimationMode) • @cfg.DefaultLayout
                                                            </div>
                                                        </div>

                                                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                                                            <MudStack Row="true" Spacing="1">
                                                                <MudChip T="string" Size="Size.Small" Color="@(theme.IsBuiltIn ? Color.Default : Color.Secondary)" Variant="Variant.Outlined">
                                                                    @(theme.IsBuiltIn ? "Built-In" : "Custom")
                                                                </MudChip>
                                                                @if (isApplied)
                                                                {
                                                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">Applied</MudChip>
                                                                }
                                                                @if (isEditing)
                                                                {
                                                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">Editing</MudChip>
                                                                }
                                                            </MudStack>
                                                        </MudStack>

                                                        @if (!string.IsNullOrWhiteSpace(theme.Description))
                                                        {
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@theme.Description</MudText>
                                                        }

                                                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                                                            <MudButton Size="Size.Small" Variant="@(isApplied ? Variant.Filled : Variant.Outlined)"
                                                                       Color="Color.Primary" OnClick="@(() => ApplyThemeAsync(theme))">
                                                                @(isApplied ? "Applied" : "Apply")
                                                            </MudButton>
                                                            <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                                                       OnClick="@(() => SelectThemeForEditing(theme))">
                                                                Edit
                                                            </MudButton>
                                                            <MudButton Size="Size.Small" Variant="Variant.Text"
                                                                       OnClick="@(() => CloneThemeAsync(theme))">
                                                                Clone
                                                            </MudButton>
                                                            <MudButton Size="Size.Small" Variant="Variant.Text"
                                                                       OnClick="@(() => ExportThemeAsync(theme))">
                                                                Export
                                                            </MudButton>
                                                            @if (theme.IsBuiltIn)
                                                            {
                                                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Warning"
                                                                           OnClick="@(() => ResetBuiltInThemeAsync(theme))">
                                                                    Reset
                                                                </MudButton>
                                                            }
                                                            else
                                                            {
                                                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                                                                           OnClick="@(() => DeleteThemeAsync(theme))">
                                                                    Delete
                                                                </MudButton>
                                                            }
                                                        </MudStack>
                                                    </MudStack>
                                                </MudPaper>
                                            </MudItem>
                                        }
                                    </MudGrid>

                                    @if (_editingTheme != null)
                                    {
                                        <MudPaper Outlined="true" Class="pa-3">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Class="mb-3">
                                                <MudText Typo="Typo.h6">Editing Theme: @_editingTheme.Name</MudText>
                                                <MudStack Row="true" Spacing="1">
                                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                                               StartIcon="@Icons.Material.Filled.Save" Disabled="@_isSaving"
                                                               OnClick="SaveEditingThemeAsync">
                                                        Save Theme
                                                    </MudButton>
                                                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small"
                                                               StartIcon="@Icons.Material.Filled.SaveAs" Disabled="@_isSaving"
                                                               OnClick="SaveAsNewCustomThemeAsync">
                                                        Save As New Custom Theme
                                                    </MudButton>
                                                </MudStack>
                                            </MudStack>

                                            <MudGrid Spacing="2">
                                                <MudItem xs="12" sm="4">
                                                    <MudTextField @bind-Value="_editingThemeName" Label="Theme Name"
                                                                  ReadOnly="@_editingTheme.IsBuiltIn"
                                                                  Variant="Variant.Outlined" Margin="Margin.Dense" />
                                                </MudItem>
                                                <MudItem xs="12" sm="8">
                                                    <MudTextField @bind-Value="_editingThemeDescription" Label="Description"
                                                                  Variant="Variant.Outlined" Margin="Margin.Dense" />
                                                </MudItem>

                                                <MudItem xs="12" sm="6">
                                                    <MudSelect T="string" @bind-Value="_themeConfig.AnimationMode" Label="Theme Default Animation"
                                                               Variant="Variant.Outlined" Margin="Margin.Dense">
                                                        <MudSelectItem T="string" Value="@CreditAnimationModes.SmoothScroll">Classic Smooth Vertical Scroll</MudSelectItem>
                                                        <MudSelectItem T="string" Value="@CreditAnimationModes.Crawl3D">3D Perspective Crawl</MudSelectItem>
                                                        <MudSelectItem T="string" Value="@CreditAnimationModes.PagedSlideshow">Paged Slideshow</MudSelectItem>
                                                    </MudSelect>
                                                </MudItem>
                                                <MudItem xs="12" sm="6">
                                                    <MudSelect T="string" @bind-Value="_themeConfig.DefaultLayout" Label="Default Section Layout"
                                                               Variant="Variant.Outlined" Margin="Margin.Dense">
                                                        <MudSelectItem T="string" Value="@CreditLayouts.SingleColumn">Single Column</MudSelectItem>
                                                        <MudSelectItem T="string" Value="@CreditLayouts.Grid2">2-Column Grid</MudSelectItem>
                                                        <MudSelectItem T="string" Value="@CreditLayouts.Grid3">3-Column Grid</MudSelectItem>
                                                        <MudSelectItem T="string" Value="@CreditLayouts.Grid4">4-Column Grid</MudSelectItem>
                                                        <MudSelectItem T="string" Value="@CreditLayouts.InlinePills">Inline Pills</MudSelectItem>
                                                        <MudSelectItem T="string" Value="@CreditLayouts.AvatarCards">Avatar Cards</MudSelectItem>
                                                        <MudSelectItem T="string" Value="@CreditLayouts.ClassicCast">Classic Cast</MudSelectItem>
                                                    </MudSelect>
                                                </MudItem>

                                                <MudItem xs="12"><MudDivider Class="my-1" /><MudText Typo="Typo.subtitle2" Class="mt-2">Background &amp; Scrim</MudText></MudItem>
                                                <MudItem xs="12" sm="4">
                                                    <MudSelect T="string" @bind-Value="_themeConfig.BackgroundType" Label="Background Type"
                                                               Variant="Variant.Outlined" Margin="Margin.Dense">
                                                        <MudSelectItem T="string" Value="@CreditBackgroundTypes.Transparent">Transparent</MudSelectItem>
                                                        <MudSelectItem T="string" Value="@CreditBackgroundTypes.Solid">Solid Color</MudSelectItem>
                                                        <MudSelectItem T="string" Value="@CreditBackgroundTypes.Gradient">CSS Gradient</MudSelectItem>
                                                        <MudSelectItem T="string" Value="@CreditBackgroundTypes.Image">Background Image</MudSelectItem>
                                                        <MudSelectItem T="string" Value="@CreditBackgroundTypes.Starfield">Animated Starfield</MudSelectItem>
                                                    </MudSelect>
                                                </MudItem>
                                                <MudItem xs="12" sm="4">
                                                    <MudTextField @bind-Value="_themeConfig.BackgroundColor" Label="Background Color"
                                                                  Variant="Variant.Outlined" Margin="Margin.Dense" />
                                                </MudItem>
                                                <MudItem xs="12" sm="4">
                                                    <MudNumericField T="int" @bind-Value="_themeConfig.BackgroundBlurPx" Label="Image Blur (px)"
                                                                     Min="0" Max="40" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                                </MudItem>
                                                @if (_themeConfig.BackgroundType == CreditBackgroundTypes.Gradient)
                                                {
                                                    <MudItem xs="12">
                                                        <MudTextField @bind-Value="_themeConfig.BackgroundGradient" Label="Background Gradient CSS"
                                                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                                                    </MudItem>
                                                }
                                                @if (_themeConfig.BackgroundType == CreditBackgroundTypes.Image)
                                                {
                                                    <MudItem xs="12">
                                                        <MediaUrlPicker @bind-Value="_themeConfig.BackgroundImageUrl" Label="Theme Background Image"
                                                                        ShowPreview="true" AllowBrowse="true" />
                                                    </MudItem>
                                                    <MudItem xs="12" sm="4">
                                                        <MudSelect T="string" @bind-Value="_themeConfig.BackgroundImageFit" Label="Image Fit"
                                                                   Variant="Variant.Outlined" Margin="Margin.Dense">
                                                            <MudSelectItem T="string" Value="@("cover")">Cover</MudSelectItem>
                                                            <MudSelectItem T="string" Value="@("contain")">Contain</MudSelectItem>
                                                        </MudSelect>
                                                    </MudItem>
                                                }
                                                <MudItem xs="6" sm="4">
                                                    <MudTextField @bind-Value="_themeConfig.BackgroundScrimColor" Label="Scrim Color"
                                                                  Variant="Variant.Outlined" Margin="Margin.Dense" />
                                                </MudItem>
                                                <MudItem xs="6" sm="4">
                                                    <MudNumericField T="double" @bind-Value="_themeConfig.BackgroundScrimOpacity" Label="Scrim Opacity (0-1)"
                                                                     Min="0" Max="1" Step="0.05" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                                </MudItem>

                                                <MudItem xs="12"><MudDivider Class="my-1" /><MudText Typo="Typo.subtitle2" Class="mt-2">Typography &amp; Colors</MudText></MudItem>
                                                <MudItem xs="12" sm="6">
                                                    <MudTextField @bind-Value="_themeConfig.FontFamilyHeading" Label="Heading Font (Google Font or CSS)"
                                                                  Variant="Variant.Outlined" Margin="Margin.Dense" />
                                                </MudItem>
                                                <MudItem xs="12" sm="6">
                                                    <MudTextField @bind-Value="_themeConfig.FontFamilyBody" Label="Body Font (Google Font or CSS)"
                                                                  Variant="Variant.Outlined" Margin="Margin.Dense" />
                                                </MudItem>
                                                <MudItem xs="12">
                                                    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="1">
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Heading Font Presets:</MudText>
                                                        @foreach (var font in new[] { "Cinzel", "Orbitron", "Montserrat", "Inter", "Press Start 2P", "Merriweather", "Oswald" })
                                                        {
                                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                                                     OnClick="@(() => _themeConfig.FontFamilyHeading = font)">@font</MudChip>
                                                        }
                                                    </MudStack>
                                                </MudItem>
                                                <MudItem xs="4" sm="2"><MudNumericField T="int" @bind-Value="_themeConfig.HeaderFontSizePx" Label="Header px" Min="16" Max="160" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                                <MudItem xs="4" sm="2"><MudNumericField T="int" @bind-Value="_themeConfig.SubtitleFontSizePx" Label="Subtitle px" Min="12" Max="100" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                                <MudItem xs="4" sm="2"><MudNumericField T="int" @bind-Value="_themeConfig.SectionTitleFontSizePx" Label="Section px" Min="14" Max="120" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                                <MudItem xs="4" sm="2"><MudNumericField T="int" @bind-Value="_themeConfig.EntryFontSizePx" Label="Entry px" Min="12" Max="80" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                                <MudItem xs="4" sm="2"><MudNumericField T="int" @bind-Value="_themeConfig.DetailFontSizePx" Label="Detail px" Min="10" Max="60" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                                <MudItem xs="4" sm="2"><MudNumericField T="int" @bind-Value="_themeConfig.FooterFontSizePx" Label="Footer px" Min="16" Max="140" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>

                                                <MudItem xs="6" sm="4"><MudTextField @bind-Value="_themeConfig.HeaderColor" Label="Header Color" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                                <MudItem xs="6" sm="4"><MudTextField @bind-Value="_themeConfig.SectionTitleColor" Label="Section Title Color" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                                <MudItem xs="6" sm="4"><MudTextField @bind-Value="_themeConfig.TextColor" Label="Entry Text Color" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                                <MudItem xs="6" sm="4"><MudTextField @bind-Value="_themeConfig.SecondaryTextColor" Label="Secondary Text Color" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                                <MudItem xs="6" sm="4"><MudTextField @bind-Value="_themeConfig.AccentColor" Label="Accent Color" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                                <MudItem xs="6" sm="4">
                                                    <MudSelect T="string" @bind-Value="_themeConfig.TextAlign" Label="Text Align" Variant="Variant.Outlined" Margin="Margin.Dense">
                                                        <MudSelectItem T="string" Value="@("center")">Center</MudSelectItem>
                                                        <MudSelectItem T="string" Value="@("left")">Left</MudSelectItem>
                                                        <MudSelectItem T="string" Value="@("right")">Right</MudSelectItem>
                                                    </MudSelect>
                                                </MudItem>
                                                <MudItem xs="12" sm="8"><MudTextField @bind-Value="_themeConfig.TextShadow" Label="Text Shadow CSS" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                                <MudItem xs="12" sm="4" Class="d-flex align-center"><MudSwitch T="bool" @bind-Value="_themeConfig.HeadingItalic" Color="Color.Primary" Label="Italic Headings" /></MudItem>

                                                <MudItem xs="12"><MudDivider Class="my-1" /><MudText Typo="Typo.subtitle2" Class="mt-2">Avatars, Spacing &amp; 3D Crawl</MudText></MudItem>
                                                <MudItem xs="12" sm="3" Class="d-flex align-center"><MudSwitch T="bool" @bind-Value="_themeConfig.ShowAvatars" Color="Color.Primary" Label="Show Avatars" /></MudItem>
                                                <MudItem xs="6" sm="3"><MudNumericField T="int" @bind-Value="_themeConfig.AvatarSizePx" Label="Avatar Size (px)" Min="16" Max="160" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                                <MudItem xs="6" sm="3">
                                                    <MudSelect T="string" @bind-Value="_themeConfig.AvatarShape" Label="Avatar Shape" Variant="Variant.Outlined" Margin="Margin.Dense">
                                                        <MudSelectItem T="string" Value="@("circle")">Circle</MudSelectItem>
                                                        <MudSelectItem T="string" Value="@("rounded")">Rounded Square</MudSelectItem>
                                                        <MudSelectItem T="string" Value="@("square")">Square</MudSelectItem>
                                                    </MudSelect>
                                                </MudItem>
                                                <MudItem xs="6" sm="3"><MudNumericField T="int" @bind-Value="_themeConfig.AvatarBorderWidthPx" Label="Border Width (px)" Min="0" Max="10" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                                <MudItem xs="6" sm="4"><MudTextField @bind-Value="_themeConfig.AvatarBorderColor" Label="Avatar Border Color" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                                <MudItem xs="6" sm="4">
                                                    <MudSelect T="string" @bind-Value="_themeConfig.AvatarFallbackMode" Label="Avatar Fallback" Variant="Variant.Outlined" Margin="Margin.Dense">
                                                        <MudSelectItem T="string" Value="@CreditAvatarFallbacks.ColoredSilhouette">Colored Silhouette</MudSelectItem>
                                                        <MudSelectItem T="string" Value="@CreditAvatarFallbacks.Initials">Colored Initials Badge</MudSelectItem>
                                                        <MudSelectItem T="string" Value="@CreditAvatarFallbacks.CustomImage">Custom Fallback Image</MudSelectItem>
                                                        <MudSelectItem T="string" Value="@CreditAvatarFallbacks.Hide">Hide Missing Avatars</MudSelectItem>
                                                    </MudSelect>
                                                </MudItem>
                                                @if (_themeConfig.AvatarFallbackMode == CreditAvatarFallbacks.CustomImage)
                                                {
                                                    <MudItem xs="12" sm="4">
                                                        <MediaUrlPicker @bind-Value="_themeConfig.AvatarFallbackImageUrl" Label="Fallback Avatar Image"
                                                                        ShowPreview="false" AllowBrowse="true" />
                                                    </MudItem>
                                                }
                                                <MudItem xs="6" sm="3"><MudNumericField T="int" @bind-Value="_themeConfig.ContainerMaxWidthPx" Label="Max Width (px)" Min="320" Max="1920" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                                <MudItem xs="6" sm="3"><MudNumericField T="int" @bind-Value="_themeConfig.SectionGapPx" Label="Section Gap (px)" Min="8" Max="240" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                                <MudItem xs="6" sm="3"><MudNumericField T="int" @bind-Value="_themeConfig.EntryGapPx" Label="Entry Gap (px)" Min="2" Max="80" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                                <MudItem xs="6" sm="3"><MudNumericField T="int" @bind-Value="_themeConfig.EdgeFadeHeightPct" Label="Edge Fade (%)" Min="0" Max="40" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>

                                                <MudItem xs="4" sm="4"><MudNumericField T="int" @bind-Value="_themeConfig.CrawlPerspectivePx" Label="3D Crawl Perspective (px)" Min="150" Max="1200" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                                <MudItem xs="4" sm="4"><MudNumericField T="int" @bind-Value="_themeConfig.CrawlTiltDegrees" Label="3D Crawl Tilt (deg)" Min="5" Max="60" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                                <MudItem xs="4" sm="4"><MudNumericField T="int" @bind-Value="_themeConfig.CrawlFadeTopPct" Label="3D Horizon Fade (%)" Min="0" Max="70" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                            </MudGrid>
                                        </MudPaper>
                                    }
                                </MudStack>
                            </MudTabPanel>

                            <!-- TAB 5: Custom CSS -->
                            <MudTabPanel Text="Custom CSS" Icon="@Icons.Material.Filled.Code">
                                <MudStack Spacing="3">
                                    <MudPaper Outlined="true" Class="pa-3">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                                            <MudText Typo="Typo.subtitle1">Active Theme Custom CSS (@(_editingTheme?.Name ?? "None"))</MudText>
                                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                                       Disabled="@(_editingTheme == null || _isSaving)" OnClick="SaveEditingThemeAsync">
                                                Save Theme CSS
                                            </MudButton>
                                        </MudStack>
                                        <MudTextField @bind-Value="_themeConfig.CustomCss" Lines="8" Variant="Variant.Outlined"
                                                      Style="font-family: monospace;"
                                                      Placeholder=".credits-section-title { letter-spacing: 0.14em; text-transform: uppercase; }" />
                                    </MudPaper>

                                    <MudPaper Outlined="true" Class="pa-3">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                                            <MudText Typo="Typo.subtitle1">Profile Custom CSS Override (@_selectedProfile.Name)</MudText>
                                            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                                                       Disabled="@_isSaving" OnClick="SaveProfileAsync">
                                                Save Profile CSS
                                            </MudButton>
                                        </MudStack>
                                        <MudTextField @bind-Value="_profileConfig.CustomCssOverride" Lines="8" Variant="Variant.Outlined"
                                                      Style="font-family: monospace;"
                                                      Placeholder="/* Profile-specific overrides loaded after theme CSS */" />
                                    </MudPaper>

                                    <MudPaper Outlined="true" Class="pa-3">
                                        <MudText Typo="Typo.subtitle2" Class="mb-2">CSS Variables &amp; Selectors Reference (click to append to Profile CSS)</MudText>
                                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                                            @foreach (var snippet in CssReferenceSnippets)
                                            {
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                                         OnClick="@(() => AppendCssSnippet(snippet))">@snippet.Split(' ')[0]</MudChip>
                                            }
                                        </MudStack>
                                    </MudPaper>
                                </MudStack>
                            </MudTabPanel>

                            <!-- TAB 6: Events & Curation -->
                            <MudTabPanel Text="Events & Curation" Icon="@Icons.Material.Filled.FactCheck">
                                <MudStack Spacing="3">
                                    <MudAlert Severity="Severity.Info" Dense="true">
                                        Resolved Window: <b>@_windowStartUtc.ToString("u")</b> to <b>@_windowEndUtc.ToString("u")</b> (@_profileConfig.TimeWindow.Mode)
                                    </MudAlert>

                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="2">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                            <MudSelect T="string" Value="_eventTypeFilter" ValueChanged="OnEventTypeFilterChangedAsync"
                                                       Label="Filter Event Type" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                       Style="min-width: 210px;">
                                                <MudSelectItem T="string" Value="@("")">All Event Types</MudSelectItem>
                                                <MudSelectItem T="string" Value="@CreditEventTypes.Follow">Follow</MudSelectItem>
                                                <MudSelectItem T="string" Value="@CreditEventTypes.Subscribe">Subscribe</MudSelectItem>
                                                <MudSelectItem T="string" Value="@CreditEventTypes.Resubscribe">Resubscribe</MudSelectItem>
                                                <MudSelectItem T="string" Value="@CreditEventTypes.SubGift">SubGift</MudSelectItem>
                                                <MudSelectItem T="string" Value="@CreditEventTypes.GiftedSubRecipient">GiftedSubRecipient</MudSelectItem>
                                                <MudSelectItem T="string" Value="@CreditEventTypes.Cheer">Cheer</MudSelectItem>
                                                <MudSelectItem T="string" Value="@CreditEventTypes.BitsPowerUp">BitsPowerUp</MudSelectItem>
                                                <MudSelectItem T="string" Value="@CreditEventTypes.IncomingRaid">IncomingRaid</MudSelectItem>
                                                <MudSelectItem T="string" Value="@CreditEventTypes.ChannelPointRedeem">ChannelPointRedeem</MudSelectItem>
                                                <MudSelectItem T="string" Value="@CreditEventTypes.WatchStreak">WatchStreak</MudSelectItem>
                                                <MudSelectItem T="string" Value="@CreditEventTypes.CharityDonation">CharityDonation</MudSelectItem>
                                                <MudSelectItem T="string" Value="@CreditEventTypes.Chatter">Chatter</MudSelectItem>
                                                <MudSelectItem T="string" Value="@CreditEventTypes.DropGameWin">DropGameWin</MudSelectItem>
                                                <MudSelectItem T="string" Value="@CreditEventTypes.SongRequest">SongRequest</MudSelectItem>
                                                <MudSelectItem T="string" Value="@CreditEventTypes.Manual">Manual</MudSelectItem>
                                            </MudSelect>
                                            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.Refresh" OnClick="RefreshEventsAndSessionsAsync">
                                                Refresh
                                            </MudButton>
                                        </MudStack>
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="OpenManualEntryDialogAsync">
                                            Add Manual Entry
                                        </MudButton>
                                    </MudStack>

                                    <MudTable T="CreditEvent" Items="_windowEvents" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                                        <HeaderContent>
                                            <MudTh>Time (UTC)</MudTh>
                                            <MudTh>Type</MudTh>
                                            <MudTh>User</MudTh>
                                            <MudTh>Amount</MudTh>
                                            <MudTh>Detail</MudTh>
                                            <MudTh>Actions</MudTh>
                                        </HeaderContent>
                                        <RowTemplate>
                                            <MudTd DataLabel="Time">@context.OccurredAtUtc.ToString("MM-dd HH:mm")</MudTd>
                                            <MudTd DataLabel="Type">
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@context.EventType</MudChip>
                                            </MudTd>
                                            <MudTd DataLabel="User">
                                                @(string.IsNullOrWhiteSpace(context.DisplayName) ? context.Username : context.DisplayName)
                                                @if (context.IsHidden)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ml-1">Hidden</MudChip>
                                                }
                                            </MudTd>
                                            <MudTd DataLabel="Amount">@CreditsDataBuilder.FormatAmount(context.Amount)</MudTd>
                                            <MudTd DataLabel="Detail">@context.Detail</MudTd>
                                            <MudTd DataLabel="Actions">
                                                <MudStack Row="true" Spacing="1">
                                                    <MudTooltip Text="@(context.IsHidden ? "Show in Credits" : "Hide from Credits")">
                                                        <MudIconButton Icon="@(context.IsHidden ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                                                       Size="Size.Small"
                                                                       OnClick="@(() => ToggleEventHiddenAsync(context))" />
                                                    </MudTooltip>
                                                    <MudTooltip Text="Delete Event">
                                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                                       OnClick="@(() => DeleteEventAsync(context))" />
                                                    </MudTooltip>
                                                </MudStack>
                                            </MudTd>
                                        </RowTemplate>
                                        <NoRecordsContent>
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">No captured events in this time window.</MudText>
                                        </NoRecordsContent>
                                    </MudTable>

                                    <MudPaper Outlined="true" Class="pa-3">
                                        <MudText Typo="Typo.subtitle2" Class="mb-2">Recent Stream Sessions &amp; Manual Checkpoints</MudText>
                                        @if (_sessions.Count == 0)
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">No sessions or checkpoints recorded yet.</MudText>
                                        }
                                        else
                                        {
                                            <MudStack Spacing="1">
                                                @foreach (var s in _sessions.Take(10))
                                                {
                                                    <MudText Typo="Typo.caption">@FormatSessionLabel(s)</MudText>
                                                }
                                            </MudStack>
                                        }
                                    </MudPaper>
                                </MudStack>
                            </MudTabPanel>
                        </MudTabs>
                    </MudPaper>
                </MudItem>

                <!-- RIGHT STICKY COLUMN: LIVE 16:9 PREVIEW -->
                <MudItem xs="12" lg="5">
                    <MudPaper Elevation="2" Class="pa-3" Style="position: sticky; top: 80px;">
                        <MudStack Spacing="2">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="1">
                                <MudText Typo="Typo.h6">Live Preview</MudText>
                                <MudSelect T="string" Value="_previewSampleMode" ValueChanged="OnPreviewSampleModeChanged"
                                           Label="Preview Data Mode" Variant="Variant.Outlined" Margin="Margin.Dense"
                                           Style="min-width: 190px;">
                                    <MudSelectItem T="string" Value="@CreditSampleModes.Fake">Fake Sample Data</MudSelectItem>
                                    <MudSelectItem T="string" Value="@CreditSampleModes.DatabaseViewers">Real DB Viewers</MudSelectItem>
                                    <MudSelectItem T="string" Value="@CreditSampleModes.Off">Live Window Events</MudSelectItem>
                                </MudSelect>
                            </MudStack>

                            <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="1">
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.PlayArrow"
                                           OnClick="@(() => SendPreviewCommandAsync("credits_restart"))">
                                    Play / Restart
                                </MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                           StartIcon="@Icons.Material.Filled.Pause"
                                           OnClick="@(() => SendPreviewCommandAsync("credits_toggle_pause"))">
                                    Pause / Resume
                                </MudButton>
                                @foreach (var spd in new[] { 0.5, 1.0, 2.0, 4.0 })
                                {
                                    var speedVal = spd;
                                    <MudChip T="string" Size="Size.Small"
                                             Variant="@(Math.Abs(_previewSpeed - speedVal) < 0.01 ? Variant.Filled : Variant.Outlined)"
                                             Color="Color.Info"
                                             OnClick="@(() => SetPreviewSpeedAsync(speedVal))">
                                        @(speedVal)x
                                    </MudChip>
                                }
                                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" Color="Color.Default"
                                               aria-label="Refresh credits preview"
                                               OnClick="RefreshPreviewFrame" />
                            </MudStack>

                            <div style="aspect-ratio: 16 / 9; width: 100%; background: #000; border-radius: 8px; overflow: hidden; border: 1px solid rgba(255,255,255,0.12);">
                                <iframe id="@PreviewIframeId"
                                        src="@GetPreviewIframeUrl()"
                                        style="width: 100%; height: 100%; border: 0;"
                                        title="Credits Live Preview"></iframe>
                            </div>

                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Save your Profile or Theme changes to update the live preview. Background audio is muted inside the preview box so it doesn't overlap your workspace.
                            </MudText>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        }
    </MudStack>
</MudContainer>

@code {
    private const string PreviewIframeId = "credits-preview-iframe";

    private static readonly string[] CssReferenceSnippets =
    [
        ".credits-header-title { letter-spacing: 0.12em; }",
        ".credits-section-title { text-transform: uppercase; letter-spacing: 0.1em; }",
        ".credits-entry { background: rgba(255,255,255,0.06); padding: 6px 14px; border-radius: 999px; }",
        ".credits-avatar { box-shadow: 0 0 12px var(--credits-accent); }",
        ".credits-footer-title { color: var(--credits-accent); }",
        ":root { --credits-accent: #f5c451; --credits-section-color: #f5c451; }"
    ];

    private bool _isLoading = true;
    private bool _isSaving;
    private int _profileSelectionVersion;
    private int _themeSelectionVersion;
    private int _eventsLoadVersion;
    private List<CreditProfile> _profiles = [];
    private List<CreditTheme> _themes = [];
    private List<CreditStreamSession> _sessions = [];
    private List<CreditEvent> _windowEvents = [];

    private Guid _selectedProfileId;
    private CreditProfile? _selectedProfile;
    private string _profileNameDraft = string.Empty;
    private Guid? _selectedThemeId;
    private CreditsProfileConfig _profileConfig = new();

    private CreditTheme? _editingTheme;
    private string _editingThemeName = string.Empty;
    private string? _editingThemeDescription;
    private CreditsThemeConfig _themeConfig = new();

    private bool _showNewProfileForm;
    private string _newProfileName = string.Empty;
    private bool _showCloneProfileForm;
    private string _cloneProfileName = string.Empty;
    private bool _showNewThemeForm;
    private string _newThemeName = string.Empty;

    private string _excludedUsernamesText = string.Empty;
    private string _footerLinesText = string.Empty;
    private string _customStartUtcInput = string.Empty;
    private string _customEndUtcInput = string.Empty;
    private string _loadedCustomStartInput = string.Empty;
    private string _loadedCustomEndInput = string.Empty;

    private string _previewSampleMode = CreditSampleModes.Fake;
    private double _previewSpeed = 1.0;
    private long _previewNonce = DateTime.UtcNow.Ticks;
    private string? _overlayKey;
    private bool _isAudioPreviewing;

    private string _eventTypeFilter = string.Empty;
    private DateTime _windowStartUtc = DateTime.UtcNow.AddHours(-6);
    private DateTime _windowEndUtc = DateTime.UtcNow;
    private int _retentionDays = 90;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await CreditsService.EnsureSeededAsync();
            _overlayKey = await OverlaySecurityService.GetOverlayKeyAsync();
            _retentionDays = await CreditsService.GetRetentionDaysAsync();
            await LoadAllAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load Stream Credits: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadAllAsync(Guid? selectProfileId = null)
    {
        _profiles = await CreditsService.GetProfilesAsync();
        _themes = await CreditsService.GetThemesAsync();
        _sessions = await CreditsService.GetSessionsAsync(30);

        var target = selectProfileId.HasValue
            ? _profiles.FirstOrDefault(p => p.Id == selectProfileId.Value)
            : _profiles.FirstOrDefault(p => p.IsDefault) ?? _profiles.FirstOrDefault();

        if (target != null)
        {
            LoadProfileIntoEditor(target);
            await RefreshEventsAndSessionsAsync();
        }
    }

    private void LoadProfileIntoEditor(CreditProfile profile)
    {
        _profileSelectionVersion++;
        _selectedProfile = profile;
        _selectedProfileId = profile.Id;
        _profileNameDraft = profile.Name;
        _selectedThemeId = profile.ThemeId;
        _profileConfig = CreditsDataBuilder.DeserializeProfileConfig(profile.ConfigJson);

        _excludedUsernamesText = string.Join(", ", _profileConfig.Exclusions.ExcludedUsernames);
        _footerLinesText = string.Join("\n", _profileConfig.Footer.Lines);
        _customStartUtcInput = _profileConfig.TimeWindow.CustomStartUtc?.ToString("yyyy-MM-ddTHH:mm") ?? string.Empty;
        _customEndUtcInput = _profileConfig.TimeWindow.CustomEndUtc?.ToString("yyyy-MM-ddTHH:mm") ?? string.Empty;
        _loadedCustomStartInput = _customStartUtcInput;
        _loadedCustomEndInput = _customEndUtcInput;

        var activeTheme = _themes.FirstOrDefault(t => t.Id == profile.ThemeId) ?? _themes.FirstOrDefault();
        if (activeTheme != null)
        {
            SelectThemeForEditing(activeTheme);
        }
    }

    private void SelectThemeForEditing(CreditTheme theme)
    {
        _themeSelectionVersion++;
        _editingTheme = theme;
        _editingThemeName = theme.Name;
        _editingThemeDescription = theme.Description;
        _themeConfig = CreditsDataBuilder.DeserializeThemeConfig(theme.ThemeJson);
    }

    private void SyncProfileDraftFieldsToConfig()
    {
        _profileConfig.Exclusions.ExcludedUsernames = _excludedUsernamesText
            .Split([',', '\r', '\n', ';'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        _profileConfig.Footer.Lines = _footerLinesText
            .Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries)
            .Select(l => l.TrimEnd())
            .ToList();

        if (!string.Equals(_customStartUtcInput, _loadedCustomStartInput, StringComparison.Ordinal))
        {
            _profileConfig.TimeWindow.CustomStartUtc = DateTime.TryParse(
                _customStartUtcInput,
                System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None,
                out var parsedStart)
                ? DateTime.SpecifyKind(parsedStart, DateTimeKind.Utc)
                : null;
        }

        if (!string.Equals(_customEndUtcInput, _loadedCustomEndInput, StringComparison.Ordinal))
        {
            _profileConfig.TimeWindow.CustomEndUtc = DateTime.TryParse(
                _customEndUtcInput,
                System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None,
                out var parsedEnd)
                ? DateTime.SpecifyKind(parsedEnd, DateTimeKind.Utc)
                : null;
        }
    }

