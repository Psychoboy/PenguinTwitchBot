    private async Task RefreshEventsAndSessionsAsync()
    {
        var selectedProfile = _selectedProfile;
        if (selectedProfile == null) return;
        var loadVersion = ++_eventsLoadVersion;
        var filterSnapshot = _eventTypeFilter;

        var payload = await CreditsService.RenderAsync(selectedProfile.Name, CreditSampleModes.Off);
        if (_eventsLoadVersion != loadVersion || _selectedProfile?.Id != selectedProfile.Id) return;

        var events = await CreditsService.GetEventsAsync(
            payload.WindowStartUtc,
            payload.WindowEndUtc,
            string.IsNullOrWhiteSpace(filterSnapshot) ? null : filterSnapshot,
            includeHidden: true);
        if (_eventsLoadVersion != loadVersion || _selectedProfile?.Id != selectedProfile.Id) return;

        var sessions = await CreditsService.GetSessionsAsync(30);
        if (_eventsLoadVersion != loadVersion || _selectedProfile?.Id != selectedProfile.Id) return;

        _windowStartUtc = payload.WindowStartUtc;
        _windowEndUtc = payload.WindowEndUtc;
        _windowEvents = events;
        _sessions = sessions;
    }

