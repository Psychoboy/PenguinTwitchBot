    private async Task SaveEditingThemeAsync()
    {
        if (_editingTheme == null) return;
        var targetThemeId = _editingTheme.Id;
        var themeVersion = _themeSelectionVersion;
        _isSaving = true;
        try
        {
            var saved = await CreditsService.SaveThemeAsync(
                _editingTheme.Id,
                string.IsNullOrWhiteSpace(_editingThemeName) ? _editingTheme.Name : _editingThemeName.Trim(),
                _editingThemeDescription,
                _themeConfig);

            _themes = await CreditsService.GetThemesAsync();
            var updatedTheme = _themes.FirstOrDefault(t => t.Id == saved.Id) ?? saved;
            if (_themeSelectionVersion == themeVersion && _editingTheme?.Id == targetThemeId)
            {
                SelectThemeForEditing(updatedTheme);
            }

            _profiles = await CreditsService.GetProfilesAsync();
            RefreshPreviewFrame();

            var affectedProfiles = _profiles
                .Where(p => p.ThemeId == saved.Id)
                .Select(p => p.Name)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();

            var reloadFailures = 0;
            foreach (var profileName in affectedProfiles)
            {
                try
                {
                    await CreditsService.NotifyReloadAsync(profileName);
                }
                catch
                {
                    reloadFailures++;
                }
            }

            if (reloadFailures == 0)
            {
                Snackbar.Add($"Saved theme '{saved.Name}'.", Severity.Success);
            }
            else
            {
                Snackbar.Add($"Saved theme '{saved.Name}', but live overlay reload notification failed for {reloadFailures} profile(s).", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to save theme: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

