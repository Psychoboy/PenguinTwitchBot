    private async Task AssignThemeOnlyAsync(Guid themeId)
    {
        if (_selectedProfile == null) return;
        var targetProfileId = _selectedProfile.Id;
        var selectionVersion = _profileSelectionVersion;
        _isSaving = true;
        try
        {
            var persisted = await CreditsService.GetProfileByIdAsync(targetProfileId);
            if (persisted == null)
            {
                Snackbar.Add("Selected profile could not be found.", Severity.Warning);
                await LoadAllAsync();
                return;
            }

            var persistedConfig = CreditsDataBuilder.DeserializeProfileConfig(persisted.ConfigJson);
            var saved = await CreditsService.SaveProfileAsync(
                persisted.Id,
                persisted.Name,
                themeId,
                persistedConfig,
                persisted.IsDefault);

            _profiles = await CreditsService.GetProfilesAsync();
            var refreshed = _profiles.FirstOrDefault(p => p.Id == saved.Id) ?? saved;
            if (_profileSelectionVersion == selectionVersion)
            {
                _selectedProfile = refreshed;
                _selectedThemeId = refreshed.ThemeId;
                RefreshPreviewFrame();
            }

            try
            {
                await CreditsService.NotifyReloadAsync(refreshed.Name);
                Snackbar.Add($"Applied theme '{GetActiveThemeName()}' to '{refreshed.Name}'.", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Applied theme '{GetActiveThemeName()}' to '{refreshed.Name}', but live overlay reload notification failed: {ex.Message}", Severity.Warning);
            }
        }
        catch (Exception ex)
