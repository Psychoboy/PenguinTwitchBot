    private async Task CopyObsUrlAsync()
    {
        var url = GetStandaloneUrl(autoStart: false);
        var copied = false;
        try
        {
            copied = await JS.InvokeAsync<bool>("copyToClipboard", url);
        }
        catch (Exception)
        {
            copied = false;
        }
        Snackbar.Add(
            copied ? "Copied OBS Credits URL to clipboard!" : $"OBS URL: {url}",
            copied ? Severity.Success : Severity.Info);
    }

    private string GetActiveThemeName() =>
        _themes.FirstOrDefault(t => t.Id == _selectedThemeId)?.Name ?? "Classic Cinema";

    private static string GetSourceDisplayName(string key) =>
        CreditSectionSources.Catalog.FirstOrDefault(c => c.Key.Equals(key, StringComparison.OrdinalIgnoreCase))?.DisplayName ?? key;

    private static string FormatSessionLabel(CreditStreamSession s)
    {
        var endLabel = s.EndedAtUtc.HasValue ? s.EndedAtUtc.Value.ToString("MM-dd HH:mm") : "Active / Open";
        var kind = s.IsManualCheckpoint ? "Checkpoint" : "Stream";
        var title = string.IsNullOrWhiteSpace(s.Title) ? kind : $"{kind}: {s.Title}";
        return $"{s.StartedAtUtc:yyyy-MM-dd HH:mm} UTC -> {endLabel} ({title})";
    }

    private static string BuildThemeSwatchStyle(CreditsThemeConfig cfg)
    {
        var bg = cfg.BackgroundType switch
        {
            CreditBackgroundTypes.Starfield => "radial-gradient(circle at 30% 30%, #1d2238 0%, #000000 100%)",
            CreditBackgroundTypes.Gradient when !string.IsNullOrWhiteSpace(cfg.BackgroundGradient) => cfg.BackgroundGradient,
            CreditBackgroundTypes.Transparent => "linear-gradient(135deg, #232733 25%, #191c24 25%, #191c24 50%, #232733 50%, #232733 75%, #191c24 75%)",
            _ => cfg.BackgroundColor
        };
        return $"background: {bg}; border-radius: 6px; padding: 10px 12px; border: 1px solid rgba(255,255,255,0.14);";
    }
}
