    private void MoveSection(int index, int delta)
    {
        var target = index + delta;
        if (target < 0 || target >= _profileConfig.Sections.Count) return;
        (_profileConfig.Sections[index], _profileConfig.Sections[target]) = (_profileConfig.Sections[target], _profileConfig.Sections[index]);
    }

    private void DuplicateSection(int index)
    {
        if (index < 0 || index >= _profileConfig.Sections.Count) return;
        var json = JsonSerializer.Serialize(_profileConfig.Sections[index], CreditsDataBuilder.JsonOptions);
        var clone = JsonSerializer.Deserialize<CreditsSectionConfig>(json, CreditsDataBuilder.JsonOptions);
        if (clone == null) return;
        clone.Id = Guid.NewGuid().ToString("N");
        clone.Title = $"{clone.Title} (Copy)";
        _profileConfig.Sections.Insert(index + 1, clone);
    }

