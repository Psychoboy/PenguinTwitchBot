    private async Task SaveProfileAsync()
    {
        if (_selectedProfile == null) return;
        if (string.IsNullOrWhiteSpace(_profileNameDraft))
        {
            Snackbar.Add("Profile name is required.", Severity.Warning);
            return;
        }

        var trimmedName = _profileNameDraft.Trim();
        if (!string.Equals(trimmedName, _selectedProfile.Name, StringComparison.Ordinal))
        {
            var confirmRename = await DialogService.ShowMessageBoxAsync(
                "Rename Credits Profile",
                $"Rename profile '{_selectedProfile.Name}' to '{trimmedName}'? Existing OBS browser source URLs or Bot Actions referencing '{_selectedProfile.Name}' will need to be updated.",
                yesText: "Rename",
                cancelText: "Cancel");
            if (confirmRename != true) return;
        }

        _isSaving = true;
        var selectionVersion = _profileSelectionVersion;
        try
        {
            SyncProfileDraftFieldsToConfig();
            var saved = await CreditsService.SaveProfileAsync(
                _selectedProfile.Id,
                trimmedName,
                _selectedThemeId,
                _profileConfig,
                _selectedProfile.IsDefault);

            _profiles = await CreditsService.GetProfilesAsync();
            var refreshed = _profiles.FirstOrDefault(p => p.Id == saved.Id) ?? saved;
            if (_profileSelectionVersion == selectionVersion)
            {
                LoadProfileIntoEditor(refreshed);
                RefreshPreviewFrame();
                await RefreshEventsAndSessionsAsync();
            }

            try
            {
                await CreditsService.NotifyReloadAsync(refreshed.Name);
                Snackbar.Add($"Saved credits profile '{refreshed.Name}'.", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Saved credits profile '{refreshed.Name}', but live overlay reload notification failed: {ex.Message}", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to save profile: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

