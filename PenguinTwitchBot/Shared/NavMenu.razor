                    <MudNavLink Icon="@Icons.Material.Filled.Air" Href="/games/balloon" Match="NavLinkMatch.Prefix">Balloon Ascent</MudNavLink>
                    <MudNavLink Icon="@Icons.Material.Filled.SportsHockey" Href="/games/curling" Match="NavLinkMatch.Prefix">Curling / Shuffleboard</MudNavLink>
