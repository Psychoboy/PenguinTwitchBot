@inject NavigationManager Navigation
@inject IVersionCheckService VersionCheck
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject PenguinTwitchBot.Bot.Features.IFeatureRuntimeCoordinator FeatureRuntimeCoordinator
@inject IQuickSearchService QuickSearchService
@using PenguinTwitchBot.Helpers
@using PenguinTwitchBot.Bot.Features
@using PenguinTwitchBot.Services
@using Microsoft.AspNetCore.Components.Authorization
@implements IDisposable

<div style="height:100%; display:flex; flex-direction:column;">
<MudNavMenu Style="flex:1; overflow:auto;">
<CascadingAuthenticationState>  
    
    <MudNavLink Icon="@Icons.Material.Filled.Home" Href="/" Match="NavLinkMatch.All">Home</MudNavLink>
    <AuthorizeView Roles="Streamer, Editor">
        <Authorized>
            <MudPaper Outlined="true" Class="mb-4 pa-2">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.overline" Class="px-2">Quick Jump</MudText>
                    <MudTextField @bind-Value="_navSearchText"
                                  @bind-Value:after="OnSearchTextChanged"
                                  Placeholder="Search menu, commands, actions..."
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  DebounceInterval="250"
                                  Clearable="true"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                    @if (_isSearching)
                    {
                        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-1" Size="Size.Small" />
                    }
                    @if (_searchResults.Count > 0)
                    {
                        <div style="max-height: 380px; overflow-y: auto;" class="px-1 pb-1">
                            @foreach (var group in _searchResults.GroupBy(r => r.Category))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Primary" Class="px-2 pt-2 pb-1 font-weight-bold" Style="display:block; text-transform:uppercase; font-size:0.7rem; letter-spacing:0.5px;">
                                    @group.Key
                                </MudText>
                                @foreach (var item in group)
                                {
                                    <MudButton OnClick="() => NavigateToItem(item.Href)"
                                               Variant="Variant.Text"
                                               FullWidth="true"
                                               Class="py-1 px-2 my-0 text-left"
                                               Style="justify-content:flex-start; text-transform:none; border-radius:4px;">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Style="width:100%; overflow:hidden;">
                                            <MudIcon Icon="@item.Icon" Size="Size.Small" Color="Color.Default" Style="flex-shrink:0;" />
                                            <div style="min-width:0; flex:1; text-align:left;">
                                                <MudText Typo="Typo.body2" Class="text-truncate">@item.Title</MudText>
                                                @if (!string.IsNullOrWhiteSpace(item.Subtitle))
                                                {
                                                    <MudText Typo="Typo.caption" Class="mud-text-secondary text-truncate" Style="display:block; font-size:0.72rem; line-height:1.1;">
                                                        @item.Subtitle
                                                    </MudText>
                                                }
                                            </div>
                                        </MudStack>
                                    </MudButton>
                                }
                            }
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(_navSearchText) && !_isSearching)
                    {
                        <MudText Typo="Typo.caption" Class="px-2 pb-1 mud-text-secondary">No matching items found.</MudText>
                    }
                </MudStack>
            </MudPaper>

            <MudNavGroup Icon="@Icons.Material.Filled.LiveTv" Title="Stream Tools" Expanded="@GetGroupExpanded("streamTools", "raidhistory", "musicplayer", "playlists", "bannedsongs", "songcooldowns", "overlay/editor", "overlay/timer")">
                <MudNavLink Icon="@Icons.Material.Filled.Groups" Href="/raidhistory" Match="NavLinkMatch.Prefix">Raid History</MudNavLink>
                <MudNavLink Icon="@Icons.Material.Filled.PlayCircle" Href="/musicplayer" Match="NavLinkMatch.Prefix" Target="_blank">Music Player</MudNavLink>
                <MudNavLink Icon="@Icons.Material.Filled.QueueMusic" Href="/playlists" Match="NavLinkMatch.Prefix">Playlists</MudNavLink>
                <MudNavLink Icon="@Icons.Material.Filled.MusicOff" Href="/bannedsongs" Match="NavLinkMatch.Prefix">Banned Songs</MudNavLink>
                <MudNavLink Icon="@Icons.Material.Filled.Timer" Href="/songcooldowns" Match="NavLinkMatch.Prefix">Song Cooldowns</MudNavLink>
                <MudNavLink Icon="@Icons.Material.Filled.Layers" Href="/overlay/editor" Match="NavLinkMatch.Prefix">Overlay Editor</MudNavLink>
                <MudNavLink Icon="@Icons.Material.Filled.Timer" Href="/overlay/timer" Match="NavLinkMatch.Prefix">Stream Timer</MudNavLink>
            </MudNavGroup>
            @if (FeatureRuntimeCoordinator.IsEnabled(FeatureKeys.DropGames))
            {
