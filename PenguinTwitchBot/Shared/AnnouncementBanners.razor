@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Server
@using Microsoft.AspNetCore.Components.Server.Circuits
@using Microsoft.Extensions.Options
@using PenguinTwitchBot.Circuit
@using PenguinTwitchBot.Services
@inject AnnouncementService Announcements
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JSRuntime
@inject ILogger<AnnouncementBanners> Logger
@inject IOptions<CircuitOptions> CircuitOptions
@inject CircuitHandler CircuitHandler
@implements IAsyncDisposable

@foreach (var announcement in _visible)
{
    <MudAlert Severity="@ToSeverity(announcement.Severity)" Class="mx-4 mt-2">
        <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween">
            <GitHubMarkdownViewer Value="@announcement.Message" Class="announcement-message" Style="min-width: 0; overflow-wrap: anywhere;" Safe="true" />
            <MudTooltip Text="Dismiss announcement">
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" aria-label="Dismiss announcement" OnClick="@(() => DismissAsync(announcement))" />
            </MudTooltip>
        </MudStack>
    </MudAlert>
}

@code {
    private readonly CancellationTokenSource _cancellation = new();
    private List<Announcement> _visible = [];
    private ClaimsPrincipal _user = new();
    private string _browserScope = "anonymous";
    private Task? _refreshTask;
    private bool _browserReady;
    private CircuitHandlerService? _circuit;

    protected override void OnInitialized()
    {
        _circuit = CircuitHandler as CircuitHandlerService;
        if (_circuit != null) _circuit.ConnectionChanged += OnConnectionChanged;
        Announcements.Changed += OnChanged;
    }

    /// <summary>Loads account context and starts periodic visibility updates after browser initialization.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        if (_cancellation.IsCancellationRequested) return;
        var userId = _user.Identity?.IsAuthenticated == true
            ? _user.FindFirst("UserId")?.Value ?? _user.FindFirst(ClaimTypes.NameIdentifier)?.Value : null;
        if (!string.IsNullOrWhiteSpace(userId)) _browserScope = userId;
        _browserReady = true;
        await RefreshAsync();
        if (!_cancellation.IsCancellationRequested) _refreshTask = RefreshPeriodicallyAsync();
    }

    /// <summary>Filters active announcements against account and browser dismissals.</summary>
    private async Task RefreshAsync()
    {
        if (_circuit?.IsConnected == false) return;
        var connectionToken = _circuit?.ConnectionToken ?? CancellationToken.None;
        try
        {
            var announcements = await Announcements.GetAnnouncementsAsync();
            var dismissed = await Announcements.GetDismissalsAsync(_user);
            var visible = new List<Announcement>();
            foreach (var announcement in announcements.Where(item => item.IsVisible(DateTime.Now) && !dismissed.Contains(item.Revision)))
            {
                if (_cancellation.IsCancellationRequested) return;
                string? local = null;
                using var browserCall = CreateBrowserCallCancellation(connectionToken);
                try { local = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", browserCall.Token, StorageKey(announcement.Revision)); }
                catch (JSDisconnectedException) { return; }
                catch (JSException) { }
                if (local != "dismissed") visible.Add(announcement);
            }
            if (_cancellation.IsCancellationRequested) return;
            _visible = visible;
            StateHasChanged();
        }
        catch (OperationCanceledException) when (_cancellation.IsCancellationRequested || connectionToken.IsCancellationRequested) { }
        catch (OperationCanceledException exception)
        {
            Logger.LogWarning(exception, "Announcement browser storage call was canceled or timed out for circuit {CircuitId}", _circuit?.CircuitId ?? "unknown");
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Unable to load announcements");
        }
    }

    /// <summary>Dismisses a revision locally and, when authenticated, across the account.</summary>
    private async Task DismissAsync(Announcement announcement)
    {
        _visible.RemoveAll(item => item.Revision == announcement.Revision);
        StateHasChanged();
        var connectionToken = _circuit?.ConnectionToken ?? CancellationToken.None;
        if (_circuit?.IsConnected != false)
        {
            using var browserCall = CreateBrowserCallCancellation(connectionToken);
            try { await JSRuntime.InvokeVoidAsync("localStorage.setItem", browserCall.Token, StorageKey(announcement.Revision), "dismissed"); }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
            catch (OperationCanceledException) when (_cancellation.IsCancellationRequested || connectionToken.IsCancellationRequested) { }
            catch (OperationCanceledException exception) { Logger.LogWarning(exception, "Announcement dismissal browser storage call was canceled or timed out for circuit {CircuitId}", _circuit?.CircuitId ?? "unknown"); }
        }
        try { await Announcements.DismissAsync(_user, announcement.Revision); }
        catch (Exception exception) { Logger.LogWarning(exception, "Unable to persist announcement dismissal"); }
    }

    private string StorageKey(Guid revision) => $"penguin.announcement.{_browserScope}.{revision}";
    private void OnChanged()
    {
        if (_browserReady && !_cancellation.IsCancellationRequested && _circuit?.IsConnected != false) _ = InvokeAsync(RefreshAsync);
    }

    private void OnConnectionChanged(bool connected)
    {
        if (connected) OnChanged();
    }

    private CancellationTokenSource CreateBrowserCallCancellation(CancellationToken connectionToken)
    {
        var cancellation = CancellationTokenSource.CreateLinkedTokenSource(_cancellation.Token, connectionToken);
        cancellation.CancelAfter(CircuitOptions.Value.JSInteropDefaultCallTimeout);
        return cancellation;
    }

    /// <summary>Refreshes scheduled announcements until the component is disposed.</summary>
    private async Task RefreshPeriodicallyAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMinutes(1));
        try
        {
            while (await timer.WaitForNextTickAsync(_cancellation.Token)) await InvokeAsync(RefreshAsync);
        }
        catch (OperationCanceledException) { }
    }

    /// <summary>Maps stored announcement severity to the corresponding alert appearance.</summary>
    private static Severity ToSeverity(AnnouncementSeverity severity) => severity switch
    {
        AnnouncementSeverity.Success => Severity.Success,
        AnnouncementSeverity.Warning => Severity.Warning,
        AnnouncementSeverity.Error => Severity.Error,
        _ => Severity.Info
    };

    /// <summary>Stops periodic refreshes and unsubscribes from announcement changes.</summary>
    public async ValueTask DisposeAsync()
    {
        Announcements.Changed -= OnChanged;
        if (_circuit != null) _circuit.ConnectionChanged -= OnConnectionChanged;
        await _cancellation.CancelAsync();
        if (_refreshTask != null) await _refreshTask;
        _cancellation.Dispose();
    }
}