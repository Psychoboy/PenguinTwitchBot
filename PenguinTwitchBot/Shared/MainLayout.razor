@using PenguinTwitchBot.Circuit;
@using PenguinTwitchBot.CustomMiddleware
@using PenguinTwitchBot.Models;
@using PenguinTwitchBot.Helpers;
@using Microsoft.AspNetCore.Components.Server.Circuits;
@using Microsoft.AspNetCore.SignalR.Client;
@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject ICircuitUserService UserService
@inject PenguinTwitchBot.Bot.Core.IServiceBackbone serviceBackbone
@inject CircuitHandler BlazorCircuitHandler
@implements IAsyncDisposable
@inject ISnackbar Snackbar
@inject ILogger<MainLayout> logger
@inject PenguinTwitchBot.Bot.TwitchServices.ITwitchService twitchService


<PageTitle>@(AppConfiguration["ApplicationTitle"] ?? "Penguin Twitch Bot")</PageTitle>
<MudThemeProvider IsDarkMode=true />
<MudPopoverProvider/>
<MudDialogProvider />
<MudSnackbarProvider />
<style>
    .streamer-auth-alert {
        border: 2px solid #ff1744 !important;
        box-shadow: 0 0 12px rgba(255, 23, 68, 0.8) !important;
        animation: streamerAuthPulse 2s ease-in-out infinite;
    }
    @@keyframes streamerAuthPulse {
        0%, 100% {
            box-shadow: 0 0 8px rgba(255, 23, 68, 0.6);
        }
        50% {
            box-shadow: 0 0 20px rgba(255, 23, 68, 1);
            transform: scale(1.02);
        }
    }
</style>
<MudLayout>
    <MudAppBar>
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
        OnClick="@((e) => DrawerToggle())" />
        @(AppConfiguration["ApplicationTitle"] ?? "Penguin Twitch Bot")
        <MudSpacer />
        <AuthorizeView Roles="Streamer">
            <Authorized>
                @if (!twitchService.IsServiceUp())
                {
                    <MudAlert Severity="Severity.Error" 
                              Variant="Variant.Filled" 
                              Dense="true" 
                              Icon="@Icons.Material.Filled.WarningAmber" 
                              Class="mx-2 mud-elevation-6 streamer-auth-alert">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudText Typo="Typo.body2" Style="font-weight: 700; letter-spacing: 0.5px;">
                                STREAMER ACCOUNT NOT CONNECTED
                            </MudText>
                            <MudButton Variant="Variant.Filled" 
                                       Color="Color.Warning" 
                                       Size="Size.Small" 
                                       Href="/settings/bot-auth"
                                       StartIcon="@Icons.Material.Filled.Key"
                                       Style="font-weight: 700;">
                                Connect Now
                            </MudButton>
                        </MudStack>
                    </MudAlert>
                }
            </Authorized>
        </AuthorizeView>
        @if(StreamOnline)
        {
            <MudAlert Severity="Severity.Success" NoIcon="true">Stream is Online</MudAlert>
        }
        else
        {
            <MudAlert Severity="Severity.Error" NoIcon="true">Stream is Offline</MudAlert>
        }
        <div id="components-reconnect-modal" class="components-reconnect-hide">

            <div class="show">
                <MudSpacer />
                <MudAlert Severity="Severity.Warning" NoIcon="true">Attempting to reconnect or manually refresh.</MudAlert>
            </div>
            <div class="rejected failed">
                <MudSpacer />
                <MudAlert Severity="Severity.Warning" NoIcon="true">
                    Reconnect failed. <a href="javascript:location.reload()" style="color: var(--mud-palette-primary);">Click here to refresh</a>.
                </MudAlert>
            </div>
        </div>
        <MudSpacer />
        <AuthorizeView>
            <Authorized Context="Auth">
                <MudImage Width="48" Src="@ProfileImage" />
                <MudMenu Label="@Username" AnchorOrigin="Origin.CenterCenter" TransformOrigin="Origin.TopCenter">
                    <MudMenuItem OnClick="Signout">Sign out</MudMenuItem>
                </MudMenu>
            </Authorized>
            <NotAuthorized>
                <MudLink OnClick="Signin">Sign In</MudLink>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>
    <MudDrawer @bind-Open="@_drawerOpen" Elevation="1">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>
@code {
    bool _drawerOpen = true;
    private string Username = "";
    private string ProfileImage = "";
    private string UserId = "";
    private bool StreamOnline = false;
    private HubConnection? hubConnection;
    private CancellationTokenSource? _hubConnectionCts;
    private System.Timers.Timer? _statusCheckTimer;
    [Inject]
    BlazorAppContext? BlazorAppContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity is not null && user.Identity.IsAuthenticated && user.Identity.Name != null)
        {
            Username = user.Identity.Name;
            if (user.HasClaim(x => x.Type.Equals("DisplayName")))
            {
                Username = user.Claims.Where(x => x.Type.Equals("DisplayName")).First().Value;
            }

            if (user.HasClaim(x => x.Type.Equals("ProfilePicture")))
            {
                ProfileImage = user.Claims.Where(x => x.Type.Equals("ProfilePicture")).First().Value;
            }
            if (user.HasClaim(x => x.Type.Equals("UserId")))
            {
                UserId = user.Claims.Where(x => x.Type.Equals("UserId")).First().Value;
            }
        }

        var handler = (CircuitHandlerService)BlazorCircuitHandler;
        await UserService.Connect(handler.CircuitId, Username, UserId, BlazorAppContext?.CurrentUserIP);
        UserService.UpdateUserLastSeen(handler.CircuitId, Navigation.Uri);
        Navigation.LocationChanged += HandleLocationChanged;
        twitchService.ServiceStatusChanged += HandleServiceStatusChanged;
        _statusCheckTimer = new System.Timers.Timer(10000);
        _statusCheckTimer.Elapsed += (s, e) => RefreshStateSafe();
        _statusCheckTimer.AutoReset = true;
        _statusCheckTimer.Start();
        StreamOnline = serviceBackbone.IsOnline;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender == false) return;

        _hubConnectionCts = new CancellationTokenSource();

        // Configure SignalR with automatic reconnect and retry policy
        hubConnection = new HubConnectionBuilder()
            .WithUrl(SignalRConnectionHelper.ResolveHubUri(AppConfiguration, Navigation, "/mainhub"), options =>
            {
                // Allow fallback to other transports if WebSockets fail
                options.Transports = Microsoft.AspNetCore.Http.Connections.HttpTransportType.WebSockets | 
                                     Microsoft.AspNetCore.Http.Connections.HttpTransportType.ServerSentEvents |
                                     Microsoft.AspNetCore.Http.Connections.HttpTransportType.LongPolling;
                options.SkipNegotiation = false; // Ensure negotiation happens for transport selection
            })
            .WithAutomaticReconnect(new[] { TimeSpan.Zero, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(10) })
            .Build();

        hubConnection.On<bool>("StreamChanged", (status) =>
        {
            StreamOnline = status;
            if (status)
            {
                Snackbar.Add("Stream is now online.", Severity.Success);
            }
            else
            {
                Snackbar.Add("Stream is now offline.", Severity.Error);
            }
            InvokeAsync(StateHasChanged);
        });

        await hubConnection.StartWithExpectedExceptionHandlingAsync(logger, Snackbar, _hubConnectionCts.Token);

        StateHasChanged();
    }

    private void HandleServiceStatusChanged(object? sender, bool isUp)
    {
        RefreshStateSafe();
    }

    private void RefreshStateSafe()
    {
        try
        {
            _ = InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException) { }
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var handler = (CircuitHandlerService)BlazorCircuitHandler;
        UserService.UpdateUserLastSeen(handler.CircuitId, Navigation.Uri);
        RefreshStateSafe();
    }

    private void Signin()
    {
        Navigation.NavigateToSigninWithReturnUrl();
    }

    private void Signout()
    {
        Navigation.NavigateTo("/signout", true);
    }

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    public async ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
        twitchService.ServiceStatusChanged -= HandleServiceStatusChanged;

        if (_statusCheckTimer is not null)
        {
            _statusCheckTimer.Stop();
            _statusCheckTimer.Dispose();
        }

        // Cancel any pending reconnection attempts
        _hubConnectionCts?.Cancel();

        if (hubConnection is not null)
        {
            try
            {
                // Stop the connection gracefully before disposing
                if (hubConnection.State != HubConnectionState.Disconnected)
                {
                    await hubConnection.StopAsync();
                }
                await hubConnection.DisposeAsync();
            }
            catch (Exception ex)
            {
                // Log but don't throw - disposal should be silent to user
                logger.LogDebug(ex, "Exception during SignalR connection disposal (non-critical)");
            }
        }

        _hubConnectionCts?.Dispose();
    }
}
