@inject IDialogService DialogService

<MudButton OnClick="OpenHelpAsync"
           Variant="Variant.Text"
           Color="@Color"
           Size="Size.Small"
           Class="@($"pa-0 text-transform-none {Class}")"
           Style="@($"min-width: 0; text-transform: none; {Style}")">
    <MudIcon Icon="@Icons.Material.Filled.HelpOutline" Size="@IconSize" Class="mr-1" />
    <MudText Typo="@Typo" Color="@Color" Style="text-decoration: underline; text-underline-offset: 2px;">
        @(string.IsNullOrWhiteSpace(Text) ? "Markdown formatting guide" : Text)
    </MudText>
</MudButton>

@code {
    [Parameter] public string Text { get; set; } = "Markdown formatting guide";
    [Parameter] public Typo Typo { get; set; } = Typo.caption;
    [Parameter] public Color Color { get; set; } = Color.Primary;
    [Parameter] public Size IconSize { get; set; } = Size.Small;
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }

    private async Task OpenHelpAsync()
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = true,
            CloseOnEscapeKey = true
        };
        await DialogService.ShowAsync<MarkdownHelpDialog>("Markdown Guide", options);
    }
}

